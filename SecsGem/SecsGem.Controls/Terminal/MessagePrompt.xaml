<Window
    x:Class="SecsGem.Controls.Terminal.MessagePrompt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Window"
    Width="350"
    Height="230"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ControlTool_WPF;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="White"
        BorderBrush="{StaticResource MaterialDesign.Brush.Primary}"
        BorderThickness="2"
        CornerRadius="20">

        <materialDesign:Card
            Padding="8,0,8,0"
            Background="Transparent"
            Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark.Foreground}">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="10" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <TextBlock
                        Margin="16,16,16,4"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding ElementName=Window, Path=Title}">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{DynamicResource MaterialDesignShadow}" />
                        </TextBlock.Foreground>
                    </TextBlock>

                    <TextBlock
                        Margin="16,16,16,4"
                        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                        Text="{Binding ElementName=Window, Path=Message}"
                        TextWrapping="WrapWithOverflow">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{DynamicResource MaterialDesignShadow}" />
                        </TextBlock.Foreground>
                    </TextBlock>

                </StackPanel>

                <Separator
                    Grid.Row="2"
                    Margin="0,0,0,0"
                    Style="{StaticResource MaterialDesignSeparator}" />

                <Grid Grid.Row="3" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="1"
                        Width="100"
                        HorizontalAlignment="Center"
                        Click="Button_Click"
                        Content="OK"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button
                        Grid.Column="0"
                        Width="100"
                        HorizontalAlignment="Center"
                        Click="Button_Click_1"
                        Content="Cancel"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Visibility="{Binding ElementName=Window, Path=Visibility_Cancel}" />
                </Grid>
            </Grid>
        </materialDesign:Card>

    </Border>
</Window>
