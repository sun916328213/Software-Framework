<Window x:Class="SecsGem.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecsGem.Controls.Views;assembly=SecsGem.Controls"
        Title="SECS/GEM 工作台" Width="1100" Height="760" MinWidth="850" MinHeight="580">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox x:Name="ConnectionMode" Width="100" SelectedIndex="0" Margin="0,0,12,0">
                        <ComboBoxItem Content="主动" />
                        <ComboBoxItem Content="被动" />
                    </ComboBox>
                    <TextBlock Text="地址" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox x:Name="AddressBox" Width="130" Text="127.0.0.1" Margin="0,0,12,0" />
                    <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox x:Name="PortBox" Width="65" Text="5000" Margin="0,0,12,0" />
                    <TextBlock Text="Device ID" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox x:Name="DeviceIdBox" Width="60" Text="0" Margin="0,0,12,0" />
                    <Button Content="连接" Click="Connect_Click" Margin="0,0,6,0" />
                    <Button Content="断开" Click="Disconnect_Click" />
                </WrapPanel>
                <controls:SecsOverviewView x:Name="Overview" Height="65" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
            <TabItem Header="通信与消息">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="建立通信 S1F13" Click="Establish_Click" Margin="0,0,6,0" />
                        <Button Content="Online Remote" Click="Online_Click" Margin="0,0,6,0" />
                        <Button Content="Offline" Click="Offline_Click" Margin="0,0,6,0" />
                        <Button Content="加载 GEM 配置" Click="LoadConfig_Click" Margin="0,0,6,0" />
                        <Button Content="载入内存示例" Click="LoadSample_Click" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="0,10,0,4" Text="手工发送 SML（例如 'S1F1' W；多行消息可附 SECS Item）" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SmlBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="'S1F1' W" FontFamily="Consolas" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox x:Name="WaitReplyBox" Content="等待回复" IsChecked="True" Margin="0,0,0,8" />
                            <Button Content="发送" Click="SendSml_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="变量 SVID/DVID/ECID">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="VariableGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="90" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="100" />
                            <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="新值" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="VariableValueBox" Width="220" Margin="0,0,8,0" />
                        <Button Content="写入选中变量" Click="SetVariable_Click" Margin="0,0,8,0" />
                        <Button Content="刷新" Click="RefreshCatalog_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="事件与报表">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,5,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CEID" Binding="{Binding ID}" Width="75" />
                            <DataGridTextColumn Header="事件" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Report IDs" Binding="{Binding ReportID_Collection}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Column="1" x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="5,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Report ID" Binding="{Binding ID}" Width="90" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="VID IDs" Binding="{Binding VID_Collection}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="上报选中 CEID (S6F11)" Click="ReportEvent_Click" Margin="0,8,5,0" />
                </Grid>
            </TabItem>
            <TabItem Header="报警">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="AlarmGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ALID" Binding="{Binding ID}" Width="90" />
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enable}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Content="选中报警触发 (S5F1)" Click="RaiseAlarm_Click" Margin="0,0,8,0" />
                        <Button Content="选中报警复位 (S5F1)" Click="ResetAlarm_Click" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="远程命令与 S10">
                <StackPanel Margin="10">
                    <TextBlock Text="收到 S2F41 后，工作台记录命令与参数并按下方 HCACK 应答。" Margin="0,0,0,10" />
                    <WrapPanel>
                        <TextBlock Text="HCACK" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="HcackBox" Width="60" Text="0" />
                    </WrapPanel>
                    <TextBlock Text="S10 Terminal 将在收到 Host 消息时弹出提示窗。" Margin="0,20,0,8" />
                    <Button Content="预览 S10 提示窗" Width="160" HorizontalAlignment="Left" Click="PreviewTerminal_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock Text="消息监视器" FontWeight="SemiBold" />
                <Button Content="清空" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="ClearLog_Click" />
            </DockPanel>
            <ListBox Grid.Row="1" x:Name="MessageLog" FontFamily="Consolas" />
        </Grid>
    </Grid>
</Window>
