<UserControl
    x:Class="DataManager.Workbench.Views.SqlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- 页头 -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Foreground="#3F51B5"
                    Kind="Database" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="SQL 数据库测试" />
                    <TextBlock Style="{StaticResource PageSubTitle}"
                               Text="通过 DataManager 的 SQLManager / ISQL&lt;T&gt; 测试 EFCore、SqlSugar、Dapper 三种工具（数据库：MySQL / PostgreSQL）" />
                </StackPanel>
            </StackPanel>

            <!-- 连接配置 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="连接配置" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="服务器 IP"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding ServerIP}" />
                        <TextBox
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="端口"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Port}" />
                        <TextBox
                            Grid.Column="4"
                            materialDesign:HintAssist.Hint="用户名"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding UserName}" />
                        <TextBox
                            Grid.Column="6"
                            materialDesign:HintAssist.Hint="密码"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Password}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="数据库名"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding DBName}" />
                        <ComboBox
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="数据库类型"
                            ItemsSource="{Binding DbTypes}"
                            SelectedItem="{Binding SelectedDbType}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <ComboBox
                            Grid.Column="4"
                            materialDesign:HintAssist.Hint="工具类型"
                            ItemsSource="{Binding ToolTypes}"
                            SelectedItem="{Binding SelectedToolType}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button Command="{Binding ConnectCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="Connection" />
                                    <TextBlock Margin="6,0,0,0" Text="连接" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Background="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Command="{Binding DisconnectCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="CloseCircleOutline" />
                                    <TextBlock Margin="6,0,0,0" Text="断开" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <materialDesign:Chip Content="{Binding StatusText}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 数据操作 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="数据操作（TestEntity：Id / Name / Age / CreateTime，Day 分表）" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding AddCommand}" Content="单条添加" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding AddRangeCommand}" Content="批量添加 10 条" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryAllCommand}" Content="查询全部" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryConditionCommand}" Content="条件查询 Age>20" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding UpdateSelectedCommand}" Content="更新选中行" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding DeleteSelectedCommand}" Content="删除选中行" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Background="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Command="{Binding DeleteAllCommand}"
                            Content="清空表"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding SplitTablesCommand}" Content="获取分表名" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 查询结果 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询结果" />
                    <DataGrid
                        Height="230"
                        Margin="0,12,0,0"
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedEntity}"
                        Style="{StaticResource MaterialDesignDataGrid}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 运行输出 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="运行输出" />
                    <TextBox Height="140" Margin="0,12,0,0" Style="{StaticResource OutputBox}" Text="{Binding OutputText, Mode=OneWay}" />
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
