<UserControl
    x:Class="DataManager.Workbench.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8" MaxWidth="1100">

            <!-- 页头 -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Foreground="#3F51B5"
                    Kind="FileDocumentOutline" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="日志测试" />
                    <TextBlock Style="{StaticResource PageSubTitle}"
                               Text="通过 DataManager 的 LogManager / ILog 测试 Serilog、NLog、log4net 日志写入与查询" />
                </StackPanel>
            </StackPanel>

            <!-- 日志配置 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="日志配置" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="名称"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding LogName}" />
                        <TextBox
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="日志目录"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding FilePath}" />
                        <TextBox
                            Grid.Column="4"
                            materialDesign:HintAssist.Hint="保存天数"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SaveDays}" />
                        <ComboBox
                            Grid.Column="6"
                            materialDesign:HintAssist.Hint="日志库"
                            ItemsSource="{Binding LogTypes}"
                            SelectedItem="{Binding SelectedLogType}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding InitLogCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Play" />
                                <TextBlock Margin="6,0,0,0" Text="初始化日志" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8" Command="{Binding OpenFolderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="FolderOpen" />
                                <TextBlock Margin="6,0,0,0" Text="打开日志目录" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 写入 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="写入日志" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="日志内容"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Message}" />
                        <ComboBox
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="等级"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding WriteCommand}" Content="写入一条" Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button Command="{Binding WriteManyCommand}" Content="批量写 100 条" Style="{StaticResource MaterialDesignRaisedButton}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 查询 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询日志" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="日志文件"
                            ItemsSource="{Binding Files}"
                            SelectedItem="{Binding SelectedFile}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                        <DatePicker
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="开始日期"
                            SelectedDate="{Binding StartDate}" />
                        <DatePicker
                            Grid.Column="4"
                            materialDesign:HintAssist.Hint="结束日期"
                            SelectedDate="{Binding EndDate}" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding RefreshFilesCommand}" Content="刷新文件列表" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryByFileCommand}" Content="按文件查询" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryByRangeCommand}" Content="按时间范围查询" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryMultiCommand}" Content="多行读取" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 查询结果 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询结果" />
                    <DataGrid
                        Height="200"
                        Margin="0,12,0,0"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding Results}"
                        Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="170" Binding="{Binding Time}" Header="时间" />
                            <DataGridTextColumn Width="90" Binding="{Binding Level}" Header="等级" />
                            <DataGridTextColumn Width="*" Binding="{Binding Info}" Header="内容" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#64748B" Text="多行原文" />
                    <TextBox Height="90" Margin="0,6,0,0" Style="{StaticResource OutputBox}" Text="{Binding MultiText, Mode=OneWay}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 运行输出 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="运行输出" />
                    <TextBox Height="120" Margin="0,12,0,0" Style="{StaticResource OutputBox}" Text="{Binding OutputText, Mode=OneWay}" />
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
