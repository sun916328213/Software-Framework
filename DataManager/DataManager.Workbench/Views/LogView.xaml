<UserControl
    x:Class="DataManager.Workbench.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:log="clr-namespace:DataManager.Log.Definition;assembly=DataManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:DataManager.Workbench.Views.Shared"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="/WPFCustomControls;component/Resources/Resources.xaml" />
           </ResourceDictionary.MergedDictionaries>-->


            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style BasedOn="{StaticResource MaterialDesignComboBox}" TargetType="ComboBox">
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="PrimaryLight" />
            </Style>

            <ObjectDataProvider
                x:Key="LogLibs"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="log:ELogType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- 宽屏双列：页头/配置占满，写入与查询、结果与输出并排 -->
        <Grid MaxWidth="1360" Margin="24,20,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  页头  -->
            <shared:PageHeaderView
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,16"
                IconKind="FileDocumentOutline"
                SubTitle="通过 DataManager 的 LogManager / ILog 测试 Serilog、NLog、log4net 日志写入与查询"
                Title="日志测试" />

            <!--  日志配置：单行档案表，持久化走壳自带的保存按钮（Config/LogConfig.json）  -->
            <materialDesign:Card
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,16"
                Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="日志配置" />
                    <wpfcc:ConfigManagerView
                        Margin="0,14,0,0"
                        Title="日志配置档案"
                        AddVisibility="Collapsed"
                        DeleteVisibility="Collapsed"
                        FileName="LogConfig.json"
                        FilePath="{Binding ConfigDir}"
                        ItemsSource="{Binding LogProfiles}"
                        SaveCallback="{Binding ProfilesSavedAction}"
                        SelectVisibility="Collapsed">
                        <wpfcc:ConfigManagerView.DataGridColumns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Header="名称" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                Header="日志目录" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Separator, UpdateSourceTrigger=PropertyChanged}"
                                Header="分隔符" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding SaveDays, UpdateSourceTrigger=PropertyChanged}"
                                Header="保存天数" />
                            <DataGridComboBoxColumn
                                Width="110"
                                Header="日志库"
                                ItemsSource="{Binding Source={StaticResource LogLibs}}"
                                SelectedItemBinding="{Binding LogType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </wpfcc:ConfigManagerView.DataGridColumns>
                    </wpfcc:ConfigManagerView>
                    <WrapPanel Margin="0,14,0,0">
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding InitLogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Play" />
                                <TextBlock Margin="6,0,0,0" Text="初始化日志" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="FolderOpen" />
                                <TextBlock Margin="6,0,0,0" Text="打开日志目录" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!--  写入  -->
            <materialDesign:Card
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,0,16"
                Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="写入日志" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="日志内容"
                            Style="{StaticResource DmInput}"
                            Text="{Binding Message}" />
                        <ComboBox
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="等级"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            Style="{StaticResource DmCombo}" />
                        <StackPanel
                            Grid.Column="4"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding WriteCommand}"
                                Content="写入一条"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button
                                Command="{Binding WriteManyCommand}"
                                Content="批量写 100 条"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!--  查询  -->
            <materialDesign:Card
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,0,0,16"
                Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询日志" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="日志文件"
                            ItemsSource="{Binding Files}"
                            SelectedItem="{Binding SelectedFile}"
                            Style="{StaticResource DmCombo}" />
                        <DatePicker
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="开始日期"
                            SelectedDate="{Binding StartDate}" />
                        <DatePicker
                            Grid.Column="4"
                            materialDesign:HintAssist.Hint="结束日期"
                            SelectedDate="{Binding EndDate}" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding RefreshFilesCommand}"
                            Content="刷新文件列表"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding QueryByFileCommand}"
                            Content="按文件查询"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding QueryByRangeCommand}"
                            Content="按时间范围查询"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding QueryMultiCommand}"
                            Content="多行读取"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!--  查询结果  -->
            <materialDesign:Card
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,0,16"
                Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询结果" />
                    <DataGrid
                        Height="200"
                        Margin="0,12,0,0"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding Results}"
                        Style="{StaticResource DmGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="170"
                                Binding="{Binding Time}"
                                Header="时间" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Level}"
                                Header="等级" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Info}"
                                Header="内容" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Opacity="0.6"
                        Text="多行原文" />
                    <TextBox
                        Height="90"
                        Margin="0,6,0,0"
                        Style="{StaticResource OutputBox}"
                        Text="{Binding MultiText, Mode=OneWay}" />
                </StackPanel>
            </materialDesign:Card>

            <!--  运行输出  -->
            <shared:RunOutputView
                Grid.Row="3"
                Grid.Column="2"
                Margin="0,0,0,16"
                OutputHeight="120" />

        </Grid>
    </ScrollViewer>
</UserControl>
