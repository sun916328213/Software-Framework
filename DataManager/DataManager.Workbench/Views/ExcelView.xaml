<UserControl
    x:Class="DataManager.Workbench.Views.ExcelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,8" MaxWidth="1100">

            <!-- 页头 -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Foreground="#3F51B5"
                    Kind="FileExcelOutline" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Excel 测试" />
                    <TextBlock Style="{StaticResource PageSubTitle}"
                               Text="通过 DataManager 的 ExcelManager / IExcel 测试 EPPlus 与 MiniExcel 读写（追加与更新仅 EPPlus 支持）" />
                </StackPanel>
            </StackPanel>

            <!-- 配置 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="文件配置" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            materialDesign:HintAssist.Hint="文件目录"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding ExcelFilePath}" />
                        <TextBox
                            Grid.Column="2"
                            materialDesign:HintAssist.Hint="文件名"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding ExcelFileName}" />
                        <ComboBox
                            Grid.Column="4"
                            materialDesign:HintAssist.Hint="Excel 库"
                            ItemsSource="{Binding ExcelTypes}"
                            SelectedItem="{Binding SelectedExcelType}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding ApplyCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Check" />
                                <TextBlock Margin="6,0,0,0" Text="应用配置" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8" Command="{Binding OpenFolderCommand}" Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="FolderOpen" />
                                <TextBlock Margin="6,0,0,0" Text="打开文件夹" />
                            </StackPanel>
                        </Button>
                        <CheckBox Margin="4,8,0,0" Content="首行为表头" IsChecked="{Binding HasHeader}" />
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 数据操作 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="数据操作（ExcelPerson：Name / Age / CreateTime）" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,8,8" Command="{Binding Write10Command}" Content="覆盖写入 10 条" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding Add1Command}" Content="追加 1 条" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding Add10Command}" Content="追加 10 条" Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryAllCommand}" Content="查询全部" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding QueryConditionCommand}" Content="条件查询 Age>25" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Margin="0,0,8,8" Command="{Binding UpdateSelectedCommand}" Content="更新选中行" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 查询结果 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询结果" />
                    <DataGrid
                        Height="260"
                        Margin="0,12,0,0"
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedEntity}"
                        Style="{StaticResource MaterialDesignDataGrid}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 运行输出 -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="运行输出" />
                    <TextBox Height="130" Margin="0,12,0,0" Style="{StaticResource OutputBox}" Text="{Binding OutputText, Mode=OneWay}" />
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
