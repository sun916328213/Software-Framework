<Window
    x:Class="DataManager.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="DataManager 测试工作台"
    Width="1280"
    Height="820"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            Foreground="#3F51B5"
                            Kind="Database" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="DataManager" />
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="测试工作台 · Material" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    DockPanel.Dock="Bottom"
                    Margin="24,0,0,20"
                    FontSize="11"
                    Foreground="#475569"
                    Text="Material · Prism · WPF · .NET 9" />

                <ListBox
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource NavListBox}" />
            </DockPanel>
        </Border>

        <!-- 内容区域（Prism 区域导航，不动） -->
        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainRegion" />
    </Grid>
</Window>
