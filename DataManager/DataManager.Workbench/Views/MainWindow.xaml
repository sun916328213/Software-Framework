<Window
    x:Class="DataManager.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="DataManager 测试工作台"
    Width="1280"
    Height="820"
    Background="{StaticResource BgBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,24">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="DM" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="DataManager" />
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="测试工作台" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    DockPanel.Dock="Bottom"
                    Margin="24,0,0,20"
                    FontSize="11"
                    Foreground="#475569"
                    Text="Prism · WPF · .NET 9" />

                <ListBox
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource NavListBox}" />
            </DockPanel>
        </Border>

        <!-- 内容区域 -->
        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainRegion" />
    </Grid>
</Window>
