<Window
    x:Class="DataManager.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="DataManager 测试工作台"
    Width="1440"
    Height="900"
    MinWidth="1100"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏（固定深色品牌区，不随主题变） -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Database" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="DataManager" />
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="测试工作台 · Material" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 主题自由切换：侧栏固定深色品牌区，控件前景固定浅色保证可读；
                     选中/页面强调色走 MD 原生 Primary 跟随主色 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <ComboBox
                        Margin="0,0,0,8"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        ItemsSource="{Binding PrimaryColors}"
                        SelectedItem="{Binding SelectedPrimary, Mode=TwoWay}"
                        ToolTip="主色（MaterialDesign PrimaryColor）">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <ComboBox
                        Margin="0,0,0,8"
                        Background="#1E293B"
                        Foreground="#E2E8F0"
                        ItemsSource="{Binding SecondaryColors}"
                        SelectedItem="{Binding SelectedSecondary, Mode=TwoWay}"
                        ToolTip="辅色（MaterialDesign SecondaryColor）">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="{Binding ThemeTip}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Foreground="#E2E8F0"
                                Kind="{Binding ThemeIconKind}" />
                        </Button>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="Material · Prism · WPF · .NET 9" />
                    </StackPanel>
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource NavListBox}" />
            </DockPanel>
        </Border>

        <!-- 内容区域（Prism 区域导航，不动） -->
        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainRegion" />
    </Grid>
</Window>
