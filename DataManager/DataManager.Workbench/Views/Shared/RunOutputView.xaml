<UserControl
    x:Class="DataManager.Workbench.Views.Shared.RunOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root">

    <!-- 运行输出卡：输出框 + 耗时 + 导出/清空。三页共用（绑定走继承来的 DataContext，无 VM 类型耦合）。 -->
    <materialDesign:Card Padding="20">
        <StackPanel>
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionTitle}"
                    Text="运行输出" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Opacity="0.6"
                        Text="{Binding LastElapsed, StringFormat='耗时：{0}'}" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ExportOutputCommand}"
                        Content="导出"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button
                        Command="{Binding ClearOutputCommand}"
                        Content="清空"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </Grid>
            <TextBox
                Height="{Binding ElementName=Root, Path=OutputHeight}"
                Margin="0,12,0,0"
                Style="{StaticResource OutputBox}"
                Text="{Binding OutputText, Mode=OneWay}" />
        </StackPanel>
    </materialDesign:Card>
</UserControl>
