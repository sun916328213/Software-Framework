<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 页面标题（Material 风格字阶；前景钉 MD 原生键，深浅切换自动跟随，不自定义画刷） -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>
    <Style x:Key="PageSubTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!-- 品牌色（侧栏固定深色区专用，不随主题变；功能色仍走 MD 原生键） -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A" />

    <!-- 输入框（官方体系：基于 MD 默认样式，只把前景显式钉到 MD 原生键；
         Outlined 默认不把主题前景赋到 Foreground 属性，深色下会回落黑色，故须显式钉） -->
    <Style x:Key="DmInput" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!-- 下拉框（默认弹出项前景不跟随主题，显式钉原生键；控件与弹层各钉一次） -->
    <Style x:Key="DmCombo" BasedOn="{StaticResource MaterialDesignComboBox}" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- 结果表格（MD 默认 DataGrid；单元格文字随原生前景键跟随主题） -->
    <Style x:Key="DmGrid" BasedOn="{StaticResource MaterialDesignDataGrid}" TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!-- 运行输出框（深色终端风，刻意不随主题，保留定制） -->
    <Style x:Key="OutputBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0F172A" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="12,10"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏导航（侧栏是固定深色品牌区：文字前景固定浅色保证两种主题下都可读；
         选中强调色走 MD 原生 Primary，跟随主色切换） -->
    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:Chip
                            Background="#334155"
                            Content="{Binding Badge}"
                            Foreground="#E2E8F0" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#E2E8F0"
                            Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="bd"
                                    Margin="0,2"
                                    Padding="12,6"
                                    Background="Transparent"
                                    CornerRadius="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
