<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        DataManager.Controls 页面样式（SqlView / LogView / ExcelView 共用）。
        页头 / 运行输出卡已迁到 WPFCustomControls.Controls.PageHeaderView / RunOutputView
        （样式内联在控件里），本字典不再定义 PageTitle / PageSubTitle。

        ⚠️ 本文件是这批样式的**唯一归属地**。
        它们原先定义在 DataManager.Workbench\Styles\Theme.xaml（宿主 WinExe）里 —— 那是错的：
        Workbench 是演示宿主，只该放自己的侧栏样式（NavItemText / NavListBox / 品牌色）；
        页面自己的样式必须跟着页面走，否则这三个页面一离开 Workbench 就 StaticResource 解析失败。
        Workbench 的 Theme.xaml 已同步移除这几个键（现只剩侧栏 / 导航 / 品牌色）。

        使用方式：由各页面在自己的 UserControl.Resources 里合并本字典（见 5 个 .xaml 顶部），
        因此不依赖任何宿主替它合并资源 —— 被 Workbench 引用或被 Packing Machine（经 WPFControl
        模块）引用都一样能加载。

        ⚠️ 本文件里的 `BasedOn="{StaticResource MaterialDesign*}"` 之所以能解析：ResourceDictionary
        经 Source 加载后是**延迟解析**的，首次取用资源时它已经被合并进宿主的资源链，StaticResource
        会沿合并链向上找到 MaterialDesign3.Defaults.xaml 里的原生样式（Workbench 的 Theme.xaml
        一直依赖同一机制）。所以各宿主必须先把 MD 主题合并进 Application.Resources —— 本仓
        Workbench / Packing Machine 的 App.xaml 都已合并，无需额外动作。
        `ScrollViewer_Style` 同理，来自 WPFCustomControls 的 Resources.xaml（由
        WPFCustomControlsModule 合并）。
    -->

    <!--  区块标题（前景钉 MD 原生键，深浅切换自动跟随，不自定义画刷）  -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!--
        输入框（官方体系：基于 MD 默认样式，只把前景显式钉到 MD 原生键；
        Outlined 默认不把主题前景赋到 Foreground 属性，深色下会回落黑色，故须显式钉）
    -->
    <Style
        x:Key="DmInput"
        BasedOn="{StaticResource MaterialDesignTextBox}"
        TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!--  下拉框（默认弹出项前景不跟随主题，显式钉原生键；控件与弹层各钉一次）  -->
    <Style
        x:Key="DmCombo"
        BasedOn="{StaticResource MaterialDesignComboBox}"
        TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </Style.Resources>
    </Style>

    <!--  结果表格（MD 默认 DataGrid；单元格文字随原生前景键跟随主题）  -->
    <Style
        x:Key="DmGrid"
        BasedOn="{StaticResource MaterialDesignDataGrid}"
        TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!--
        运行输出框 / 多行原文框（等宽字体，但跟随主题）。
        底色比卡片暗一档 ⇒ 读作内嵌凹槽；浅色 #F1F1F1 + 近黑字 / 深色 #323232 + 近白字。
        `ScrollViewer_Style` 必须保留：WPF 默认 ScrollViewer 模板在右下角放了一个填充系统色的
        Rectangle，横竖滚动条同时出现时会露出来。它属于 ScrollViewer，只套 ScrollBar_Style 治不到。
        该键由 WPFCustomControls 提供（宿主经 WPFCustomControlsModule 合并）。
    -->
    <Style x:Key="OutputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="12,10"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            Style="{StaticResource ScrollViewer_Style}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        SqlView「断开 / 清空表」两个按钮的前景：底是 MaterialDesign.Brush.ValidationError。
        ⚠️ 这是 on-color，极性与其他语义色相反 —— 它压在「随浅深翻转」的危险色底上：
        ValidationError 浅色 #B00020（深红，白字 7.33:1 ✓）/ 深色 #CF6679（浅粉，白字仅 3.60 ✗）。
        没有任何单一固定值能两边都过（浅色底要白字、深色底要黑字）。

        注意：本仓的 Brush.* 别名体系（Extension.UI.Theme.ThemeService.EnsureAliasBrushes /
        SyncAliasBrushes）**并没有登记 Brush.OnDanger**，所以这里给出定义。
        它由宿主（Workbench）经 ThemeService 按深浅替换为 白/黑；未接入 ThemeService 的宿主
        （如 Packing Machine）会一直用下面的浅色基准值。
        ⚠️ 因为要支持运行时替换，这里刻意不给它加 x:Shared，也不写死在控件上。
    -->
    <SolidColorBrush x:Key="Brush.OnDanger" Color="#FFFFFF" />

</ResourceDictionary>
