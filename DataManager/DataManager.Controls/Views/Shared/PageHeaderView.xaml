<UserControl
    x:Class="DataManager.Controls.Views.Shared.PageHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root">


    <!--
        测试页页头：图标 + 标题 + 副标题。三页共用，后续可给 WPFControl 复用
        （只依赖 MD，无 VM 耦合，DataContext 穿透）。
        
        这里刻意不挂主题切换：侧栏（MainWindow 的 Grid.Column=0）在导航时始终可见，
        主题入口放一处就够，页面上同时出现两个属于重复。
        主题切换 UI 是 WPFCustomControls.Controls.ThemePickerView，唯一实例挂在侧栏
        （侧栏已跟随主题，不再是固定深色品牌区，但「始终可见」这一点没变，所以这条结论不变）。
    -->
    <StackPanel Orientation="Horizontal">
        <materialDesign:PackIcon
            Width="28"
            Height="28"
            VerticalAlignment="Center"
            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
            Kind="{Binding ElementName=Root, Path=IconKind}" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PageTitle }" Text="{Binding ElementName=Root, Path=Title}" />
            <TextBlock Style="{StaticResource PageSubTitle}" Text="{Binding ElementName=Root, Path=SubTitle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
