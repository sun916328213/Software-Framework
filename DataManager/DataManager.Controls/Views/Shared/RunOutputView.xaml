<UserControl
    x:Class="DataManager.Controls.Views.Shared.RunOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root">

    <!--  运行输出卡：输出框 + 耗时 + 导出/清空。三页共用（绑定走继承来的 DataContext，无 VM 类型耦合）。  -->
    <!--
        Padding 20 → 16：三页（Log/Sql/Excel）里所有同级卡都已统一到 16，
        就这个共用卡还是 20，并排时内边距明显比邻居厚一圈。
        三个宿主都是本轮一起收口的页面，故直接对齐。
    -->
    <materialDesign:Card Padding="16" UniformCornerRadius="12">
        <!--
            用 Grid 而不是 StackPanel：StackPanel 只按「子元素想要多高」排布，
            输出框会永远停在 OutputHeight，宿主行再高也只能在卡片底部留一片空白。
            换成 Grid + `*` 行之后：
              · 宿主行是 Auto（SqlView 130 / ExcelView 130）→ `*` 行退化成内容高度，行为与改前完全一致；
              · 宿主行是 `*`（LogView 的结果区）→ 输出框跟着长高，把卡片填满。
            ⚠️ 于是 OutputHeight 的语义从「高度」变成「最小高度」—— 传小值不会被拉伸，
            传大值保证不低于它。
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionTitle}"
                    Text="运行输出" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Opacity="0.6"
                        Text="{Binding LastElapsed, StringFormat='耗时：{0}'}" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ExportOutputCommand}"
                        Content="导出"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button
                        Command="{Binding ClearOutputCommand}"
                        Content="清空"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </Grid>
            <TextBox
                Grid.Row="1"
                MinHeight="{Binding ElementName=Root, Path=OutputHeight}"
                Margin="0,12,0,0"
                Style="{StaticResource OutputBox}"
                Text="{Binding OutputText, Mode=OneWay}" />
        </Grid>
    </materialDesign:Card>
</UserControl>
