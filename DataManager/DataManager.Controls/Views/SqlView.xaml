<UserControl
    x:Class="DataManager.Controls.Views.SqlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sql="clr-namespace:DataManager.SQL.Definition;assembly=DataManager"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewmodels="clr-namespace:DataManager.Controls.ViewModels"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  页面样式归 DataManager.Controls 自己所有，由本页自行合并（宿主不替页面合并）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DataManager.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>


            <!--  连接表头：必须基于 MD 原生表头样式，裸样式会丢模板变成 WPF 默认灰表头  -->
            <Style
                x:Key="ConnHeader"
                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
                TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
            <ObjectDataProvider
                x:Key="DbTypes"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="sql:ESQLType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider
                x:Key="ToolTypes"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="sql:ESQLToolType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!--  宽屏双列：页头/配置/操作占满，查询结果与运行输出并排  -->
        <Grid
            MaxWidth="1360"
            Margin="24,0,24,0"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  页头  -->
            <wpfcc:PageHeaderView
                Title="SQL 数据库测试"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,12,0,12"
                IconKind="Database"
                SubTitle="通过 DataManager 的 SQLManager / ISQL&lt;T&gt; 测试 EFCore、SqlSugar、Dapper 三种工具（数据库：MySQL / PostgreSQL）" />

            <!--  连接配置  -->
            <materialDesign:Card
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,12"
                Padding="16"
                UniformCornerRadius="12">
                <StackPanel>
                    <!--
                        卡片标题行 = 标题（左）+ 动作按钮与连接状态（右）。
                        「连接 / 断开 / 测试连接 / 状态 chip」原先单独占卡片**底部**一整行
                        （8 上边距 + 32 按钮行 ≈ 40px），而它们本来就是「这个配置区的动作」——
                        提到标题行右侧既省掉这一行，也让「动作跟着它作用的对象」
                        （与 LogView / ExcelView 的配置卡同一手法）。
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="连接配置"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button Command="{Binding ConnectCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="Connection" />
                                    <TextBlock Margin="6,0,0,0" Text="连接" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                Command="{Binding DisconnectCommand}"
                                Foreground="{DynamicResource Brush.OnDanger}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="CloseCircleOutline" />
                                    <TextBlock Margin="6,0,0,0" Text="断开" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding TestConnectionCommand}"
                                Content="测试连接"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="连上即断开，只验证选中行的连接是否可用" />

                            <materialDesign:Chip
                                Margin="8,0,0,0"
                                Content="{Binding Model.StatusText}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </StackPanel>
                    </Grid>
                    <!--
                        连接档案表：通用配置壳，列与回调全 XAML 声明，零 code-behind。
                        持久化走壳自带的保存按钮（Config/SqlConnections.json）
                        
                        Height=250：ConfigManagerView 右侧按钮列要 240（5 按钮 × 48）+ 10 外框。
                        原来给 300 ⇒ 底部 50px 是纯空白（LogView / ExcelView 已是 250）。
                    -->
                    <wpfcc:ConfigManagerView
                        x:Name="ConnectionManager"
                        Title="SQL 连接档案"
                        Height="250"
                        Margin="0,12,0,0"
                        AddCallback="{Binding ConnectionAddedAction}"
                        DeletedCallback="{Binding ConnectionDeletedAction}"
                        FileName="{Binding Model.FileName}"
                        FilePath="{Binding Model.FilePath}"
                        ItemsSource="{Binding Model.DataCollection}"
                        SaveCallback="{Binding ProfilesSavedAction}"
                        SelectItem="{Binding Model.SelectedConnection, Mode=TwoWay}">
                        <wpfcc:ConfigManagerView.DataGridColumns>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Header="档案名"
                                HeaderStyle="{StaticResource ConnHeader}" />
                            <DataGridComboBoxColumn
                                Width="*"
                                MinWidth="100"
                                Header="数据库类型"
                                HeaderStyle="{StaticResource ConnHeader}"
                                ItemsSource="{Binding Source={StaticResource DbTypes}}"
                                SelectedItemBinding="{Binding DBType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridComboBoxColumn
                                Width="*"
                                MinWidth="100"
                                Header="工具类型"
                                HeaderStyle="{StaticResource ConnHeader}"
                                ItemsSource="{Binding Source={StaticResource ToolTypes}}"
                                SelectedItemBinding="{Binding ToolType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding ServerIP, UpdateSourceTrigger=PropertyChanged}"
                                Header="服务器"
                                HeaderStyle="{StaticResource ConnHeader}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                Header="端口"
                                HeaderStyle="{StaticResource ConnHeader}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding DBName, UpdateSourceTrigger=PropertyChanged}"
                                Header="数据库"
                                HeaderStyle="{StaticResource ConnHeader}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                Header="用户名"
                                HeaderStyle="{StaticResource ConnHeader}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                Header="密码"
                                HeaderStyle="{StaticResource ConnHeader}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                Header="文件路径"
                                HeaderStyle="{StaticResource ConnHeader}" />
                        </wpfcc:ConfigManagerView.DataGridColumns>
                    </wpfcc:ConfigManagerView>
                    <Expander
                        Header="高级：标准连接字符串"
                        IsExpanded="False"
                        Style="{StaticResource MaterialDesignExpander}">
                        <TextBox
                            Margin="4"
                            materialDesign:HintAssist.Hint="直通串（非空时优先使用，覆盖上方分字段）例：Host=127.0.0.1;Port=5432;Database=workbench;Username=postgres;Password=postgres;"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Style="{StaticResource DmInput}"
                            Text="{Binding Model.SelectedConnection.ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </materialDesign:Card>

            <!--  数据操作  -->
            <materialDesign:Card
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,12"
                Padding="16"
                UniformCornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                        标题只留「数据操作」，实体字段说明挪到 ToolTip：
                        原先标题自然宽 460.5，7 个按钮合计 738.7，共需 1199 > 可用 1063
                        ⇒ 按钮并进标题行必然把标题截掉（实测留档 `op-row.txt`）。
                        说明信息不丢，改成悬停可见。
                        标题列 `Auto`（不被压缩）+ 按钮列 `*`（右对齐），省掉原来独立的按钮行 40px。
                    -->
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SectionTitle}"
                        Text="数据操作"
                        ToolTip="SqlTestEntity：Id / Name / CreateTime，Day 分表" />

                    <WrapPanel
                        Grid.Column="1"
                        Margin="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding AddCommand}"
                            Content="单条添加"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding AddRangeCommand}"
                            Content="批量添加 10 条"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding QueryAllCommand}"
                            Content="查询全部"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding UpdateSelectedCommand}"
                            Content="更新选中行"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="删除选中行"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.ValidationError}"
                            Command="{Binding DeleteAllCommand}"
                            Content="清空表"
                            Foreground="{DynamicResource Brush.OnDanger}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,8"
                            Command="{Binding SplitTablesCommand}"
                            Content="获取分表名"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                </Grid>
            </materialDesign:Card>

            <!--  查询结果  -->
            <materialDesign:Card
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,0,12"
                Padding="16"
                UniformCornerRadius="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询结果" />
                    <DataGrid
                        Height="230"
                        Margin="0,12,0,0"
                        ItemsSource="{Binding Model.Results}"
                        SelectedItem="{Binding Model.SelectedEntity}"
                        Style="{StaticResource DmGrid}" />
                </StackPanel>
            </materialDesign:Card>

            <!--  运行输出  -->
            <wpfcc:RunOutputView
                Grid.Row="3"
                Grid.Column="2"
                Margin="0,0,0,12"
                ClearCommand="{Binding ClearOutputCommand}"
                Elapsed="{Binding LastElapsed}"
                ExportCommand="{Binding ExportOutputCommand}"
                Text="{Binding OutputText}" />

        </Grid>
    </ScrollViewer>
</UserControl>
