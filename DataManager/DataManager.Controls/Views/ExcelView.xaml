<UserControl
    x:Class="DataManager.Controls.Views.ExcelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:excel="clr-namespace:DataManager.Excel.Definition;assembly=DataManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:DataManager.Controls.Views.Shared"
    xmlns:viewmodels="clr-namespace:DataManager.Controls.ViewModels"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  页面样式归 DataManager.Controls 自己所有，由本页自行合并（宿主不替页面合并）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DataManager.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  追加/更新仅 EPPlus 支持，下拉只给这两项  -->
            <x:Array x:Key="ExcelTools" Type="{x:Type excel:ExcelType}">
                <excel:ExcelType>EPPlus</excel:ExcelType>
                <excel:ExcelType>MiniExcel</excel:ExcelType>
            </x:Array>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!--  宽屏双列：页头/配置/操作占满，查询结果与运行输出并排  -->
        <Grid MaxWidth="1360" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  页头  -->
            <shared:PageHeaderView
                Title="Excel 测试"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,12,0,12"
                IconKind="FileExcelOutline"
                SubTitle="通过 DataManager 的 ExcelManager / IExcel 测试 EPPlus 与 MiniExcel 读写（追加与更新仅 EPPlus 支持）" />

            <!--  配置：多档案表（对标 SQL），持久化走壳自带的保存按钮（Config/ExcelConfig.json）  -->
            <materialDesign:Card
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,12"
                Padding="16"
                UniformCornerRadius="12">
                <StackPanel>
                    <!--
                        卡片标题行 = 标题（左）+ 动作按钮（右）。
                        「应用配置 / 打开文件夹」原先单独占卡片**底部**一整行
                        （14 上边距 + 32 按钮 + 8 下边距 ≈ 54px），而它们本来就是
                        「这个配置区的动作」，提到标题行右侧省掉这一行
                        （与 LogView / SqlView 的配置卡同一手法）。
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="文件配置（可多档案，选中后分别写入/查询）"
                            TextTrimming="CharacterEllipsis" />
                        <WrapPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding ApplyCommand}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="Check" />
                                    <TextBlock Margin="6,0,0,0" Text="应用配置" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Command="{Binding OpenFolderCommand}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="FolderOpen" />
                                    <TextBlock Margin="6,0,0,0" Text="打开文件夹" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                    <wpfcc:ConfigManagerView
                        Title="文件配置档案"
                        Height="250"
                        Margin="0,12,0,0"
                        AddCallback="{Binding ExcelAddedAction}"
                        DeletedCallback="{Binding ExcelDeletedAction}"
                        FileName="{Binding Model.FileName}"
                        FilePath="{Binding Model.FilePath}"
                        ItemsSource="{Binding Model.DataCollection}"
                        SaveCallback="{Binding ProfilesSavedAction}"
                        SelectItem="{Binding Model.SelectedExcelParam, Mode=TwoWay}">
                        <wpfcc:ConfigManagerView.DataGridColumns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Header="名称" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                Header="文件目录" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                                Header="文件名" />
                            <DataGridCheckBoxColumn
                                Width="90"
                                Binding="{Binding HasHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Header="首行表头">
                                <!--
                                    复选列会把行高顶高：实测纯文本列行高 33.51，加一列复选就变 45.80。
                                    原因是 MD 的 CheckBox 自然高度 28.80，再叠上单元格默认的上下内边距 ~14，
                                    期望高度超过一行文本，行就跟着长。
                                    
                                    把**这一列**的单元格内边距收掉即可：行高回到 33.51（与纯文本列完全一致），
                                    复选框仍用 MD 模板、不被裁（期望高 28.80，实际撑满单元格 32.51）。
                                    
                                    ⚠️ 别用「不写 BasedOn 的 ElementStyle」去修 —— 那会把 MD 模板整个顶掉、
                                    换成系统原生复选框；行高数字同样是 33.51，但外观已经不是 MD 的了。
                                    ⚠️ 也别指望 VerticalAlignment=Center（实测对行高无效）。
                                -->
                                <DataGridCheckBoxColumn.CellStyle>
                                    <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </DataGridCheckBoxColumn.CellStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridComboBoxColumn
                                Width="110"
                                Header="Excel 库"
                                ItemsSource="{Binding Source={StaticResource ExcelTools}}"
                                SelectedItemBinding="{Binding ToolType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </wpfcc:ConfigManagerView.DataGridColumns>
                    </wpfcc:ConfigManagerView>
                </StackPanel>
            </materialDesign:Card>

            <!--  数据操作  -->
            <materialDesign:Card
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,12"
                Padding="16"
                UniformCornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                        标题只留「数据操作」，实体字段说明挪到 ToolTip：
                        原先标题自然宽 411.7，6 个按钮合计 699.6，共需 1111 > 可用 1080
                        ⇒ 按钮并进标题行会把标题截掉（实测留档 `op-row.txt`）。
                        说明信息不丢，改成悬停可见。
                        同 SqlView「数据操作」卡同一手法，省掉原来独立的按钮行 40px。
                    -->
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SectionTitle}"
                        Text="数据操作"
                        ToolTip="ExcelTestEntity：Name / Age / CreateTime" />
                    <WrapPanel
                        Grid.Column="1"
                        Margin="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding Write10Command}"
                            Content="覆盖写入 10 条"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding Add1Command}"
                            Content="追加 1 条"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding Add10Command}"
                            Content="追加 10 条"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding QueryAllCommand}"
                            Content="查询全部"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding QueryConditionCommand}"
                            Content="条件查询 Age&gt;25"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding UpdateSelectedCommand}"
                            Content="更新选中行"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                </Grid>
            </materialDesign:Card>

            <!--  查询结果  -->
            <materialDesign:Card
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,0,12"
                Padding="16"
                UniformCornerRadius="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="查询结果" />
                    <DataGrid
                        Height="260"
                        Margin="0,12,0,0"
                        ItemsSource="{Binding Model.Results}"
                        SelectedItem="{Binding Model.SelectedEntity}"
                        Style="{StaticResource DmGrid}" />
                </StackPanel>
            </materialDesign:Card>

            <!--  运行输出  -->
            <shared:RunOutputView
                Grid.Row="3"
                Grid.Column="2"
                Margin="0,0,0,12"
                OutputHeight="130" />

        </Grid>
    </ScrollViewer>
</UserControl>
