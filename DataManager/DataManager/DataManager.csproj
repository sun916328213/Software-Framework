<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>Library</OutputType>
    <!-- P12 兼容门面：平台策略保持 AnyCPU；程序集名 DataManager 冻结，现有引用路径不变。 -->
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DataManager</AssemblyName>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataManager.Core\DataManager.Core.csproj" />
    <ProjectReference Include="..\DataManager.Runtime\DataManager.Runtime.csproj" />
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
  </ItemGroup>
</Project>
