<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>Library</OutputType>
    <!-- P12：平台策略保持 AnyCPU，本轮不以 net9.0-windows7.0 -> net9.0 为目标。 -->
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DataManager.Core</AssemblyName>
    <!-- Core 只承载契约与纯模型，暂不单独打包。 -->
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 参数类（SQLParam/LogParam/ExcelParam）为 ObservableObject；基础 MVVM 库，非 Provider 实现。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
