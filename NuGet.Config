<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 仓库内部 NuGet 源配置：相对路径本地 feed（过渡期；推送到私有/远程源后移除本条目）。
       pack 输出到 NugetPackages/.feed（git 忽略），任意 clone 路径均可 restore。
       保留 nuget.org 以满足其它第三方依赖。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="SoftwareFramework-local" value="./NugetPackages/.feed" />
  </packageSources>
</configuration>
