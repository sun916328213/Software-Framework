<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 内部包恢复链路：稳定公共源 + 私有远程源（GitHub Packages / Azure Artifacts /
       公司 NuGet Server，凭据不要提交到仓库）。NugetPackages/.feed 仅用于本机打包验证，
       通过命令行 source 参数显式使用，不作为主仓库恢复前提。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 待办：把下面占位地址替换为真实私有 Feed URL，并把内部包正式发布到该源 -->
    <add key="SoftwareFramework-private" value="https://nuget.local/software-framework/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="SoftwareFramework-private">
      <package pattern="Mitsubishi.MxComponent.Interop" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
