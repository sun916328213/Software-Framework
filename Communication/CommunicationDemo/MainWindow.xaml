<Window
    x:Class="CommunicationDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunicationDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <TabControl>
        <TabItem Height="30" Header="HPSocket Client">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126*" />
                    <ColumnDefinition Width="271*" />
                </Grid.ColumnDefinitions>

                <Button
                    Margin="43,21,0,0"
                    Click="Button1_Click"
                    Content="连接" />
                <Button
                    Margin="43,76,0,0"
                    Click="Button2_Click"
                    Content="发送" />
                <TextBlock x:Name="tbk_ReceivedData" Margin="43,150,59,204" />
                <Button
                    Margin="43,223,0,0"
                    Click="Button3_Click"
                    Content="断开" />
                <Button
                    Grid.ColumnSpan="2"
                    Margin="234,76,0,0"
                    Click="Button4_Click"
                    Content="发送接收" />
            </Grid>
        </TabItem>

        <TabItem Header="Mitsubishi Client">
            <Grid>
                <Button
                    Grid.ColumnSpan="2"
                    Margin="43,21,0,0"
                    Click="ButtonMitsubishi1_Click"
                    Content="连接" />
                <Button
                    Grid.ColumnSpan="2"
                    Margin="43,76,0,0"
                    Click="ButtonMitsubishi2_Click"
                    Content="发送" />
                <TextBlock
                    Margin="239,88,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="寄存器地址" />
                <TextBox x:Name="tb_Register" Margin="304,76,340,292" />
                <TextBlock
                    Margin="239,153,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="寄存器数据" />
                <TextBox x:Name="tb_Value" Margin="304,141,340,227" />
                <Button
                    Margin="43,144,0,0"
                    Click="ButtonMitsubishi3_Click"
                    Content="读取" />
                <Button
                    Margin="43,213,0,0"
                    Click="ButtonMitsubishi4_Click"
                    Content="断开" />
                <Button
                    Margin="43,275,0,0"
                    Click="ButtonMitsubishi5_Click"
                    Content="循环读取" />
                <Button
                    Margin="43,333,0,0"
                    Click="ButtonMitsubishi6_Click"
                    Content="停止循环读取" />
                <Button
                    Margin="269,213,0,0"
                    Click="ButtonMitsubishi7_Click"
                    Content="多点位写入" />
            </Grid>

        </TabItem>

        <TabItem Header="Mitsubishi MC">
            <Grid>
                <Button
                    Grid.ColumnSpan="2"
                    Margin="43,21,0,0"
                    Click="ButtonMC1_Click"
                    Content="连接" />
                <Button
                    Grid.ColumnSpan="2"
                    Margin="43,76,0,0"
                    Click="ButtonMC2_Click"
                    Content="发送" />
                <TextBlock
                    Grid.Column="1"
                    Margin="55,88,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="寄存器地址" />
                <TextBox x:Name="tb_MCRegister" Margin="220,76,0,0" />
                <TextBlock
                    Grid.Column="1"
                    Margin="55,153,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="寄存器数据" />
                <TextBox x:Name="tb_MCValue" Margin="220,141,0,0" />
                <Button
                    Margin="43,144,0,0"
                    Click="ButtonMC3_Click"
                    Content="读取" />
                <Button
                    Margin="43,213,0,0"
                    Click="ButtonMC4_Click"
                    Content="断开" />
                <Button
                    Grid.ColumnSpan="2"
                    Margin="43,275,0,0"
                    Click="ButtonMC5_Click"
                    Content="循环读取" />
                <Button
                    Grid.ColumnSpan="2"
                    Margin="43,332,0,0"
                    Click="ButtonMC6_Click"
                    Content="停止循环读取" />
                <Button
                    Margin="397,71,0,0"
                    Click="ButtonMC7_Click"
                    Content="多点位发送" />
            </Grid>

        </TabItem>

        <TabItem Header="ModbusTCP">
            <Grid>
                <Button
                    Margin="43,21,0,0"
                    Click="ButtonModbusTCP1_Click"
                    Content="连接" />
                <Button
                    Margin="43,76,0,0"
                    Click="ButtonModbusTCP2_Click"
                    Content="批量读取" />
                <TextBlock
                    Margin="239,88,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="寄存器地址" />
                <TextBox
                    x:Name="tb_ModbusTCPRegister"
                    Margin="320,76,0,0"
                    Text="40001" />
                <TextBlock
                    Margin="239,153,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="读取值" />
                <TextBox x:Name="tb_ModbusTCPValue" Margin="320,141,0,0" />
                <Button
                    Margin="43,144,0,0"
                    Click="ButtonModbusTCP3_Click"
                    Content="单点读取" />
                <Button
                    Margin="43,213,0,0"
                    Click="ButtonModbusTCP4_Click"
                    Content="单点写入" />
                <Button
                    Margin="43,275,0,0"
                    Click="ButtonModbusTCP5_Click"
                    Content="断开" />
                <Button
                    Margin="269,213,0,0"
                    Click="ButtonModbusTCP6_Click"
                    Content="多点写入" />
                <TextBlock
                    Margin="239,275,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="写入值" />
                <TextBox
                    x:Name="tb_ModbusTCPWriteValue"
                    Margin="320,263,0,0"
                    Text="100" />
                <Button
                    Margin="43,333,0,0"
                    Click="ButtonModbusTCP7_Click"
                    Content="循环读取" />
                <Button
                    Margin="269,333,0,0"
                    Click="ButtonModbusTCP8_Click"
                    Content="停止循环读取" />
            </Grid>
        </TabItem>

        <TabItem Header="OPC UA Client">
            <Grid>
                <Button
                    Margin="43,21,0,0"
                    Click="ButtonOpcUaClient1_Click"
                    Content="连接" />
                <Button
                    Margin="43,76,0,0"
                    Click="ButtonOpcUaClient2_Click"
                    Content="批量读取" />
                <TextBlock
                    Margin="239,88,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="节点ID配置" />
                <TextBox
                    x:Name="tb_OpcUaClientNodeId"
                    Margin="320,76,0,0"
                    Text="ns=2;s=Device.Temperature" />
                <TextBlock
                    Margin="239,153,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="读取值" />
                <TextBox x:Name="tb_OpcUaClientValue" Margin="320,141,0,0" />
                <Button
                    Margin="43,144,0,0"
                    Click="ButtonOpcUaClient3_Click"
                    Content="单点读取" />
                <Button
                    Margin="43,213,0,0"
                    Click="ButtonOpcUaClient4_Click"
                    Content="单点写入" />
                <Button
                    Margin="43,275,0,0"
                    Click="ButtonOpcUaClient5_Click"
                    Content="断开" />
                <Button
                    Margin="269,213,0,0"
                    Click="ButtonOpcUaClient6_Click"
                    Content="多点写入" />
                <TextBlock
                    Margin="239,275,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="写入值" />
                <TextBox
                    x:Name="tb_OpcUaClientWriteValue"
                    Margin="320,263,0,0"
                    Text="25.5" />
            </Grid>
        </TabItem>

        <TabItem Header="OPC UA Server">
            <Grid>
                <Button
                    Margin="43,21,0,0"
                    Click="ButtonOpcUaServer1_Click"
                    Content="启动服务器" />
                <Button
                    Margin="43,76,0,0"
                    Click="ButtonOpcUaServer2_Click"
                    Content="添加变量节点" />
                <TextBlock
                    Margin="43,130,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="节点名称" />
                <TextBox
                    x:Name="tb_ServerNodeName"
                    Margin="120,120,0,0"
                    Text="MyVariable" />
                <TextBlock
                    Margin="239,130,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="节点值" />
                <TextBox
                    x:Name="tb_ServerNodeValue"
                    Margin="320,120,0,0"
                    Text="100.0" />
                <Button
                    Margin="43,170,0,0"
                    Click="ButtonOpcUaServer3_Click"
                    Content="更新节点值" />
                <Button
                    Margin="43,225,0,0"
                    Click="ButtonOpcUaServer4_Click"
                    Content="停止服务器" />
                <TextBlock
                    Margin="43,280,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="服务器状态" />
                <TextBlock
                    x:Name="tb_ServerStatus"
                    Margin="120,275,0,0"
                    Foreground="Red"
                    Text="未启动" />
                <TextBlock
                    Margin="239,280,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Text="端点地址" />
                <TextBlock
                    x:Name="tb_ServerEndpoint"
                    Margin="320,275,0,0"
                    Text="opc.tcp://localhost:4840" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
