<UserControl
    x:Class="Communication.Controls.Views.DeviceConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Communication.Controls.ViewModels"
    xmlns:views="clr-namespace:Communication.Controls.Views"
    Width="820"
    d:DataContext="{d:DesignInstance Type=vm:DeviceConfigDialogViewModel}"
    d:DesignHeight="640"
    d:DesignWidth="820"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Communication.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <views:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVis" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>

            <!--  双列表单：两列均分，列内标签 + 编辑器左右排  -->
            <ItemsPanelTemplate x:Key="TwoColumnPanel">
                <UniformGrid Columns="2" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="TextFieldTemplate">
                <Grid Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="3"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Hint}" />
                    <TextBox
                        Grid.Column="1"
                        Margin="3"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                        ToolTip="{Binding Hint}">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource DmInput}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BoolFieldTemplate">
                <Grid Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Hint}" />
                    <CheckBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsChecked}"
                        ToolTip="{Binding Hint}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OptionFieldTemplate">
                <Grid Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Hint}" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding Text, Mode=TwoWay}"
                        Style="{StaticResource DmCombo}"
                        ToolTip="{Binding Hint}" />
                </Grid>
            </DataTemplate>

            <!--  串口号：下拉选 + 可手工输入，输入即校验  -->
            <DataTemplate x:Key="EditableOptionFieldTemplate">
                <Grid Margin="0,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Hint}" />
                    <ComboBox
                        Grid.Column="1"
                        IsEditable="True"
                        ItemsSource="{Binding Options}"
                        Style="{StaticResource DmCombo}"
                        Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                        ToolTip="{Binding Hint}" />
                </Grid>
            </DataTemplate>

            <v:ParamFieldTemplateSelector
                xmlns:v="clr-namespace:Communication.Controls.Views"
                x:Key="FieldTemplateSelector"
                BoolTemplate="{StaticResource BoolFieldTemplate}"
                EditableOptionTemplate="{StaticResource EditableOptionFieldTemplate}"
                OptionTemplate="{StaticResource OptionFieldTemplate}"
                TextTemplate="{StaticResource TextFieldTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,16"
            Orientation="Horizontal">
            <materialDesign:PackIcon
                Width="26"
                Height="26"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Kind="CogOutline" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource PageTitle}"
                Text="{Binding Title}" />
        </StackPanel>

        <!--
            基础信息：协议/角色排在最前——它是这次新建的第一个决定，
            参数表单和设备名称都跟着它变，放在名称下面会让人先填了名字再改协议。
        -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="协议类型" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    IsEnabled="{Binding CanChangeProtocol}"
                    ItemsSource="{Binding ProtocolOptions}"
                    SelectedIndex="{Binding SelectedProtocolIndex, Mode=TwoWay}"
                    Style="{StaticResource DmCombo}"
                    ToolTip="编辑模式下协议锁定，换协议请新建设备">
                    <!--  协议项带图标 + 按能力分组：TCP Socket 与 Modbus TCP 这类近名项不再容易点错  -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="{Binding Icon}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="角色" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Width="120"
                    DisplayMemberPath="DisplayName"
                    IsEnabled="{Binding RoleComboEnabled}"
                    ItemsSource="{Binding RoleOptions}"
                    SelectedIndex="{Binding SelectedRoleIndex, Mode=TwoWay}"
                    Style="{StaticResource DmCombo}"
                    ToolTip="编辑模式下角色锁定，换角色请新建设备" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="设备名称" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource DmInput}"
                    Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="默认按协议与角色自动生成（如 TCP客户端-Client），改过之后就以你写的为准" />

                <!--  无提示时整行收起，不再占一行空白  -->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Style="{StaticResource HintText}"
                    Text="{Binding SelectedProtocolInfo.UsageHint}"
                    TextWrapping="Wrap"
                    Visibility="{Binding SelectedProtocolInfo.UsageHint, Converter={StaticResource NonEmptyStringToVis}}" />
            </Grid>
        </materialDesign:Card>

        <!--  参数动态表单：按当前协议与角色筛选，只列 CommunicationNew adapter 真正读取的参数  -->
        <materialDesign:Card Grid.Row="2">
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,10">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="协议参数" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource HintText}"
                            Text="{Binding FormHint}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ItemsControl
                        ItemTemplateSelector="{StaticResource FieldTemplateSelector}"
                        ItemsPanel="{StaticResource TwoColumnPanel}"
                        ItemsSource="{Binding Fields}" />
                    <TextBlock
                        Margin="0,16,0,4"
                        Style="{StaticResource SectionTitle}"
                        Text="通用参数" />
                    <ItemsControl
                        ItemTemplateSelector="{StaticResource FieldTemplateSelector}"
                        ItemsPanel="{StaticResource TwoColumnPanel}"
                        ItemsSource="{Binding CommonFields}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource HintText}"
                        Text="表单只列所选协议与角色真正读取的参数；其余参数保持默认值，保存/加载配置 JSON 时仍会原样持久化。" />
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <StackPanel
            Grid.Row="3"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="88"
                Command="{Binding CancelCommand}"
                Content="取消"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button
                Width="88"
                Margin="10,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</UserControl>
