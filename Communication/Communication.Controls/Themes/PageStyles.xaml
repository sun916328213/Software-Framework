<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        页面样式（CommunicationView 使用，由页面在自己的 UserControl.Resources 里合并，宿主不替页面合并）。
        前景一律钉 MaterialDesign 原生键，深浅主题自动跟随；
        语义色（成功/警告/失败/收发）用 Extension ThemeService 的 Brush.* 别名（App.OnStartup 注入）。
        ScrollViewer_Style / ScrollBar_Style 由 WPFCustomControls 的 Resources.xaml 提供。
    -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>
    <Style x:Key="PageSubTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>
    <!--  卡片内分组标题（读取 / 写入 / 发送数据）：比 SectionTitle 小一档，分组之间靠统一间距分隔  -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>
    <!--  次要说明文字：主前景 + Opacity，不用 ForegroundLight（对比度不够 AA）。  -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="DmInput"
        BasedOn="{StaticResource MaterialDesignTextBox}"
        TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <Style
        x:Key="DmCombo"
        BasedOn="{StaticResource MaterialDesignComboBox}"
        TargetType="ComboBox">
        <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="PrimaryLight" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </Style.Resources>
    </Style>

    <!--  只读结果框：底色比卡片暗一档，细边框，等宽字体，跟随主题。  -->
    <Style x:Key="OutputBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary.Background}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="12,10"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            Style="{StaticResource ScrollViewer_Style}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  日志级别徽章：圆角小药丸，底色用对应语义色的 Soft 变体  -->
    <Style x:Key="LogLevelBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Rx">
                <Setter Property="Background" Value="{DynamicResource Brush.Info.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Tx">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        日志级别着色：必须用 DataTrigger + DynamicResource 才能跟着主题换色；
        换成 IValueConverter + FindResource 会把画刷实例钉死，切主题后不再更新。
    -->
    <Style x:Key="LogLevelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Rx">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Tx">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        危险动作按钮的前景（压在 MaterialDesign.Brush.ValidationError 底色上）：
        该底色随深浅翻转（浅 #B00020 要白字 / 深 #CF6679 要黑字），没有单一固定值两边都过，
        故留成可由 ThemeService 按深浅替换的可变画刷；未接入时始终用下面的浅色基准值。
    -->
    <SolidColorBrush x:Key="Brush.OnDanger" Color="#FFFFFF" />

</ResourceDictionary>
