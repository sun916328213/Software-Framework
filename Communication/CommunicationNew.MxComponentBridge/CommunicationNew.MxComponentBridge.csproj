<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CommunicationNew.MxComponentBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 桥接进程使用与主程序集相同的 64 位 MX Component Interop。 -->
    <Reference Include="Interop.ActSupportMsg64Lib">
      <HintPath>..\..\Dll\Mitsubishi\Interop.ActSupportMsg64Lib.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.ActUtlType64Lib">
      <HintPath>..\..\Dll\Mitsubishi\Interop.ActUtlType64Lib.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 与主程序集共享设备编号格式，防止直接模式和桥接模式的地址规则漂移。 -->
    <Compile Include="..\CommunicationNew\Protocols\Mitsubishi\Models\McDeviceAddressFormatter.cs"
             Link="Shared\McDeviceAddressFormatter.cs" />
    <Compile Include="..\CommunicationNew\Protocols\Mitsubishi\MxComponent\MxComponentBitCodec.cs"
             Link="Shared\MxComponentBitCodec.cs" />
    <Compile Include="..\CommunicationNew\Protocols\Mitsubishi\MxComponent\MxComponentWordCodec.cs"
             Link="Shared\MxComponentWordCodec.cs" />
  </ItemGroup>
</Project>
