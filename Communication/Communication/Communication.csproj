<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>CommunicationNew</RootNamespace>
    <!-- P11 兼容门面：程序集 / NuGet 身份显式冻结为 CommunicationNew，保持 API 与二进制兼容；实现已迁入 Core/Runtime。 -->
    <AssemblyName>CommunicationNew</AssemblyName>
    <PackageId>CommunicationNew</PackageId>
    <Description>面向工业设备的 .NET 通信库，提供 Modbus、三菱 MC/MX、OPC UA、Socket、Serial、HTTP 与 WebApi adapter。（P11 兼容门面：类型转发到 Communication.Core / Communication.Runtime）</Description>
    <PackageTags>industrial;communication;modbus;mitsubishi;opcua;tcp;udp;serial</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 将公共 API 注释随 NuGet 包发布，供调用方 IntelliSense 使用。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 旧兼容 API 仍在分批补注释；不让 CS1591 淹没真实编译和打包警告。 -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Pack 后执行 SDK 自带的包结构、目标框架与公开兼容性检查。 -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Communication.Core\Communication.Core.csproj" />
    <ProjectReference Include="..\Communication.Runtime\Communication.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet 页面使用根目录 README，帮助使用方识别协议能力和平台限制。 -->
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
