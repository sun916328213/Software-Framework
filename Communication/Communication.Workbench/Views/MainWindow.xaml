<Window
    x:Class="Communication.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Communication.Workbench.ViewModels"
    Title="通讯测试台 · CommunicationNew Workbench"
    Width="1280"
    Height="800"
    MinWidth="1080"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Background="{DynamicResource Brush.Bg.0}"
    FontFamily="{StaticResource FontFamily.Default}"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <v:LevelToBrushConverter xmlns:v="clr-namespace:Communication.Workbench.Views" x:Key="LevelBrush" />
        <v:ConnectedToBrushConverter xmlns:v="clr-namespace:Communication.Workbench.Views" x:Key="ConnectedBrush" />

        <!--  设备列表行模板  -->
        <DataTemplate x:Key="DeviceItemTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border
                x:Name="Root"
                Margin="0,2"
                Padding="10,8"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="{StaticResource Metric.Radius.M}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="34"
                        Height="34"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Bg.3}"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="{Binding ProtocolIcon}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.Fg.Primary}"
                            Text="{Binding Name}" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Protocol}" />
                            <TextBlock
                                Margin="5,0"
                                Style="{StaticResource Text.Label}"
                                Text="·" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding RoleText}" />
                        </StackPanel>
                    </StackPanel>
                    <Ellipse
                        Grid.Column="2"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{Binding IsConnected, Converter={StaticResource ConnectedBrush}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#1A3B82F6" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ===== 标题栏 =====  -->
        <Border
            Grid.Row="0"
            Background="{DynamicResource Brush.Bg.1}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="30"
                        Height="30"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Accent.Soft}"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#9889;" />
                    </Border>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Header}"
                        Text="通讯测试台" />
                    <TextBlock
                        Margin="14,3,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="CommunicationNew · Prism · .NET 9" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,10,0"
                        Command="{Binding ToggleThemeCommand}"
                        Content="{Binding ThemeIcon}"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Style="{StaticResource Button.Icon}"
                        ToolTip="切换浅色/深色主题" />
                    <Border
                        Padding="10,4"
                        CornerRadius="12"
                        Style="{StaticResource Panel}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Brush.Success}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Text.Label}"
                                Text="就绪" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== 主区域 =====  -->
        <Grid Grid.Row="1" Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：设备列表  -->
            <Border
                Grid.Column="0"
                Padding="10"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="6,4,6,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Section}"
                            Text="设备" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding AddDeviceCommand}"
                            Content="&#43; 新建"
                            Style="{StaticResource Button.Primary}" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        Padding="8"
                        Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding ConnectCommand}"
                                    Content="连接"
                                    Style="{StaticResource Button.Success}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding DisconnectCommand}"
                                    Content="断开"
                                    Style="{StaticResource Button.Secondary}" />
                                <Button
                                    Grid.Column="4"
                                    Command="{Binding RemoveDeviceCommand}"
                                    Content="移除"
                                    Style="{StaticResource Button.Danger}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding ConnectAllCommand}"
                                    Content="全部连接"
                                    Style="{StaticResource Button.Secondary}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding DisconnectAllCommand}"
                                    Content="全部断开"
                                    Style="{StaticResource Button.Secondary}" />
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding SaveConfigCommand}"
                                    Content="保存配置"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="设备参数 JSON（全部协议走 CommunicationNew）" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding LoadConfigCommand}"
                                    Content="加载配置"
                                    Style="{StaticResource Button.Secondary}" />
                                <Button
                                    Grid.Column="4"
                                    Command="{Binding CancelOperationCommand}"
                                    Content="取消"
                                    Style="{StaticResource Button.Danger}"
                                    ToolTip="取消当前耗时操作" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ListBox
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        ItemTemplate="{StaticResource DeviceItemTemplate}"
                        ItemsSource="{Binding Devices}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedDevice}"
                        Style="{StaticResource List.Base}" />
                </Grid>
            </Border>

            <!--  右侧：操作 + 日志  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  测试面板  -->
                <UniformGrid Grid.Row="0" Columns="3">
                    <!--  读测试  -->
                    <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                Style="{StaticResource Text.Section}"
                                Text="&#128207; 读取测试" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource Text.Label}"
                                Text="{Binding AddressHint, StringFormat='地址：{0}'}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBox
                                Margin="0,0,0,8"
                                Style="{StaticResource Input}"
                                Text="{Binding ReadAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Margin="0,0,0,8"
                                Style="{StaticResource Input}"
                                Text="{Binding ReadLength, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="读取长度（字节数/寄存器数/元素数）" />
                            <Button
                                Margin="0,0,0,8"
                                Command="{Binding ReadCommand}"
                                Content="读取"
                                Style="{StaticResource Button.Primary}" />
                            <Border
                                MinHeight="64"
                                MaxHeight="120"
                                Style="{StaticResource Panel}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        Foreground="{DynamicResource Brush.Fg.Primary}"
                                        Style="{StaticResource Text.Mono}"
                                        Text="{Binding ReadResult}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  写测试  -->
                    <Border Margin="0,0,12,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                Style="{StaticResource Text.Section}"
                                Text="&#9999; 写入测试" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource Text.Label}"
                                Text="{Binding AddressHint, StringFormat='地址：{0}'}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBox
                                Margin="0,0,0,8"
                                Style="{StaticResource Input}"
                                Text="{Binding WriteAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                MinHeight="52"
                                Margin="0,0,0,8"
                                Style="{StaticResource Input.Mono}"
                                Text="{Binding WriteData, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="十六进制字节序列，如 00 01 0A FF" />
                            <Button
                                Margin="0,0,0,8"
                                Command="{Binding WriteCommand}"
                                Content="写入"
                                Style="{StaticResource Button.Primary}" />
                            <TextBlock
                                Style="{StaticResource Text.Label}"
                                Text="数据以十六进制写入目标地址。Modbus 写寄存器按大端序组包。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  原始收发  -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource Text.Section}" Text="&#128232; 原始收发" />
                                <CheckBox
                                    HorizontalAlignment="Right"
                                    Content="HEX"
                                    FontSize="{StaticResource FontSize.S}"
                                    IsChecked="{Binding UseHex}"
                                    ToolTip="收发统一格式：勾选HEX，去掉文本" />
                            </Grid>
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource Text.Label}"
                                Text="仅 TCP / UDP / 串口（字节流/数据报）" />
                            <TextBox
                                MinHeight="52"
                                Margin="0,0,0,8"
                                Style="{StaticResource Input.Mono}"
                                Text="{Binding RawInput, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="十六进制或文本（取决于 HEX 开关）" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding SendRawCommand}"
                                    Content="发送"
                                    Style="{StaticResource Button.Primary}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SendAndReceiveCommand}"
                                    Content="发送并接收"
                                    Style="{StaticResource Button.Secondary}" />
                            </Grid>
                            <Border
                                MinHeight="64"
                                MaxHeight="120"
                                Style="{StaticResource Panel}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        Foreground="{DynamicResource Brush.Info}"
                                        Style="{StaticResource Text.Mono}"
                                        Text="{Binding RawResult}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!--  日志面板  -->
                <Border
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Text.Section}"
                                    Text="&#128221; 通讯日志" />
                                <Border
                                    Margin="12,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    CornerRadius="10"
                                    Style="{StaticResource Panel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Foreground="{DynamicResource Brush.Warning}"
                                            Style="{StaticResource Text.Label}"
                                            Text="TX" />
                                        <TextBlock
                                            Margin="6,0,12,0"
                                            Foreground="{DynamicResource Brush.Fg.Primary}"
                                            Style="{StaticResource Text.Mono}"
                                            Text="{Binding TxCountText}" />
                                        <TextBlock
                                            Foreground="{DynamicResource Brush.Info}"
                                            Style="{StaticResource Text.Label}"
                                            Text="RX" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Foreground="{DynamicResource Brush.Fg.Primary}"
                                            Style="{StaticResource Text.Mono}"
                                            Text="{Binding RxCountText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ComboBox
                                    Width="86"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding LogLevelOptions}"
                                    SelectedItem="{Binding LogLevelFilter, Mode=TwoWay}"
                                    Style="{StaticResource Combo}"
                                    ToolTip="日志级别过滤" />
                                <TextBox
                                    Width="140"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Input}"
                                    Text="{Binding LogKeyword, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="关键字过滤（来源/内容）" />
                                <CheckBox
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Content="自动滚动"
                                    IsChecked="{Binding AutoScrollLog}" />
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="10,4"
                                    Command="{Binding ExportLogCommand}"
                                    Content="导出"
                                    Style="{StaticResource Button.Secondary}" />
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="10,4"
                                    Command="{Binding ClearLogCommand}"
                                    Content="清空"
                                    Style="{StaticResource Button.Secondary}" />
                                <Button
                                    Padding="10,4"
                                    Command="{Binding ResetCountersCommand}"
                                    Content="归零计数"
                                    Style="{StaticResource Button.Secondary}" />
                            </StackPanel>
                        </Grid>

                        <ListBox
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            FontFamily="{StaticResource FontFamily.Mono}"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Style="{StaticResource List.Base}"
                            VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Top"
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.Fg.Muted}"
                                            Text="{Binding TimeText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"
                                            Text="{Binding LevelText}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            FontSize="11"
                                            Foreground="{DynamicResource Brush.Fg.Secondary}"
                                            Text="{Binding Source}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource Brush.Fg.Primary}"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ===== 状态栏 =====  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource Brush.Bg.1}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,1,0,0">
            <Grid Margin="18,6">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource Text.Label}"
                        Text="{Binding SelectedDevice.Name, FallbackValue='未选择设备', StringFormat='当前设备：{0}'}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Style="{StaticResource Text.Label}"
                        Text="{Binding DeviceSummary}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Style="{StaticResource Text.Label}"
                        Text="{Binding LastElapsed, StringFormat='耗时：{0}'}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        Style="{StaticResource Text.Label}"
                        Text="{Binding StatusHint}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="CommunicationNew · Prism 9 · .NET 9.0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
