<Window x:Class="MotionControl.Workbench.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MotionControl.Controls.Views;assembly=MotionControl.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MotionControl Workbench" Height="640" Width="920"
        mc:Ignorable="d">
  <DockPanel Margin="8">
    <GroupBox DockPanel.Dock="Top" Header="设备连接">
      <StackPanel Orientation="Horizontal" Margin="6" VerticalAlignment="Center">
        <TextBlock Text="厂商：" VerticalAlignment="Center" />
        <ComboBox x:Name="VendorBox" Width="130" Margin="0,0,12,0"
                  ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}" />
        <TextBlock Text="轴数：" VerticalAlignment="Center" />
        <TextBox Width="50" Margin="0,0,12,0" Text="{Binding AxisCount, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="IP：" VerticalAlignment="Center" />
        <TextBox Width="120" Margin="0,0,12,0" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="连接" Padding="16,2" Margin="0,0,6,0" Click="OnConnect" />
        <Button Content="断开" Padding="16,2" Margin="0,0,12,0" Click="OnDisconnect" />
        <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </GroupBox>

    <TabControl Margin="0,8,0,0">
      <TabItem Header="单轴测试">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="当前轴：" VerticalAlignment="Center" />
              <ComboBox x:Name="AxisBox" Width="80"
                        ItemsSource="{Binding AxisIndices}"
                        SelectedItem="{Binding SelectedAxisIndex}"
                        SelectionChanged="OnAxisSelectionChanged" />
            </StackPanel>
            <WrapPanel>
              <controls:AxisStatusControl x:Name="StatusControl" Margin="0,0,8,8" />
              <controls:AxisJogControl x:Name="JogControl" Margin="0,0,8,8" />
              <controls:AxisOperationControl x:Name="OperationControl" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="多轴总览">
        <controls:MotionOverviewControl x:Name="OverviewControl" Margin="6" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
