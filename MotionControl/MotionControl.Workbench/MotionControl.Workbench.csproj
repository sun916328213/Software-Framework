<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>MotionControl.Workbench</RootNamespace>
    <AssemblyName>MotionControl.Workbench</AssemblyName>
    <!-- P0 骨架：Workbench 是组合根与人工验证宿主，阶段 6 再接 Simulation / 真实 Vendor。 -->
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotionControl.Core\MotionControl.Core.csproj" />
    <ProjectReference Include="..\MotionControl.Runtime\MotionControl.Runtime.csproj" />
    <ProjectReference Include="..\MotionControl.Controls\MotionControl.Controls.csproj" />
  </ItemGroup>

</Project>
