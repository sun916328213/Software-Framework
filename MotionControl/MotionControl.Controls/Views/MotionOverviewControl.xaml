<UserControl
    x:Class="MotionControl.Controls.Views.MotionOverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="220"
    d:DesignWidth="520"
    mc:Ignorable="d">
    <GroupBox Header="多轴总览">
        <ListView Margin="6" ItemsSource="{Binding Axes}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="轴" DisplayMemberBinding="{Binding Axis}" />
                    <GridViewColumn Header="指令位置" DisplayMemberBinding="{Binding CommandPosition, StringFormat=F3}" />
                    <GridViewColumn Header="编码器" DisplayMemberBinding="{Binding EncoderPosition, StringFormat=F3}" />
                    <GridViewColumn Header="Servo" DisplayMemberBinding="{Binding Enabled}" />
                    <GridViewColumn Header="运动" DisplayMemberBinding="{Binding Moving}" />
                    <GridViewColumn Header="到位" DisplayMemberBinding="{Binding InPosition}" />
                    <GridViewColumn Header="报警" DisplayMemberBinding="{Binding Alarm}" />
                    <GridViewColumn Header="回零" DisplayMemberBinding="{Binding Homed}" />
                </GridView>
            </ListView.View>
        </ListView>
    </GroupBox>
</UserControl>
