<UserControl
    x:Class="MotionControl.Controls.Views.AxisStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:MotionControl.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="220"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToBrushConverter x:Key="StateBrush" />
        <converters:BoolToBrushConverter x:Key="AlarmBrush" TrueBrush="Red" />
    </UserControl.Resources>
    <GroupBox Header="{Binding AxisTitle, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="指令：" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViewModel.CommandPosition, StringFormat=F3}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="编码器：" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ViewModel.EncoderPosition, StringFormat=F3}" />

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.Enabled, Converter={StaticResource StateBrush}}" />
                <TextBlock Text="Servo" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.Moving, Converter={StaticResource StateBrush}}" />
                <TextBlock Text="运动" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.InPosition, Converter={StaticResource StateBrush}}" />
                <TextBlock Text="到位" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.Homed, Converter={StaticResource StateBrush}}" />
                <TextBlock Text="回零" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.Alarm, Converter={StaticResource AlarmBrush}}" />
                <TextBlock Text="报警" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.PositiveLimit, Converter={StaticResource AlarmBrush}}" />
                <TextBlock Text="正限位" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.NegativeLimit, Converter={StaticResource AlarmBrush}}" />
                <TextBlock Text="负限位" Margin="4,0,12,0" VerticalAlignment="Center" />
                <Ellipse Width="12" Height="12" Fill="{Binding ViewModel.EmergencyStop, Converter={StaticResource AlarmBrush}}" />
                <TextBlock Text="急停" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0"
                       Text="{Binding ViewModel.StatusSummary}" TextWrapping="Wrap" />
        </Grid>
    </GroupBox>
</UserControl>
