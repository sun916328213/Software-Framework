<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>MotionControl.Controls</RootNamespace>
    <AssemblyName>MotionControl.Controls</AssemblyName>
    <!-- P0 骨架：Controls 只做 UI 与展示层，阶段 5 再实现 AxisStatus / Jog / Operation 等复用控件。 -->
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotionControl.Core\MotionControl.Core.csproj" />
    <ProjectReference Include="..\MotionControl.Runtime\MotionControl.Runtime.csproj" />
  </ItemGroup>

</Project>
