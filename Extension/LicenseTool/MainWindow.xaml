<Window x:Class="LicenseTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License 授权工具" Height="680" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">
            <!-- ══════════ 密钥管理 ══════════ -->
            <TabItem Header="① 密钥管理">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="Gray"
                        Text="流程：厂商在此生成密钥对 → 私钥自己存好（绝不进客户端）→ 公钥硬编码/配置文件 embedded 到客户端程序。"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="BtnGenKeys" Content="生成 2048 密钥对" Margin="0,0,8,0" Padding="12,4" Click="BtnGenKeys_Click"/>
                        <Button x:Name="BtnLoadPri" Content="加载私钥" Margin="0,0,8,0" Padding="12,4" Click="BtnLoadPri_Click"/>
                        <Button x:Name="BtnLoadPub" Content="加载公钥" Margin="0,0,8,0" Padding="12,4" Click="BtnLoadPub_Click"/>
                        <Button x:Name="BtnSavePri" Content="保存私钥" Margin="0,0,8,0" Padding="12,4" Click="BtnSavePri_Click"/>
                        <Button x:Name="BtnSavePub" Content="保存公钥" Margin="0,0,8,0" Padding="12,4" Click="BtnSavePub_Click"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,4" Text="私钥（厂商保管）："/>
                        <TextBox Grid.Row="1" x:Name="TxtPrivateKey" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" FontWeight="Bold" Margin="0,0,0,4" Text="公钥（嵌入客户端）："/>
                        <TextBox Grid.Row="3" x:Name="TxtPublicKey" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ══════════ 签发 License ══════════ -->
            <TabItem Header="② 签发 License">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="80"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="客户名称："/>
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtCustomer" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="绑定机器码："/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMachineCode" Margin="0,4" FontFamily="Consolas"
                                 ToolTip="为空 = 不绑定，任意机器可用"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnFillLocalMachine" Content="填入本机" Margin="8,4,0,4" Padding="10,2" Click="BtnFillLocalMachine_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="本机机器码："/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LblLocalMachine"
                                   VerticalAlignment="Center" Margin="0,4" FontFamily="Consolas" Foreground="DarkGreen"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="过期日期："/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <DatePicker x:Name="DpExpire" Width="160"/>
                            <CheckBox x:Name="ChkPermanent" Content="永久有效" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="试用天数：" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBox x:Name="TxtTrialDays" Text="30" Width="50"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" Text="使用私钥："/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <Button x:Name="BtnUseKeyTabPri" Content="取自【密钥管理】页私钥框" Padding="10,2" Click="BtnUseKeyTabPri_Click"/>
                            <TextBlock x:Name="LblPriStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" Text="未载入"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" Text="功能点（每行一个，空=全部）："/>
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtFeatures" Margin="0,4"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="Vision&#x0a;Motion"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" Text="扩展字段（每行 key=value）："/>
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtExtra" Margin="0,4"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <WrapPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Button x:Name="BtnCreate" Content="生成 License" Padding="14,4" Margin="0,0,8,0" Click="BtnCreate_Click"/>
                            <Button x:Name="BtnCreateTrial" Content="生成试用版" Padding="14,4" Margin="0,0,8,0" Click="BtnCreateTrial_Click"/>
                            <Button x:Name="BtnSaveLic" Content="保存为 .lic 文件" Padding="14,4" Click="BtnSaveLic_Click"/>
                        </WrapPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,8,0,4" Text="License 文本："/>
                    <TextBox x:Name="TxtLicenseOut" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" IsReadOnly="True"/>
                </DockPanel>
            </TabItem>

            <!-- ══════════ 验证 License ══════════ -->
            <TabItem Header="③ 验证 License">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="110"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="License 文本："/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtLicIn" Margin="0,4"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnLoadLic" Content="从 .lic 文件加载" Margin="8,4,0,4" Padding="10,2" Click="BtnLoadLic_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="客户端公钥："/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtVerifyPub" Margin="0,4" FontFamily="Consolas" FontSize="11"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnUseKeyTabPub" Content="取自【密钥管理】页" Margin="8,4,0,4" Padding="10,2" Click="BtnUseKeyTabPub_Click"/>

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="ChkCheckMachine" Content="校验机器码绑定" IsChecked="True" VerticalAlignment="Center"/>
                            <TextBlock Text="所需功能点：" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBox x:Name="TxtRequiredFeature" Width="140"/>
                        </StackPanel>

                        <Button Grid.Row="3" Grid.Column="1" x:Name="BtnVerify" Content="验 证" Padding="30,4"
                                HorizontalAlignment="Left" Margin="0,4" Click="BtnVerify_Click"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" x:Name="TxtVerifyResult" FontWeight="Bold" FontSize="15" Margin="0,8,0,4" Text="等待验证…"/>
                    <TextBox x:Name="TxtVerifyDetail" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
