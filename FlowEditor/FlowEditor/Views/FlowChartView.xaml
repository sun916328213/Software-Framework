<UserControl
    x:Class="FlowEditor.Views.FlowChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="RootFlowChart"
    AllowDrop="True"
    Background="Transparent"
    DragOver="OnCanvasDragOver"
    Drop="OnCanvasDrop"
    Focusable="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFCustomControls;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style BasedOn="{StaticResource ScrollViewer_Style}" TargetType="ScrollViewer" />

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <ContextMenu x:Key="CanvasContextMenu" x:Shared="False">
                <MenuItem Header="自适应画布视图" Command="{Binding ZoomToFitCommand}" />
                <Separator />
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
            </ContextMenu>

            <ContextMenu x:Key="NodeContextMenu" x:Shared="False">
                <MenuItem
                    Header="从此节点继续执行"
                    Command="{Binding FlowChart.ContinueFromNodeCommand}"
                    CommandParameter="{Binding Node}" />
                <Separator />
                <MenuItem
                    Header="新增输入端口"
                    Command="{Binding FlowChart.AddInputPortCommand}"
                    CommandParameter="{Binding Node}"
                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <MenuItem
                    Header="新增输出端口"
                    Command="{Binding FlowChart.AddOutputPortCommand}"
                    CommandParameter="{Binding Node}"
                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <Separator Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <MenuItem
                    Header="复制节点"
                    Command="{Binding FlowChart.CopyNodeCommand}"
                    CommandParameter="{Binding Node}"
                    InputGestureText="Ctrl+C"
                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <MenuItem
                    Header="删除节点"
                    Command="{Binding FlowChart.DeleteNodeCommand}"
                    CommandParameter="{Binding Node}"
                    InputGestureText="Delete"
                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}" />
                <Separator />
                <MenuItem
                    Header="{Binding MoveHeader}"
                    Command="{Binding MoveCommand}"
                    CommandParameter="{Binding Node}"
                    Visibility="{Binding CanMoveToInactiveContainer, Converter={StaticResource BoolToVis}}" />
                <Separator Visibility="{Binding CanMoveToInactiveContainer, Converter={StaticResource BoolToVis}}" />
                <MenuItem Header="权限">
                    <MenuItem Header="正常" Command="{Binding FlowChart.SetNormalPermissionCommand}" CommandParameter="{Binding Node}" />
                    <MenuItem Header="只读" Command="{Binding FlowChart.SetReadOnlyPermissionCommand}" CommandParameter="{Binding Node}" />
                    <MenuItem Header="禁用" Command="{Binding FlowChart.SetDisabledPermissionCommand}" CommandParameter="{Binding Node}" />
                </MenuItem>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="ScrollViewerHost"
        Background="{x:Null}"
        HorizontalScrollBarVisibility="Hidden"
        PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
        VerticalScrollBarVisibility="Hidden">
        <ScrollViewer.Resources>
            <Style BasedOn="{StaticResource {x:Type ScrollViewer}}" TargetType="ScrollViewer">
                <Setter Property="Background" Value="{x:Null}" />
            </Style>
        </ScrollViewer.Resources>

        <!--  缩放容器  -->
        <Grid
            x:Name="ZoomContainer"
            Width="{Binding Model.CanvasWidth}"
            Height="{Binding Model.CanvasHeight}"
            MouseRightButtonDown="OnCanvasRightClick"
            PreviewMouseDown="OnPanMouseDown"
            PreviewMouseUp="OnPanMouseUp"
            PreviewMouseMove="OnPanMouseMove">
            <Grid.Background>
                <DrawingBrush
                    Stretch="None"
                    TileMode="Tile"
                    Viewport="0,0,20,20"
                    ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry
                                    Center="1,1"
                                    RadiusX="1.2"
                                    RadiusY="1.2" />
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#C8D8E8" Thickness="1.2" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Model.ZoomLevel}" ScaleY="{Binding Model.ZoomLevel}" />
            </Grid.LayoutTransform>

            <!--  连线层  -->
            <Canvas x:Name="ConnectionCanvas" IsHitTestVisible="True" />

            <!--  节点层  -->
            <Canvas
                x:Name="FlowChartCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OnCanvasMouseDown"
                MouseLeftButtonUp="OnCanvasMouseUp"
                MouseMove="OnCanvasMouseMove" />

            <!--  临时连线层  -->
            <Canvas x:Name="PendingCanvas" IsHitTestVisible="False" />

            <!--  ROI 框选层  -->
            <Canvas IsHitTestVisible="False">
                <Rectangle
                    x:Name="SelectionRectangle"
                    Fill="#284A90E2"
                    Stroke="#4A90E2"
                    StrokeDashArray="4,2"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </ScrollViewer>
</UserControl>
