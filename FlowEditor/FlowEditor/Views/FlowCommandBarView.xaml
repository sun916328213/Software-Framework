<UserControl
    x:Class="FlowEditor.Views.FlowCommandBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="clr-namespace:FlowEditor.Presentation.Commands"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Fill" Value="{StaticResource Flow_Border_Port}" />
        </Style>

        <Style
            x:Key="ToolBarButtonStyle"
            BasedOn="{StaticResource MaterialDesignFlatButton}"
            TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Flow_Text_Hint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesign.Brush.Primary}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="4,2">
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button
                    Command="{Binding RunCurrentCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="当前流程执行">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="NavigationVariant" />
                </Button>
                <Button
                    Command="{Binding RunAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="全部运行 (F5)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="PlayArrow" />
                </Button>
                <Button
                    Command="{Binding StopAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="全部停止 (Shift+F5)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Stop" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding LoopRunAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="循环执行">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Loop" />
                </Button>
                <Button
                    Command="{Binding LoopStopAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="停止循环">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="StopCircleOutline" />
                </Button>
                <TextBlock
                    Margin="6,0,2,0"
                    Style="{StaticResource InfoTextStyle}"
                    Text="间隔(ms):" />
                <TextBox
                    Width="70"
                    Height="24"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding ActiveTab.Model.LoopInterval, UpdateSourceTrigger=PropertyChanged}" />
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding NewFlowCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="新建流程 (Ctrl+N)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Plus" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.SaveCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="保存当前页面流程 (Ctrl+S)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSave" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.SaveAsCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="另存为当前页面流程">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSaveAll" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.LoadCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="打开文件 (Ctrl+O)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="FolderOpen" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding SaveAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="保存所有流程">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSaveAll" />
                </Button>
                <Button
                    Command="{Binding SaveAllAsCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="多流程另存为">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSaveMoveOutline" />
                </Button>
                <Button
                    Command="{Binding LoadAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="打开多流程文件">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="FolderMultipleOutline" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding ActiveTab.ClearAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="清空当前流程">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Delete" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.UndoCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="撤销 (Ctrl+Z)">
                    <materialDesign:PackIcon Kind="Undo" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.RedoCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="重做 (Ctrl+Y)">
                    <materialDesign:PackIcon Kind="Redo" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding ActiveTab.ZoomOutCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="缩小">
                    <materialDesign:PackIcon Kind="MagnifyMinus" />
                </Button>
                <TextBlock
                    Width="44"
                    Style="{StaticResource InfoTextStyle}"
                    Text="{Binding ActiveTab.Model.ZoomPercentage}"
                    TextAlignment="Center" />
                <Button
                    Command="{Binding ActiveTab.ZoomInCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="放大">
                    <materialDesign:PackIcon Kind="MagnifyPlus" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.ZoomToFitCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="自适应画布">
                    <materialDesign:PackIcon Kind="FitToPage" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding ActiveTab.StepContinueCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="执行当前选中节点（调试暂停时继续）">
                    <materialDesign:PackIcon Kind="StepForward" />
                </Button>
                <Button
                    Command="{x:Static commands:FlowChartRoutedCommands.ExportPng}"
                    CommandParameter="{Binding ActiveTab}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="导出PNG">
                    <materialDesign:PackIcon Kind="ImageOutline" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Viewbox
                    Width="40"
                    Height="22"
                    Stretch="Uniform">
                    <ToggleButton
                        x:Name="DataConnectionsToggle"
                        IsChecked="{Binding ActiveTab.Model.ShowDataConnections}"
                        ToolTip="显示/隐藏数据连线">
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="ChartTimelineVariant" />
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </Viewbox>
                <Button
                    x:Name="ShortcutHelpButton"
                    Command="{Binding ShowShortcutHelpCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    ToolTip="显示快捷键帮助">
                    <materialDesign:PackIcon Kind="HelpCircleOutline" />
                </Button>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <ProgressBar
                    Width="60"
                    Height="4"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsIndeterminate="{Binding ActiveTab.Model.IsRunning}"
                    Visibility="{Binding ActiveTab.Model.IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Margin="0,0,4,0"
                    Style="{StaticResource InfoTextStyle}"
                    Text="{Binding ActiveTab.Model.LoopProgressText}"
                    Visibility="{Binding ActiveTab.Model.IsLoopRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Margin="0,0,8,0"
                    Style="{StaticResource InfoTextStyle}"
                    Text="{Binding ActiveTab.Model.StatusText}" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
