<UserControl
    x:Class="FlowEditor.Views.FlowChartContainerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FlowEditor.Converters"
    xmlns:ctl="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlowEditor.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:WPFCustomControls.PropertyGrid.Views;assembly=WPFCustomControls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:FlowEditor.ViewModels"
    x:Name="RootContainer"
    d:DataContext="{d:DesignInstance Type=vm:FlowChartContainerViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Focusable="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowEditor;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:NullableToVisibilityConverter x:Key="NullableToVisConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />


            <Style BasedOn="{StaticResource ScrollViewer_Style}" TargetType="ScrollViewer" />

            <!--  通用分隔条  -->
            <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="4,4" />
                <Setter Property="Fill" Value="{StaticResource Flow_Border_Port}" />
            </Style>
            <!--  工具栏按钮  -->
            <Style
                x:Key="ToolBarButtonStyle"
                BasedOn="{StaticResource MaterialDesignFlatButton}"
                TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="1,0" />
            </Style>
            <!--  面板标题块  -->
            <Style x:Key="PanelHeaderStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderBrush" Value="{StaticResource Flow_Border_Default}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <!--  面板标题文本  -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Flow_Text_Primary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  副标题文本  -->
            <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Flow_Text_Tertiary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  小号信息文本  -->
            <Style x:Key="InfoTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Flow_Text_Hint}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--  工具项图标容器  -->
            <Style x:Key="ToolIconBorderStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <!--  分类计数徽标  -->
            <Style x:Key="CountBadgeStyle" TargetType="Border">
                <Setter Property="Height" Value="16" />
                <Setter Property="MinWidth" Value="18" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="{StaticResource Flow_Bg_Badge}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <!--  搜索框包裹边栏  -->
            <Style x:Key="SearchPanelStyle" TargetType="Border">
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderBrush" Value="{StaticResource Flow_Border_Search}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource MaterialDesign.Brush.Primary}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  ══════════ 快捷键 ══════════  -->
    <UserControl.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding NewFlowCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveAllCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="O"
            Command="{Binding ActiveTab.LoadCommand}"
            Modifiers="Control" />
        <KeyBinding Key="F5" Command="{Binding RunAllCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ═══════════════ 顶部工具栏 ═══════════════  -->
        <Border Grid.Row="0" Padding="4,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button
                        Command="{Binding RunCurrentCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="当前流程执行">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="NavigationVariant" />
                    </Button>
                    <Button
                        Command="{Binding RunAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="全部运行 (F5)">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="PlayArrow" />
                    </Button>
                    <Button
                        Command="{Binding StopAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="全部停止 (Shift+F5)">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="Stop" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button
                        Command="{Binding LoopRunAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="循环执行">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="Loop" />
                    </Button>
                    <Button
                        Command="{Binding LoopStopAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="停止循环">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="StopCircleOutline" />
                    </Button>
                    <TextBlock
                        Margin="6,0,2,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource InfoTextStyle}"
                        Text="间隔(ms):" />
                    <TextBox
                        Width="70"
                        Height="24"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Text="{Binding ActiveTab.Model.LoopInterval, UpdateSourceTrigger=PropertyChanged}" />
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button
                        Command="{Binding NewFlowCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="新建流程 (Ctrl+N)">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="Plus" />
                    </Button>
                    <Button
                        Command="{Binding ActiveTab.SaveCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="保存当前页面流程 (Ctrl+S)">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="ContentSave" />
                    </Button>
                    <Button
                        Command="{Binding ActiveTab.SaveAsCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="另存为当前页面流程">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="ContentSaveAll" />
                    </Button>
                    <Button
                        Command="{Binding ActiveTab.LoadCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="打开文件 (Ctrl+O)">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="FolderOpen" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button
                        Command="{Binding SaveAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="保存所有流程">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="ContentSaveAll" />
                    </Button>
                    <Button
                        Command="{Binding SaveAllAsCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="多流程另存为">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="ContentSaveMoveOutline" />
                    </Button>
                    <Button
                        Command="{Binding LoadAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="打开多流程文件">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="FolderMultipleOutline" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button
                        Command="{Binding ActiveTab.ClearAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="清空当前流程">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="Delete" />
                    </Button>
                    <Button
                        Command="{Binding ActiveTab.UndoCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="撤销 (Ctrl+Z)">
                        <materialDesign:PackIcon Kind="Undo" />
                    </Button>
                    <Button
                        Command="{Binding ActiveTab.RedoCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="重做 (Ctrl+Y)">
                        <materialDesign:PackIcon Kind="Redo" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button
                        Command="{Binding ActiveTab.ZoomOutCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="缩小">
                        <materialDesign:PackIcon Kind="MagnifyMinus" />
                    </Button>
                    <TextBlock
                        Width="44"
                        Style="{StaticResource InfoTextStyle}"
                        Text="{Binding ActiveTab.Model.ZoomPercentage}"
                        TextAlignment="Center" />
                    <Button
                        Command="{Binding ActiveTab.ZoomInCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="放大">
                        <materialDesign:PackIcon Kind="MagnifyPlus" />
                    </Button>
                    <Button
                        Command="{Binding ActiveTab.ZoomToFitCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="自适应画布">
                        <materialDesign:PackIcon Kind="FitToPage" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button
                        Command="{Binding ActiveTab.StepContinueCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="执行当前选中节点（调试暂停时继续）">
                        <materialDesign:PackIcon Kind="StepForward" />
                    </Button>
                    <Button
                        Click="OnExportPngClick"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="导出PNG">
                        <materialDesign:PackIcon Kind="ImageOutline" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <StackPanel Orientation="Horizontal">

                        <ToggleButton
                            x:Name="DataConnectionsToggle"
                            Margin="5,2"
                            Padding="2"
                            IsChecked="{Binding ActiveTab.Model.ShowDataConnections}"
                            ToolTip="显示/隐藏数据连线">
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="ChartTimelineVariant" />
                            </materialDesign:ToggleButtonAssist.OnContent>

                        </ToggleButton>

                    </StackPanel>

                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <ProgressBar
                        Width="60"
                        Height="4"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="{Binding ActiveTab.Model.IsRunning}"
                        Visibility="{Binding ActiveTab.Model.IsRunning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Margin="0,0,4,0"
                        Style="{StaticResource InfoTextStyle}"
                        Text="{Binding ActiveTab.Model.LoopProgressText}"
                        Visibility="{Binding ActiveTab.Model.IsLoopRunning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Margin="0,0,8,0"
                        Style="{StaticResource InfoTextStyle}"
                        Text="{Binding ActiveTab.Model.StatusText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  ═══════════════ 主体：三栏布局（工具箱 | TabControl | 属性面板） ═══════════════  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!--  左侧工具箱  -->
            <Border
                Grid.Column="0"
                BorderBrush="{StaticResource Flow_Border_Default}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Toolbox" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource SectionHeaderTextStyle}"
                                Text="工具箱" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SearchPanelStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="32"
                                materialDesign:HintAssist.Hint="搜索工具名称..."
                                materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                FontSize="12"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding ToolboxSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <materialDesign:PackIcon
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Foreground="{StaticResource Flow_Text_Muted}"
                                Kind="Magnify" />
                        </Grid>
                    </Border>
                    <ScrollViewer
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ToolboxCategories}">
                            <ItemsControl.Resources>
                                <!--  工具项公共模板  -->
                                <DataTemplate x:Key="PaletteItemTemplate">
                                    <Border
                                        Margin="12,4"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnPaletteItemMouseDown"
                                        MouseMove="OnPaletteItemMouseMove"
                                        ToolTip="{Binding Description}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Margin="8,0,0,0" Kind="{Binding IconKind}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource Flow_Text_Primary}"
                                                Text="{Binding DisplayName}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,2">
                                        <StackPanel>
                                            <Border
                                                Padding="8,6,8,4"
                                                Background="{StaticResource Flow_Bg_Category}"
                                                BorderBrush="{StaticResource Flow_Border_Light}"
                                                BorderThickness="0,1,0,1"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="OnCategoryHeaderClick"
                                                Tag="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="22"
                                                        Height="22"
                                                        Foreground="{StaticResource Flow_Text_Hint}"
                                                        Kind="ChevronDown">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                        <Setter Property="Kind" Value="ChevronRight" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="4,0"
                                                        Style="{StaticResource SubHeaderTextStyle}"
                                                        Text="{Binding Name}" />
                                                    <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource Flow_Text_Hint}"
                                                            Text="{Binding TotalCount}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <!--  直属一级分组的工具项  -->
                                                <ItemsControl ItemTemplate="{StaticResource PaletteItemTemplate}" ItemsSource="{Binding Items}" />
                                                <!--  二级子分组  -->
                                                <ItemsControl ItemsSource="{Binding SubGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <Border
                                                                    Padding="18,4,8,4"
                                                                    Background="Transparent"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="OnCategoryHeaderClick"
                                                                    Tag="{Binding}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <materialDesign:PackIcon
                                                                            Grid.Column="0"
                                                                            Width="22"
                                                                            Height="22"
                                                                            Foreground="{StaticResource Flow_Text_Hint}"
                                                                            Kind="ChevronDown">
                                                                            <materialDesign:PackIcon.Style>
                                                                                <Style TargetType="materialDesign:PackIcon">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                            <Setter Property="Kind" Value="ChevronRight" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </materialDesign:PackIcon.Style>
                                                                        </materialDesign:PackIcon>
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Margin="4,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource Flow_Text_Primary}"
                                                                            Text="{Binding Name}" />
                                                                        <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
                                                                            <TextBlock
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="10"
                                                                                Foreground="{StaticResource Flow_Text_Hint}"
                                                                                Text="{Binding Items.Count}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <ItemsControl
                                                                    Margin="12,0,0,0"
                                                                    ItemTemplate="{StaticResource PaletteItemTemplate}"
                                                                    ItemsSource="{Binding Items}"
                                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  工具箱分栏条  -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                ResizeBehavior="PreviousAndNext" />

            <!--  中央标签页区域  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" MinHeight="80" />
                </Grid.RowDefinitions>
                <ctl:EditTabControl
                    x:Name="FlowTabControl"
                    Grid.Row="0"
                    CloseTabCommand="{Binding CloseTabCommand}"
                    HeaderMemberPath="Model.TabTitle"
                    HeaderRenamed="OnHeaderRenamed"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    ShowCloseButton="True"
                    TabStripPlacement="Top">
                    <ctl:EditTabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:FlowChartViewModel}">
                            <local:FlowChartView DataContext="{Binding}" />
                        </DataTemplate>
                    </ctl:EditTabControl.ContentTemplate>
                </ctl:EditTabControl>

                <!--  画布与输出栏之间的分栏条  -->
                <GridSplitter
                    Grid.Row="1"
                    Height="4"
                    Margin="0,2"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="SizeNS"
                    ResizeBehavior="PreviousAndNext" />

                <!--  底部输出日志面板（仅画布下方）  -->
                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource Flow_Border_Divider}"
                    BorderThickness="0,1,0,0">
                    <TextBox
                        x:Name="OutputTextBox"
                        Padding="10,2"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{StaticResource Flow_Text_Primary}"
                        IsReadOnly="True"
                        Text="{Binding ActiveTab.Model.OutputText, Mode=OneWay}"
                        TextChanged="OnOutputTextChanged"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

            <!--  画布与属性栏之间的分栏条  -->
            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                ResizeBehavior="PreviousAndNext" />

            <!--  右侧属性面板  -->
            <Border
                Grid.Column="4"
                BorderBrush="{StaticResource Flow_Border_Default}"
                BorderThickness="1,0,0,0">

                <pg:PropertyGridHost x:Name="PropertyGrid" DataContext="{Binding PropertyGridVM}" />

            </Border>
        </Grid>
    </Grid>
</UserControl>
