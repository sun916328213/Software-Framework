<UserControl
    x:Class="FlowEditor.Views.FlowChartContainerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FlowEditor.Behaviors"
    xmlns:commands="clr-namespace:FlowEditor.Presentation.Commands"
    xmlns:ctl="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlowEditor.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:WPFCustomControls.PropertyGrid.Views;assembly=WPFCustomControls"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:FlowEditor.ViewModels"
    x:Name="RootContainer"
    d:DataContext="{d:DesignInstance Type=vm:FlowChartContainerViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="1600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Focusable="True"
    mc:Ignorable="d">

    <UserControl.CommandBindings>
        <CommandBinding
            CanExecute="OnExportPngCanExecute"
            Command="{x:Static commands:FlowChartRoutedCommands.ExportPng}"
            Executed="OnExportPngExecuted" />
    </UserControl.CommandBindings>

    <!--  ══════════ 快捷键 ══════════  -->
    <UserControl.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding NewFlowCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="S"
            Command="{Binding ActiveTab.SaveCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="O"
            Command="{Binding ActiveTab.LoadCommand}"
            Modifiers="Control" />
        <KeyBinding Key="F5" Command="{Binding RunAllCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部命令栏独立承载容器级命令和运行状态。  -->
        <local:FlowCommandBarView Grid.Row="0" />

        <!--  ═══════════════ 主体：三栏布局（工具箱 | TabControl | 属性面板） ═══════════════  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!--  左侧工具箱独立封装搜索、分类展开、双击添加和拖放发起。  -->
            <local:FlowToolboxView Grid.Column="0" />
            <!--  工具箱分栏条  -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                ResizeBehavior="PreviousAndNext" />

            <!--  中央标签页区域  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" MinHeight="80" />
                </Grid.RowDefinitions>
                <ctl:EditTabControl
                    x:Name="FlowTabControl"
                    Grid.Row="0"
                    CloseTabCommand="{Binding CloseTabCommand}"
                    HeaderMemberPath="Model.TabTitle"
                    HeaderRenamed="OnHeaderRenamed"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    ShowCloseButton="True"
                    TabStripPlacement="Top">
                    <ctl:EditTabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:FlowChartViewModel}">
                            <local:FlowChartView DataContext="{Binding}" />
                        </DataTemplate>
                    </ctl:EditTabControl.ContentTemplate>
                </ctl:EditTabControl>

                <!--  画布与输出栏之间的分栏条  -->
                <GridSplitter
                    Grid.Row="1"
                    Height="4"
                    Margin="0,2"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="SizeNS"
                    ResizeBehavior="PreviousAndNext" />

                <!--  底部输出日志面板（仅画布下方）  -->
                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource Flow_Border_Divider}"
                    BorderThickness="0,1,0,0">
                    <TextBox
                        x:Name="OutputTextBox"
                        behaviors:TextBoxAutoScrollBehavior.IsEnabled="True"
                        Padding="10,2"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{StaticResource Flow_Text_Primary}"
                        IsReadOnly="True"
                        Text="{Binding ActiveTab.Model.OutputText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

            <!--  画布与属性栏之间的分栏条  -->
            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                ResizeBehavior="PreviousAndNext" />

            <!--  右侧属性面板  -->
            <Border
                Grid.Column="4"
                BorderBrush="{StaticResource Flow_Border_Default}"
                BorderThickness="1,0,0,0">

                <pg:PropertyGridHost x:Name="PropertyGrid" DataContext="{Binding PropertyGridVM}" />

            </Border>
        </Grid>
    </Grid>
</UserControl>
