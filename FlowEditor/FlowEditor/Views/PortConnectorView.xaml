<UserControl
    x:Class="FlowEditor.Views.PortConnectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FlowEditor.Converters"
    xmlns:models="clr-namespace:FlowEditor.Models;assembly=FlowEditor.Runtime"
    Width="24"
    Height="24"
    Cursor="Cross"
    Focusable="False">
    <UserControl.Resources>
        <converters:PortColorConverter x:Key="PortColorConverter" />
    </UserControl.Resources>

    <!-- 24px 透明命中区，内部圆点在悬停、捕获和候选状态下平滑放大。 -->
    <Grid Background="Transparent" ToolTip="{Binding Port.ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid
            x:Name="Indicator"
            Width="10"
            Height="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- 输入为圆形，输出为菱形；填充色始终表示数据类型。 -->
            <Ellipse
                Fill="{Binding Port.DataType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PortColorConverter}}"
                Stroke="{StaticResource Flow_Border_Port}"
                StrokeThickness="1.25">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Port.Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:PortDirection.Output}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Rectangle
                Fill="{Binding Port.DataType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource PortColorConverter}}"
                RadiusX="1"
                RadiusY="1"
                Stroke="{StaticResource Flow_Border_Port}"
                StrokeThickness="1.25">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" CenterX="5" CenterY="5" />
                </Rectangle.RenderTransform>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Port.Direction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static models:PortDirection.Output}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
