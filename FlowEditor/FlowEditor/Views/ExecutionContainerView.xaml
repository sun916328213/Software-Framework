<UserControl
    x:Class="FlowEditor.Views.ExecutionContainerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FlowEditor.Converters"
    xmlns:models="clr-namespace:FlowEditor.Models;assembly=FlowEditor.Runtime"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:views="clr-namespace:FlowEditor.Views"
    Width="{Binding Model.ContainerWidth}"
    Height="{Binding Model.ContainerHeight}"
    Background="{x:Null}">

    <UserControl.Resources>
        <converters:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!--  执行容器的外观集中在 XAML，运行语义不依赖这些视觉尺寸。  -->
    <Grid Background="{x:Null}">
        <Border
            Background="#0D00A896"
            BorderBrush="{Binding Status, Converter={StaticResource NodeStatusToBrushConverter}}"
            BorderThickness="2"
            CornerRadius="16"
            IsHitTestVisible="False" />

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="TitleBar"
                Grid.Row="0"
                Padding="14,9"
                Background="#16009688"
                BorderBrush="#5A00A896"
                BorderThickness="0,0,0,1"
                CornerRadius="14,14,0,0"
                Cursor="SizeAll">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Flow_Text_Primary}"
                        Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="10"
                        Foreground="{StaticResource Flow_Text_Secondary}"
                        Text="将节点直接拖入下方泳道；容器自动管理入口、汇聚和循环"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl
                x:Name="LanePresenter"
                Grid.Row="1"
                Margin="12,8,12,16"
                IsHitTestVisible="False"
                ItemsSource="{Binding Model.ExecutionLanes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,6"
                            Background="#08FFFFFF"
                            BorderBrush="#6200A896"
                            BorderThickness="1"
                            CornerRadius="9">
                            <TextBlock
                                Margin="10,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#008F83"
                                Text="{Binding Name}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <ItemsControl
            Width="28"
            Margin="-14,64,0,16"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding InputPorts}"
            Visibility="{Binding Model.ShowBoundaryPorts, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:PortModel}">
                    <views:PortConnectorView Port="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl
            Width="28"
            Margin="0,64,-14,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding OutputPorts}"
            Visibility="{Binding Model.ShowBoundaryPorts, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:PortModel}">
                    <views:PortConnectorView Port="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Ellipse
            Width="10"
            Height="10"
            Margin="0,16,16,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Fill="{StaticResource Flow_Indicator_Active}"
            IsHitTestVisible="False"
            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

        <primitives:Thumb
            Width="22"
            Height="22"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="SizeNWSE"
            DragCompleted="OnResizeCompleted"
            DragDelta="OnResizeDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Path Margin="3" Data="M 2,16 L 16,2 M 9,16 L 16,9" Stroke="#008F83" StrokeThickness="1.5" />
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</UserControl>
