<UserControl
    x:Class="FlowEditor.Views.FlowOutputPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FlowEditor.Behaviors">

    <Border
        BorderBrush="{StaticResource Flow_Border_Divider}"
        BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="8,0,4,0"
                LastChildFill="True">
                <Button
                    x:Name="ClearOutputButton"
                    Height="24"
                    MinWidth="52"
                    Padding="8,1"
                    HorizontalAlignment="Right"
                    Command="{Binding ActiveTab.ClearOutputCommand}"
                    Content="清除"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    ToolTip="一键清空当前输出" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Flow_Text_Primary}"
                    Text="输出" />
            </DockPanel>
            <TextBox
                x:Name="OutputTextBox"
                Grid.Row="1"
                Padding="10,2"
                behaviors:TextBoxAutoScrollBehavior.IsEnabled="True"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource Flow_Text_Primary}"
                IsReadOnly="True"
                Text="{Binding ActiveTab.Model.OutputText, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Border>
</UserControl>
