<UserControl
    x:Class="FlowEditor.Views.FlowToolboxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style BasedOn="{StaticResource ScrollViewer_Style}" TargetType="ScrollViewer" />
        <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

        <Style x:Key="PanelHeaderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource Flow_Border_Default}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Flow_Text_Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Flow_Text_Tertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CountBadgeStyle" TargetType="Border">
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{StaticResource Flow_Bg_Badge}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SearchPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource Flow_Border_Search}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesign.Brush.Primary}" />
        </Style>

        <DataTemplate x:Key="PaletteItemTemplate">
            <Border
                Margin="12,4"
                Background="Transparent"
                CornerRadius="6"
                Cursor="Hand"
                MouseLeftButtonDown="OnPaletteItemMouseDown"
                MouseMove="OnPaletteItemMouseMove"
                ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Margin="8,0,0,0" Kind="{Binding IconKind}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource Flow_Text_Primary}"
                        Text="{Binding DisplayName}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource Flow_Border_Default}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Toolbox" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource SectionHeaderTextStyle}"
                        Text="工具箱" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SearchPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Height="32"
                        materialDesign:HintAssist.Hint="搜索工具名称..."
                        materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                        FontSize="12"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding ToolboxSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <materialDesign:PackIcon
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        Margin="4,0,0,0"
                        Foreground="{StaticResource Flow_Text_Muted}"
                        Kind="Magnify" />
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ToolboxCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,2">
                                <StackPanel>
                                    <Border
                                        Padding="8,6,8,4"
                                        Background="{StaticResource Flow_Bg_Category}"
                                        BorderBrush="{StaticResource Flow_Border_Light}"
                                        BorderThickness="0,1,0,1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnCategoryHeaderClick"
                                        Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="22"
                                                Height="22"
                                                Foreground="{StaticResource Flow_Text_Hint}"
                                                Kind="ChevronDown">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                <Setter Property="Kind" Value="ChevronRight" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="4,0"
                                                Style="{StaticResource SubHeaderTextStyle}"
                                                Text="{Binding Name}" />
                                            <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource Flow_Text_Hint}"
                                                    Text="{Binding TotalCount}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemTemplate="{StaticResource PaletteItemTemplate}" ItemsSource="{Binding Items}" />
                                        <ItemsControl ItemsSource="{Binding SubGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border
                                                            Padding="18,4,8,4"
                                                            Background="Transparent"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="OnCategoryHeaderClick"
                                                            Tag="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <materialDesign:PackIcon
                                                                    Grid.Column="0"
                                                                    Width="22"
                                                                    Height="22"
                                                                    Foreground="{StaticResource Flow_Text_Hint}"
                                                                    Kind="ChevronDown">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                    <Setter Property="Kind" Value="ChevronRight" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="4,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource Flow_Text_Primary}"
                                                                    Text="{Binding Name}" />
                                                                <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        Foreground="{StaticResource Flow_Text_Hint}"
                                                                        Text="{Binding Items.Count}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl
                                                            Margin="12,0,0,0"
                                                            ItemTemplate="{StaticResource PaletteItemTemplate}"
                                                            ItemsSource="{Binding Items}"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
