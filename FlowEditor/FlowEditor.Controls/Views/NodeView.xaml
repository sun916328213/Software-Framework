<UserControl
    x:Class="FlowEditor.Views.NodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FlowEditor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:FlowEditor.Models;assembly=FlowEditor.Core"
    xmlns:nodes="clr-namespace:FlowEditor.Nodes"
    xmlns:views="clr-namespace:FlowEditor.Views"
    xmlns:viewmodels="clr-namespace:FlowEditor.ViewModels"
    x:Name="RootNode"
    MinWidth="160"
    MaxWidth="200"
    d:DataContext="{d:DesignInstance Type=viewmodels:NodeViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FlowEditor.Controls;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <converters:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:PermissionToOpacityConverter x:Key="PermissionToOpacityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="NodeBorder"
        Background="White"
        BorderBrush="{Binding Status, Converter={StaticResource NodeStatusToBrushConverter}}"
        BorderThickness="2"
        CornerRadius="8"
        Opacity="{Binding Permission, Converter={StaticResource PermissionToOpacityConverter}}"
        SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="6"
                Opacity="0.15"
                ShadowDepth="1"
                Color="{StaticResource Flow_Shadow}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Border
                x:Name="TitleBar"
                Grid.Row="0"
                Padding="8,5"
                Background="{StaticResource Flow_Bg_NodeTitle}"
                CornerRadius="8,8,0,0"
                Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Flow_Text_Primary}"
                            Text="{Binding Name}" />
                        <Border
                            Margin="6,0,0,0"
                            Padding="4,0"
                            Background="#DCE3EA"
                            CornerRadius="3"
                            Visibility="{Binding IsExcludedFromExecution, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="9" Foreground="#526273" Text="不执行" />
                        </Border>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource Flow_Text_Muted}"
                            Text="{Binding LastElapsedMs, StringFormat='{}{0}ms'}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        ToolTip="Count = historical total. RunSeq = global exec index this run (loop A repeats N times then B fires at RunSeq N+1)">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource Flow_Text_Muted}"
                            Text="{Binding Count}" />
                        <TextBlock
                            Margin="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource Flow_Text_Muted}"
                            Text="-" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource Flow_Text_Muted}"
                            Text="{Binding RunSequence}" />
                    </StackPanel>

                    <Ellipse
                        Grid.Column="2"
                        Width="10"
                        Height="10"
                        Margin="4,-1,0,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource Flow_Indicator_Active}"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!--  端口区  -->
            <Grid Grid.Row="1" Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  输入端口  -->
                <ItemsControl
                    x:Name="InputPortsItemsControl"
                    Grid.Column="0"
                    Margin="-6,0,8,0"
                    ItemsSource="{Binding InputPorts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PortModel}">
                            <Grid Margin="0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <views:PortConnectorView
                                    Grid.Column="0"
                                    Margin="-7,0,0,0"
                                    Port="{Binding}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource Flow_Text_Secondary}"
                                    Text="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  输出端口  -->
                <ItemsControl
                    x:Name="OutputPortsItemsControl"
                    Grid.Column="1"
                    Margin="8,0,-6,0"
                    ItemsSource="{Binding OutputPorts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PortModel}">
                            <Grid Margin="0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource Flow_Text_Secondary}"
                                    Text="{Binding Name}"
                                    TextAlignment="Right" />
                                <views:PortConnectorView
                                    Grid.Column="1"
                                    Margin="0,0,-7,0"
                                    Port="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!--  底部按钮区  -->
            <ItemsControl
                Grid.Row="2"
                Margin="4,0,4,4"
                ItemsSource="{Binding ActionButtons}"
                Visibility="{Binding HasActionButtons, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:NodeActionViewModel}">
                        <Button
                            Margin="0,1"
                            Padding="4,2"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Command}"
                            FontSize="10"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="12"
                                    Height="12"
                                    Kind="{Binding IconResource}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
