    <NoWarn>$(NoWarn);NU1605;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Secs4Net\Secs4Net.csproj" />
