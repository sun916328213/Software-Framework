<UserControl
    x:Class="Secs.Controls.Views.SecsOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="View">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="SECS/GEM 工作台" />
            <TextBlock Margin="0,12,0,0" Text="连接状态" />
            <TextBlock FontSize="18" Text="{Binding ConnectionStatus, ElementName=View}" />
            <TextBlock Margin="0,20,0,0" Text="设备模式" />
            <TextBlock FontSize="18" Text="{Binding ModeStatus, ElementName=View}" />
            <TextBlock Margin="0,20,0,0" Text="设备状态" />
            <TextBlock FontSize="18" Text="{Binding DeviceStatus, ElementName=View}" />
        </StackPanel>
    </Grid>
</UserControl>
