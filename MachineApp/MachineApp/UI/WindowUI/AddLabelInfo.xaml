<Window
    x:Class="MachineApp.UI.WindowUI.AddLabelInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MachineApp.UI.WindowUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:MachineApp.UI.ViewModel"
    Title="添加标签方向"
    Style="{StaticResource MaterialDesignWindow}"
    MinWidth="300"
    MinHeight="210"
    Width="320"
    Height="210"
    d:DataContext="{d:DesignInstance Type=viewmodel:RecipeViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">



    <Window.Resources>
        <Style
            x:Key="LabelStyle"
            BasedOn="{StaticResource MaterialDesignLabel}"
            TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Width" Value="100" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label
                Width="84"
                Margin="0,0,8,0"
                Content="标签方向:"
                Style="{StaticResource LabelStyle}" />
            <ComboBox Style="{StaticResource CompactComboBox}"
                x:Name="cmb_Fosb"
                Grid.Column="1"
                Height="32"
                AutomationProperties.Name="标签方向"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding LabelDir}"
                SelectedIndex="0"
                SelectedItem="{Binding LabelInfo_AddLabel.LabelDir}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Margin="8,3,10,3"
                Command="{Binding AddLabelCommand}"
                Content="确认" />
        </Grid>
    </Grid>
</Window>
