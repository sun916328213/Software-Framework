<!--
中文阅读说明：界面与资源声明。
MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="MachineApp.UI.View.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bulletinboard="clr-namespace:WPFControls.Controls.Views.BulletinBoard;assembly=WPFControls"
    xmlns:control="clr-namespace:WPFControls.ProgramControl.Views;assembly=WPFControls"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views;assembly=WPFControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MachineApp.UI.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <ContentControl
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="0,0,4,0"
            prism:RegionManager.RegionName="DisplayRegion1" />

        <ContentControl
            Grid.Row="0"
            Grid.Column="1"
            Margin="4,0,0,4"
            prism:RegionManager.RegionName="DisplayRegion2" />

        <ContentControl
            Grid.Row="1"
            Grid.Column="1"
            Margin="4,4,0,0"
            prism:RegionManager.RegionName="DisplayRegion3" />

    </Grid>
</UserControl>