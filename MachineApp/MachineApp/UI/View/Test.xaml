<!--
中文阅读说明：界面与资源声明。
MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="MachineApp.UI.View.Test"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MachineApp.UI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource CompactPrimaryButton}" TargetType="Button">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="32" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="12">
        <Button Content="产能数据库测试" HorizontalAlignment="Left" Click="Button_Click" />
    </StackPanel>
</UserControl>
