<!--
中文阅读说明：界面与资源声明。
MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="MachineApp.UI.View.VisionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctr="clr-namespace:Vision.Controls.View;assembly=Vision.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MachineApp.UI.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodel="clr-namespace:MachineApp.UI.ViewModel"
    d:DesignHeight="850"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" TabStripPlacement="Right">
            <!--<TabItem Header="条码">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">

                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.BarcodeReader_Auto}" />

                </Border>
            </TabItem>-->

            <TabItem Header="条码">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">

                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.BarcodeReader}" />

                </Border>
            </TabItem>

            <TabItem Header="二维码">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.BarcodeReader_2D}" />
                </Border>
            </TabItem>
            <TabItem Header="湿度卡A匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.TemplateMatch_HumidityCardA, Mode=TwoWay}" />
                </Border>
            </TabItem>
            <TabItem Header="湿度卡B匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.TemplateMatch_HumidityCardB, Mode=TwoWay}" />
                </Border>
            </TabItem>
            <TabItem Header="干燥剂匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.TemplateMatch_Accessory}" />
                </Border>
            </TabItem>
            <TabItem Header="铝塑袋定位左侧">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.BagPattern_Left}" />
                </Border>
            </TabItem>
            <TabItem Header="铝塑袋定位右侧">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.BagPattern_Right}" />
                </Border>
            </TabItem>
            <TabItem Header="封口检测">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.DetectionToolSession}" />
                </Border>
            </TabItem>
            <TabItem Header="九点标定模版匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.TemplateMatch_Caliber}" />
                </Border>
            </TabItem>
            <TabItem Header="多点标定">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.CalibrationSession}" />
                </Border>
            </TabItem>
            <TabItem Header="仿射变换">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:ToolEditorView
                        Margin="8"
                        Tool="{Binding Datas.TransformPointSession}" />
                </Border>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
