<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <IsIntegrationHost>true</IsIntegrationHost>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\图标.ico</ApplicationIcon>
    <LangVersion>13.0</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>MachineApp</AssemblyName>
    <RootNamespace>MachineApp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Config\Flow\StartupFlow\01_初始化控件.cs" />
    <Compile Remove="Config\Flow\StartupFlow\02_初始化工具.cs" />
