<!--
中文阅读说明：界面与资源声明。
MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<base:BaseMainWindow
    x:Class="MachineApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assist="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:base="clr-namespace:WPFControls.WindowUI;assembly=WPFControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    WindowStyle="None"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <Border Background="{DynamicResource MaterialDesign.Brush.Background}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题栏区域  -->
            <ContentControl
                Grid.Row="0"
                Margin="0"
                prism:RegionManager.RegionName="WindowMenuRegion" />

            <!--  主内容区域  -->
            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                <!--  左侧菜单  -->
                <ContentControl
                    Margin="0"
                    prism:RegionManager.RegionName="MenuRegion"
                    DockPanel.Dock="Left"  
                    PreviewMouseDoubleClick="DockPanel_PreviewMouseLeftButtonDown" />

                <!--  右侧内容  -->
                <Grid DockPanel.Dock="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <!--  顶部状态栏  -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0" prism:RegionManager.RegionName="IconRegion" />
                        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="StatisticsRegion" />
                        <ContentControl
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            prism:RegionManager.RegionName="ControlRegion" />
                    </Grid>

                    <!--  主内容  -->
                    <ContentControl
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="8,8,8,8"
                        prism:RegionManager.RegionName="MainContentRegion" />
                </Grid>
            </DockPanel>
        </Grid>
    </Border>

</base:BaseMainWindow>

