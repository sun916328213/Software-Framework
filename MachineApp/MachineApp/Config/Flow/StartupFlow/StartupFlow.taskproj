{
  "Name": "新建任务",
  "Scripts": [
    {
      "Title": "初始化控件",
      "Code": "using Extension.UI.Controls;\r\nusing Extension.Core.Models;\r\nusing Extension.Imaging.Models;\r\nusing Extension.Automation.Device;\r\nusing MaterialDesignThemes.Wpf;\r\nusing MachineApp.Data;\r\nusing MachineApp.Infra.Core;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing SecsGem.Controls;\nusing SecsGem.Core;\nusing SecsGem.Runtime;\r\nusing System.Collections.ObjectModel;\r\nusing WPFControls.Controls.Models;\r\nusing WPFControls.ProgramControl.Models;\r\nusing WPFControls.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n\r\n    private  ControlService _ControlService;\r\n    private  StatisticService _StatisticService;\r\n    private  WindowMenuService _WindowMenuService;\r\n    private  MenuService _MenuService;\r\n\r\n    private  IRegionManager _IRegionManager;\r\n    private  DialogService _DialogService;\r\n\r\n    private  SecsControl _SecsControl;\r\n    public  void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _ControlService = ContainerManager.Resolve<ControlService>();\r\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\r\n        _WindowMenuService = ContainerManager.Resolve<WindowMenuService>();\r\n        _MenuService = ContainerManager.Resolve<MenuService>();\r\n\r\n        _IRegionManager = ContainerManager.Resolve<IRegionManager>();\r\n        _DialogService = ContainerManager.Resolve<DialogService>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n    }\r\n\r\n    public  void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Init_Menu();\r\n        Init_Control();\r\n        Init_Display();\r\n    }\r\n\r\n    #region 控件\r\n    private  void Init_Control()\r\n    {\r\n        //控制按钮功能\r\n        _ControlService.AddAction(new List<Action>\r\n        {\r\n        async ()  =>\r\n             {\r\n             \r\n                 //_StatisticService.UpdateDeviceStatus(EDeviceStatus.Ready);\r\n                 //_ = _SecsControl._ConnectManager.Online_EtoH();\r\n             },\r\n         () =>\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Running);\r\n                 _ = _SecsControl._ConnectManager.Offline_EtoH();\r\n             },\r\n         () =>\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Idle);\r\n             },\r\n\r\n         () =>\r\n             {\r\n                 _WindowMenuService.CloseApplication();\r\n             }\r\n        });\r\n    }\r\n\r\n    private  void Init_Display()\r\n    {\r\n        var _DisplayService = ContainerManager.Resolve<DisplayService>();\r\n\r\n        _DisplayService.Clear();\r\n        _DisplayService.SetRowCol(2, 3);\r\n\r\n        _DisplayService.AddDisplayTitle(\"1\");\r\n        _DisplayService.AddDisplayTitle(\"2\");\r\n        _DisplayService.AddDisplayTitle(\"3\");\r\n        _DisplayService.AddDisplayTitle(\"4\");\r\n        _DisplayService.AddDisplayTitle(\"5\");\r\n        _DisplayService.AddDisplayTitle(\"6\");\r\n    }\r\n\r\n    private  void Init_Menu()\r\n    {\r\n        _MenuService.Clear();\r\n        _MenuService.AddRange(new List<CNavigationItem>\r\n     {\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.主页.GetMessage(),\r\n             SelectedIcon = PackIconKind.Home,\r\n             Icon = PackIconKind.HomeOutline,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Home\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"Test\",\r\n             Icon = PackIconKind.TestTube,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Test\");\r\n             })\r\n         },\r\n        new CNavigationItem\r\n         {\r\n             Title = \"Test\",\r\n             Icon = PackIconKind.TestTube,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogConfigView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.配方.GetMessage(),\r\n             SelectedIcon = PackIconKind.ReceiptTextEdit,\r\n             Icon = PackIconKind.ReceiptTextEditOutline,\r\n             //Userlevel= EUserLevel.Admin,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Recipe\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.打印设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Printer,\r\n             Icon = PackIconKind.PrinterOutline,\r\n             Action = (() =>\r\n             {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"PrintManagerView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.视觉查看.GetMessage(),\r\n             SelectedIcon = PackIconKind.Video,\r\n             Icon = PackIconKind.VideoOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DisplayView\"); }),\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.流程.GetMessage(),\r\n             SelectedIcon = PackIconKind.ListBox,\r\n             Icon = PackIconKind.ListBoxOutline,\r\n             Children = new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"加载流程\" ,\r\n                     Icon = PackIconKind.DownloadBoxOutline,\r\n                     Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"StartupFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.初始化流程.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Refresh,\r\n                     Icon = PackIconKind.Refresh,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"InitializeFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.自动流程.GetMessage(),\r\n                   \r\n                     Icon = PackIconKind.RepeatVariant,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AutoFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.关闭流程.GetMessage(),\r\n                    \r\n                     Icon = PackIconKind.CloseThick,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ShutdownFlowView\"); })\r\n                 },\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title =Message.检测项设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.PencilRuler,\r\n             Icon = PackIconKind.PencilRulerOutline,\r\n\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.视觉设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.PencilBoxMultiple,\r\n                      Icon = PackIconKind.PencilBoxMultipleOutline,\r\n                     Action = (() =>\r\n                     {\r\n                         _IRegionManager.RequestNavigate(\"MainContentRegion\", \"VisionView\");\r\n                     })\r\n                 }\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.硬件设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Cog ,\r\n             Icon = PackIconKind.CogOutline,\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Cam设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Camera,\r\n                     Icon = PackIconKind.CameraOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CamManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.RFID设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CastConnected,\r\n                     Icon = PackIconKind.Cast,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"RFIDManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"扫码枪设置\",\r\n                     Icon = PackIconKind.Barcode,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ScanManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"光源控制器设置\",\r\n                     Icon = PackIconKind.CarLightDimmed,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LightControlManagerView\"); })\r\n                 },\r\n\r\n             }\r\n         },\r\n\r\n           new CNavigationItem\r\n         {\r\n             Title = \"查询\",\r\n             SelectedIcon = PackIconKind.DatabaseSearch,\r\n             Icon = PackIconKind.DatabaseSearchOutline,\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Log查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.NoteSearch,\r\n                     Icon = PackIconKind.NoteSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.SEMILog查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CloudSearch,\r\n                     Icon = PackIconKind.CloudSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMILogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.数据查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.TextBoxSearch,\r\n                     Icon = PackIconKind.TextBoxSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DataQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"产能查询\",\r\n                      \r\n                     Icon = PackIconKind.EqualizerOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CapacityStatisticsView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.图像查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.ImageSearch,\r\n                     Icon = PackIconKind.ImageSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ImageQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.报警查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.AlarmLight,\r\n                     Icon = PackIconKind.AlarmLightOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoQueryView\"); })\r\n                 },\r\n             }\r\n         },\r\n\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户登录.GetMessage(),\r\n             SelectedIcon = PackIconKind.User,\r\n             Icon = PackIconKind.UserOutline,\r\n             Action = () => { _DialogService.ShowDialog(\"UserInfoView\"); },\r\n             ItemType = NavigationItemType.UserLogin // 设置菜单项类型为用户登录\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户信息管理.GetMessage(),\r\n             SelectedIcon = PackIconKind.AccountKey,\r\n             Icon = PackIconKind.AccountKeyOutline,\r\n             Action = () => { _IRegionManager.RequestNavigate(\"MainContentRegion\",\"UserInfoManagerView\"); },\r\n             Userlevel= EUserLevel.Admin,\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.SEMI设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.ConsoleNetwork,\r\n             Icon = PackIconKind.ConsoleNetworkOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMIManagerView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.报警设置.GetMessage(),\r\n              Userlevel= EUserLevel.SuperAdmin,\r\n             SelectedIcon = PackIconKind.BellCog,\r\n             Icon = PackIconKind.BellCogOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoManagerView\"); })\r\n         },\r\n\r\n         // ---- DataManager.Controls 提供的三个配置页 ----\r\n         // 页面归 DataManager.Controls；行实体与导航注册在 Packing Machine 的 App.RegisterTypes\r\n         // （WPFControls 只是引用它们，模块里注册不了 —— 泛型 VM 的实参是宿主自己的实体）。\r\n         new CNavigationItem\r\n         {\r\n             Title = \"SQL 配置\",\r\n             Icon = PackIconKind.Database,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SqlView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"日志测试\",\r\n             Icon = PackIconKind.FileDocumentOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"Excel 配置\",\r\n             Icon = PackIconKind.Table,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ExcelView\"); })\r\n         },\r\n     });\r\n    }\r\n    #endregion\r\n}",
      "References": []
    },
    {
      "Title": "初始化工具",
      "Code": "using MachineApp.Infra.Persistence.Entities;\r\nusing DataManager.Core.Log;\nusing DataManager.Runtime.Log;\r\nusing DataManager.Core.Log.Definition;\r\nusing DataManager.Core.SQL;\nusing DataManager.Runtime.SQL;\r\nusing DataManager.Core.SQL.Definition;\nusing DataManager.Runtime.SQL.Definition;\r\nusing MachineApp.Data;\r\nusing MachineApp.Infra.Core;\r\nusing MachineApp.Infra.Tool;\r\nusing MachineApp.UI.Model;\r\nusing SecsGem.Controls;\nusing SecsGem.Core;\nusing SecsGem.Runtime;\r\nusing WPFControls.ProgramControl.Models;\r\nusing WPFControls.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n\r\n    private static PLCTool _PLCMethod;\r\n    private static SecsControl _SecsControl;\r\n\r\n\r\n    private static AlarmInfoManagerService _AlarmInfoService;\r\n\r\n    private static LogManager _LogManager;\r\n    private static SQLManager _SQLManager;\r\n\r\n\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _PLCMethod = ContainerManager.Resolve<PLCTool>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n\r\n\r\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\r\n\r\n\r\n        _LogManager = ContainerManager.Resolve<LogManager>();\r\n        _SQLManager = ContainerManager.Resolve<SQLManager>();\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Init_Tool();\r\n    }\r\n\r\n    private static void Init_Tool()\r\n    {\r\n        GlobalData.Load();\r\n\r\n        Console.WriteLine(\"初始化Log日志\");\r\n        //日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = GlobalData.LogPath,\r\n            Name = \"Log\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化SMEI日志\");\r\n        //SEMI日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = GlobalData.LogPath,\r\n            Name = \"SEMILog\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create<CSQLData>(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"test1\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[0].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n        \r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create<CapacityStatisticsInfo>(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"产能数据库\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[1].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n    }\r\n}",
      "References": []
    },
    {
      "Title": "初始化硬件",
      "Code": "using MachineApp.Infra.Core;\nusing MachineApp.Infra.Device;\n\npublic class Script\n{\n    private ProductionDeviceSession _devices;\n    public void Initialize() => _devices = ContainerManager.Resolve<ProductionDeviceSession>();\n    public void Run()\n    {\n        _devices.InitializeAsync().ConfigureAwait(false).GetAwaiter().GetResult();\n        Console.WriteLine(\"新 Device 生产设备已按全部档案连接，光源已关闭。\");\n    }\n}\n",
      "References": []
    },
    {
      "Title": "初始化后台",
      "Code": "using Extension.UI.Controls;\r\nusing WPFControls.Controls.Resources;\r\n\r\npublic class Script\r\n{\r\n    ResourceMonitorService _ResourceMonitorService;\r\n    BulletinBoardService _BulletinBoardService;\r\n    StatisticService _StatisticService;\r\n    AlarmInfoManagerService _AlarmInfoService;\r\n    SecsControl _SecsControl;\r\n\r\n    public void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _ResourceMonitorService = ContainerManager.Resolve<ResourceMonitorService>();\r\n        _BulletinBoardService = ContainerManager.Resolve<BulletinBoardService>();\r\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\r\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n    }\r\n\r\n    public void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        _ResourceMonitorService.StartAutoRefresh();\r\n\r\n\r\n        DispatcherTimerEx.DispatcherTimer(new Action(Loop), 1000, \"Loop\");\r\n    }\r\n\r\n    private void Loop()\r\n    {\r\n        var now = DateTime.Now;\r\n\r\n        if (now.Minute % 2 == 0 && now.Second == 0)//5分钟读一次        {\r\n            //读取OK NG\r\n            //ReadCount();\r\n            //更新每天统计信息\r\n            _BulletinBoardService.ShowData_Day(new List<WPFControls.Controls.Models.Charts.LineSeries>\r\n            {\r\n                new WPFControls.Controls.Models.Charts.LineSeries {\r\n                    SeriesName=\"OK\",\r\n                    Value=new System.Collections.ObjectModel.ObservableCollection<double>{ 10},\r\n                    Color= ColorHelper.Color_Green,\r\n                },\r\n                new WPFControls.Controls.Models.Charts.LineSeries {\r\n                    SeriesName=\"NG\",\r\n                    Value=new System.Collections.ObjectModel.ObservableCollection<double>{ 20,20,30,40,130,20,0},\r\n                    Color= ColorHelper.Color_Red,\r\n                },\r\n                new WPFControls.Controls.Models.Charts.LineSeries {\r\n                    SeriesName=\"Total\",\r\n                    Value=new System.Collections.ObjectModel.ObservableCollection<double>{ 120,120,130,140,230,120,0},\r\n                    Color= ColorHelper.Color_Blue,\r\n                }\r\n            });\r\n        }\r\n        else if (now.Hour == 0)\r\n        {\r\n            /// 更新每月统计信息\r\n            _BulletinBoardService.ShowData_Month(new List<WPFControls.Controls.Models.Charts.LineSeries>\r\n            {\r\n                new WPFControls.Controls.Models.Charts.LineSeries\r\n                {\r\n                    SeriesName = \"OK\",\r\n                    Value = new System.Collections.ObjectModel.ObservableCollection<double> { 10, 120 },\r\n                    Color = ColorHelper.Color_Blue,\r\n                },\r\n                new WPFControls.Controls.Models.Charts.LineSeries\r\n                {\r\n                    SeriesName = \"NG\",\r\n                    Value = new System.Collections.ObjectModel.ObservableCollection<double> { 20, 20 },\r\n                    Color = ColorHelper.Color_Red,\r\n                }\r\n            });\r\n        }\r\n\r\n\r\n        // 旧 MCHelper.IsConnected 已随旧通信栈删除；PLC 状态暂按 Offline 处理。\r\n        var plcstatus = ELinkStatus.Offline;\r\n        if (plcstatus == ELinkStatus.Online)\r\n        {\r\n            //await RefreshSystem();\r\n            RefreshAlarm();\r\n        }\r\n\r\n        // 更新统计信息（在UI线程上执行）\r\n        _StatisticService.UpdateID(\"12345678\");\r\n\r\n        _StatisticService.UpdateCount(10, 200);\r\n        _StatisticService.UpdateRunTime(_AlarmInfoService.TotalAlarmTime == 0 ? 100 : 500, 800);\r\n        _StatisticService.UpdateSecsMode(_SecsControl._StatusManager.CurrentMode);\r\n        _StatisticService.UpdatePLC(plcstatus);\r\n        _StatisticService.UpdateSecsStatus(_SecsControl.IsConnected ? ELinkStatus.Online : ELinkStatus.Offline);\r\n        _StatisticService.UpdateTime();\r\n\r\n\r\n        // 在后台线程执行耗时操作\r\n        Task.Run(() =>\r\n        {\r\n            // 每小时检查一次（当分钟为0且秒丼时）\r\n            if (now.Minute / 10 == 0 && now.Second == 0)\r\n            {\r\n                ScheduledDeletion.DeleteExpiredFiles(GlobalData.Path_Image, GlobalData.SaveImageDay);\r\n            }\r\n            if (now.Second == 0)\r\n                GC.Collect();\r\n        });\r\n    }\r\n\r\n    private void RefreshAlarm()\r\n    {\r\n        // 旧实现走 CommunicationManager.GetData(\"Alarm\")，该能力已随旧通信栈删除。\r\n        // 报警读取暂时停用：不伪造数据，待迁移到 Communication.Core 后恢复。\r\n    }\r\n}\r\n",
      "References": []
    }
  ],
  "References": []
}
