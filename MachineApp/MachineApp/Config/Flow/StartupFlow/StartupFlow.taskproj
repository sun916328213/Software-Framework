{
    "Name":  "新建任务",
    "Scripts":  [
                    {
                        "Title":  "初始化控件",
                        "ScriptId":  "251652e5-bd42-4731-abe3-777f8fd280c3",
                        "Code":  "// 【中文阅读说明】\r\n// MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n// 本文件定义：Script。成员说明可结合下方具体实现阅读。\r\n// 直接导入的协作命名空间包括：Extension.UI.Controls、Extension.Core.Models、Extension.Imaging.Models、Extension.Automation.Device、MaterialDesignThemes.Wpf、MachineApp.Data。导入不代表所有类型都会在运行时加载。\r\nusing Extension.UI.Controls;\r\nusing Extension.Core.Models;\r\nusing Extension.Imaging.Models;\r\nusing Extension.Automation.Device;\r\nusing MaterialDesignThemes.Wpf;\r\nusing MachineApp.Data;\r\nusing MachineApp.Infra.Core;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing SecsGem.Core;\r\nusing System.Collections.ObjectModel;\r\nusing WPFControls.Controls.Models;\r\nusing WPFControls.ProgramControl.Models;\r\nusing WPFControls.ProgramControl.Services;\r\n\r\n/// \u003csummary\u003e\r\n/// Script 的类型定义。MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n/// \u003c/summary\u003e\r\npublic class Script\r\n{\r\n\r\n    private  ControlService _ControlService;\r\n    private  StatisticService _StatisticService;\r\n    private  WindowMenuService _WindowMenuService;\r\n    private  MenuService _MenuService;\r\n\r\n    private  IRegionManager _IRegionManager;\r\n    private  DialogService _DialogService;\r\n\r\n    private ISecsGemRuntime _secsRuntime;\r\n    /// \u003csummary\u003e\r\n    /// 执行初始化步骤；对应入口为 Initialize。\r\n    /// 正文中的关键协作调用包括 Resolve；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    public  void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _ControlService = ContainerManager.Resolve\u003cControlService\u003e();\r\n        _StatisticService = ContainerManager.Resolve\u003cStatisticService\u003e();\r\n        _WindowMenuService = ContainerManager.Resolve\u003cWindowMenuService\u003e();\r\n        _MenuService = ContainerManager.Resolve\u003cMenuService\u003e();\r\n\r\n        _IRegionManager = ContainerManager.Resolve\u003cIRegionManager\u003e();\r\n        _DialogService = ContainerManager.Resolve\u003cDialogService\u003e();\r\n\r\n        _secsRuntime = ContainerManager.Resolve\u003cISecsGemRuntime\u003e();\r\n    }\r\n\r\n    /// \u003csummary\u003e\r\n    /// 运行当前处理流程；对应入口为 Run。\r\n    /// 正文中的关键协作调用包括 WriteLine、Init_Menu、Init_Control、Init_Display；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    public  void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Init_Menu();\r\n        Init_Control();\r\n        Init_Display();\r\n    }\r\n\r\n    #region 控件\r\n    private  void Init_Control()\r\n    {\r\n        //控制按钮功能\r\n        _ControlService.AddAction(new List\u003cAction\u003e\r\n        {\r\n        async ()  =\u003e\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Ready);\r\n                 _ = _secsRuntime.GoOnlineLocalAsync();\r\n             },\r\n         () =\u003e\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Running);\r\n                 _ = _secsRuntime.GoOnlineRemoteAsync();\r\n             },\r\n         () =\u003e\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Idle);\r\n                   _ = _secsRuntime.GoOfflineAsync();\r\n             },\r\n\r\n         () =\u003e\r\n             {\r\n                 _WindowMenuService.CloseApplication();\r\n             }\r\n        });\r\n    }\r\n\r\n    /// \u003csummary\u003e\r\n    /// 处理当前类型提供的操作；对应入口为 Init_Display。\r\n    /// 正文中的关键协作调用包括 Resolve、Clear、SetRowCol、AddDisplayTitle；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    private  void Init_Display()\r\n    {\r\n        var _DisplayService = ContainerManager.Resolve\u003cDisplayService\u003e();\r\n\r\n        _DisplayService.Clear();\r\n        _DisplayService.SetRowCol(2, 3);\r\n\r\n        _DisplayService.AddDisplayTitle(\"1\");\r\n        _DisplayService.AddDisplayTitle(\"2\");\r\n        _DisplayService.AddDisplayTitle(\"3\");\r\n        _DisplayService.AddDisplayTitle(\"4\");\r\n        _DisplayService.AddDisplayTitle(\"5\");\r\n        _DisplayService.AddDisplayTitle(\"6\");\r\n    }\r\n\r\n    /// \u003csummary\u003e\r\n    /// 处理当前类型提供的操作；对应入口为 Init_Menu。\r\n    /// 正文中的关键协作调用包括 Clear、AddRange、GetMessage、RequestNavigate、ShowDialog；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    private  void Init_Menu()\r\n    {\r\n        _MenuService.Clear();\r\n        _MenuService.AddRange(new List\u003cCNavigationItem\u003e\r\n     {\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.主页.GetMessage(),\r\n             SelectedIcon = PackIconKind.Home,\r\n             Icon = PackIconKind.HomeOutline,\r\n             Action = (() =\u003e {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Home\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"Test\",\r\n             Icon = PackIconKind.TestTube,\r\n             Action = (() =\u003e {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Test\");\r\n             })\r\n         },\r\n        new CNavigationItem\r\n         {\r\n             Title = \"Test\",\r\n             Icon = PackIconKind.TestTube,\r\n             Action = (() =\u003e {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogConfigView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.配方.GetMessage(),\r\n             SelectedIcon = PackIconKind.ReceiptTextEdit,\r\n             Icon = PackIconKind.ReceiptTextEditOutline,\r\n             //Userlevel= EUserLevel.Admin,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Recipe\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.打印设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Printer,\r\n             Icon = PackIconKind.PrinterOutline,\r\n             Action = (() =\u003e\r\n             {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"PrintManagerView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.视觉查看.GetMessage(),\r\n             SelectedIcon = PackIconKind.Video,\r\n             Icon = PackIconKind.VideoOutline,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DisplayView\"); }),\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.流程.GetMessage(),\r\n             SelectedIcon = PackIconKind.ListBox,\r\n             Icon = PackIconKind.ListBoxOutline,\r\n             Children = new ObservableCollection\u003cCNavigationItem\u003e\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"加载流程\" ,\r\n                     Icon = PackIconKind.DownloadBoxOutline,\r\n                     Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"StartupFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.初始化流程.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Refresh,\r\n                     Icon = PackIconKind.Refresh,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"InitializeFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.自动流程.GetMessage(),\r\n                   \r\n                     Icon = PackIconKind.RepeatVariant,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AutoFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.关闭流程.GetMessage(),\r\n                    \r\n                     Icon = PackIconKind.CloseThick,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ShutdownFlowView\"); })\r\n                 },\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title =Message.检测项设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.PencilRuler,\r\n             Icon = PackIconKind.PencilRulerOutline,\r\n\r\n             Children=new ObservableCollection\u003cCNavigationItem\u003e\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.视觉设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.PencilBoxMultiple,\r\n                      Icon = PackIconKind.PencilBoxMultipleOutline,\r\n                     Action = (() =\u003e\r\n                     {\r\n                         _IRegionManager.RequestNavigate(\"MainContentRegion\", \"VisionView\");\r\n                     })\r\n                 }\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.硬件设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Cog ,\r\n             Icon = PackIconKind.CogOutline,\r\n             Children=new ObservableCollection\u003cCNavigationItem\u003e\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Cam设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Camera,\r\n                     Icon = PackIconKind.CameraOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CamManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.RFID设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CastConnected,\r\n                     Icon = PackIconKind.Cast,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"RFIDManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"扫码枪设置\",\r\n                     Icon = PackIconKind.Barcode,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ScanManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"光源控制器设置\",\r\n                     Icon = PackIconKind.CarLightDimmed,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LightControlManagerView\"); })\r\n                 },\r\n\r\n             }\r\n         },\r\n\r\n           new CNavigationItem\r\n         {\r\n             Title = \"查询\",\r\n             SelectedIcon = PackIconKind.DatabaseSearch,\r\n             Icon = PackIconKind.DatabaseSearchOutline,\r\n             Children=new ObservableCollection\u003cCNavigationItem\u003e\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Log查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.NoteSearch,\r\n                     Icon = PackIconKind.NoteSearchOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.SEMILog查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CloudSearch,\r\n                     Icon = PackIconKind.CloudSearchOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMILogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.数据查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.TextBoxSearch,\r\n                     Icon = PackIconKind.TextBoxSearchOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DataQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"产能查询\",\r\n                      \r\n                     Icon = PackIconKind.EqualizerOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CapacityStatisticsView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.图像查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.ImageSearch,\r\n                     Icon = PackIconKind.ImageSearchOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ImageQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.报警查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.AlarmLight,\r\n                     Icon = PackIconKind.AlarmLightOutline,\r\n                     Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoQueryView\"); })\r\n                 },\r\n             }\r\n         },\r\n\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户登录.GetMessage(),\r\n             SelectedIcon = PackIconKind.User,\r\n             Icon = PackIconKind.UserOutline,\r\n             Action = () =\u003e { _DialogService.ShowDialog(\"UserInfoView\"); },\r\n             ItemType = NavigationItemType.UserLogin // 设置菜单项类型为用户登录\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户信息管理.GetMessage(),\r\n             SelectedIcon = PackIconKind.AccountKey,\r\n             Icon = PackIconKind.AccountKeyOutline,\r\n             Action = () =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\",\"UserInfoManagerView\"); },\r\n             Userlevel= EUserLevel.Admin,\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.SEMI设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.ConsoleNetwork,\r\n             Icon = PackIconKind.ConsoleNetworkOutline,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMIManagerView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.报警设置.GetMessage(),\r\n              Userlevel= EUserLevel.SuperAdmin,\r\n             SelectedIcon = PackIconKind.BellCog,\r\n             Icon = PackIconKind.BellCogOutline,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoManagerView\"); })\r\n         },\r\n\r\n         // ---- DataManager.Controls 提供的三个配置页 ----\r\n         // 页面归 DataManager.Controls；行实体与导航注册在 Packing Machine 的 App.RegisterTypes\r\n         // （WPFControls 只是引用它们，模块里注册不了 —— 泛型 VM 的实参是宿主自己的实体）。\r\n         new CNavigationItem\r\n         {\r\n             Title = \"SQL 配置\",\r\n             Icon = PackIconKind.Database,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SqlView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"日志测试\",\r\n             Icon = PackIconKind.FileDocumentOutline,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"Excel 配置\",\r\n             Icon = PackIconKind.Table,\r\n             Action = (() =\u003e { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ExcelView\"); })\r\n         },\r\n     });\r\n    }\r\n    #endregion\r\n}\r\n"
                    },
                    {
                        "Title":  "初始化工具",
                        "ScriptId":  "73814210-ab4e-4825-8bf8-7f044b079471",
                        "Code":  "// 【中文阅读说明】\r\n// MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n// 本文件定义：Script。成员说明可结合下方具体实现阅读。\r\n// 直接导入的协作命名空间包括：MachineApp.Infra.Persistence.Entities、DataManager.Core.Log、DataManager.Runtime.Log、DataManager.Core.Log.Definition、DataManager.Core.SQL、DataManager.Runtime.SQL。导入不代表所有类型都会在运行时加载。\r\nusing MachineApp.Infra.Persistence.Entities;\r\nusing DataManager.Core.Log;\r\nusing DataManager.Runtime.Log;\r\nusing DataManager.Core.Log.Definition;\r\nusing DataManager.Core.SQL;\r\nusing DataManager.Runtime.SQL;\r\nusing DataManager.Core.SQL.Definition;\r\nusing DataManager.Runtime.SQL.Definition;\r\nusing MachineApp.Data;\r\nusing MachineApp.Infra.Core;\r\nusing MachineApp.Infra.Tool;\r\nusing MachineApp.UI.Model;\r\nusing WPFControls.ProgramControl.Models;\r\nusing WPFControls.ProgramControl.Services;\r\n\r\n/// \u003csummary\u003e\r\n/// Script 的类型定义。MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n/// \u003c/summary\u003e\r\npublic class Script\r\n{\r\n\r\n    private static PLCTool _PLCMethod;\r\n\r\n\r\n    private static AlarmInfoManagerService _AlarmInfoService;\r\n\r\n    private static ILogManager _LogManager;\r\n    private static SQLManager _SQLManager;\r\n\r\n\r\n    /// \u003csummary\u003e\r\n    /// 执行初始化步骤；对应入口为 Initialize。\r\n    /// 正文中的关键协作调用包括 Resolve；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _PLCMethod = ContainerManager.Resolve\u003cPLCTool\u003e();\r\n\r\n\r\n\r\n        _AlarmInfoService = ContainerManager.Resolve\u003cAlarmInfoManagerService\u003e();\r\n\r\n\r\n        _LogManager = ContainerManager.Resolve\u003cILogManager\u003e();\r\n        _SQLManager = ContainerManager.Resolve\u003cSQLManager\u003e();\r\n    }\r\n\r\n    /// \u003csummary\u003e\r\n    /// 运行当前处理流程；对应入口为 Run。\r\n    /// 正文中的关键协作调用包括 Init_Tool；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    public static void Run()\r\n    {\r\n        Init_Tool();\r\n    }\r\n\r\n    /// \u003csummary\u003e\r\n    /// 处理当前类型提供的操作；对应入口为 Init_Tool。\r\n    /// 正文中的关键协作调用包括 Load、WriteLine、Create、Connect；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    private static void Init_Tool()\r\n    {\r\n        GlobalData.Load();\r\n\r\n        Console.WriteLine(\"初始化Log日志\");\r\n        // GlobalData.LogPath 从未实现过（git log -S 无任何记录）。改用唯一生产先例\r\n        // LogWorkspace.cs:332 的 Path.Combine(BaseDirectory, \"logs\") —— 日志落盘位置\r\n        // 不能依赖工作目录，工厂现场从非 exe 目录启动是常见翻车点。\r\n        //日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, \"logs\"),\r\n            Name = \"Log\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化SMEI日志\");\r\n        //SEMI日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, \"logs\"),\r\n            Name = \"SEMILog\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create\u003cCSQLData\u003e(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"test1\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[0].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n        \r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create\u003cCapacityStatisticsInfo\u003e(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"产能数据库\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[1].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n    }\r\n}\r\n"
                    },
                    {
                        "Title":  "初始化硬件",
                        "ScriptId":  "c39b31a2-ffc4-4d08-a2f1-a854ad302d32",
                        "Code":  "// 【中文阅读说明】\r\n// MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n// 本文件定义：Script。成员说明可结合下方具体实现阅读。\r\n// 直接导入的协作命名空间包括：MachineApp.Infra.Core、MachineApp.Infra.Device。导入不代表所有类型都会在运行时加载。\r\nusing MachineApp.Infra.Core;\r\nusing MachineApp.Infra.Device;\r\n\r\n/// \u003csummary\u003e\r\n/// Script 的类型定义。MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n/// \u003c/summary\u003e\r\npublic class Script\r\n{\r\n    private ProductionDeviceSession _devices;\r\n    /// \u003csummary\u003e\r\n    /// 执行初始化步骤；对应入口为 Initialize。\r\n    /// 正文中的关键协作调用包括 Resolve；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    public void Initialize() =\u003e _devices = ContainerManager.Resolve\u003cProductionDeviceSession\u003e();\r\n    /// \u003csummary\u003e\r\n    /// 运行当前处理流程；对应入口为 Run。\r\n    /// 正文中的关键协作调用包括 GetResult、GetAwaiter、ConfigureAwait、InitializeAsync、WriteLine；具体条件和先后次序见方法体。\r\n    /// \u003c/summary\u003e\r\n    public void Run()\r\n    {\r\n        _devices.InitializeAsync().ConfigureAwait(false).GetAwaiter().GetResult();\r\n        Console.WriteLine(\"新 Device 生产设备已按全部档案连接，光源已关闭。\");\r\n    }\r\n}\r\n"
                    },
                    {
                        "Title":  "初始化后台",
                        "ScriptId":  "c78fc52c-3df8-49b8-8495-88563db33037",
                        "Code":  "// 【中文阅读说明】\r\n// MachineApp 模块：具体机型的应用宿主，负责机型业务、导航选择、数据库实体和生产设备生命周期。\r\n// 本文件定义：Script。成员说明可结合下方具体实现阅读。\r\n// 直接导入的协作命名空间包括：Extension.UI.Controls、WPFControls.Controls.Resources、SecsGem.Core、Extension.Automation.Secs。导入不代表所有类型都会在运行时加载。\r\nusing Extension.UI.Controls;\r\nusing WPFControls.Controls.Resources;\r\nusing SecsGem.Core;\r\nusing Extension.Automation.Secs;\r\nusing MachineApp.Infra.Core;\r\nusing MachineApp.Infra.Tool;\r\nusing WPFControls.ProgramControl.Services;\r\nusing MachineApp.Data;\r\nusing WPFControls.ProgramControl.Models;\r\nusing Extension.IO.Retention;\r\n\r\npublic class Script\r\n{\r\n    ResourceMonitorService _ResourceMonitorService;\r\n    BulletinBoardService _BulletinBoardService;\r\n    StatisticService _StatisticService;\r\n    AlarmInfoManagerService _AlarmInfoService;\r\n    ISecsGemRuntime _secsRuntime;\r\n    PLCTool _PLCMethod;\r\n\r\n    public void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _ResourceMonitorService = ContainerManager.Resolve\u003cResourceMonitorService\u003e();\r\n        _BulletinBoardService = ContainerManager.Resolve\u003cBulletinBoardService\u003e();\r\n        _StatisticService = ContainerManager.Resolve\u003cStatisticService\u003e();\r\n        _AlarmInfoService = ContainerManager.Resolve\u003cAlarmInfoManagerService\u003e();\r\n        _secsRuntime = ContainerManager.Resolve\u003cISecsGemRuntime\u003e();\r\n        _PLCMethod = ContainerManager.Resolve\u003cPLCTool\u003e();\r\n    }\r\n\r\n    public void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        _ResourceMonitorService.StartAutoRefresh();\r\n\r\n\r\n        DispatcherTimerEx.DispatcherTimer(new Action(Loop), 1000, \"Loop\");\r\n    }\r\n\r\n    private void Loop()\r\n    {\r\n        // 与 ReadCount 共用同一个单例；Resolve 失败不该让整个 Loop 崩掉。\r\n        CapacityStatisticsService statistics = null;\r\n        try { statistics = ContainerManager.Resolve\u003cCapacityStatisticsService\u003e(); }\r\n        catch (Exception ex) { Console.WriteLine(\"产能统计服务不可用：\" + ex.Message); return; }\r\n        var now = DateTime.Now;\r\n\r\n        if (now.Minute % 2 == 0 \u0026\u0026 now.Second == 0) // 5分钟读一次\r\n        {\r\n            // 更新每天统计信息：读真实产能数据。\r\n            // 原先这里推的是硬编码占位值（OK={10} / NG={20,20,30,40,130,20,0} /\r\n            // Total={120,120,130,140,230,120,0}），看板上显示的一直是假数字。\r\n            // 必须自己 try/catch：异常冒到定时器回调里会打断整个 Loop，\r\n            // 而数据库不可用是现场常见状态，不该因此崩掉。\r\n            try\r\n            {\r\n                ReadCount(DateTime.Today, DateTime.Now, _BulletinBoardService.ShowData_Day);\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                // 保留看板上一次的数据，不用占位值盖回去。\r\n                Console.WriteLine(\"读取日产能统计失败：\" + ex.Message);\r\n            }\r\n        }\r\n        else if (now.Hour == 0)\r\n        {\r\n            // 更新每月统计信息\r\n            try\r\n            {\r\n                ReadCount(new DateTime(now.Year, now.Month, 1), now, _BulletinBoardService.ShowData_Month);\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                Console.WriteLine(\"读取月产能统计失败：\" + ex.Message);\r\n            }\r\n        }\r\n\r\n\r\n        // PLC 状态读真实连接状态；断线后自动反映 Offline。\r\n        // 原先这里写死 ELinkStatus.Offline，下面的 if (Online) 分支因此永不执行。\r\n        // 与 AutoProcess.cs:242 同一写法。\r\n        ELinkStatus plcstatus = _PLCMethod.IsOnline ? ELinkStatus.Online : ELinkStatus.Offline;\r\n        if (plcstatus == ELinkStatus.Online)\r\n        {\r\n            //await RefreshSystem();\r\n            RefreshAlarm();\r\n        }\r\n\r\n        // 更新统计信息（在UI线程上执行）\r\n        // 原先写死 \"12345678\"。StatisicsModel.ID 在全部 XAML 里没有任何显示位置（\r\n        // 界面只消费 DateTime/OK/Total/PLCLinkStatus/SecsStatus/SecsMode），\r\n        // 且没有配置项或设备序列号来源 —— 与其继续显示一个编造的值，不如置空。\r\n        _StatisticService.UpdateID(string.Empty);\r\n\r\n        // OK/总数改读真实产能数据（CapacityStatisticsService 的同一份查询结果）。\r\n        // 原先写死 (10, 200)，BulletinBoardView 的 OKCount/TotalCount 绑的就是 StatisicsModel.OK/Total。\r\n        // Model 是单例上的可变状态：Resolve 只拿到实例，不会自动查库。\r\n        // 这里必须自己刷一次，否则上面 UpdateCount/UpdateRunTime 拿的是上一次（甚至从未查询过）的值。\r\n        try\r\n        {\r\n            statistics.Model.StartTime = DateTime.Today;\r\n            statistics.Model.EndTime = DateTime.Now;\r\n            statistics.GetStatistics();\r\n        }\r\n        catch (Exception ex)\r\n        {\r\n            Console.WriteLine(\"刷新头部统计数据失败：\" + ex.Message);\r\n        }\r\n\r\n        _StatisticService.UpdateCount(statistics.Model.GoodCount, statistics.Model.TotalOutput);\r\n        // 运行时长原写死 800。CapacityStatisticsModel 有真实的 RunTime（小时）与 UtilizationRate（%），\r\n        // 取自数据库聚合结果；报警时长仍是 AlarmInfoManagerService.TotalAlarmTime。\r\n        _StatisticService.UpdateRunTime(_AlarmInfoService.TotalAlarmTime, statistics.Model.RunTime);\r\n        var secsState = _secsRuntime.GetState();\r\n        _StatisticService.UpdateSecsMode(secsState.Mode switch\r\n        {\r\n            SecsGemMode.OnlineLocal =\u003e ESecsMode.Online_Local,\r\n            SecsGemMode.OnlineRemote =\u003e ESecsMode.Online_Remote,\r\n            _ =\u003e ESecsMode.Offline\r\n        });\r\n        _StatisticService.UpdatePLC(plcstatus);\r\n        _StatisticService.UpdateSecsStatus(secsState.IsConnected ? ELinkStatus.Online : ELinkStatus.Offline);\r\n        _StatisticService.UpdateTime();\r\n\r\n\r\n        // 在后台线程执行耗时操作\r\n        Task.Run(() =\u003e\r\n        {\r\n            // 每小时检查一次（当分钟为0且秒丼时）\r\n            if (now.Minute / 10 == 0 \u0026\u0026 now.Second == 0)\r\n            {\r\n                ScheduledDeletion.DeleteExpiredFiles(GlobalData.Path_Image, GlobalData.SaveImageDay);\r\n            }\r\n            if (now.Second == 0)\r\n                GC.Collect();\r\n        });\r\n    }\r\n    /// \u003csummary\u003e\r\n    /// 读真实产能数据并推给看板。\r\n    /// \u003cpara\u003e\r\n    /// 用 WPFControls 已有的 \u003cc\u003eCapacityStatisticsService\u003c/c\u003e：它内部的\r\n    /// \u003cc\u003eCapacityStatisticsPresentation.Apply\u003c/c\u003e 产出的正是 \u003cc\u003eOK\u003c/c\u003e / \u003cc\u003eNG\u003c/c\u003e / \u003cc\u003eTotal\u003c/c\u003e\r\n    /// 三条 \u003cc\u003eLineSeries\u003c/c\u003e，且名称与配色（绿/红/蓝）和本看板一致 ——\r\n    /// 这正是这些硬编码数值的来处。所以不必自己去拼 \u003cc\u003eOKCOunt1..24\u003c/c\u003e 那 24 个小时桶。\r\n    /// \u003c/para\u003e\r\n    /// \u003c/summary\u003e\r\n    private void ReadCount(DateTime from, DateTime to,\r\n        Action\u003cList\u003cWPFControls.Controls.Models.Charts.LineSeries\u003e\u003e publish)\r\n    {\r\n        var statistics = ContainerManager.Resolve\u003cCapacityStatisticsService\u003e();\r\n        statistics.Model.StartTime = from;\r\n        statistics.Model.EndTime = to;\r\n        statistics.GetStatistics();          // 同步查库\r\n        publish(statistics.Model.OutputTrend.ToList());\r\n    }\r\n\r\n\r\n    private void RefreshAlarm()\r\n    {\r\n        // 旧实现走 CommunicationManager.GetData(\"Alarm\")，该能力已随旧通信栈删除。\r\n        // 报警读取暂时停用：不伪造数据，待迁移到 Communication.Core 后恢复。\r\n    }\r\n}\r\n"
                    }
                ]
}