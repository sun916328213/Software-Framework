  "Scripts": [
    {
      "Title": "新脚本 1",
      "Code": "using MachineApp.Infra.Tool;\r\nusing MachineApp.Infra.Core;\r\nusing Device.Camera;\r\nusing Device.Light;\r\nusing Device.RFID;\r\nusing Device.Scan;\r\nusing MachineApp.Data;\r\nusing Prism.Ioc;\r\nusing SecsGem.Controls;\nusing SecsGem.Core;\nusing SecsGem.Runtime;\r\nusing WPFControl.Helper;\r\nusing WPFControl.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n     \r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Closed();\r\n    }\r\n\r\n    private static void Closed()\r\n    {\r\n        ContainerManager.Resolve<PrintManagerService>().Close();\r\n\r\n        ContainerManager.Resolve<PLCTool>().StopRefresh();\r\n        ContainerManager.Resolve<SecsControl>().Close();\r\n\r\n        ContainerManager.Resolve<CamManager>().Dispose();\r\n        ContainerManager.Resolve<ScanManager>().Dispose();\r\n        ContainerManager.Resolve<RFIDManager>().Dispose();\r\n\r\n        LightControlManager _LightControlManager = ContainerManager.Resolve<LightControlManager>();\r\n        for (int i = 1; i <= 8; i++)\r\n            _LightControlManager[0].Setlight(0, i);\r\n        _LightControlManager.Dispose();\r\n    }\r\n}",
      "References": []
    }
  ],
  "References": []
}
