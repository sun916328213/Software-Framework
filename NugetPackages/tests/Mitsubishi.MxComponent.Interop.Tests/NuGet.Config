<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 独立验收源：consumer 仅从待验收本地 feed + nuget.org 恢复目标版本。
       保持与 Frame.sln 的 restore 解耦，避免“先有鸡还是先有蛋”循环。
       先 pack 到 ../../.feed，再 restore/build/run 本工程。 -->
  <packageSources>
    <clear />
    <add key="verify-local" value="../../.feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="verify-local">
      <package pattern="Mitsubishi.MxComponent.Interop" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
