<Project Sdk="Microsoft.NET.Sdk">
  <!-- 包消费验证：确认 Mitsubishi.MxComponent.Interop 标准 lib 引用下，
       编译引用生效、且 6 个 dll 作为运行时资产复制到输出目录。
       仅做编译解析 + 输出布局检查；不创建 COM 对象、不要求安装 MX Component、不连接 PLC。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Platform>AnyCPU</Platform>
    <Platforms>AnyCPU</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mitsubishi.MxComponent.Interop" Version="5.0.0-internal.3" />
  </ItemGroup>
</Project>
