<Project Sdk="Microsoft.NET.Sdk">

  <!--
    三菱 PLC MX Component 的 COM Interop 程序集打包项目。
    作用：把 Dll\Mitsubishi\ 下 6 个 RCW 程序集（ActUtlType / ActProg / ActSupportMsg，各含 32 位与 64 位）
    打包为独立 NuGet 包，供各工程通过 PackageReference 引用，替代手工 HintPath 拷贝。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Platform>AnyCPU</Platform>
    <Platforms>AnyCPU</Platforms>

    <!-- 包元数据 -->
    <PackageId>Mitsubishi.MxComponent.Interop</PackageId>
    <!-- 内部包装版本：源 RCW 属于厂商 5.0.0；internal.3 是第三次内部包装修订。详见 README。 -->
    <Version>5.0.0-internal.3</Version>
    <!-- 厂商来源版本（MX Component 产品/RCW 来源版本），与内部包装修订解耦。 -->
    <MxComponentVendorVersion>5.0.0</MxComponentVendorVersion>
    <Authors>sun_lei123</Authors>
    <Company>Software-Framework</Company>
    <Description>
      三菱 PLC MX Component 的 COM Interop 程序集（RCW）打包。
      包含 ActUtlType（数据通信）、ActProg（程序/监控）、ActSupportMsg（支持消息）三组接口，
      每组同时提供 32 位（x86）与 64 位（x64）版本。
      注意：本包仅封装托管 Interop 层，运行机器需安装三菱 MX Component 原生运行时（ActUtlType.dll 等），
      并按进程位数选择对应的 64 位 / 32 位程序集。包内程序集来源于三菱电机，仅供内部项目使用。
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Mitsubishi;MELSEC;PLC;MX;Interop;ActUtlType;ActProg</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- 纯打包：不打入本项目的编译输出，不生成程序集 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 把 Dll\Mitsubishi\ 下的 6 个 dll 作为包内容打进 lib/net9.0/（标准 lib 引用，无自定义 build targets；
       与 Communication 的 net9.0 / AnyCPU 对齐；Windows + 64 位属于运行条件，由消费方运行时守卫负责，见包 README） -->
  <ItemGroup>
    <None Include="..\..\Dll\Mitsubishi\Interop.ActUtlType64Lib.dll" Pack="true" PackagePath="lib/net9.0/" />
    <None Include="..\..\Dll\Mitsubishi\Interop.ActUtlTypeLib.dll" Pack="true" PackagePath="lib/net9.0/" />
    <None Include="..\..\Dll\Mitsubishi\Interop.ActProgType64Lib.dll" Pack="true" PackagePath="lib/net9.0/" />
    <None Include="..\..\Dll\Mitsubishi\Interop.ActProgTypeLib.dll" Pack="true" PackagePath="lib/net9.0/" />
    <None Include="..\..\Dll\Mitsubishi\Interop.ActSupportMsg64Lib.dll" Pack="true" PackagePath="lib/net9.0/" />
    <None Include="..\..\Dll\Mitsubishi\Interop.ActSupportMsgLib.dll" Pack="true" PackagePath="lib/net9.0/" />

    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
