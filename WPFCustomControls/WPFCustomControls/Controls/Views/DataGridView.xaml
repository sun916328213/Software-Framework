<DataGrid
    x:Class="WPFCustomControls.Controls.DataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="dataGrid"
    d:DesignHeight="450"
    d:DesignWidth="800"
    materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
    CanUserAddRows="False"
    EnableColumnVirtualization="True"
    EnableRowVirtualization="True"
    FontFamily="Microsoft YaHei UI"
    HorizontalScrollBarVisibility="Auto"
    RowHeight="{Binding RowHeight, ElementName=dataGrid}"
    ScrollViewer.CanContentScroll="True"
    ScrollViewer.IsDeferredScrollingEnabled="True"
    SelectionMode="Extended"
    Style="{StaticResource MaterialDesignDataGrid}"
    Validation.ErrorTemplate="{x:Null}"
    VerticalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Standard"
    mc:Ignorable="d">

    <!--  列头前景钉 MD 原生动态键：原先写死 Color_Black，深色主题下黑字压黑底不可读  -->
    <DataGrid.ColumnHeaderStyle>
        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.DataGrid.ColumnHeaderForeground}" />
        </Style>
    </DataGrid.ColumnHeaderStyle>

    <DataGrid.Resources>
        <ResourceDictionary>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="{x:Type ScrollBar}" />
        </ResourceDictionary>
    </DataGrid.Resources>

</DataGrid>
