<DataGrid
    x:Class="WPFCustomControls.Controls.DataGridLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="dataGrid"
    Margin="3"
    d:DesignHeight="250"
    d:DesignWidth="400"
    materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
    CanUserAddRows="False"
    EnableColumnVirtualization="False"
    EnableRowVirtualization="True"
    FontFamily="Microsoft YaHei UI"
    HorizontalScrollBarVisibility="Auto"
    ScrollViewer.CanContentScroll="True"
    ScrollViewer.IsDeferredScrollingEnabled="False"
    SelectionMode="Extended"
    SelectionUnit="FullRow"
    Style="{StaticResource MaterialDesignDataGrid}"
    Validation.ErrorTemplate="{x:Null}"
    VerticalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Standard"
    mc:Ignorable="d">

    <DataGrid.Resources>
        <ResourceDictionary>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="{x:Type ScrollBar}" />
        </ResourceDictionary>
    </DataGrid.Resources>

    <!--  列头前景钉 MD 原生动态键：原先写死 Color_Black，深色主题下黑字压黑底不可读  -->
    <DataGrid.ColumnHeaderStyle>
        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.DataGrid.ColumnHeaderForeground}" />
        </Style>
    </DataGrid.ColumnHeaderStyle>

    <DataGrid.RowStyle>
        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource Color_Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource Color_Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="SysError">
                    <Setter Property="Foreground" Value="{StaticResource Color_Purple}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Reset">
                    <Setter Property="Foreground" Value="{StaticResource Color_Green}" />
                </DataTrigger>
            </Style.Triggers>

        </Style>
    </DataGrid.RowStyle>
</DataGrid>
