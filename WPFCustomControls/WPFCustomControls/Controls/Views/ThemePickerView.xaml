<UserControl
    x:Class="WPFCustomControls.Controls.ThemePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WPFCustomControls.ValueConvert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="180"
    d:DesignWidth="240"
    mc:Ignorable="d">

    <!--
        主题选择复用控件：主色 / 辅色下拉框，下面跟一排「浅色 / 深色」分段按钮。
        宿主只需传 Theme（Extension.Core.ThemeEx.ThemeService 单例）：
            <wpfcc:ThemePickerView Theme="{Binding Theme}" />
        只要黑白切换就把 ShowColorPickers 置 false，那时只剩分段按钮（分段按钮不受它影响）。
        换肤逻辑全在 ThemeService 里，本控件不持有任何配色常量。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ThemeColorToBrushConverter x:Key="ThemeColorBrush" />

        <!--  色块描边：深色品牌底上给条半透明白边，免得深色色板（如深紫、棕）糊进背景  -->
        <Style x:Key="SwatchBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--
            左侧字段小标签（主色 / 辅色）。
            LineHeight 必须显式给足：WPF 的行高按「主字体」（Segoe UI，约 1.27em）算，
            而中文会回退到雅黑（行高约 1.32em 且字形下缘更低），
            行盒不够高时中文底部会被切掉 —— 表现为「浅色」看着像被裁了一刀。
        -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!--  小字说明（分段按钮里的「浅色 / 深色」），同样需要显式行高  -->
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <!--  面板容器：半透明白底 + 细描边，深色品牌侧栏上的分组块  -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--
            配色下拉项模板：色块 + 名称。
            ComboBox 收起时走 SelectionBoxItemTemplate（未设则回落 ItemTemplate），
            所以「当前选中色」也自带色块预览 —— 下拉项与当前色共用这一份模板，不会各画各的。
        -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border
                    Width="34"
                    Height="14"
                    VerticalAlignment="Center"
                    Background="{Binding Converter={StaticResource ThemeColorBrush}}"
                    CornerRadius="7"
                    Style="{StaticResource SwatchBorder}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    LineHeight="17"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <!--
            下拉框统一外观。
            必须 BasedOn MD 的轮廓样式：显式 Style 不写 BasedOn 会把隐式 MD 样式整个顶掉，
            退化成 WPF 自带模板（浅灰底 + 浅色文字，在深色侧栏上直接看不见）。
            轮廓样式内部 Background 默认 Transparent、边框走 MD 键，所以底色/描边/前景都就地覆盖。
        -->
        <Style
            x:Key="PickerCombo"
            BasedOn="{StaticResource MaterialDesignOutlinedComboBox}"
            TargetType="ComboBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="ItemTemplate" Value="{StaticResource ColorItemTemplate}" />
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="6" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <!--  弹出层渲染在应用根视觉树上，默认前景不跟随主题，须显式钉 MD 原生动态键  -->
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            分段按钮（浅色 / 深色）。
            自定义模板的 Button 必须显式 Height=Auto / MinHeight=0 / MinWidth=0 / Padding=0：
            MD 的隐式 Button 样式带 MinHeight，会把内容裁掉一截。
            默认 Opacity 0.6 表示「未选中」，选中态由各按钮自己的 DataTrigger 抬到 1 并铺一层底。

            容器底色 / 描边 / 选中态底色 / 选中态前景全部走本控件的依赖属性（默认值 = 深色品牌侧栏配套），
            所以控件放到跟随主题的浅底上时，宿主必须覆盖这几个属性，否则白色半透明在浅底上等于看不见。
        -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <!--
                未选中态前景 = 字段前景。必须写在 Style 里、不能写在按钮上：
                局部值会盖掉 DataTrigger，选中态就换不了色。
                也不能用 ElementName —— Style 有独立命名域，ElementName 在这里解析不到，
                只有 RelativeSource FindAncestor 可靠。
            -->
            <Setter Property="Foreground" Value="{Binding FieldForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter
                                x:Name="Content"
                                Margin="0,5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!--  可选标题：留空则不占位  -->
        <TextBlock
            Margin="0,0,0,6"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="{Binding ElementName=Root, Path=FieldForeground}"
            LineHeight="17"
            LineStackingStrategy="BlockLineHeight"
            Opacity="0.7"
            Text="{Binding ElementName=Root, Path=Caption}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=Root, Path=Caption}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=Root, Path=Caption}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--  ═══ 主色 / 辅色（ShowColorPickers=false 时整块收起）  ═══  -->
        <StackPanel x:Name="ColorPickerPanel" Visibility="{Binding ElementName=Root, Path=ShowColorPickers, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Foreground="{Binding ElementName=Root, Path=FieldForeground}"
                            Style="{StaticResource FieldLabel}"
                            Text="主色" />
                        <ComboBox
                            Grid.Column="1"
                            Background="{Binding ElementName=Root, Path=FieldBackground}"
                            Foreground="{Binding ElementName=Root, Path=FieldForeground}"
                            ItemsSource="{Binding PrimaryColors}"
                            SelectedItem="{Binding SelectedPrimary, Mode=TwoWay}"
                            Style="{StaticResource PickerCombo}"
                            ToolTip="主色（MaterialDesign PrimaryColor）" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Foreground="{Binding ElementName=Root, Path=FieldForeground}"
                            Style="{StaticResource FieldLabel}"
                            Text="辅色" />
                        <ComboBox
                            Grid.Column="1"
                            Background="{Binding ElementName=Root, Path=FieldBackground}"
                            Foreground="{Binding ElementName=Root, Path=FieldForeground}"
                            ItemsSource="{Binding SecondaryColors}"
                            SelectedItem="{Binding SelectedSecondary, Mode=TwoWay}"
                            Style="{StaticResource PickerCombo}"
                            ToolTip="辅色（MaterialDesign SecondaryColor）" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  ═══ 浅色 / 深色：分段按钮，当前态高亮；不受 ShowColorPickers 影响  ═══  -->
        <Border
            Padding="4"
            Background="{Binding ElementName=Root, Path=SegmentBackground}"
            BorderBrush="{Binding ElementName=Root, Path=SegmentBorder}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="LightThemeButton"
                    Grid.Column="0"
                    Command="{Binding SetLightThemeCommand}"
                    ToolTip="切到浅色主题">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SegmentButton}" TargetType="Button">
                            <Style.Triggers>
                                <!--  未选中时保持 0.6 的默认透明度，选中时抬满并铺选中底  -->
                                <DataTrigger Binding="{Binding IsDark}" Value="False">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="Background" Value="{Binding SegmentSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
                                    <Setter Property="Foreground" Value="{Binding SegmentSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
                                </DataTrigger>
                                <!--
                                    选中态前景留空（null）时回落字段前景。
                                    必须声明在选中触发器之后：两个触发器同时命中时后者胜。
                                -->
                                <DataTrigger Binding="{Binding SegmentSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="{Binding FieldForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Kind="WeatherSunny" />
                        <TextBlock
                            Margin="6,0,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="浅色" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="DarkThemeButton"
                    Grid.Column="1"
                    Command="{Binding SetDarkThemeCommand}"
                    ToolTip="切到深色主题">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SegmentButton}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="Background" Value="{Binding SegmentSelectedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
                                    <Setter Property="Foreground" Value="{Binding SegmentSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
                                </DataTrigger>
                                <!--  同左：选中态前景留空时回落字段前景，须排在选中触发器之后  -->
                                <DataTrigger Binding="{Binding SegmentSelectedForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="{Binding FieldForeground, RelativeSource={RelativeSource AncestorType={x:Type local:ThemePickerView}}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Kind="WeatherNight" />
                        <TextBlock
                            Margin="6,0,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="深色" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
