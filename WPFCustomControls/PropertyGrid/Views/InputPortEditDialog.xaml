<Window
    x:Class="WPFCustomControls.PropertyGrid.Views.InputPortEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WPFCustomControls.ValueConvert"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="360"
    Height="420"
    Background="Transparent"
    FontSize="14"
    Style="{DynamicResource DialogWindowStyle}"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Border
        Padding="20"
        Background="{StaticResource Color_White}"
        BorderBrush="{StaticResource MaterialDesign.Brush.Primary}"
        BorderThickness="2"
        CornerRadius="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
        <Border.Resources>
            <conv:BoolInverseConverter x:Key="PG_InverseBool" />
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                FontSize="15"
                FontWeight="Medium"
                Text="选择端口类型：" />

            <!--  选项1：绑定上游数据  -->
            <RadioButton
                x:Name="rbUpstreamData"
                Grid.Row="1"
                Margin="0,0,0,8"
                Content="绑定上游数据（连接上游输出端口）"
                IsChecked="{Binding IsUpstreamData}" />

            <StackPanel
                Grid.Row="2"
                Margin="20,0,0,8"
                IsEnabled="{Binding IsChecked, ElementName=rbUpstreamData}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="{StaticResource Color_Gray10}"
                        Text="输入端口名称" />
                    <TextBox
                        Height="28"
                        Margin="0,0,0,10"
                        VerticalContentAlignment="Center"
                        Text="{Binding CurrentPortName}"
                        IsEnabled="{Binding IsModifyMode, Converter={StaticResource PG_InverseBool}}"
                        ToolTip="请输入输入端口名称">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource MaterialDesignTextBox}" TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModifyMode}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11"
                    Foreground="{StaticResource Color_Gray10}"
                    Text="选择上游节点" />
                <ComboBox
                    Height="28"
                    Margin="0,0,0,10"
                    ItemsSource="{Binding UpstreamNodes}"
                    DisplayMemberPath="NodeName"
                    SelectedItem="{Binding SelectedUpstreamNode}" />
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11"
                    Foreground="{StaticResource Color_Gray10}"
                    Text="选择上游输出端口" />
                <ComboBox
                    Height="28"
                    ItemsSource="{Binding UpstreamPorts}"
                    SelectedItem="{Binding SelectedUpstreamPort}" />
            </StackPanel>

            <!--  选项2：自定义端口  -->
            <RadioButton
                x:Name="rbCustomName"
                Grid.Row="3"
                Margin="0,0,0,8"
                Content="自定义端口（不绑定属性）"
                IsChecked="{Binding IsUpstreamData, Converter={StaticResource PG_InverseBool}}" />

            <TextBox
                Grid.Row="4"
                Height="28"
                Margin="20,0,0,0"
                VerticalContentAlignment="Center"
                Text="{Binding CustomPortName}"
                IsEnabled="{Binding IsChecked, ElementName=rbCustomName}"
                ToolTip="请输入端口名称" />

            <StackPanel
                Grid.Row="5"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="32"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.8"
                            Text="取消" />
                    </StackPanel>
                </Button>
                <Button
                    Width="100"
                    Height="32"
                    Margin="10,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Cursor="Hand"
                    Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Check" />
                        <TextBlock VerticalAlignment="Center" Text="确认" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>