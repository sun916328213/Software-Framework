<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WPFCustomControls.ValueConvert"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:svc="clr-namespace:WPFCustomControls.PropertyGrid.Services"
    xmlns:vm="clr-namespace:WPFCustomControls.PropertyGrid.ViewModels">

    <BooleanToVisibilityConverter x:Key="PG_BoolToVis" />
    <conv:BoolInverseConverter x:Key="PG_InverseBool" />
    <conv:BoolInverseToVisibilityConverter x:Key="PG_InverseBoolToVis" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="PG_StringNotEmptyToVis" />
    <conv:IntZeroToVisibilityConverter x:Key="PG_CountToVis" />

    <Style
        x:Key="TextBoxStyle"
        BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}"
        TargetType="{x:Type TextBox}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="0,4,6,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Color_Gray11}" />
    </Style>

    <Style
        x:Key="LabelStyle"
        BasedOn="{StaticResource MaterialDesignTextBlock}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource Color_Gray11}" />
    </Style>

    <Style
        x:Key="TitleStyle"
        BasedOn="{StaticResource MaterialDesignTextBlock}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Color_Black}" />
    </Style>

    <Style
        x:Key="ComboBoxStyle"
        BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}"
        TargetType="ComboBox">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,4,6,4" />
        <Setter Property="Foreground" Value="{StaticResource Color_Gray11}" />
    </Style>

    <Style BasedOn="{StaticResource MaterialDesignCheckBox}" TargetType="CheckBox" />
    <Style BasedOn="{StaticResource MaterialDesignOutlinedButton}" TargetType="Button">
        <Setter Property="Margin" Value="8,4" />
    </Style>

    <Style TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <DataTemplate x:Key="PG_PortRowTemplate">
        <Border
            Margin="8,2,8,2"
            Padding="4,3,4,3"
            Background="{StaticResource Color_Gray1}"
            BorderBrush="{StaticResource Color_Gray9}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  第1列：端口名称/属性选择  -->
                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <!--  显示端口名称（已绑定的输入端口 或 有绑定属性的输出端口）  -->
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        ToolTip="端口名称">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAsTextBlock}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--  未绑定的自定义输入端口：可编辑名称  -->
                    <TextBox
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="11"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="自定义端口名称">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAsTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!--  未绑定属性的输出端口：选择绑定属性  -->
                    <ComboBox
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="11"
                        ItemsSource="{Binding AvailableProperties}"
                        SelectedItem="{Binding BoundPropertyName, Mode=TwoWay}"
                        ToolTip="选择绑定的工具属性">
                        <ComboBox.Style>
                            <Style BasedOn="{StaticResource ComboBoxStyle}" TargetType="ComboBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAsComboBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>

                <!--  第2列：端口当前数据值（主要为输出端口展示运行时数据）  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource Color_Gray11}"
                        Text="{Binding ValueText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="该端口当前数据值">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <!--  仅输出端口展示数据（输入端口显示绑定状态）  -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInputPort}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--  第3列：绑定状态或未绑定提示  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  已绑定状态  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="9"
                        Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                        Text="{Binding BindingStatusText}"
                        ToolTip="绑定状态"
                        Visibility="{Binding IsBound, Converter={StaticResource PG_BoolToVis}}" />
                    <!--  未绑定提示（输入端口或未绑定属性的输出端口显示）  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="9"
                        Foreground="{StaticResource Color_Gray11}"
                        Text="未绑定"
                        ToolTip="点击绑定上游工具属性">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <!--  输入端口未绑定  -->
                                    <DataTrigger Binding="{Binding IsUnbound}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--  第4列：绑定/修改/解除绑定按钮  -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <!--  绑定按钮（未绑定输入端口显示）  -->
                    <Button
                        Width="20"
                        Height="20"
                        Margin="0,0,2,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding BindCommand}"
                        Cursor="Hand"
                        ToolTip="绑定上游工具属性">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBound}" Value="False" />
                                            <Condition Binding="{Binding IsInputPort}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Foreground="{StaticResource Color_Green}" Kind="Link" />
                    </Button>

                    <!--  修改绑定按钮（已绑定显示）  -->
                    <Button
                        Width="20"
                        Height="20"
                        Margin="0,0,2,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ModifyBindingCommand}"
                        Cursor="Hand"
                        ToolTip="修改绑定"
                        Visibility="{Binding IsBound, Converter={StaticResource PG_BoolToVis}}">
                        <materialDesign:PackIcon Foreground="{StaticResource MaterialDesign.Brush.Primary}" Kind="Pencil" />
                    </Button>

                    <!--  解除绑定按钮（已绑定显示）  -->
                    <Button
                        Width="20"
                        Height="20"
                        Margin="0,0,4,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding UnbindCommand}"
                        Cursor="Hand"
                        ToolTip="解除绑定"
                        Visibility="{Binding IsBound, Converter={StaticResource PG_BoolToVis}}">
                        <materialDesign:PackIcon Foreground="{StaticResource Color_Red}" Kind="LinkOff" />
                    </Button>
                </StackPanel>

                <!--  第5列：删除按钮  -->
                <Button
                    Grid.Column="4"
                    Width="20"
                    Height="20"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DeleteCommand}"
                    Cursor="Hand"
                    FontSize="11"
                    Foreground="{StaticResource Color_Red}"
                    ToolTip="删除此端口">
                    <materialDesign:PackIcon Kind="Delete" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PG_PortManagementTemplate" DataType="vm:PortManagementViewModel">
        <Border
            Margin="4"
            Background="{StaticResource Color_White}"
            BorderBrush="{StaticResource Color_Gray9}"
            BorderThickness="1.5"
            CornerRadius="6"
            RenderOptions.BitmapScalingMode="HighQuality">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="12,8,12,8"
                    Background="{StaticResource Color_Gray2}"
                    CornerRadius="5,5,0,0">
                    <TextBlock Style="{StaticResource TitleStyle}" Text="自定义端口" />
                </Border>
                <StackPanel Grid.Row="1" Margin="0,4,0,4">
                    <Border
                        Margin="8,4,8,2"
                        Padding="8,3,8,3"
                        Background="{StaticResource Color_Gray2}"
                        CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                                Text="▶ 输入端口" />
                            <Button
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ToggleInputLockCommand}"
                                Cursor="Hand">
                                <Grid>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                                        Kind="LockOpen">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInputLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="{StaticResource Color_Gray10}"
                                        Kind="Lock">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInputLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="ToolTip" Value="点击锁定，禁止修改输入端口" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInputLocked}" Value="True">
                                                <Setter Property="ToolTip" Value="点击解锁输入端口" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl ItemTemplate="{StaticResource PG_PortRowTemplate}" ItemsSource="{Binding InputPorts}" />
                    <Button
                        materialDesign:ButtonAssist.CornerRadius="4"
                        Command="{Binding AddInputPortCommand}"
                        Content="+ 添加输入端口"
                        Cursor="Hand"
                        IsEnabled="{Binding IsInputLocked, Converter={StaticResource PG_InverseBool}}" />
                    <Border
                        Margin="8,8,8,2"
                        Padding="8,3,8,3"
                        Background="{StaticResource Color_Gray2}"
                        CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MaterialDesign.Brush.Secondary}"
                                Text="▶ 输出端口" />
                            <Button
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ToggleOutputLockCommand}"
                                Cursor="Hand">
                                <Grid>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="{StaticResource MaterialDesign.Brush.Secondary}"
                                        Kind="LockOpen">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutputLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="{StaticResource Color_Gray10}"
                                        Kind="Lock">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutputLocked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="ToolTip" Value="点击锁定，禁止修改输出端口" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutputLocked}" Value="True">
                                                <Setter Property="ToolTip" Value="点击解锁输出端口" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl ItemTemplate="{StaticResource PG_PortRowTemplate}" ItemsSource="{Binding OutputPorts}" />
                    <Button
                        BorderBrush="{StaticResource MaterialDesign.Brush.Secondary}"
                        Command="{Binding AddOutputPortCommand}"
                        Content="+ 添加输出端口"
                        Cursor="Hand"
                        Foreground="{StaticResource MaterialDesign.Brush.Secondary}"
                        IsEnabled="{Binding IsOutputLocked, Converter={StaticResource PG_InverseBool}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PG_TextEditorTemplate">
        <Grid Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource LabelStyle}"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="3,0,0,0"
                    Text="ⓘ"
                    ToolTip="{Binding Description}"
                    Visibility="{Binding Description, Converter={StaticResource PG_StringNotEmptyToVis}}" />
            </StackPanel>
            <TextBox
                Grid.Column="1"
                IsReadOnly="{Binding IsReadOnly}"
                Style="{StaticResource TextBoxStyle}"
                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="2"
                IsChecked="{Binding IsInputPort}"
                ToolTip="启用输入端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
            <CheckBox
                Grid.Column="3"
                IsChecked="{Binding IsOutputPort}"
                ToolTip="启用输出端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PG_BoolEditorTemplate">
        <Grid Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource LabelStyle}"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="3,0,0,0"
                    Text="ⓘ"
                    ToolTip="{Binding Description}"
                    Visibility="{Binding Description, Converter={StaticResource PG_StringNotEmptyToVis}}" />
            </StackPanel>
            <CheckBox
                Grid.Column="1"
                HorizontalAlignment="Center"
                IsChecked="{Binding Value, Mode=TwoWay}"
                IsEnabled="{Binding IsEditable}"
                IsThreeState="{Binding IsNullable}" />
            <CheckBox
                Grid.Column="2"
                IsChecked="{Binding IsInputPort}"
                ToolTip="启用输入端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
            <CheckBox
                Grid.Column="3"
                IsChecked="{Binding IsOutputPort}"
                ToolTip="启用输出端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PG_EnumEditorTemplate">
        <Grid Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource LabelStyle}"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="3,0,0,0"
                    Text="ⓘ"
                    ToolTip="{Binding Description}"
                    Visibility="{Binding Description, Converter={StaticResource PG_StringNotEmptyToVis}}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                DisplayMemberPath="DisplayName"
                IsEnabled="{Binding IsEditable}"
                ItemsSource="{Binding EnumOptions}"
                SelectedValue="{Binding Value, Mode=TwoWay}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxStyle}" />
            <CheckBox
                Grid.Column="2"
                IsChecked="{Binding IsInputPort}"
                ToolTip="启用输入端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
            <CheckBox
                Grid.Column="3"
                IsChecked="{Binding IsOutputPort}"
                ToolTip="启用输出端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PG_NumericEditorTemplate">
        <Grid Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource LabelStyle}"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="3,0,0,0"
                    Text="ⓘ"
                    ToolTip="{Binding Description}"
                    Visibility="{Binding Description, Converter={StaticResource PG_StringNotEmptyToVis}}" />
            </StackPanel>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    IsReadOnly="{Binding IsReadOnly}"
                    Style="{StaticResource TextBoxStyle}"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <StackPanel Grid.Column="1" Margin="2,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button
                        Width="12"
                        Height="12"
                        Margin="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding IncrementCommand}"
                        Cursor="Hand"
                        ToolTip="加一步">
                        <materialDesign:PackIcon
                            Width="12"
                            Height="12"
                            Kind="ChevronUp" />
                    </Button>
                    <Button
                        Width="12"
                        Height="12"
                        Margin="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DecrementCommand}"
                        Cursor="Hand"
                        ToolTip="减一步">
                        <materialDesign:PackIcon
                            Width="12"
                            Height="12"
                            Kind="ChevronDown" />
                    </Button>
                </StackPanel>
            </Grid>
            <CheckBox
                Grid.Column="2"
                IsChecked="{Binding IsInputPort}"
                ToolTip="启用输入端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
            <CheckBox
                Grid.Column="3"
                IsChecked="{Binding IsOutputPort}"
                ToolTip="启用输出端口"
                Visibility="{Binding IsPortConfigurable, Converter={StaticResource PG_BoolToVis}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PG_CollectionEditorTemplate">
        <StackPanel Margin="8,4,8,4">
            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="3,0,0,0"
                    Text="ⓘ"
                    ToolTip="{Binding Description}"
                    Visibility="{Binding Description, Converter={StaticResource PG_StringNotEmptyToVis}}" />
                <Border
                    Margin="6,0,0,0"
                    Padding="6,1,6,1"
                    VerticalAlignment="Center"
                    Background="{StaticResource Color_Gray2}"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                        Text="{Binding CollectionCount, StringFormat='{}{0} 项'}" />
                </Border>
            </StackPanel>
            <Border
                Padding="4,2,4,2"
                Background="{StaticResource Color_Gray1}"
                BorderBrush="{StaticResource Color_Gray9}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <ItemsControl ItemsSource="{Binding CollectionSource}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,2,6,2" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" FontSize="11">
                                            <TextBlock.Text>
                                                <PriorityBinding>
                                                    <Binding Path="DisplayName" />
                                                    <Binding Path="Name" />
                                                </PriorityBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="2"
                                        Padding="6,3,6,3"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="{StaticResource Color_Gray9}"
                                        BorderThickness="1"
                                        FontSize="11"
                                        Text="{Binding Value, Mode=TwoWay, FallbackValue=''}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="6,4"
                        FontSize="11"
                        Foreground="{StaticResource Color_Gray10}"
                        Text="(空)"
                        Visibility="{Binding CollectionCount, Converter={StaticResource PG_CountToVis}}" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

        <svc:PropertyEditorSelector
        x:Key="PG_PropertyEditorSelector"
        BoolTemplate="{StaticResource PG_BoolEditorTemplate}"
        CollectionTemplate="{StaticResource PG_CollectionEditorTemplate}"
        EnumTemplate="{StaticResource PG_EnumEditorTemplate}"
        NumericTemplate="{StaticResource PG_NumericEditorTemplate}"
        TextTemplate="{StaticResource PG_TextEditorTemplate}" />

    <DataTemplate x:Key="PG_GroupTemplate" DataType="vm:PropertyGroupViewModel">
        <Border
            Margin="4"
            Background="{StaticResource Color_White}"
            BorderBrush="{StaticResource Color_Gray9}"
            BorderThickness="1.5"
            CornerRadius="6"
            RenderOptions.BitmapScalingMode="HighQuality">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="12,8,12,8"
                    Background="{StaticResource Color_Gray2}"
                    CornerRadius="5,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource TitleStyle}"
                            Text="{Binding GroupName}" />
                        <Border
                            Grid.Column="1"
                            Padding="6,1,6,1"
                            VerticalAlignment="Center"
                            Background="{StaticResource Color_Gray2}"
                            CornerRadius="8">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                                Text="{Binding ItemCount, StringFormat='{}{0} 项'}" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Padding="0,2,0,2">
                    <ItemsControl ItemTemplateSelector="{StaticResource PG_PropertyEditorSelector}" ItemsSource="{Binding Items}" />
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
