<Window
    x:Class="WPFCustomControls.Window.Views.NameInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="380"
    Height="200"
    Background="Transparent"
    Style="{DynamicResource DialogWindowStyle}"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFCustomControls;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Padding="20"
        Background="{StaticResource Color_White}"
        BorderBrush="{StaticResource MaterialDesign.Brush.Primary}"
        BorderThickness="2"
        CornerRadius="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,14"
                Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                    Kind="RenameOutline" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                    Text="{Binding Title}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                Opacity="0.8"
                Text="{Binding Description}"
                TextWrapping="Wrap" />

            <Border
                Grid.Row="2"
                Margin="0,0,0,2"
                Background="Transparent"
                BorderBrush="{StaticResource MaterialDesign.Brush.Primary.Light}"
                SnapsToDevicePixels="True">
                <Grid>
                    <materialDesign:HintAssist.Hint>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding Placeholder}" />
                    </materialDesign:HintAssist.Hint>
                    <TextBox
                        x:Name="InputBox"
                        Height="34"
                        KeyDown="InputBox_OnKeyDown"
                        Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <StackPanel
                Grid.Row="4"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="32"
                    Click="OnCancelClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.8"
                            Text="取消" />
                    </StackPanel>
                </Button>
                <Button
                    Width="100"
                    Height="32"
                    Margin="10,0,0,0"
                    Click="OnConfirmClick"
                    Cursor="Hand"
                    Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Check" />
                        <TextBlock VerticalAlignment="Center" Text="确认" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
