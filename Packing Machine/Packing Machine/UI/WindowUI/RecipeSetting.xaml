<Window
    x:Class="Packing_Machine.UI.WindowUI.RecipeSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Packing_Machine.UI.WindowUI"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Packing_Machine.UI.ViewModel"
    Title="RecipeSetting"
    Width="380"
    Height="450"
    d:DataContext="{d:DesignInstance Type=viewmodel:RecipeViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--<i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>-->




    <Window.Resources>
        <Style
            x:Key="LabelStyle"
            BasedOn="{StaticResource MaterialDesignLabel}"
            TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Width" Value="100" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal">
            <Label Content="ID:" Style="{StaticResource LabelStyle}" />
            <TextBox
                x:Name="txt_ID"
                Width="150"
                Text="{Binding CurRecipe.ID, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Orientation="Horizontal">
            <Label Content="FOSB名称:" Style="{StaticResource LabelStyle}" />
            <ComboBox
                Width="{Binding ElementName=txt_ID, Path=Width}"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding FOSBType}"
                SelectedItem="{Binding CurRecipe.FOSBType}" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Orientation="Horizontal">
            <Label Content="FOSB标签方向:" Style="{StaticResource LabelStyle}" />
            <ComboBox
                x:Name="cmb_Fosb"
                Width="{Binding ElementName=txt_ID, Path=Width}"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding CurRecipeLabelDir_First}"
                SelectedIndex="0" />
            <Button
                Width="30"
                Margin="3"
                Padding="0"
                Command="{Binding LabelManger_Add}"
                CommandParameter="1">
                <Button.Content>
                    <materialDesign:PackIcon
                        Width="30"
                        Height="30"
                        Kind="Plus" />
                </Button.Content>
            </Button>
            <Button
                Width="30"
                Margin="3"
                Padding="0">
                <Button.Content>
                    <materialDesign:PackIcon
                        Width="30"
                        Height="30"
                        Kind="Minus" />
                </Button.Content>
            </Button>
        </StackPanel>
     
        <StackPanel
            Grid.Row="4"
            Grid.Column="1"
            Orientation="Horizontal">
            <Label Content="AL标签方向:" Style="{StaticResource LabelStyle}" />
            <ComboBox
                x:Name="cmb_AL"
                Width="{Binding ElementName=txt_ID, Path=Width}"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding CurRecipeLabelDir_Second}"
                SelectedIndex="0" />
            <Button
                Width="30"
                Margin="3"
                Padding="0"
                Command="{Binding LabelManger_Add}"
                CommandParameter="2">
                <Button.Content>
                    <materialDesign:PackIcon
                        Width="30"
                        Height="30"
                        Kind="Plus" />
                </Button.Content>
            </Button>
            <Button
                Width="30"
                Margin="3"
                Padding="0">
                <Button.Content>
                    <materialDesign:PackIcon
                        Width="30"
                        Height="30"
                        Kind="Minus" />
                </Button.Content>
            </Button>
        </StackPanel>
     
        <Grid Grid.Row="6" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Margin="3,3,10,3"
                Click="Button_Click"
                Content="确认" />
            <Button
                Grid.Column="1"
                Margin="10,3,3,3"
                Click="Button_Click_1"
                Content="取消" />
        </Grid>

    </Grid>
</Window>
