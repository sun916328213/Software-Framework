<UserControl
    x:Class="Packing_Machine.UI.View.VisionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctr="clr-namespace:Vision.Controls.Ctr_Halcon.View;assembly=Vision.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Packing_Machine.UI.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodel="clr-namespace:Packing_Machine.UI.ViewModel"
    d:DesignHeight="850"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" TabStripPlacement="Right">
            <!--<TabItem Header="条码">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">

                    <ctr:Ctr_HVisionTool_DP
                        Title="条码"
                        Margin="8"
                        HTool="{Binding Datas.BarcodeReader_Auto}" />

                </Border>
            </TabItem>-->

            <TabItem Header="条码">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">

                    <ctr:Ctr_HVisionTool_DP
                        Title="条码"
                        Margin="8"
                        HTool="{Binding Datas.BarcodeReader}" />

                </Border>
            </TabItem>

            <TabItem Header="二维码">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="二维码"
                        Margin="8"
                        HTool="{Binding Datas.BarcodeReader_2D}" />
                </Border>
            </TabItem>
            <TabItem Header="湿度卡A匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="湿度卡A匹配"
                        Margin="8"
                        HTool="{Binding Datas.TemplateMatch_HumidityCardA, Mode=TwoWay}" />
                </Border>
            </TabItem>
            <TabItem Header="湿度卡B匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="湿度卡B匹配"
                        Margin="8"
                        HTool="{Binding Datas.TemplateMatch_HumidityCardB, Mode=TwoWay}" />
                </Border>
            </TabItem>
            <TabItem Header="干燥剂匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="干燥剂匹配"
                        Margin="8"
                        HTool="{Binding Datas.TemplateMatch_Accessory}" />
                </Border>
            </TabItem>
            <TabItem Header="铝塑袋定位左侧">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="铝塑袋定位左侧"
                        Margin="8"
                        HTool="{Binding Datas.BagPattern_Left}" />
                </Border>
            </TabItem>
            <TabItem Header="铝塑袋定位右侧">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="铝塑袋定位右侧"
                        Margin="8"
                        HTool="{Binding Datas.BagPattern_Right}" />
                </Border>
            </TabItem>
            <TabItem Header="封口检测">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="封口检测"
                        Margin="8"
                        HTool="{Binding Datas.AITool}" />
                </Border>
            </TabItem>
            <TabItem Header="九点标定模版匹配">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="九点标定模版匹配"
                        Margin="8"
                        HTool="{Binding Datas.TemplateMatch_Caliber}" />
                </Border>
            </TabItem>
            <TabItem Header="多点标定">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="多点标定"
                        Margin="8"
                        HTool="{Binding Datas.HTool_NPoints}" />
                </Border>
            </TabItem>
            <TabItem Header="仿射变换">
                <Border DockPanel.Dock="Top" Style="{StaticResource Border_Style}">
                    <ctr:Ctr_HVisionTool_DP
                        Title="仿射变换"
                        Margin="8"
                        HTool="{Binding Datas.HTool_TransforPoint}" />
                </Border>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
