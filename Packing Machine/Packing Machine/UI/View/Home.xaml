<UserControl
    x:Class="Packing_Machine.UI.View.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bulletinboard="clr-namespace:WPFControl.CustomControl.Views.BulletinBoard;assembly=WPFControl"
    xmlns:control="clr-namespace:WPFControl.ProgramControl.Views;assembly=WPFControl"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views;assembly=WPFControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Packing_Machine.UI.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <ContentControl
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            prism:RegionManager.RegionName="DisplayRegion1" />

        <ContentControl
            Grid.Row="0"
            Grid.Column="1"
            prism:RegionManager.RegionName="DisplayRegion2" />

        <ContentControl
            Grid.Row="1"
            Grid.Column="1"
            prism:RegionManager.RegionName="DisplayRegion3" />

    </Grid>
</UserControl>