<UserControl
    x:Class="Packing_Machine.UI.View.Recipe"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Packing_Machine.UI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:viewmodel="clr-namespace:Packing_Machine.UI.ViewModel"
    x:Name="UserControl"
    d:DesignHeight="950"
    d:DesignWidth="1200"
    mc:Ignorable="d">


    <UserControl.Resources>

        <Style
            x:Key="LabelStyle"
            BasedOn="{StaticResource MaterialDesignLabel}"
            TargetType="Label">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="ButtonStyle"
            BasedOn="{StaticResource MaterialDesignRaisedButton}"
            TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
        </Style>

        <Style
            x:Key="DatePickerStyle"
            BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}"
            TargetType="DatePicker">
            <Setter Property="Width" Value="180" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SelectedDateFormat" Value="Long" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>


    <DockPanel>

        <Border
            Height="70"
            HorizontalAlignment="Left"
            DockPanel.Dock="Top"
            Style="{StaticResource Border_Style}">
            <Grid Margin="12,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="120"
                    Command="{Binding AddCommand}"
                    Content="Add"
                    Style="{StaticResource ButtonStyle}" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="120"
                    Command="{Binding ModifyCommand}"
                    Content="Modify"
                    Style="{StaticResource ButtonStyle}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="120"
                    Command="{Binding SaveCommand}"
                    Content=" Save"
                    Style="{StaticResource ButtonStyle}" />

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="3"
                    Width="120"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Label Content="ID:" Style="{StaticResource LabelStyle}" />
                    <Label Content="{Binding CurRecipe.ID}" Style="{StaticResource LabelStyle}" />
                </StackPanel>

                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    Width="120"
                    Command="{Binding SettingCommand}"
                    Content=" 设置"
                    Style="{StaticResource ButtonStyle}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="5"
                    Width="120"
                    Command="{Binding UpdateCommand}"
                    Content=" 更新"
                    Style="{StaticResource ButtonStyle}" />
            </Grid>
        </Border>


        <Border Style="{StaticResource Border_Style}">
            <view:DataGridView
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutoGenerateColumns="False"
                Background="{StaticResource Color_White}"
                FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas}"
                SelectedIndex="{Binding SelectIndex}"
                SelectedItem="{Binding CurRecipe}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ID}" Header="ID" />
                    <DataGridTextColumn Binding="{Binding FOSBType}" Header="FOSBName" />
                    <DataGridTemplateColumn Header="FOSB LabelInfo">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl Margin="10,0,0,0" ItemsSource="{Binding LabelInfoCollection.LabelInfo_First}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Width="60" Text="{Binding LabelDir, StringFormat={}{0}}" />
                                                <TextBlock Text="{Binding LabelNum}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="AL LabelInfo">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl Margin="10,0,0,0" ItemsSource="{Binding LabelInfoCollection.LabelInfo_Second}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Width="60" Text="{Binding LabelDir, StringFormat={}{0}}" />
                                                <TextBlock Text="{Binding LabelNum}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </view:DataGridView>
        </Border>
    </DockPanel>

</UserControl>