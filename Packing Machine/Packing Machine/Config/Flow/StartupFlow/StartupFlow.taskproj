{
  "Name": "新建任务",
  "Scripts": [
    {
      "Title": "初始化控件",
      "Code": "using Extension.Core.SystemEx;\r\nusing Extension.Struct;\r\nusing MaterialDesignThemes.Wpf;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Infra.Core;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing Secs;\r\nusing System.Collections.ObjectModel;\r\nusing WPFControl.CustomControl.Models;\r\nusing WPFControl.ProgramControl.Models;\r\nusing WPFControl.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n\r\n    private  ControlService _ControlService;\r\n    private  StatisticService _StatisticService;\r\n    private  WindowMenuService _WindowMenuService;\r\n    private  MenuService _MenuService;\r\n\r\n    private  IRegionManager _IRegionManager;\r\n    private  DialogService _DialogService;\r\n\r\n    private  SecsControl _SecsControl;\r\n    public  void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _ControlService = ContainerManager.Resolve<ControlService>();\r\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\r\n        _WindowMenuService = ContainerManager.Resolve<WindowMenuService>();\r\n        _MenuService = ContainerManager.Resolve<MenuService>();\r\n\r\n        _IRegionManager = ContainerManager.Resolve<IRegionManager>();\r\n        _DialogService = ContainerManager.Resolve<DialogService>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n    }\r\n\r\n    public  void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Init_Menu();\r\n        Init_Control();\r\n        Init_Display();\r\n    }\r\n\r\n    #region 控件\r\n    private  void Init_Control()\r\n    {\r\n        //控制按钮功能\r\n        _ControlService.AddAction(new List<Action>\r\n        {\r\n        async ()  =>\r\n             {\r\n             \r\n                 //_StatisticService.UpdateDeviceStatus(EDeviceStatus.Ready);\r\n                 //_ = _SecsControl._ConnectManager.Online_EtoH();\r\n             },\r\n         () =>\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Running);\r\n                 _ = _SecsControl._ConnectManager.Offline_EtoH();\r\n             },\r\n         () =>\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Idle);\r\n             },\r\n\r\n         () =>\r\n             {\r\n                 _WindowMenuService.CloseApplication();\r\n             }\r\n        });\r\n    }\r\n\r\n    private  void Init_Display()\r\n    {\r\n        var _DisplayService = ContainerManager.Resolve<DisplayService>();\r\n\r\n        _DisplayService.Clear();\r\n        _DisplayService.SetRowCol(2, 3);\r\n\r\n        _DisplayService.AddDisplayTitle(\"1\");\r\n        _DisplayService.AddDisplayTitle(\"2\");\r\n        _DisplayService.AddDisplayTitle(\"3\");\r\n        _DisplayService.AddDisplayTitle(\"4\");\r\n        _DisplayService.AddDisplayTitle(\"5\");\r\n        _DisplayService.AddDisplayTitle(\"6\");\r\n    }\r\n\r\n    private  void Init_Menu()\r\n    {\r\n        _MenuService.Clear();\r\n        _MenuService.AddRange(new List<CNavigationItem>\r\n     {\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.主页.GetMessage(),\r\n             SelectedIcon = PackIconKind.Home,\r\n             Icon = PackIconKind.HomeOutline,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Home\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = \"Test\",\r\n             Icon = PackIconKind.TestTube,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Test\");\r\n             })\r\n         },\r\n        new CNavigationItem\r\n         {\r\n             Title = \"Test\",\r\n             Icon = PackIconKind.TestTube,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogConfigView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.配方.GetMessage(),\r\n             SelectedIcon = PackIconKind.ReceiptTextEdit,\r\n             Icon = PackIconKind.ReceiptTextEditOutline,\r\n             //Userlevel= EUserLevel.Admin,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Recipe\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.打印设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Printer,\r\n             Icon = PackIconKind.PrinterOutline,\r\n             Action = (() =>\r\n             {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"PrintManagerView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.视觉查看.GetMessage(),\r\n             SelectedIcon = PackIconKind.Video,\r\n             Icon = PackIconKind.VideoOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DisplayView\"); }),\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.流程.GetMessage(),\r\n             SelectedIcon = PackIconKind.ListBox,\r\n             Icon = PackIconKind.ListBoxOutline,\r\n             Children = new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"加载流程\" ,\r\n                     Icon = PackIconKind.DownloadBoxOutline,\r\n                     Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"StartupFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.初始化流程.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Refresh,\r\n                     Icon = PackIconKind.Refresh,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"InitializeFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.自动流程.GetMessage(),\r\n                   \r\n                     Icon = PackIconKind.RepeatVariant,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AutoFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.关闭流程.GetMessage(),\r\n                    \r\n                     Icon = PackIconKind.CloseThick,\r\n                      Userlevel= EUserLevel.SuperAdmin,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ShutdownFlowView\"); })\r\n                 },\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title =Message.检测项设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.PencilRuler,\r\n             Icon = PackIconKind.PencilRulerOutline,\r\n\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.视觉设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.PencilBoxMultiple,\r\n                      Icon = PackIconKind.PencilBoxMultipleOutline,\r\n                     Action = (() =>\r\n                     {\r\n                         _IRegionManager.RequestNavigate(\"MainContentRegion\", \"VisionView\");\r\n                     })\r\n                 }\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.硬件设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Cog ,\r\n             Icon = PackIconKind.CogOutline,\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Cam设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Camera,\r\n                     Icon = PackIconKind.CameraOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CamManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.RFID设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CastConnected,\r\n                     Icon = PackIconKind.Cast,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"RFIDManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"扫码枪设置\",\r\n                     Icon = PackIconKind.Barcode,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ScanManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"光源控制器设置\",\r\n                     Icon = PackIconKind.CarLightDimmed,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LightControlManagerView\"); })\r\n                 },\r\n\r\n             }\r\n         },\r\n\r\n           new CNavigationItem\r\n         {\r\n             Title = \"查询\",\r\n             SelectedIcon = PackIconKind.DatabaseSearch,\r\n             Icon = PackIconKind.DatabaseSearchOutline,\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Log查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.NoteSearch,\r\n                     Icon = PackIconKind.NoteSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.SEMILog查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CloudSearch,\r\n                     Icon = PackIconKind.CloudSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMILogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.数据查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.TextBoxSearch,\r\n                     Icon = PackIconKind.TextBoxSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DataQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"产能查询\",\r\n                      \r\n                     Icon = PackIconKind.EqualizerOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CapacityStatisticsView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.图像查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.ImageSearch,\r\n                     Icon = PackIconKind.ImageSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ImageQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.报警查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.AlarmLight,\r\n                     Icon = PackIconKind.AlarmLightOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoQueryView\"); })\r\n                 },\r\n             }\r\n         },\r\n\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户登录.GetMessage(),\r\n             SelectedIcon = PackIconKind.User,\r\n             Icon = PackIconKind.UserOutline,\r\n             Action = () => { _DialogService.ShowDialog(\"UserInfoView\"); },\r\n             ItemType = NavigationItemType.UserLogin // 设置菜单项类型为用户登录\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户信息管理.GetMessage(),\r\n             SelectedIcon = PackIconKind.AccountKey,\r\n             Icon = PackIconKind.AccountKeyOutline,\r\n             Action = () => { _IRegionManager.RequestNavigate(\"MainContentRegion\",\"UserInfoManagerView\"); },\r\n             Userlevel= EUserLevel.Admin,\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.SEMI设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.ConsoleNetwork,\r\n             Icon = PackIconKind.ConsoleNetworkOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMIManagerView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.报警设置.GetMessage(),\r\n              Userlevel= EUserLevel.SuperAdmin,\r\n             SelectedIcon = PackIconKind.BellCog,\r\n             Icon = PackIconKind.BellCogOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoManagerView\"); })\r\n         },\r\n     });\r\n    }\r\n    #endregion\r\n}",
      "References": []
    },
    {
      "Title": "初始化工具",
      "Code": "using Communication;\r\nusing Communication.MC;\r\nusing DataManager.Log;\r\nusing DataManager.Log.Definition;\r\nusing DataManager.SQL;\r\nusing DataManager.SQL.Definition;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Infra.Core;\r\nusing Packing_Machine.Infra.Tool;\r\nusing Packing_Machine.UI.Model;\r\nusing Secs;\r\nusing WPFControl.ProgramControl.Models;\r\nusing WPFControl.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n\r\n    private static CommunicationManager _CommunicationManager;\r\n    private static MCHelper _MCHelper;\r\n    private static PLCTool _PLCMethod;\r\n    private static SecsControl _SecsControl;\r\n\r\n\r\n    private static AlarmInfoManagerService _AlarmInfoService;\r\n\r\n    private static LogManager _LogManager;\r\n    private static SQLManager _SQLManager;\r\n\r\n\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _MCHelper = ContainerManager.Resolve<MCHelper>();\r\n        _CommunicationManager = ContainerManager.Resolve<CommunicationManager>();\r\n        _PLCMethod = ContainerManager.Resolve<PLCTool>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n\r\n\r\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\r\n\r\n\r\n        _LogManager = ContainerManager.Resolve<LogManager>();\r\n        _SQLManager = ContainerManager.Resolve<SQLManager>();\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Init_Tool();\r\n    }\r\n\r\n    private static void Init_Tool()\r\n    {\r\n        GlobalData.Load();\r\n\r\n        Console.WriteLine(\"初始化Log日志\");\r\n        //日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = GlobalData.LogPath,\r\n            Name = \"Log\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化SMEI日志\");\r\n        //SEMI日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = GlobalData.LogPath,\r\n            Name = \"SEMILog\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create<CSQLData>(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"test1\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[0].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n        \r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create<CapacityStatisticsInfo>(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"产能数据库\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[1].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n    }\r\n}",
      "References": []
    },
    {
      "Title": "初始化通讯",
      "Code": "using Communication;\r\nusing Communication.MC;\r\nusing Extension.Core.CompareEx;\r\nusing Extension.Core.ConvertEx;\r\nusing Extension.Core.FileEx;\r\nusing Packing_Machine.Business.Order;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Infra.Core;\r\nusing Packing_Machine.Infra.Tool;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing Secs;\r\nusing WPFControl.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n\r\n    private static CommunicationManager _CommunicationManager;\r\n    private static MCHelper _MCHelper;\r\n    private static PLCTool _PLCMethod;\r\n    private static SecsControl _SecsControl;\r\n\r\n\r\n    private static AlarmInfoManagerService _AlarmInfoService;\r\n\r\n\r\n    private static ControlService _ControlService;\r\n    private static StatisticService _StatisticService;\r\n    private static WindowMenuService _WindowMenuService;\r\n    private static MenuService _MenuService;\r\n\r\n    private static IRegionManager _IRegionManager;\r\n    private static DialogService _DialogService;\r\n\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _MCHelper = ContainerManager.Resolve<MCHelper>();\r\n        _CommunicationManager = ContainerManager.Resolve<CommunicationManager>();\r\n        _PLCMethod = ContainerManager.Resolve<PLCTool>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n\r\n\r\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\r\n\r\n        _ControlService = ContainerManager.Resolve<ControlService>();\r\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\r\n        _WindowMenuService = ContainerManager.Resolve<WindowMenuService>();\r\n        _MenuService = ContainerManager.Resolve<MenuService>();\r\n\r\n        _IRegionManager = ContainerManager.Resolve<IRegionManager>();\r\n        _DialogService = ContainerManager.Resolve<DialogService>();\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Init_PLC();\r\n//        Init_SEMI();\r\n    }\r\n\r\n\r\n    #region 通讯\r\n    private static void Init_PLC()\r\n    {\r\n        var d = CSVEx.ReadCsv<CRegisterInfo>(GlobalData.PLCPath);\r\n\r\n        List<CRegisterInfo> registerInfos = new List<CRegisterInfo>();\r\n        foreach (var item in d)\r\n        {\r\n            if (item.Name?.ToLower().Contains(\"_trigger\") == true)\r\n            {\r\n                var add = Convert.ToInt32(item.Address.ReplaceLetter());\r\n                var let = item.Address.ReplaceNum();\r\n                registerInfos.Add(item);\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Reply), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Result), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Function), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Count), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.CountReply), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.ID), Type = EDataType.String, Length = 20 });\r\n            }\r\n            else\r\n            {\r\n                registerInfos.Add(item);\r\n            }\r\n        }\r\n        var d1 = _MCHelper.Connect(1);\r\n        if (!d1) throw new Exception(\"PLC connect fail\");\r\n        _CommunicationManager.LoadConfig(registerInfos);\r\n        _PLCMethod.CompleteAll(PLCSystem.PLC_SysTrigger, PLCSystem.PLC_SysTrigger, 1000);\r\n    }\r\n\r\n    private static void Init_SEMI()\r\n    {\r\n        _SecsControl.Config();\r\n        var d = _SecsControl.Connect(false, \"127.0.0.1\", 5000);\r\n\r\n        var alarm = _AlarmInfoService.GetAlarms().Select(x => new Secs.Variable.AlarmInfo { ID = x.ID.ToString(), Description = x.Info_EN, Enable = true }).ToList();\r\n        _SecsControl._VIDManager.AddAlarm(alarm);\r\n        _SecsControl._StatusManager.Config(VIDOrder.DeviceStatus, VIDOrder.DeviceMode, EventOrder.Device_Status, EventOrder.Device_Mode);\r\n        _SecsControl._StatusManager.StartMonitoringAsync().ConfigureAwait(false);\r\n        _SecsControl._ConnectManager.WaitOnlineAndOfflineAsync().ConfigureAwait(false);\r\n    }\r\n    #endregion\r\n\r\n\r\n}",
      "References": []
    },
    {
      "Title": "初始化硬件",
      "Code": "using Communication;\r\nusing Communication.MC;\r\nusing Extension.Core.CompareEx;\r\nusing Extension.Core.ConvertEx;\r\nusing Extension.Core.FileEx;\r\nusing Packing_Machine.Business.Order;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Infra.Core;\r\nusing Packing_Machine.Infra.Tool;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing Secs;\r\nusing WPFControl.ProgramControl.Services;\r\n\r\npublic class Script\r\n{\r\n    CamManager _CamManager;\r\n    CamManagerService _CamManagerService;\r\n\r\n    LightControlManager _LightControlManager;\r\n    LightControlManagerService _LightControlManagerService;\r\n\r\n    ScanManager _ScanManager;\r\n    ScanManagerService _ScanManagerService;\r\n\r\n    RFIDManager _RFIDManager;\r\n    RFIDManagerService _RFIDManagerService;\r\n\r\n    public void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _CamManager = ContainerManager.Resolve<CamManager>();\r\n        _CamManagerService = ContainerManager.Resolve<CamManagerService>();\r\n\r\n        _LightControlManager = ContainerManager.Resolve<LightControlManager>();\r\n        _LightControlManagerService = ContainerManager.Resolve<LightControlManagerService>();\r\n\r\n        _ScanManager = ContainerManager.Resolve<ScanManager>();\r\n        _ScanManagerService = ContainerManager.Resolve<ScanManagerService>();\r\n\r\n        _RFIDManager = ContainerManager.Resolve<RFIDManager>();\r\n        _RFIDManagerService = ContainerManager.Resolve<RFIDManagerService>();\r\n    }\r\n\r\n    public void Run()\r\n    {\r\n        _CamManager.Config(_CamManagerService.Model.DataCollection.ToList());\r\n        Console.WriteLine(\"相机加载成功\");\r\n        _CamManager.Connect();\r\n        Console.WriteLine(\"相机连接成功\");\r\n\r\n        _LightControlManager.Config(_LightControlManagerService.Model.DataCollection.ToList());\r\n        Console.WriteLine(\"光源控制器加载成功\");\r\n        _LightControlManager.Connect();\r\n        Console.WriteLine(\"光源控制器连接成功\");\r\n        for (int index = 0; index < _LightControlManager.Count; index++)\r\n        {\r\n            for (int i = 1; i <= 8; i++)\r\n                _LightControlManager[index].Setlight(0, i);\r\n        }\r\n\r\n        _ScanManager.Config(_ScanManagerService.Model.DataCollection.ToList());\r\n        Console.WriteLine(\"扫码枪加载成功\");\r\n        _ScanManager.Connect();\r\n        Console.WriteLine(\"扫码枪连接成功\");\r\n\r\n        _RFIDManager.Config(_RFIDManagerService.Model.DataCollection.ToList());\r\n        Console.WriteLine(\"RFID加载成功\");\r\n        _RFIDManager.Connect();\r\n        Console.WriteLine(\"RFID连接成功\");\r\n    }\r\n}",
      "References": []
    },
    {
      "Title": "初始化后台",
      "Code": "using Extension.Core.SystemEx;\nusing Extension.Struct;\nusing MaterialDesignThemes.Wpf;\nusing Packing_Machine.Data;\nusing Packing_Machine.Infra.Core;\nusing Prism.Regions;\nusing Prism.Services.Dialogs;\nusing Secs;\nusing System.Collections.ObjectModel;\nusing WPFControl.CustomControl.Models;\nusing WPFControl.ProgramControl.Models;\nusing WPFControl.ProgramControl.Services;\n\npublic class Script\n{\n    private static ResourceMonitorService _ResourceMonitorService;\n    \n    private static CommunicationManager _CommunicationManager;\n    \n    public static void Initialize()\n    {\n        // 初始化逻辑\n        _ResourceMonitorService = ContainerManager.Resolve<ResourceMonitorService>();\n        _CommunicationManager = ContainerManager.Resolve<CommunicationManager>();\n        _BulletinBoardService = ContainerManager.Resolve<BulletinBoardService>();\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\n        _MCHelper = ContainerManager.Resolve<MCHelper>();\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\n    }\n\n    public static void Run()\n    {\n        Console.WriteLine(\"开始执行脚本\");\n        _ResourceMonitorService.StartAutoRefresh();\n        _CommunicationManager.SetReadTask(\"Data\", \"D8000\", 1000,  Extension.Core.CompareEx.EComparePolarity.None);\n        _CommunicationManager.StartLoop();\n    }\n}",
      "References": []
    }
