{
  "Name": "新建任务",
  "Scripts": [
    {
      "Title": "初始化控件",
      "Code": "using WPFControl.ProgramControl.Services;\r\nusing WPFControl.CustomControl.Views.Display;\r\nusing WPFControl.ProgramControl.Models;\r\nusing WPFControl.CustomControl.Models;\r\nusing Packing_Machine.Infra.Tool;\r\nusing Packing_Machine.Infra.Core;\r\nusing Communication;\r\nusing Communication.MC;\r\nusing Extension.Core.ControlEx;\r\nusing Extension.Core.ConvertEx;\r\nusing Extension.Core.FileEx;\r\nusing Extension.Core.SystemEx;\r\nusing Extension.Struct;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Data.Model;\r\nusing Packing_Machine.Business.Order;\r\nusing Packing_Machine.UI.ViewModel;\r\nusing Secs;\r\nusing MaterialDesignThemes.Wpf;\r\nusing Prism.Ioc;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing System.Collections.ObjectModel;\r\npublic class Script\r\n{\r\n\r\n    private static ControlService _ControlService;\r\n    private static StatisticService _StatisticService;\r\n    private static WindowMenuService _WindowMenuService;\r\n    private static MenuService _MenuService;\r\n\r\n    private static IRegionManager _IRegionManager;\r\n    private static DialogService _DialogService;\r\n\r\n    private static SecsControl _SecsControl;\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _ControlService = ContainerManager.Resolve<ControlService>();\r\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\r\n        _WindowMenuService = ContainerManager.Resolve<WindowMenuService>();\r\n        _MenuService = ContainerManager.Resolve<MenuService>();\r\n\r\n        _IRegionManager = ContainerManager.Resolve<IRegionManager>();\r\n        _DialogService = ContainerManager.Resolve<DialogService>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Init_Menu();\r\n        Init_Control();\r\n        Init_Display();\r\n    }\r\n\r\n    #region 控件\r\n    private static void Init_Control()\r\n    {\r\n        //控制按钮功能\r\n        _ControlService.AddAction(new List<Action>\r\n        {\r\n        async ()  =>\r\n             {\r\n             \r\n                 //_StatisticService.UpdateDeviceStatus(EDeviceStatus.Ready);\r\n                 //_ = _SecsControl._ConnectManager.Online_EtoH();\r\n             },\r\n         () =>\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Running);\r\n                 _ = _SecsControl._ConnectManager.Offline_EtoH();\r\n             },\r\n         () =>\r\n             {\r\n                 _StatisticService.UpdateDeviceStatus(EDeviceStatus.Idle);\r\n             },\r\n\r\n         () =>\r\n             {\r\n                 _WindowMenuService.CloseApplication();\r\n             }\r\n        });\r\n    }\r\n\r\n    private static void Init_Display()\r\n    {\r\n        var _DisplayService = ContainerManager.Resolve<DisplayService>();\r\n\r\n        _DisplayService.Clear();\r\n        _DisplayService.SetRowCol(2, 3);\r\n\r\n        _DisplayService.AddDisplayTitle(\"1\");\r\n        _DisplayService.AddDisplayTitle(\"2\");\r\n        _DisplayService.AddDisplayTitle(\"3\");\r\n        _DisplayService.AddDisplayTitle(\"4\");\r\n        _DisplayService.AddDisplayTitle(\"5\");\r\n        _DisplayService.AddDisplayTitle(\"6\");\r\n    }\r\n\r\n    private static void Init_Menu()\r\n    {\r\n        _MenuService.Clear();\r\n        _MenuService.AddRange(new List<CNavigationItem>\r\n     {\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.主页.GetMessage(),\r\n             SelectedIcon = PackIconKind.Home,\r\n             UnselectedIcon = PackIconKind.HomeOutline,\r\n             Action = (() => {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Home\");\r\n             })\r\n         },\r\n\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.配方.GetMessage(),\r\n             SelectedIcon = PackIconKind.ReceiptTextEdit,\r\n             UnselectedIcon = PackIconKind.ReceiptTextEditOutline,\r\n             //Userlevel= EUserLevel.Admin,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"Recipe\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.打印设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Printer,\r\n             UnselectedIcon = PackIconKind.PrinterOutline,\r\n             Action = (() =>\r\n             {\r\n                 _IRegionManager.RequestNavigate(\"MainContentRegion\", \"PrintManagerView\");\r\n             })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.视觉查看.GetMessage(),\r\n             SelectedIcon = PackIconKind.Video,\r\n             UnselectedIcon = PackIconKind.VideoOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DisplayView\"); }),\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.Cam设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Camera,\r\n             UnselectedIcon = PackIconKind.CameraOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CamManagerView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.流程.GetMessage(),\r\n             SelectedIcon = PackIconKind.ListBox,\r\n             UnselectedIcon = PackIconKind.ListBoxOutline,\r\n             Children = new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"加载流程\" ,\r\n                     SelectedIcon = PackIconKind.Download,\r\n                     UnselectedIcon = PackIconKind.Download,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"StartupFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.初始化流程.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Refresh,\r\n                     UnselectedIcon = PackIconKind.Refresh,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"InitializeFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.自动流程.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Autorenew,\r\n                     UnselectedIcon = PackIconKind.Autorenew,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AutoFlowView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.关闭流程.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Power,\r\n                     UnselectedIcon = PackIconKind.Power,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ShutdownFlowView\"); })\r\n                 },\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title =Message.检测项设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.PencilRuler,\r\n             UnselectedIcon = PackIconKind.PencilRulerOutline,\r\n\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title =Message.检测项设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CameraWireless,\r\n                     UnselectedIcon = PackIconKind.CameraWirelessOutline,\r\n                     Action = (() =>\r\n                     {\r\n                         _IRegionManager.RequestNavigate(\"MainContentRegion\", \"VisionSettingView\");\r\n                     }),\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.视觉设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.PencilBoxMultiple,\r\n                     UnselectedIcon = PackIconKind.PencilBoxMultipleOutline,\r\n                     Action = (() =>\r\n                     {\r\n                         _IRegionManager.RequestNavigate(\"MainContentRegion\", \"VisionView\");\r\n                     })\r\n                 }\r\n             }\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.硬件设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.Cog ,\r\n             UnselectedIcon = PackIconKind.CogOutline,\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Cam设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.Camera,\r\n                     UnselectedIcon = PackIconKind.CameraOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"CamManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.RFID设置.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CastConnected,\r\n                     UnselectedIcon = PackIconKind.Cast,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"RFIDManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"扫码枪设置\",\r\n                     SelectedIcon = PackIconKind.CodeBraces,\r\n                     UnselectedIcon = PackIconKind.CodeBracesBox,\r\n\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ScanManagerView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = \"光源控制器设置\",\r\n                     SelectedIcon = PackIconKind.CodeBraces,\r\n                     UnselectedIcon = PackIconKind.CodeBracesBox,\r\n\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LightControlManagerView\"); })\r\n                 },\r\n                \r\n             }\r\n         },\r\n\r\n           new CNavigationItem\r\n         {\r\n             Title = Message.数据查询.GetMessage(),\r\n             SelectedIcon = PackIconKind.DatabaseSearch,\r\n             UnselectedIcon = PackIconKind.DatabaseSearchOutline,\r\n             Children=new ObservableCollection<CNavigationItem>\r\n             {\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.Log查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.NoteSearch,\r\n                     UnselectedIcon = PackIconKind.NoteSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"LogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.SEMILog查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.CloudSearch,\r\n                     UnselectedIcon = PackIconKind.CloudSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMILogQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.数据查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.TextBoxSearch,\r\n                     UnselectedIcon = PackIconKind.TextBoxSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"DataQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.图像查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.ImageSearch,\r\n                     UnselectedIcon = PackIconKind.ImageSearchOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"ImageQueryView\"); })\r\n                 },\r\n                 new CNavigationItem\r\n                 {\r\n                     Title = Message.报警查询.GetMessage(),\r\n                     SelectedIcon = PackIconKind.AlarmLight,\r\n                     UnselectedIcon = PackIconKind.AlarmLightOutline,\r\n                     Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoQueryView\"); })\r\n                 },\r\n             }\r\n         },\r\n\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户登录.GetMessage(),\r\n             SelectedIcon = PackIconKind.User,\r\n             UnselectedIcon = PackIconKind.UserOutline,\r\n             Action = () => { _DialogService.ShowDialog(\"UserInfoView\"); },\r\n             ItemType = NavigationItemType.UserLogin // 设置菜单项类型为用户登录\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.用户信息管理.GetMessage(),\r\n             SelectedIcon = PackIconKind.AccountKey,\r\n             UnselectedIcon = PackIconKind.AccountKeyOutline,\r\n             Action = () => { _IRegionManager.RequestNavigate(\"MainContentRegion\",\"UserInfoManagerView\"); },\r\n             Userlevel= EUserLevel.Admin,\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.SEMI设置.GetMessage(),\r\n             SelectedIcon = PackIconKind.ConsoleNetwork,\r\n             UnselectedIcon = PackIconKind.ConsoleNetworkOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"SEMIManagerView\"); })\r\n         },\r\n         new CNavigationItem\r\n         {\r\n             Title = Message.报警设置.GetMessage(),\r\n              Userlevel= EUserLevel.SuperAdmin,\r\n             SelectedIcon = PackIconKind.BellCog,\r\n             UnselectedIcon = PackIconKind.BellCogOutline,\r\n             Action = (() => { _IRegionManager.RequestNavigate(\"MainContentRegion\", \"AlarmInfoView\"); })\r\n         },\r\n     });\r\n    }\r\n    #endregion\r\n}",
      "References": []
    },
    {
      "Title": "初始化工具",
      "Code": "using WPFControl.ProgramControl.Services;\r\nusing WPFControl.CustomControl.Views.Display;\r\nusing WPFControl.ProgramControl.Models;\r\nusing WPFControl.CustomControl.Models;\r\nusing Packing_Machine.Infra.Tool;\r\nusing Packing_Machine.Infra.Core;\r\nusing Communication;\r\nusing Communication.MC;\r\nusing Extension.Core.ControlEx;\r\nusing Extension.Core.ConvertEx;\r\nusing Extension.Core.FileEx;\r\nusing Extension.Core.SystemEx;\r\nusing Extension.Struct;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Data.Model;\r\nusing Packing_Machine.Business.Order;\r\nusing Packing_Machine.UI.ViewModel;\r\nusing Secs;\r\nusing MaterialDesignThemes.Wpf;\r\nusing Prism.Ioc;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing System.Collections.ObjectModel;\r\nusing DataManager.Log;\r\nusing DataManager.Log.Definition;\r\nusing DataManager.SQL;\r\nusing DataManager.SQL.Definition;\r\n\r\npublic class Script\r\n{\r\n\r\n    private static CommunicationManager _CommunicationManager;\r\n    private static MCHelper _MCHelper;\r\n    private static PLCTool _PLCMethod;\r\n    private static SecsControl _SecsControl;\r\n\r\n\r\n    private static AlarmInfoManagerService _AlarmInfoService;\r\n\r\n    private static LogManager _LogManager;\r\n    private static SQLManager _SQLManager;\r\n\r\n\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _MCHelper = ContainerManager.Resolve<MCHelper>();\r\n        _CommunicationManager = ContainerManager.Resolve<CommunicationManager>();\r\n        _PLCMethod = ContainerManager.Resolve<PLCTool>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n\r\n\r\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\r\n\r\n\r\n        _LogManager = ContainerManager.Resolve<LogManager>();\r\n        _SQLManager = ContainerManager.Resolve<SQLManager>();\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Init_Tool();\r\n    }\r\n\r\n    private static void Init_Tool()\r\n    {\r\n        GlobalData.Load();\r\n\r\n        Console.WriteLine(\"初始化Log日志\");\r\n        //日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = GlobalData.LogPath,\r\n            Name = \"Log\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化SMEI日志\");\r\n        //SEMI日志\r\n        _LogManager.Create(new LogParam()\r\n        {\r\n            FilePath = GlobalData.SecsLogPath,\r\n            Name = \"SEMILog\",\r\n            Separator = \"||\",\r\n            SaveDays = 180,\r\n            LogType = ELogType.SeriLog\r\n        });\r\n\r\n        Console.WriteLine(\"初始化数据库\");\r\n        _SQLManager.Create<CSQLData>(new SQLParam()\r\n        {\r\n            ServerIP = \"localhost\",\r\n            Port = \"5432\",\r\n            UserName = \"postgres\",\r\n            Password = \"123\",\r\n            DBName = \"test1\",\r\n            DBType = ESQLType.PostgreSQL,\r\n            ToolType = ESQLToolType.EFCore,\r\n        });\r\n\r\n        Console.WriteLine(\"连接数据库\");\r\n        //连接数据库\r\n        _SQLManager[0].Connect();\r\n        Console.WriteLine(\"连接数据库成功\");\r\n    }\r\n}",
      "References": []
    },
    {
      "Title": "初始化通讯",
      "Code": "using WPFControl.ProgramControl.Services;\r\nusing WPFControl.CustomControl.Views.Display;\r\nusing WPFControl.ProgramControl.Models;\r\nusing WPFControl.CustomControl.Models;\r\nusing Packing_Machine.Infra.Tool;\r\nusing Packing_Machine.Infra.Core;\r\nusing Communication;\r\nusing Communication.MC;\r\nusing Extension.Core.ControlEx;\r\nusing Extension.Core.ConvertEx;\r\nusing Extension.Core.FileEx;\r\nusing Extension.Core.SystemEx;\r\nusing Extension.Struct;\r\nusing Packing_Machine.Data;\r\nusing Packing_Machine.Data.Model;\r\nusing Packing_Machine.Business.Order;\r\nusing Packing_Machine.UI.ViewModel;\r\nusing Secs;\r\nusing MaterialDesignThemes.Wpf;\r\nusing Prism.Ioc;\r\nusing Prism.Regions;\r\nusing Prism.Services.Dialogs;\r\nusing System.Collections.ObjectModel;\r\n\r\npublic class Script\r\n{\r\n\r\n    private static CommunicationManager _CommunicationManager;\r\n    private static MCHelper _MCHelper;\r\n    private static PLCTool _PLCMethod;\r\n    private static SecsControl _SecsControl;\r\n\r\n\r\n    private static AlarmInfoManagerService _AlarmInfoService;\r\n\r\n\r\n    private static ControlService _ControlService;\r\n    private static StatisticService _StatisticService;\r\n    private static WindowMenuService _WindowMenuService;\r\n    private static MenuService _MenuService;\r\n\r\n    private static IRegionManager _IRegionManager;\r\n    private static DialogService _DialogService;\r\n\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n        _MCHelper = ContainerManager.Resolve<MCHelper>();\r\n        _CommunicationManager = ContainerManager.Resolve<CommunicationManager>();\r\n        _PLCMethod = ContainerManager.Resolve<PLCTool>();\r\n\r\n        _SecsControl = ContainerManager.Resolve<SecsControl>();\r\n\r\n\r\n        _AlarmInfoService = ContainerManager.Resolve<AlarmInfoManagerService>();\r\n\r\n        _ControlService = ContainerManager.Resolve<ControlService>();\r\n        _StatisticService = ContainerManager.Resolve<StatisticService>();\r\n        _WindowMenuService = ContainerManager.Resolve<WindowMenuService>();\r\n        _MenuService = ContainerManager.Resolve<MenuService>();\r\n\r\n        _IRegionManager = ContainerManager.Resolve<IRegionManager>();\r\n        _DialogService = ContainerManager.Resolve<DialogService>();\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n        Init_PLC();\r\n//        Init_SEMI();\r\n    }\r\n\r\n\r\n    #region 通讯\r\n    private static void Init_PLC()\r\n    {\r\n        var d = CSVEx.ReadCsv<CRegisterInfo>(GlobalData.PLCPath);\r\n\r\n        List<CRegisterInfo> registerInfos = new List<CRegisterInfo>();\r\n        foreach (var item in d)\r\n        {\r\n            if (item.Name?.ToLower().Contains(\"_trigger\") == true)\r\n            {\r\n                var add = Convert.ToInt32(item.Address.ReplaceLetter());\r\n                var let = item.Address.ReplaceNum();\r\n                registerInfos.Add(item);\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Reply), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Result), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Function), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.Count), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.CountReply), Type = EDataType.Short });\r\n                registerInfos.Add(new CRegisterInfo() { Address = let + Convert.ToInt32(add + PLCAddressOffest.ID), Type = EDataType.String, Length = 20 });\r\n            }\r\n            else\r\n            {\r\n                registerInfos.Add(item);\r\n            }\r\n        }\r\n        var d1 = _MCHelper.Connect(1);\r\n        if (!d1) throw new Exception(\"PLC connect fail\");\r\n        _CommunicationManager.LoadConfig(registerInfos);\r\n        _PLCMethod.CompleteAll(PLCSystem.PLC_SysTrigger, PLCSystem.PLC_SysTrigger, 1000);\r\n    }\r\n\r\n    private static void Init_SEMI()\r\n    {\r\n        _SecsControl.Config();\r\n        var d = _SecsControl.Connect(false, \"127.0.0.1\", 5000);\r\n\r\n        var alarm = _AlarmInfoService.GetAlarms().Select(x => new Secs.Variable.AlarmInfo { ID = x.ID.ToString(), Description = x.Info_EN, Enable = true }).ToList();\r\n        _SecsControl._VIDManager.AddAlarm(alarm);\r\n        _SecsControl._StatusManager.Config(VIDOrder.DeviceStatus, VIDOrder.DeviceMode, EventOrder.Device_Status, EventOrder.Device_Mode);\r\n        _SecsControl._StatusManager.StartMonitoringAsync().ConfigureAwait(false);\r\n        _SecsControl._ConnectManager.WaitOnlineAndOfflineAsync().ConfigureAwait(false);\r\n    }\r\n    #endregion\r\n\r\n\r\n}",
      "References": []
    },
    {
      "Title": "初始化硬件",
      "Code": "\r\npublic class Script\r\n{\r\n    public static void Initialize()\r\n    {\r\n        // 初始化逻辑\r\n    }\r\n\r\n    public static void Run()\r\n    {\r\n        Console.WriteLine(\"开始执行脚本\");\r\n    }\r\n}",
      "References": []
    },
    {
      "Title": "初始化后台",
      "Code": "using WPFControl.ProgramControl.Services;\nusing Packing_Machine.Infra.Tool;\r\nusing Packing_Machine.Infra.Core;\nusing Communication;\nusing Communication.MC;\n\npublic class Script\n{\n    private static ResourceMonitorService _ResourceMonitorService;\n    \n    private static CommunicationManager _CommunicationManager;\n    \n    public static void Initialize()\n    {\n        // 初始化逻辑\n        _ResourceMonitorService = ContainerManager.Resolve<ResourceMonitorService>();\n        _CommunicationManager = ContainerManager.Resolve<CommunicationManager>();\n    }\n\n    public static void Run()\n    {\n        Console.WriteLine(\"开始执行脚本\");\n        _ResourceMonitorService.StartAutoRefresh();\n        _CommunicationManager.SetReadTask(\"Data\", \"D8000\", 1000,  Extension.Core.CompareEx.EComparePolarity.None);\n        _CommunicationManager.StartLoop();\n    }\n}",
      "References": []
    }
  ],
  "References": []
}