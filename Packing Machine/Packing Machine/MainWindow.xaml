<base:BaseMainWindow
    x:Class="Packing_Machine.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assist="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:base="clr-namespace:WPFControl.WindowUI;assembly=WPFControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border Background="{DynamicResource Color_Gray5}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题栏区域  -->
            <ContentControl
                Grid.Row="0"
                Margin="-1"
                prism:RegionManager.RegionName="WindowMenuRegion" />

            <!--  主内容区域  -->
            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                <!--  左侧菜单  -->
                <ContentControl
                    Margin="-5,0,0,-5"
                    prism:RegionManager.RegionName="MenuRegion"
                    DockPanel.Dock="Left"
                    PreviewMouseDoubleClick="DockPanel_PreviewMouseLeftButtonDown" />

                <!--  右侧内容  -->
                <Grid DockPanel.Dock="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <!--  顶部状态栏  -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0" prism:RegionManager.RegionName="IconRegion" />
                        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="StatisticsRegion" />
                        <ContentControl
                            Grid.Column="2"
                            Margin="0,0,-5,0"
                            prism:RegionManager.RegionName="ControlRegion" />
                    </Grid>

                    <!--  主内容  -->
                    <ContentControl
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,0,-5,-5"
                        prism:RegionManager.RegionName="MainContentRegion" />
                </Grid>
            </DockPanel>
        </Grid>
    </Border>

</base:BaseMainWindow>

