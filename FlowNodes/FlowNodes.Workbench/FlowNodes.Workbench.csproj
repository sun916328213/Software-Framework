<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- P6：项目统一 AnyCPU；厂商 SDK 位数限制改由 Device.Runtime 在运行时检查。 -->
    <Platform>AnyCPU</Platform>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>FlowNodes.Workbench</RootNamespace>
    <AssemblyName>FlowNodes.Workbench</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Device\Device.Core\Device.Core.csproj" />
    <ProjectReference Include="..\..\Device\Device.Runtime\Device.Runtime.csproj" />
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\FlowEditor\FlowEditor\FlowEditor.csproj" />
    <ProjectReference Include="..\..\ScriptEditor\ScriptEditor\ScriptEditor.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
    <ProjectReference Include="..\FlowNodes\FlowNodes.csproj" />
  </ItemGroup>

</Project>
