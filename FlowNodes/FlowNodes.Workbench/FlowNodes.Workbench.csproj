<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 解决方案平台保持 AnyCPU；Device.Drivers 带来的厂商 SDK 只有 64 位，
         因此这里单独指定最终进程为 x64，避免真实相机测试时加载原生 DLL 失败。 -->
    <Platform>AnyCPU</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>FlowNodes.Workbench</RootNamespace>
    <AssemblyName>FlowNodes.Workbench</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Communication\CommunicationNew\CommunicationNew.csproj" />
    <ProjectReference Include="..\..\DataManager\DataManager\DataManager.csproj" />
    <ProjectReference Include="..\..\Device\Device.Core\Device.Core.csproj" />
    <ProjectReference Include="..\..\Device\Device.Drivers\Device.Drivers.csproj" />
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\FlowEditor\FlowEditor\FlowEditor.csproj" />
    <ProjectReference Include="..\..\ScriptEditor\ScriptEditor\ScriptEditor.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
    <ProjectReference Include="..\FlowNodes\FlowNodes.csproj" />
  </ItemGroup>

</Project>
