<UserControl
    x:Class="ScriptEditor.Views.ScriptManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScriptEditor.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="640"
    MinHeight="400"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFCustomControls;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style
                x:Key="ToolBarButtonStyle"
                BasedOn="{StaticResource MaterialDesignFlatButton}"
                TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="ToolBarPackIconStyle" TargetType="materialDesign:PackIcon">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
            </Style>
<!--
    标签内容模板：ScriptEditorView 直接绑定到 ScriptItem（VM 层数据）。
    TabControl 只 realized 选中的标签内容，因此非选中的脚本不会创建
    重量级 RoslynPad 编辑器（启动加载只构造 ScriptItem，完全错开编辑器构建）。
    注意：除 LoopInterval 外全部使用 OneWay——EditTabControl 复用同一
    ScriptEditorView 实例切页，TwoWay 会在 DataContext 切换瞬间把旧脚本的
    输出/状态经依赖属性回写进新 ScriptItem，造成多脚本输出串扰。
    输出等状态由视图代码在确认 _attachedItem 与 DataContext 一致后显式写回。
-->
<DataTemplate x:Key="ScriptEditorContentTemplate">
    <local:ScriptEditorView
        IsLooping="{Binding IsLooping, Mode=OneWay}"
        IsRunning="{Binding IsRunning, Mode=OneWay}"
        ItemStatus="{Binding ItemStatus, Mode=OneWay}"
        LoopInterval="{Binding LoopInterval, Mode=TwoWay}"
        OutputText="{Binding OutputText, Mode=OneWay}"
        ScriptCode="{Binding Code, Mode=OneWay}" />
</DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="脚本管理器" />
                    <Separator Margin="16,0" Style="{StaticResource SeparatorVertical_Style}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Command="{Binding AddScriptCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="添加脚本 (Ctrl+N)">
                        <materialDesign:PackIcon Kind="Plus" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding CopyScriptCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="复制脚本">
                        <materialDesign:PackIcon Kind="ContentCopy" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding RemoveAllScriptCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="删除全部脚本">
                        <materialDesign:PackIcon Kind="DeleteSweep" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Separator Margin="8,0" Style="{StaticResource SeparatorVertical_Style}" />
                    <Button
                        Command="{Binding MoveToTopCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="移至最上方">
                        <materialDesign:PackIcon Kind="ArrowCollapseUp" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding MoveUpCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="上移">
                        <materialDesign:PackIcon Kind="ArrowUp" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding MoveDownCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="下移">
                        <materialDesign:PackIcon Kind="ArrowDown" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding MoveToBottomCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="移至最下方">
                        <materialDesign:PackIcon Kind="ArrowCollapseDown" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Separator Margin="8,0" Style="{StaticResource SeparatorVertical_Style}" />
                    <Button
                        Command="{Binding SaveTaskCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="保存任务">
                        <materialDesign:PackIcon Kind="ContentSave" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding SaveAsTaskCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="任务另存为...">
                        <materialDesign:PackIcon Kind="ContentSaveAll" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding LoadTaskCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="加载整个任务">
                        <materialDesign:PackIcon Kind="FolderOpen" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Separator Margin="8,0" Style="{StaticResource SeparatorVertical_Style}" />
                    <Button
                        Command="{Binding RunAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="依次执行所有脚本">
                        <materialDesign:PackIcon Kind="PlayArrow" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding StopAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="终止所有正在执行的脚本">
                        <materialDesign:PackIcon Kind="Stop" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding LoopRunCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="按设定间隔循环执行所有脚本">
                        <materialDesign:PackIcon Kind="Repeat" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding StopLoopCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="停止当前的循环执行">
                        <materialDesign:PackIcon Kind="StopCircleOutline" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ctl:EditTabControl
            x:Name="ScriptTabControl"
            Grid.Row="1"
            CloseTabCommand="{Binding RemoveScriptCommand}"
            ContentTemplate="{StaticResource ScriptEditorContentTemplate}"
            HeaderMemberPath="Title"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding Model.SelectedItem, Mode=TwoWay}"
            ShowCloseButton="True"
            TabStripPlacement="Right" />

        <Border
            Grid.Row="2"
            Padding="10,6"
            Background="{StaticResource Color_Gray3}"
            BorderBrush="{StaticResource Color_Gray6}"
            BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center">
                <Run Text="{Binding Model.StatusText, Mode=OneWay}" />
                <Run Text="  |  " />
                <Run Text="脚本数: " />
                <Run Text="{Binding TotalScriptCount, Mode=OneWay}" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
