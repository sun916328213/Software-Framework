<!--
中文阅读说明：项目构建声明。
MotionControl 模块：运动契约、控制卡适配和验证界面；实际轴状态、命令结果及释放顺序遵守设备实现。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>MotionControl.Workbench</RootNamespace>
    <AssemblyName>MotionControl.Workbench</AssemblyName>
    <!-- P0 骨架：Workbench 是组合根与人工验证宿主，阶段 6 再接 Simulation / 真实 Vendor。 -->
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MotionControl.Core\MotionControl.Core.csproj" />
    <ProjectReference Include="..\MotionControl.Runtime\MotionControl.Runtime.csproj" />
    <ProjectReference Include="..\MotionControl.Controls\MotionControl.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
  </ItemGroup>
</Project>
