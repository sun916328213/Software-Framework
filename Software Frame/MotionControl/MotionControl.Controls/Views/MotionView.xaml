<!--
    中文阅读说明：界面与资源声明。
    MotionControl 模块：运动契约、控制卡适配和验证界面；实际轴状态、命令结果及释放顺序遵守设备实现。
    绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="MotionControl.Controls.Views.MotionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:controls="clr-namespace:MotionControl.Controls.Views"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MotionControl.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <common:PageHeaderView
            Title="运动控制"
            Margin="0,0,0,8"
            IconKind="AxisArrow"
            SubTitle="设备连接 · 单轴调试 · 多轴状态" />
        <md:Card
            Grid.Row="1"
            Margin="0,0,0,8"
            Style="{StaticResource MotionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource MotionSectionTitle}" Text="设备连接" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="VendorBox"
                        md:HintAssist.Hint="驱动 / 厂商"
                        ItemsSource="{Binding Model.Vendors}"
                        SelectedItem="{Binding Model.SelectedVendor}"
                        Style="{StaticResource CompactComboBox}" />
                    <TextBox
                        Grid.Column="2"
                        MinWidth="80"
                        md:HintAssist.Hint="轴数"
                        Style="{StaticResource CompactTextBox}"
                        Text="{Binding Model.AxisCount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="4"
                        MinWidth="80"
                        md:HintAssist.Hint="设备 IP"
                        Style="{StaticResource CompactTextBox}"
                        Text="{Binding Model.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="6"
                        MinHeight="32"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="连接"
                        Command="{Binding ConnectCommand}"
                        Content="连接"
                        Style="{StaticResource CompactPrimaryButton}" />
                    <Button
                        Grid.Column="7"
                        MinHeight="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="断开"
                        Command="{Binding DisconnectCommand}"
                        Content="断开"
                        Style="{StaticResource CompactOutlinedButton}" />
                </Grid>
                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Opacity="0.75"
                    Text="{Binding Model.StatusMessage}"
                    TextWrapping="Wrap" />
            </Grid>
        </md:Card>
        <TabControl Grid.Row="2" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <TabItem Header="单轴调试">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox
                            x:Name="AxisBox"
                            Width="180"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            md:HintAssist.Hint="当前轴"
                            IsEnabled="{Binding Model.IsConnected}"
                            ItemsSource="{Binding Model.AxisIndices}"
                            SelectedItem="{Binding Model.SelectedAxisIndex}"
                            Style="{StaticResource CompactComboBox}" />
                        <controls:AxisStatusControl
                            x:Name="StatusControl"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            AxisIndex="{Binding Model.SelectedAxisIndex}"
                            MotionCard="{Binding Model.SelectedCard}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:AxisJogControl
                                x:Name="JogControl"
                                AxisIndex="{Binding Model.SelectedAxisIndex}"
                                MotionCard="{Binding Model.SelectedCard}" />
                            <controls:AxisOperationControl
                                x:Name="OperationControl"
                                Grid.Column="2"
                                AxisIndex="{Binding Model.SelectedAxisIndex}"
                                MotionCard="{Binding Model.SelectedCard}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="多轴总览">
                <controls:MotionOverviewControl
                    x:Name="OverviewControl"
                    Margin="0,8,0,0"
                    MotionCard="{Binding Model.SelectedCard}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
