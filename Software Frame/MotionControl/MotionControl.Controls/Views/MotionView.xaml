<!--
中文阅读说明：界面与资源声明。
MotionControl 模块：运动契约、控制卡适配和验证界面；实际轴状态、命令结果及释放顺序遵守设备实现。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl x:Class="MotionControl.Controls.Views.MotionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:controls="clr-namespace:MotionControl.Controls.Views"
    xmlns:common="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MotionControl.Controls;component/Themes/PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <common:PageHeaderView Title="运动控制" SubTitle="设备连接 · 单轴调试 · 多轴状态" IconKind="AxisArrow" Margin="0,0,0,8"/>
        <md:Card Grid.Row="1" Style="{StaticResource MotionCard}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="设备连接" Style="{StaticResource MotionSectionTitle}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="VendorBox" md:HintAssist.Hint="驱动 / 厂商" Style="{StaticResource CompactOutlinedComboBox}"
                              ItemsSource="{Binding Model.Vendors}" SelectedItem="{Binding Model.SelectedVendor}"/>
                    <TextBox Grid.Column="2" md:HintAssist.Hint="轴数" Style="{StaticResource CompactOutlinedTextBox}"
                             Text="{Binding Model.AxisCount, UpdateSourceTrigger=PropertyChanged}" MinWidth="80" />
                    <TextBox Grid.Column="4" md:HintAssist.Hint="设备 IP" Style="{StaticResource CompactOutlinedTextBox}"
                             Text="{Binding Model.IpAddress, UpdateSourceTrigger=PropertyChanged}" MinWidth="80" />
                    <Button Grid.Column="6" Content="连接" Command="{Binding ConnectCommand}" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" VerticalAlignment="Center" MinHeight="32" AutomationProperties.Name="连接" />
                    <Button Grid.Column="7" Content="断开" Command="{Binding DisconnectCommand}" Style="{StaticResource CompactOutlinedButton}" VerticalAlignment="Center" MinHeight="32" AutomationProperties.Name="断开" />
                </Grid>
                <TextBlock Grid.Row="2" x:Name="StatusText" Text="{Binding Model.StatusMessage}" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"/>
            </Grid>
        </md:Card>
        <TabControl Grid.Row="2" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <TabItem Header="单轴调试">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ComboBox x:Name="AxisBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"
                                  IsEnabled="{Binding Model.IsConnected}"
                                  md:HintAssist.Hint="当前轴" Style="{StaticResource CompactOutlinedComboBox}"
                                  ItemsSource="{Binding Model.AxisIndices}" SelectedItem="{Binding Model.SelectedAxisIndex}"/>
                        <controls:AxisStatusControl Grid.Row="1" x:Name="StatusControl" MotionCard="{Binding Model.SelectedCard}" AxisIndex="{Binding Model.SelectedAxisIndex}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <controls:AxisJogControl x:Name="JogControl" MotionCard="{Binding Model.SelectedCard}" AxisIndex="{Binding Model.SelectedAxisIndex}"/>
                            <controls:AxisOperationControl Grid.Column="2" x:Name="OperationControl" MotionCard="{Binding Model.SelectedCard}" AxisIndex="{Binding Model.SelectedAxisIndex}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="多轴总览"><controls:MotionOverviewControl x:Name="OverviewControl" MotionCard="{Binding Model.SelectedCard}" Margin="0,8,0,0"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>
