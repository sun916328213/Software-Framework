<!--
中文阅读说明：界面与资源声明。
MotionControl 模块：运动契约、控制卡适配和验证界面；实际轴状态、命令结果及释放顺序遵守设备实现。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WPFCustomControls;component/Resources/CompactControlStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="MotionInput" TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="MotionAction" TargetType="Button" BasedOn="{StaticResource CompactOutlinedButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Width" Value="120" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="MotionHoldAction" TargetType="Button" BasedOn="{StaticResource MotionAction}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Width" Value="160" />
    </Style>
    <Style x:Key="MotionSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="MotionCard" TargetType="md:Card">
        <Setter Property="Padding" Value="12" />
        <Setter Property="UniformCornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
