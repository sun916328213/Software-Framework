<!--
中文阅读说明：项目构建声明。
SecsGem 模块：SECS/GEM 契约、协议运行及界面适配；状态变化和报文处理以协议实现及配置为准。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SecsGem.Workbench</RootNamespace>
    <!-- 验证宿主以管理员身份启动：S2F31 设置系统时间需要令牌内含 SeSystemtimePrivilege，
         该特权只存在于提权令牌中（未提权令牌被 UAC 过滤掉，进程内补不出来）。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SecsGem.Controls\SecsGem.Controls.csproj" />
    <ProjectReference Include="..\..\DataManager\DataManager.Controls\DataManager.Controls.csproj" />
    <ProjectReference Include="..\SecsGem.Runtime\SecsGem.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 出厂 GEM 配置：路径与运行时一致（Config\SecsJson\<表>\<表>.csv，相对工作目录）。
         文件缺失时 DataBase.LoadDefaults() 兜底，这里给的是可编辑的实体文件。 -->
    <None Include="Config\SecsJson\SVID\SVID.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config\SecsJson\DVID\DVID.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config\SecsJson\ECID\ECID.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config\SecsJson\CEID\CEID.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Config\SecsJson\ReportID\ReportID.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
  </ItemGroup>
</Project>
