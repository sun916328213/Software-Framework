<UserControl x:Class="SecsGem.Workbench.Views.RecipeTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:custom="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SecsGem.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <custom:PageHeaderView Title="配方管理" IconKind="FileDocumentOutline"
                SubTitle="配方列表与手动切换 · 外部 Host 下载后自动刷新" Margin="0,0,0,12" />
            <md:Card Style="{StaticResource SecsCard}">
                <StackPanel>
                    <TextBlock Text="配方列表（包含 S7F3 / S7F23 接收的 PPID）" Margin="0,0,0,8" />
                    <DataGrid x:Name="RecipeListGrid" Height="240" IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                        ItemsSource="{Binding Model.RecipeRows}" SelectedValuePath="Key"
                        SelectedValue="{Binding Model.SelectedPpid, Mode=TwoWay}"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PPID" Width="2*" Binding="{Binding Key}" />
                            <DataGridTextColumn Header="状态" Width="240" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="错误详情" Width="2*" Binding="{Binding Error}" />
                            <DataGridTextColumn Header="版本" Width="*" Binding="{Binding Value.Version}" />
                            <DataGridTextColumn Header="曝光 (μs)" Width="*" Binding="{Binding Value.ExposureUs}" />
                            <DataGridTextColumn Header="增益" Width="*" Binding="{Binding Value.Gain}" />
                            <DataGridTextColumn Header="速度 (mm/s)" Width="*" Binding="{Binding Value.SpeedMmPerSec}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding Model.SelectedPpid, StringFormat=待切换 PPID：{0}}" VerticalAlignment="Center" Margin="0,0,12,8" />
                        <Button Content="切换当前配方" Command="{Binding SwitchRecipeCommand}"
                            AutomationProperties.Name="切换当前配方" Margin="0,0,0,8"
                            Style="{StaticResource CompactOutlinedButton}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Model.CurrentPpid, StringFormat=当前 PPID：{0}}" Margin="0,8" />
                    <TextBlock Text="{Binding Model.CurrentRecipe.Version, StringFormat=Version：{0}}" />
                    <TextBlock Text="{Binding Model.CurrentRecipe.ExposureUs, StringFormat=曝光：{0} μs}" />
                    <TextBlock Text="{Binding Model.CurrentRecipe.Gain, StringFormat=增益：{0}}" />
                    <TextBlock Text="{Binding Model.CurrentRecipe.SpeedMmPerSec, StringFormat=速度：{0} mm/s}" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding Model.Status}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"
                        Text="外部 Host 使用 S7F3（不是 S2F3）下载 UTF-8 JSON 配方；收到后自动刷新列表，解析失败也显示 PPID 和错误，但不能切换。同一 PPID 更新原行，新 PPID 新增一行。本 Workbench 示例的 S7F23 映射使用命令编号 1、PPARM=L[4]，依次为版本、曝光、增益、速度；接收支持 ASCII 数字及可转换的数值类型，不强制 U4/F8。完整业务校验后可手动切换，映射失败显示错误且不可切换。切换仅使用已校验的业务参数，不执行任意工艺命令。选中行或下载不会切换当前配方，必须点击切换按钮；失败原因请查看 SECS/GEM 消息监视器。" />
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
