<!--
    中文阅读说明：界面与资源声明。
    SecsGem 模块：SECS/GEM 契约、协议运行及界面适配；状态变化和报文处理以协议实现及配置为准。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
    绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window
    x:Class="SecsGem.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Title="SecsGem 测试工作台"
    Style="{StaticResource WorkbenchWindow}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <DockPanel>
                <StackPanel Margin="12,16,12,16" DockPanel.Dock="Top">
                    <md:PackIcon
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="LanConnect" />
                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="SecsGem" />
                    <TextBlock Opacity="0.7" Text="测试工作台" />
                </StackPanel>
                <StackPanel Margin="16" DockPanel.Dock="Bottom">
                    <controls:ThemePickerView
                        FieldBackground="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        FieldForeground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Theme="{Binding Theme}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Text="{Binding NavigationError}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ListBox
                    Margin="12,0"
                    VerticalAlignment="Top"
                    IsEnabled="{Binding CanSelectNavigation}"
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="8,6"
                                FontWeight="SemiBold"
                                Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="16">
            <ContentControl prism:RegionManager.RegionName="SecsRegion" />
        </Grid>
    </Grid>
</Window>