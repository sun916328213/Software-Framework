<!--
中文阅读说明：界面与资源声明。
SecsGem 模块：SECS/GEM 契约、协议运行及界面适配；状态变化和报文处理以协议实现及配置为准。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl x:Class="SecsGem.Controls.Views.SecsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecsGem.Controls.Views"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:common="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SecsGem.Controls;component/Themes/PageStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="150" MinHeight="100" />
        </Grid.RowDefinitions>
        <common:PageHeaderView Title="SECS/GEM" SubTitle="协议联调 · 消息监视" IconKind="LanConnect" Margin="0,0,0,8"/>
        <md:Card Grid.Row="1" Style="{StaticResource SecsCard}" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ConnectionMode" Width="100" SelectedIndex="{Binding Model.ConnectionModeIndex}" Margin="0,0,12,0" Style="{StaticResource CompactOutlinedComboBox}">
                        <ComboBoxItem Content="主动" />
                        <ComboBoxItem Content="被动" />
                    </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="地址" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="AddressBox" Width="130" Text="{Binding Model.Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"  Style="{StaticResource CompactOutlinedTextBox}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="PortBox" Width="65" Text="{Binding Model.PortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"  Style="{StaticResource CompactOutlinedTextBox}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Device ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="DeviceIdBox" Width="60" Text="{Binding Model.DeviceIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"  Style="{StaticResource CompactOutlinedTextBox}" />
                    </StackPanel>
                    <Button Content="连接" Command="{Binding ConnectCommand}" Margin="0,0,8,4"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="连接" />
                    <Button Content="断开" Command="{Binding DisconnectCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="断开" />
                </WrapPanel>
                <controls:SecsOverviewView x:Name="Overview" ConnectionStatus="{Binding Model.ConnectionStatus}" ModeStatus="{Binding Model.ModeStatus}" DeviceStatus="{Binding Model.DeviceStatus}" MinHeight="56" Margin="0,8,0,0" />
            </StackPanel>
        </md:Card>
        <TabControl Grid.Row="2" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <TabItem Header="通信与消息">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="建立通信 S1F13" Command="{Binding EstablishCommand}" Margin="0,0,8,4"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="建立通信 S1F13" />
                        <Button Content="Online Remote" Command="{Binding OnlineCommand}" Margin="0,0,8,4"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="Online Remote" />
                        <Button Content="Offline" Command="{Binding OfflineCommand}" Margin="0,0,8,4"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="Offline" />
                        <Button Content="加载 GEM 配置" Command="{Binding LoadConfigCommand}" Margin="0,0,8,4"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="加载 GEM 配置" />
                        <Button Content="载入内存示例" Command="{Binding LoadSampleCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="载入内存示例" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="0,8,0,4" Text="手工发送 SML（例如 'S1F1' W；多行消息可附 SECS Item）" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SmlBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Model.Sml, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"  Style="{StaticResource CompactMultilineTextBox}" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox x:Name="WaitReplyBox" Content="等待回复" IsChecked="{Binding Model.WaitForReply}" Margin="0,0,0,4" />
                            <Button Content="发送" Command="{Binding SendSmlCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="发送" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="变量 SVID/DVID/ECID">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="VariableGrid" ItemsSource="{Binding Model.Variables}" SelectedItem="{Binding Model.SelectedVariable}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="90" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="100" />
                            <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="新值" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="VariableValueBox" Text="{Binding Model.VariableValue, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0"  Style="{StaticResource CompactOutlinedTextBox}" />
                        <Button Content="写入选中变量" Command="{Binding SetVariableCommand}" Margin="0,0,8,0"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="写入选中变量" />
                        <Button Content="刷新" Command="{Binding RefreshCatalogNowCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="刷新" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="事件与报表">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="EventGrid" ItemsSource="{Binding Model.Events}" SelectedItem="{Binding Model.SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,8,0" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CEID" Binding="{Binding ID}" Width="75" />
                            <DataGridTextColumn Header="事件" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Report IDs" Binding="{Binding ReportID_Collection}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Column="1" x:Name="ReportGrid" ItemsSource="{Binding Model.Reports}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5,0,0,0" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Report ID" Binding="{Binding ID}" Width="90" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="VID IDs" Binding="{Binding VID_Collection}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="上报选中 CEID (S6F11)" Command="{Binding ReportEventCommand}" Margin="0,8,5,0"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="上报选中 CEID (S6F11)" />
                </Grid>
            </TabItem>
            <TabItem Header="报警">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="AlarmGrid" ItemsSource="{Binding Model.Alarms}" SelectedItem="{Binding Model.SelectedAlarm}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ALID" Binding="{Binding ID}" Width="90" />
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enable}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Content="选中报警触发 (S5F1)" Command="{Binding RaiseAlarmCommand}" Margin="0,0,8,0"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="选中报警触发 (S5F1)" />
                        <Button Content="选中报警复位 (S5F1)" Command="{Binding ResetAlarmCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="选中报警复位 (S5F1)" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="远程命令与 S10">
                <StackPanel Margin="12">
                    <TextBlock Text="收到 S2F41 后，工作台记录命令与参数并按下方 HCACK 应答。" Margin="0,0,0,10" />
                    <WrapPanel>
                        <TextBlock Text="HCACK" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="HcackBox" Width="60" Text="{Binding Model.Hcack, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource CompactOutlinedTextBox}" />
                    </WrapPanel>
                    <TextBlock Text="S10 Terminal 将在收到 Host 消息时弹出提示窗。" Margin="0,12,0,8" />
                    <Button Content="预览 S10 提示窗" Width="160" HorizontalAlignment="Left" Command="{Binding PreviewTerminalCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="预览 S10 提示窗" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel>
                <Button Content="清空" DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding ClearLogCommand}"  Style="{StaticResource CompactOutlinedButton}" MinHeight="32" AutomationProperties.Name="清空" />
                <TextBlock Text="消息监视器" Style="{StaticResource SecsSectionTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox Grid.Row="1" x:Name="MessageLog" ItemsSource="{Binding Model.Messages}" FontFamily="Consolas" />
        </Grid>
    </Grid>
</UserControl>
