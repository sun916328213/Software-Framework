    中文阅读说明：界面与资源声明。
    SecsGem 模块：SECS/GEM 契约、协议运行及界面适配；状态变化和报文处理以协议实现及配置为准。
    绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window
    x:Class="SecsGem.Controls.Terminal.MessagePrompt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Window"
    Width="400"
    MinHeight="230"
    MaxHeight="600"
    AllowsTransparency="True"
    Background="Transparent"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ControlTool_WPF;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
        BorderThickness="2"
        CornerRadius="12">

        <materialDesign:Card
            Padding="12"
            Background="Transparent"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    MaxHeight="400"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding ElementName=Window, Path=Title}" />

                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="16"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding ElementName=Window, Path=Message}"
                            TextWrapping="Wrap" />

                    </StackPanel>
                </ScrollViewer>

                <Separator
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    Style="{StaticResource MaterialDesignSeparator}" />

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="1"
                        Width="100"
                        MinHeight="32"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="OK"
                        Click="Button_Click"
                        Content="OK"
                        Style="{StaticResource CompactOutlinedButton}" />
                    <Button
                        Grid.Column="0"
                        Width="100"
                        MinHeight="32"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Cancel"
                        Click="Button_Click_1"
                        Content="Cancel"
                        Style="{StaticResource CompactOutlinedButton}"
                        Visibility="{Binding ElementName=Window, Path=Visibility_Cancel}" />
                </Grid>
            </Grid>
        </materialDesign:Card>

    </Border>
</Window>
