<!--
中文阅读说明：界面与资源声明。
ScriptEditor 模块：脚本持久化模型、运行时编译执行和编辑器协作；脚本 ID、引用及断点属于需要保留的状态。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="ScriptEditor.Controls.Views.ScriptManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScriptEditor.Controls.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="640"
    MinHeight="400"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ScriptEditor;component/Themes/PageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>




<!--
    标签内容模板：ScriptEditorView 直接绑定到 ScriptItem（纯数据）。
    TabControl 只 realized 选中的标签内容，因此非选中的脚本不会创建
    重量级 RoslynPad 编辑器（启动加载只构造 ScriptItem，完全错开编辑器构建）。
    运行状态（IsRunning / IsLooping / Output / StatusText / LoopInterval）不再由
    ScriptItem 承载，也不再经依赖属性回写——它们由每个脚本自己的 ScriptSession 持有，
    视图在附加脚本项时订阅该会话。因此切页只切换订阅，不会改变任何运行事实。
-->
<DataTemplate x:Key="ScriptEditorContentTemplate">
    <local:ScriptEditorView ScriptCode="{Binding Code, Mode=OneWay}" />
</DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:PageHeaderView Title="脚本编辑器" SubTitle="脚本管理 · 编辑与调试" IconKind="CodeBraces" Margin="0,0,0,8"/>
        <Border Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Text="任务操作" />
                    <Separator Margin="16,0" Style="{StaticResource SeparatorVertical_Style}" />
                </StackPanel>
                <WrapPanel Grid.Column="1">
                    <Button
                        Command="{Binding AddScriptCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="添加脚本 (Ctrl+N)"
                    ToolTip="添加脚本 (Ctrl+N)">
                        <materialDesign:PackIcon Kind="Plus" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding CopyScriptCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="复制脚本"
                    ToolTip="复制脚本">
                        <materialDesign:PackIcon Kind="ContentCopy" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding RemoveAllScriptCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="删除全部脚本"
                    ToolTip="删除全部脚本">
                        <materialDesign:PackIcon Kind="DeleteSweep" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Separator Margin="8,0" Style="{StaticResource SeparatorVertical_Style}" />
                    <Button
                        Command="{Binding MoveToTopCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="移至最上方"
                    ToolTip="移至最上方">
                        <materialDesign:PackIcon Kind="ArrowCollapseUp" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding MoveUpCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="上移"
                    ToolTip="上移">
                        <materialDesign:PackIcon Kind="ArrowUp" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding MoveDownCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="下移"
                    ToolTip="下移">
                        <materialDesign:PackIcon Kind="ArrowDown" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding MoveToBottomCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="移至最下方"
                    ToolTip="移至最下方">
                        <materialDesign:PackIcon Kind="ArrowCollapseDown" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Separator Margin="8,0" Style="{StaticResource SeparatorVertical_Style}" />
                    <Button
                        Command="{Binding SaveTaskCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="保存任务"
                    ToolTip="保存任务">
                        <materialDesign:PackIcon Kind="ContentSave" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding SaveAsTaskCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="任务另存为..."
                    ToolTip="任务另存为...">
                        <materialDesign:PackIcon Kind="ContentSaveAll" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding LoadTaskCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="加载整个任务"
                    ToolTip="加载整个任务">
                        <materialDesign:PackIcon Kind="FolderOpen" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Separator Margin="8,0" Style="{StaticResource SeparatorVertical_Style}" />
                    <Button
                        Command="{Binding RunAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="依次执行所有脚本"
                    ToolTip="依次执行所有脚本">
                        <materialDesign:PackIcon Kind="PlayArrow" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding StopAllCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="终止所有正在执行的脚本"
                    ToolTip="终止所有正在执行的脚本">
                        <materialDesign:PackIcon Kind="Stop" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding LoopRunCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="按设定间隔循环执行所有脚本"
                    ToolTip="按设定间隔循环执行所有脚本">
                        <materialDesign:PackIcon Kind="Repeat" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                    <Button
                        Command="{Binding StopLoopCommand}"
                        Style="{StaticResource ToolBarButtonStyle}"
                        AutomationProperties.Name="停止当前的循环执行"
                    ToolTip="停止当前的循环执行">
                        <materialDesign:PackIcon Kind="StopCircleOutline" Style="{StaticResource ToolBarPackIconStyle}" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <ctl:EditTabControl
            x:Name="ScriptTabControl"
            Grid.Row="2"
            CloseTabCommand="{Binding RemoveScriptCommand}"
            ContentTemplate="{StaticResource ScriptEditorContentTemplate}"
            HeaderMemberPath="Title"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding Model.SelectedItem, Mode=TwoWay}"
            ShowCloseButton="True"
            TabStripPlacement="Top" />

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="暂无脚本" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="点击添加脚本开始编辑，或加载任务工程。" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <Border x:Name="StatusBar"
            Grid.Row="3"
            Padding="12,8"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
            BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center">
                <Run Text="{Binding Model.StatusText, Mode=OneWay}" />
                <Run Text="  |  " />
                <Run Text="脚本数: " />
                <Run Text="{Binding TotalScriptCount, Mode=OneWay}" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
