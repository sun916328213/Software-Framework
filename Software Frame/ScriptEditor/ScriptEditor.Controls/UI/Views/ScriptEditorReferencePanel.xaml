<!--
中文阅读说明：界面与资源声明。
ScriptEditor 模块：脚本持久化模型、运行时编译执行和编辑器协作；脚本 ID、引用及断点属于需要保留的状态。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<!--
    ScriptEditorReferencePanel.xaml - 引用管理侧边栏（前后端分离：从 ScriptEditorView 中独立出来，延迟创建）
    配色：一律走 MaterialDesign 原生动态键（跟随明暗主题），根节点设 Foreground 由属性继承下发。
-->
<UserControl
    x:Class="ScriptEditor.Controls.Views.ScriptEditorReferencePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <UserControl.Resources>
        <!-- 资源字典已提升到 App.xaml 级别，无需在此重复加载 -->
    </UserControl.Resources>

    <Border
        Width="260"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
        BorderThickness="1,0,0,0">
        <DockPanel>
            <!--  头部  -->
            <Border
                Padding="10,8"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="引用管理" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding AddReferenceCommand}"
                        Style="{StaticResource CompactFlatButton}"
                        AutomationProperties.Name="添加 DLL 引用"
                    ToolTip="添加 DLL 引用">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="Plus" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding ToggleReferencePanelCommand}"
                        Style="{StaticResource CompactFlatButton}"
                        AutomationProperties.Name="关闭引用面板"
                    ToolTip="关闭引用面板">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <!--  搜索框  -->
            <Border
                Padding="8,6"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ReferenceFilterBox"
                        AutomationProperties.Name="搜索引用"
                        VerticalContentAlignment="Center"
                        materialDesign:HintAssist.Hint="搜索引用..."
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding ReferenceFilter, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding ClearReferenceFilterCommand}"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Style="{StaticResource CompactFlatButton}"
                        AutomationProperties.Name="清除搜索"
                    ToolTip="清除搜索">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="CloseCircle" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4">
                    <!--  用户添加的引用  -->
                    <Expander
                        x:Name="UserRefExpander"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        Header="用户添加的引用"
                        IsExpanded="True"
                        Style="{StaticResource MaterialDesignExpander}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock VerticalAlignment="Center" Text="用户添加的引用" />
                                    <Border
                                        Height="20"
                                        Margin="8,0"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="4"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                            Text="{Binding DataContext.References.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <ItemsControl
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredReferences}"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="4,1"
                                        Padding="6,4"
                                        CornerRadius="3">
                                        <DockPanel>
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                materialDesign:ButtonAssist.CornerRadius="3"
                                                Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                DockPanel.Dock="Right"
                                                Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                AutomationProperties.Name="移除引用"
                    ToolTip="移除引用">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Close" />
                                            </Button>
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="12"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding FullPath}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                    Text="{Binding FullPath}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding FullPath}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!--  默认引用  -->
                    <Expander
                        x:Name="DefaultRefExpander"
                        Background="Transparent"
                        Header="默认引用"
                        IsExpanded="False"
                        Style="{StaticResource MaterialDesignExpander}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock VerticalAlignment="Center" Text="默认引用" />
                                    <Border
                                        Height="20"
                                        Margin="8,0"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                        CornerRadius="3">
                                        <TextBlock
                                            Margin="4"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                            Text="{Binding DataContext.DefaultReferences.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <ItemsControl
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding FilteredDefaultReferences}"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="4,1"
                                        Padding="6,4"
                                        CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding FullPath}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                Text="{Binding FullPath}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding FullPath}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>