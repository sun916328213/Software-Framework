<!--
中文阅读说明：界面与资源声明。
ScriptEditor 模块：脚本持久化模型、运行时编译执行和编辑器协作；脚本 ID、引用及断点属于需要保留的状态。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<!--
    SearchReplacePanel.xaml - 脚本编辑器查找/替换面板样式
    用途：覆盖 RoslynPad.Editor.SearchReplacePanel 的默认模板，
    面板内控件显式 Style="{x:Null}"，避免继承应用级 MaterialDesign
    隐式样式导致查找栏 UI 混乱。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="clr-namespace:ScriptEditor.Controls.Behaviors"
    xmlns:editor="clr-namespace:RoslynPad.Editor;assembly=RoslynPad.Editor.Windows"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">

    <Style TargetType="{x:Type editor:SearchReplacePanel}">
        <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}" />
        <Setter Property="FontSize" Value="{x:Static SystemFonts.MessageFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type editor:SearchReplacePanel}">
                    <Border
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Cursor="Arrow"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  查找/替换模式切换  -->
                            <ToggleButton
                                Grid.Row="0"
                                Grid.Column="0"
                                materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=ChevronUp,
                                                                                                      Size=26}"
                                Background="Transparent"
                                Content="{materialDesign:PackIcon Kind=ChevronDown,
                                                                  Size=26}"
                                IsChecked="{Binding IsReplaceMode, RelativeSource={RelativeSource TemplatedParent}}"
                                Opacity="0.8"
                                Style="{StaticResource MaterialDesignActionToggleButton}"
                                AutomationProperties.Name="切换查找/替换模式"
                    ToolTip="切换查找/替换模式" />

                            <!--  查找输入框  -->
                            <TextBox Style="{StaticResource CompactTextBox}"
                                x:Name="PART_searchTextBox"
                                AutomationProperties.Name="查找文本"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="160"
                                Height="32"
                                Margin="2"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                materialDesign:HintAssist.Hint="查找"
                                Text="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, RelativeSource={RelativeSource TemplatedParent}}" />

                            <!--  替换输入框  -->
                            <TextBox Style="{StaticResource CompactTextBox}"
                                x:Name="ReplaceBox"
                                AutomationProperties.Name="替换文本"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="160"
                                Height="32"
                                Margin="2"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                materialDesign:HintAssist.Hint="替换"
                                Text="{Binding ReplacePattern, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, RelativeSource={RelativeSource TemplatedParent}}"
                                Visibility="Collapsed" />

                            <!--  查找按钮组（上一个/下一个/关闭）  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="2"
                                    Padding="0"
                                    Command="avalonedit:SearchCommands.FindPrevious"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Style="{StaticResource CompactFlatButton}"
                                    AutomationProperties.Name="查找上一个"
                    ToolTip="查找上一个">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="ArrowLeft"
                                        Opacity="0.8" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="2"
                                    Padding="0"
                                    Command="avalonedit:SearchCommands.FindNext"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Style="{StaticResource CompactFlatButton}"
                                    AutomationProperties.Name="查找下一个"
                    ToolTip="查找下一个">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="ArrowRight"
                                        Opacity="0.8" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="2"
                                    Padding="0"
                                    Command="avalonedit:SearchCommands.CloseSearchPanel"
                                    Focusable="False"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Style="{StaticResource CompactFlatButton}"
                                    AutomationProperties.Name="关闭查找"
                    ToolTip="关闭查找">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="Close"
                                        Opacity="0.8" />
                                </Button>
                            </StackPanel>

                            <!--  替换按钮组  -->
                            <StackPanel
                                x:Name="ReplaceButtons"
                                Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="2"
                                    Padding="0"
                                    Command="editor:SearchCommandsEx.ReplaceNext"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Style="{StaticResource CompactFlatButton}"
                                    AutomationProperties.Name="替换下一个 (Alt+R)"
                    ToolTip="替换下一个 (Alt+R)">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="FindReplace"
                                        Opacity="0.8" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="2"
                                    Padding="0"
                                    Command="editor:SearchCommandsEx.ReplaceAll"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                    Style="{StaticResource CompactFlatButton}"
                                    AutomationProperties.Name="全部替换 (Alt+A)"
                    ToolTip="全部替换 (Alt+A)">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="FindInPage"
                                        Opacity="0.8" />

                                </Button>
                            </StackPanel>

                            <!--  第三行：查找选项平铺（通过 Behavior 同步到 SearchStrategy）  -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="0,8"
                                Orientation="Horizontal">
                                <CheckBox
                                    Margin="4,0"
                                    behaviors:SearchOptionsBehavior.SyncSearchOptions="True"
                                    Content="匹配大小写"
                                    Style="{x:Null}"
                                    ToolTip="区分大小写查找" />
                                <CheckBox
                                    Margin="4,0"
                                    behaviors:SearchOptionsBehavior.SyncSearchOptions="True"
                                    Content="全字匹配"
                                    Style="{x:Null}"
                                    ToolTip="仅匹配完整单词" />
                                <CheckBox
                                    Margin="4,0"
                                    behaviors:SearchOptionsBehavior.SyncSearchOptions="True"
                                    Content="使用正则"
                                    Style="{x:Null}"
                                    ToolTip="使用正则表达式语法" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="editor:SearchReplacePanel.IsReplaceMode" Value="True">
                            <Setter TargetName="ReplaceBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ReplaceButtons" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
