<!--
中文阅读说明：项目构建声明。
ScriptEditor 模块：脚本持久化模型、运行时编译执行和编辑器协作；脚本 ID、引用及断点属于需要保留的状态。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScriptEditor.Workbench</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Composition Root：显式组合被装配的层（Controls 提供视图与服务，Runtime 提供会话运行时），
         不靠传递依赖获得 Runtime。 -->
    <ProjectReference Include="..\ScriptEditor.Controls\ScriptEditor.Controls.csproj" />
    <ProjectReference Include="..\ScriptEditor.Runtime\ScriptEditor.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
  </ItemGroup>
</Project>
