<!--
    中文阅读说明：界面与资源声明。
    Communication 模块：连接、协议适配及通信界面；主动请求应答与被动数据接收需遵守所用连接的实际契约。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
    绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        壳层样式（侧栏 + 导航）。页面自身样式在 Communication.Controls 的 Themes/PageStyles.xaml，由页面自己合并。
        配色一律引用 MaterialDesign 原生键，深浅主题自动跟随，不自定义中性色画刷；
        语义状态色（成功/警告/失败/收发）走 Extension ThemeService 的 Brush.* 别名。
    -->

    <!--  导航项标题：前景写在 Style.Setter 里，DataTrigger 才能覆盖它（写进 DataTemplate 会被当局部值压住）。  -->
    <Style x:Key="NavItemText" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  侧栏导航：悬停用 MD 半透明叠层，选中用主色（Primary.Foreground 随主色明暗自动翻黑白）。  -->
    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:Chip
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            Content="{Binding Badge}"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        <TextBlock Style="{StaticResource NavItemText}" Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="bd"
                                    Margin="0,2"
                                    Padding="8,6"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListView.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
