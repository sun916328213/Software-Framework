<!--
中文阅读说明：界面与资源声明。
Communication 模块：连接、协议适配及通信界面；主动请求应答与被动数据接收需遵守所用连接的实际契约。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="Communication.Controls.Views.CommunicationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Communication.Controls.ViewModels"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DataContext="{d:DesignInstance Type=vm:CommunicationViewModel}"
    d:DesignHeight="860"
    d:DesignWidth="1280"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  页面样式归页面自己所有，由本页合并（宿主只合并壳层 Styles/Theme.xaml）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Communication.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>


            <!--  输入框标题：MD 的浮动 hint 在"绑定预填值"时会和文字叠在一起，改成静态小标签  -->
            <Style
                x:Key="FieldLabel"
                BasedOn="{StaticResource {x:Type TextBlock}}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>

            <!--  危险动作按钮：MD 没有「危险实心」样式，压在 ValidationError 底色上要按深浅翻字色  -->
            <Style
                x:Key="DangerButton"
                BasedOn="{StaticResource CompactPrimaryButton}"
                TargetType="Button">
                <Setter Property="Margin" Value="8" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnDanger}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.38" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  次要动作：与实心主按钮同宽，避免一屏里全是实心  -->
            <Style
                x:Key="QuietButton"
                BasedOn="{StaticResource CompactOutlinedButton}"
                TargetType="Button">
                <Setter Property="Margin" Value="8" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="88" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.38" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                动作按钮：MD 的 disabled 描边和 enabled 几乎看不出差别，点下去没反应会被当成"界面坏了"，
                所以禁用态要明显压暗——灰只表示"没连接"这一种意思。
            -->
            <Style
                x:Key="ActionSolid"
                BasedOn="{StaticResource CompactPrimaryButton}"
                TargetType="Button">
                <Setter Property="Margin" Value="8" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="76" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.38" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style
                x:Key="ActionGhost"
                BasedOn="{StaticResource CompactOutlinedButton}"
                TargetType="Button">
                <Setter Property="Margin" Value="8" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="76" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.38" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="DeviceItemTemplate" DataType="{x:Type vm:DeviceViewModel}">
                <Grid Margin="0,3" ToolTip="{Binding StatusText}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource MaterialDesign.Brush.Primary.Background}"
                        CornerRadius="8">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="{Binding ProtocolIcon}" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="6,0"
                        VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Text="{Binding StatusShort}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding StatusText}" />
                        </Grid>
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding Protocol}" />
                            <TextBlock Margin="5,0" Text="·" />
                            <TextBlock Text="{Binding RoleText}" />
                        </StackPanel>
                    </StackPanel>
                    <Ellipse
                        Grid.Column="2"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                <Setter Property="Opacity" Value="0.3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.5"
                                                    ShadowDepth="0"
                                                    Color="{DynamicResource Brush.Success.Color}" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" MinHeight="420" />
        </Grid.RowDefinitions>

        <!--  页头：标题 + 会话概览（壳的侧栏负责主题与导航，这里不再放主题切换）  -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="Network" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Style="{StaticResource PageTitle}" Text="通讯设备测试" />
                    <TextBlock
                        Margin="0"
                        Style="{StaticResource PageSubTitle}"
                        Text="全部协议统一走 CommunicationNew 的 ICommunicationDevice 一套对外接口：连接控制、地址读写、原始收发与收发日志都在本页完成" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Row="1" Margin="0,8,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <materialDesign:Chip
                    VerticalAlignment="Center"
                    Content="{Binding DeviceSummary}"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <materialDesign:Chip
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="{Binding StatusHint}"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </StackPanel>
        </Grid>

        <!--  两栏：左设备 | 右操作+日志。可拖拽调整宽度  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="300"
                    MinWidth="300"
                    MaxWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE" />

            <!--  设备：列表 + 生命周期动作  -->
            <materialDesign:Card
                Grid.Column="0"
                Padding="12"
                UniformCornerRadius="12">
                <DockPanel>
                    <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="通讯设备" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Command="{Binding AddDeviceCommand}"
                                Style="{StaticResource CompactPrimaryButton}" AutomationProperties.Name="新建">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Kind="Plus" />
                                    <TextBlock Margin="6,0,0,0" Text="新建" />
                                </StackPanel>
                            </Button>
                            <!--  编辑选中设备参数（协议/角色锁定，只改参数）  -->
                            <Button
                                Margin="6,0,0,0"
                                Padding="8,0"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Command="{Binding EditDeviceCommand}"
                                Style="{StaticResource CompactOutlinedButton}"
                                ToolTip="编辑选中设备的参数" AutomationProperties.Name="编辑设备参数">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Pencil" />
                            </Button>
                            <!--  批量与配置动作收进菜单：设备列只有 300 宽，按钮堆到底部会吃掉列表  -->
                            <materialDesign:PopupBox
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="批量操作与配置导入导出">
                                <StackPanel>
                                    <Button
                                        Command="{Binding SaveConfigCommand}"
                                        Content="保存配置"
                                        Style="{StaticResource CompactFlatButton}"
                                        ToolTip="设备参数 JSON（全部协议走 CommunicationNew）" AutomationProperties.Name="保存配置" />
                                    <Button
                                        Command="{Binding LoadConfigCommand}"
                                        Content="加载配置"
                                        Style="{StaticResource CompactFlatButton}" AutomationProperties.Name="加载配置" />
                                    <Separator />
                                    <Button
                                        Command="{Binding ConnectAllCommand}"
                                        Content="全部连接"
                                        Style="{StaticResource CompactFlatButton}" AutomationProperties.Name="全部连接" />
                                    <Button
                                        Command="{Binding DisconnectAllCommand}"
                                        Content="全部断开"
                                        Style="{StaticResource CompactFlatButton}" AutomationProperties.Name="全部断开" />
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </Grid>

                    <!--
                        常态只有 连接/断开/移除 三个等宽按钮；"取消操作"只在真的有耗时操作在跑时出现，
                        平时它是一个永远点不动的灰按钮，占掉一格还让人以为少了功能。
                    -->
                    <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">

                        <UniformGrid Columns="2">

                            <Button
                                Margin="5"
                                Command="{Binding ConnectCommand}"
                                Content="连接"
                                Style="{StaticResource ActionSolid}"
                                ToolTip="连接当前选中的设备" AutomationProperties.Name="连接" />
                            <Button
                                Margin="5"
                                Command="{Binding DisconnectCommand}"
                                Content="断开"
                                Style="{StaticResource QuietButton}" AutomationProperties.Name="断开" />
                            <Button
                                Margin="5"
                                Command="{Binding RemoveCommand}"
                                Content="移除"
                                Style="{StaticResource DangerButton}" AutomationProperties.Name="移除" />
                            <Button
                                Margin="5"
                                Command="{Binding CancelOperationCommand}"
                                Content="取消当前操作"
                                Style="{StaticResource QuietButton}" AutomationProperties.Name="取消当前操作" />
                        </UniformGrid>
                    </StackPanel>

                    <Grid>
                        <ListBox
                            Margin="0,4,0,0"
                            HorizontalContentAlignment="Stretch"
                            ItemTemplate="{StaticResource DeviceItemTemplate}"
                            ItemsSource="{Binding Devices}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedDevice}">
                            <!--  选中项：左侧色条 + 微亮背景，一眼看到当前操作的是哪台  -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!--  空列表时给一句下一步指引，而不是留一块看不出原因的空白  -->
                        <TextBlock
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            TextAlignment="Center">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource HintText}" TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDevices}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="还没有通讯设备" />
                            <LineBreak />
                            <Run Text="点右上「新建」，先选协议再填参数" />
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </materialDesign:Card>

            <!--  右栏：上操作区 + 下输出区（通讯日志），可拖拽高度  -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="5*" />
                </Grid.RowDefinitions>

                <GridSplitter
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="SizeNS" />

                <!--  操作：按协议分组（地址组 / 原始收发组二选一），按钮内联进各组标题行  -->
                <materialDesign:Card
                    Grid.Row="0"
                    Padding="12"
                    UniformCornerRadius="12">
                    <!--  矮窗口下让整列滚动，而不是把行高压扁、提示文字被裁  -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="560" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题随协议切换（地址读写 / 原始收发），HEX 开关收进标题行  -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{Binding OperationTitle}" />
                                <CheckBox
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="HEX"
                                    IsChecked="{Binding UseHex}"
                                    ToolTip="勾选：收发按原始十六进制字节（地址写入忽略数据类型）；取消：地址读写按所选数据类型编解码，仅 String 用 UTF-8" />
                            </Grid>

                            <!--  协议提示：一行说清本协议能干什么 + 当前连接态  -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="ShieldOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Opacity="0.85"
                                    Text="{Binding CapabilitySummary}"
                                   TextWrapping="Wrap"
                                    ToolTip="{Binding ProtocolUsageHint}" />
                            </Grid>
                            <!--
                                地址读写组（Modbus / MC / OPC UA / HTTP）：
                                地址、读取长度、写入数据放在同一个 Grid 的同一套列里，
                                两组的左右边界与行距因此必然一致，不会再出现"地址和写入数据间距不一样"。
                            -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,0,0,10"
                                Visibility="{Binding DeviceSupportsAddress, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="按地址读写" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource FieldLabel}"
                                        Text="地址" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource FieldLabel}"
                                        Text="读取长度"
                                        ToolTip="一次读多少个：Modbus 是寄存器数，MC / OPC UA 是元素数，HTTP 是字节数" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="4"
                                        Style="{StaticResource FieldLabel}"
                                        Text="数据类型"
                                        ToolTip="写入按该类型编码为寄存器字节；读取按该类型解码显示。仅 String 用 UTF-8，数值类型按字节序二进制" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="字节序"
                                        ToolTip="32 位及以上数值的字/字节顺序（ABCD 大端 … DCBA 小端）；String / ByteArray 忽略。三菱 MC 默认 DCBA（线上小端），编解码自动做设备内交换补偿" />

                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Height="Auto"
                                        Style="{StaticResource DmInput}"
                                        Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{Binding AddressDetailHint}" MinHeight="32" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Height="Auto"
                                        Style="{StaticResource DmInput}"
                                        Text="{Binding ReadLength, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="读取长度（寄存器数 / 元素数 / 字节数）" MinHeight="32" />
                                    <ComboBox
                                        Grid.Row="2"
                                        Grid.Column="4"
                                        Height="Auto"
                                        VerticalContentAlignment="Center"
                                        ItemsSource="{Binding DataTypeOptions}"
                                        SelectedItem="{Binding SelectedDataType, Mode=TwoWay}"
                                        Style="{StaticResource DmCombo}"
                                        ToolTip="写入按该类型编码；读取按该类型解码。HEX 勾选时写入仍按原始字节，忽略类型" MinHeight="32" />
                                    <ComboBox
                                        Grid.Row="2"
                                        Grid.Column="6"
                                        Height="Auto"
                                        VerticalContentAlignment="Center"
                                        ItemsSource="{Binding DataFormatOptions}"
                                        SelectedItem="{Binding SelectedDataFormat, Mode=TwoWay}"
                                        Style="{StaticResource DmCombo}"
                                        ToolTip="设备侧字/字节顺序；String、ByteArray、Bool、Byte 不受此影响。三菱 MC 默认 DCBA（线上小端），编解码会自动做设备内交换补偿" MinHeight="32" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="8"
                                        MinWidth="72"
                                        Padding="14,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding ReadCommand}"
                                        Content="读取"
                                        Style="{StaticResource ActionSolid}"
                                        ToolTip="按左侧地址、长度与数据类型取数，结果记入下方「通讯日志」（RX 记录）" AutomationProperties.Name="读取" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource FieldLabel}"
                                        Text="写入数据" />
                                    <TextBox
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="7"
                                        Height="Auto"
                                        VerticalContentAlignment="Center"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        Style="{StaticResource DmInput}"
                                        Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"
                                       TextWrapping="Wrap"
                                        ToolTip="HEX 勾选：按十六进制原始字节写入；否则按上方数据类型解析（如 Int16 填 1234，Float 填 3.14，String 才按 UTF-8）" MinHeight="32" />
                                    <Button
                                        Grid.Row="6"
                                        Grid.Column="8"
                                        MinWidth="72"
                                        Padding="14,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding WriteCommand}"
                                        Content="写入"
                                        Style="{StaticResource ActionGhost}"
                                        ToolTip="按数据类型编码后写入到上方地址" AutomationProperties.Name="写入" />
                                </Grid>

                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource HintText}"
                                    Text="{Binding WriteLengthHint}"
                                   TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  原始发送组（TCP / UDP / 串口）：发送框 + 右侧发送/收发按钮，调试助手式  -->
                            <StackPanel
                                Grid.Row="3"
                                Margin="0,0,0,10"
                                Visibility="{Binding DeviceSupportsRaw, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="发送数据" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--  回车发送：按 Enter 直接触发发送，不用再去点按钮  -->
                                    <TextBox
                                        Grid.Column="0"
                                        Height="Auto"
                                        VerticalContentAlignment="Center"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        Style="{StaticResource DmInput}"
                                        Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="HEX 勾选时按十六进制解析，否则按文本发送" MinHeight="32">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SendRawCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            MinWidth="64"
                                            Command="{Binding SendRawCommand}"
                                            Content="发送"
                                            Style="{StaticResource ActionSolid}"
                                            ToolTip="原始发送，仅字节流/数据报协议（TCP / UDP / 串口）" AutomationProperties.Name="发送" />
                                        <Button
                                            MinWidth="64"
                                            Margin="6,0,0,0"
                                            Command="{Binding SendAndReceiveCommand}"
                                            Content="收发"
                                            Style="{StaticResource ActionGhost}"
                                            ToolTip="发送并等待回复，需要设备实现 IRequestReplyClient（服务端没有这项能力）"
                                            Visibility="{Binding DeviceSupportsRequestReply, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="收发" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel
                                    Height="32"
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal"
                                    ToolTip="已发送过的报文（最新在前），选中即填入上方发送框">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FieldLabel}"
                                        Text="历史数据" />
                                    <ComboBox
                                        Width="240"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        IsEditable="True"
                                        ItemsSource="{Binding PayloadHistory}"
                                        SelectedItem="{Binding Payload, Mode=OneWay}"
                                        Style="{StaticResource DmCombo}" />
                                </StackPanel>
                            </StackPanel>

                            <!--
                                循环发送独立成组：字节流协议循环「发送」，地址协议循环「读取」。
                                原来它挂在发送组里，选 Modbus 时整块都不显示，看起来就像这个功能没有。
                            -->
                            <StackPanel
                                Grid.Row="4"
                                Margin="0,0,0,10"
                                Visibility="{Binding SupportsLoop, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="{Binding LoopTitle}" />
                                <StackPanel
                                    Height="32"
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal"
                                    ToolTip="按间隔反复执行当前协议的主动作">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FieldLabel}"
                                        Text="间隔 (ms)" />
                                    <TextBox
                                        Width="64"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DmInput}"
                                        Text="{Binding LoopIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="每隔多少毫秒自动执行一次，最小 10 毫秒" />
                                    <Button
                                        Margin="10,0,0,0"
                                        Padding="14,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding StartLoopSendCommand}"
                                        Content="开始"
                                        Style="{StaticResource ActionSolid}"
                                        ToolTip="设备已连接后可点：按上面的间隔反复执行当前动作" AutomationProperties.Name="开始" />
                                    <Button
                                        Margin="6,0,0,0"
                                        Padding="14,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding StopLoopSendCommand}"
                                        Content="停止"
                                        Style="{StaticResource ActionGhost}"
                                        ToolTip="停止循环；断开、移除设备或切换设备时也会自动停止" AutomationProperties.Name="停止" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource HintText}"
                                        Text="{Binding LoopSendStateText}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  底部说明：无内容时整行收起，不占高度  -->
                            <TextBlock
                                Grid.Row="5"
                                Margin="0,8,0,0"
                                Style="{StaticResource HintText}"
                                Text="{Binding BottomNotice}"
                               TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </materialDesign:Card>

                <!--  输出区：只有通讯日志。读取/收发应答/被动推送统一记为 RX（含全文），不再另设接收窗口。  -->
                <!--  子内容在缩放/改高后若画进 Card 圆角象限会把圆角盖成直角，这里按圆角几何裁剪  -->
                <materialDesign:Card
                    Grid.Row="2"
                    Padding="12"
                    UniformCornerRadius="12">
                    <DockPanel>
                        <!--  标题行：左边标题，右边计数与动作  -->
                        <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="通讯日志"
                                    ToolTip="连接、收发、错误混排的事件时间线，可导出；RX 为全文显示" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    Height="20"
                                    Padding="4,1"
                                    Background="{DynamicResource Brush.Warning.Soft}"
                                    CornerRadius="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.Warning}"
                                        Text="TX" />
                                </Border>
                                <TextBlock
                                    Margin="4,0,10,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Text="{Binding TxCountText}" />
                                <Border
                                    Height="20"
                                    Padding="4,1"
                                    Background="{DynamicResource Brush.Info.Soft}"
                                    CornerRadius="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.Info}"
                                        Text="RX" />
                                </Border>
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Text="{Binding RxCountText}" />
                                <CheckBox
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="自动滚动"
                                    FontSize="11"
                                    IsChecked="{Binding AutoScrollLog}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    Command="{Binding ClearLogCommand}"
                                    Content="清空"
                                    FontSize="11"
                                    Style="{StaticResource CompactFlatButton}" AutomationProperties.Name="清空" />
                                <Button
                                    Margin="4,0,0,0"
                                    Padding="8,2"
                                    Command="{Binding ExportLogCommand}"
                                    Content="导出"
                                    FontSize="11"
                                    Style="{StaticResource CompactFlatButton}" AutomationProperties.Name="导出" />
                                <Button
                                    Margin="4,0,0,0"
                                    Padding="8,2"
                                    Command="{Binding ResetCountersCommand}"
                                    Content="归零"
                                    FontSize="11"
                                    Style="{StaticResource CompactFlatButton}"
                                    ToolTip="TX / RX 计数归零" AutomationProperties.Name="归零" />
                            </StackPanel>
                        </Grid>
                        <!--  过滤行：级别 + 设备 + 关键字  -->
                        <WrapPanel
                            Margin="0,0,0,8"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal">
                            <ComboBox
                                Width="86"
                                Padding="4"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding LogLevelOptions}"
                                SelectedItem="{Binding LogLevelFilter, Mode=TwoWay}"
                                Style="{StaticResource DmCombo}"
                                ToolTip="日志级别过滤" />
                            <ComboBox
                                Width="130"
                                Margin="10,0,0,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding LogDeviceOptions}"
                                SelectedItem="{Binding LogDeviceFilter, Mode=TwoWay}"
                                Style="{StaticResource DmCombo}"
                                ToolTip="按设备过滤：一个设备对应一份日志视图" />
                            <CheckBox
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="跟随选中设备"
                                FontSize="11"
                                IsChecked="{Binding FollowSelectedDevice}"
                                ToolTip="勾选后左侧切设备，日志自动切到该设备；手动改设备下拉会自动取消勾选" />
                            <TextBox
                                Width="130"
                                Margin="10,0,0,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                materialDesign:HintAssist.Hint="关键字"
                                Style="{StaticResource DmInput}"
                                Text="{Binding LogKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <!--  日志：连接/收发/错误的事件时间线，RX 为全文  -->
                        <ListBox
                            x:Name="LogList"
                            FontFamily="Consolas"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                           VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Top"
                                            FontSize="11"
                                            Opacity="0.6"
                                            Text="{Binding TimeText}" />
                                        <Border Grid.Column="1" Style="{StaticResource LogLevelBadge}">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource LogLevelText}"
                                                Text="{Binding LevelText}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="2"
                                            MaxWidth="120"
                                            VerticalAlignment="Top"
                                            FontSize="11"
                                            Opacity="0.75"
                                            Text="{Binding Source}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Source}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            FontSize="12"
                                            Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                            ToolTip="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
