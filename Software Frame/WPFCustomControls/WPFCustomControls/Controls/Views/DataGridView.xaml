<!--
中文阅读说明：界面与资源声明。
WPFCustomControls 模块：基础 WPF 控件、属性编辑器及主题资源，供业务界面与工作台复用。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<DataGrid
    x:Class="WPFCustomControls.Controls.DataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="dataGrid"
    d:DesignHeight="450"
    d:DesignWidth="800"
    materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
    CanUserAddRows="False"
    EnableColumnVirtualization="True"
    EnableRowVirtualization="True"
    FontFamily="Microsoft YaHei UI"
    HorizontalScrollBarVisibility="Auto"
    RowHeight="{Binding RowHeight, ElementName=dataGrid}"
    ScrollViewer.CanContentScroll="True"
    ScrollViewer.IsDeferredScrollingEnabled="True"
    SelectionMode="Extended"
    Style="{StaticResource MaterialDesignDataGrid}"
    Validation.ErrorTemplate="{x:Null}"
    VerticalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Standard"
    mc:Ignorable="d" />
