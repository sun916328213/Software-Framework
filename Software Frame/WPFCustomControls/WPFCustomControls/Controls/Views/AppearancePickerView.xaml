<UserControl
    x:Class="WPFCustomControls.Controls.AppearancePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFCustomControls;component/Resources/CompactControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Button
            x:Name="AppearanceButton"
            Width="76"
            Height="30"
            MinHeight="30"
            Padding="8,3"
            AutomationProperties.Name="外观"
            Click="ToggleAppearance"
            FontSize="12"
            Style="{StaticResource CompactFlatButton}"
            ToolTip="外观：浅色 / 深色、主色和辅色">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon
                    Width="18"
                    Height="18"
                    Margin="0,0,5,0"
                    Kind="PaletteOutline" />
                <TextBlock VerticalAlignment="Center" Text="外观" />
            </StackPanel>
        </Button>
        <Popup
            x:Name="AppearancePopup"
            AllowsTransparency="True"
            Closed="PopupClosed"
            HorizontalOffset="0"
            Opened="PopupOpened"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=AppearanceButton}"
            StaysOpen="False">
            <Border
                Padding="12"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                BorderThickness="1"
                CornerRadius="6"
                TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Text="外观设置" />
                    <ContentControl x:Name="PickerHost" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
