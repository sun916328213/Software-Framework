<UserControl
    x:Class="WPFCustomControls.Controls.TitleSeparatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="UserControl"
    d:DesignHeight="100"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <DockPanel>
        <Label
            Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
            Content="{Binding ElementName=UserControl, Path=Title}"
            DockPanel.Dock="Top" />
        <Separator Style="{StaticResource Separator_Style}" />
    </DockPanel>
</UserControl>
