<UserControl
    x:Class="WPFCustomControls.Controls.CircleProcessBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="UserControl"
    d:DesignHeight="100"
    d:DesignWidth="100"
    mc:Ignorable="d">

    <Grid>
        <ProgressBar
            x:Name="ProgressBar1"
            Width="60"
            Height="60"
            BorderThickness="10"
            IsIndeterminate="False"
            Style="{StaticResource MaterialDesignCircularProgressBar}"
            Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock
            x:Name="TextBlock1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding Value, StringFormat='{}{0:F2}%', RelativeSource={RelativeSource AncestorType=UserControl}}"
            TextAlignment="Center" />
    </Grid>
</UserControl>
