<UserControl
    x:Class="WPFCustomControls.Controls.TitleTextBlockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFCustomControls.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="statisticsItem"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <DockPanel>
        <TextBlock
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            Text="{Binding Title, ElementName=statisticsItem}" />

        <TextBlock
            x:Name="ValueLabel" FontWeight="SemiBold"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            Text="{Binding Value, ElementName=statisticsItem}" />

        <TextBlock
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            Text="{Binding Unit, ElementName=statisticsItem}" />
    </DockPanel>
</UserControl>
