<!--
中文阅读说明：界面与资源声明。
WPFCustomControls 模块：基础 WPF 控件、属性编辑器及主题资源，供业务界面与工作台复用。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window
    x:Class="WPFCustomControls.Window.Views.ProgramLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:WPFCustomControls.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootWindow"
    Width="450"
    Height="200"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    Background="Transparent"
    SnapsToDevicePixels="True"
    Style="{DynamicResource DialogWindowStyle}"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFCustomControls;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
        BorderThickness="2"
        CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="20,20,20,10"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Text="项目加载中..." />
                <ProgressBar
                    Width="20"
                    Height="20"
                    Margin="10,0,0,0"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Height="12"
                Margin="30,10"
                custom:RoundedCornerClipAssist.IsEnabled="True"
                CornerRadius="5">
                <ProgressBar
                    x:Name="ProgressBar"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Height}"
                    VerticalContentAlignment="Stretch"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    IsIndeterminate="False"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource MaterialDesignLinearProgressBar}"
                    Value="{Binding ElementName=RootWindow, Path=ProgressValue}" />
            </Border>


            <StackPanel
                Grid.Row="2"
                Margin="30,10,30,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="StatusTextBlock"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Text="{Binding ElementName=RootWindow, Path=StatusText}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Text="{Binding ElementName=RootWindow, Path=ProgressValue, StringFormat='{}{0}%'}" />
            </StackPanel>

            <TextBlock
                Grid.Row="3"
                Margin="30,0,30,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Text="{Binding ElementName=RootWindow, Path=StepInfo}" />
        </Grid>
    </Border>
</Window>
