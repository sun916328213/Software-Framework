<!--
中文阅读说明：界面与资源声明。
WPFCustomControls 模块：基础 WPF 控件、属性编辑器及主题资源，供业务界面与工作台复用。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window
    x:Class="WPFCustomControls.PropertyGrid.Views.OutputPortEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WPFCustomControls.ValueConvert"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="360"
    Height="300"
    SizeToContent="Height"
    MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    Background="Transparent"
    FontSize="14"
    Style="{DynamicResource DialogWindowStyle}"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Border
        Padding="12"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
        BorderThickness="2"
        CornerRadius="12"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
        <Border.Resources>
            <conv:BoolInverseConverter x:Key="PG_InverseBool" />
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                FontSize="15"
                FontWeight="Medium"
                Text="选择端口类型：" />

            <!-- 选项1：绑定工具属性 -->
            <RadioButton
                Grid.Row="1"
                Margin="0,0,0,8"
                Content="绑定工具属性"
                IsChecked="{Binding IsToolProperty}" />

            <ComboBox
                Grid.Row="2"
                Height="32"
                Margin="20,0,0,12"
                ItemsSource="{Binding AvailableProperties}"
                SelectedItem="{Binding BoundPropertyName}"
                IsEnabled="{Binding IsToolProperty}" />

            <!-- 选项2：自定义端口 -->
            <RadioButton
                Grid.Row="3"
                Margin="0,0,0,8"
                Content="自定义端口（不绑定属性）"
                IsChecked="{Binding IsToolProperty, Converter={StaticResource PG_InverseBool}}" />

            <TextBox
                Grid.Row="4"
                Height="32"
                Margin="20,0,0,0"
                VerticalContentAlignment="Center"
                Text="{Binding CustomPortName}"
                IsEnabled="{Binding IsToolProperty, Converter={StaticResource PG_InverseBool}}"
                ToolTip="请输入端口名称" />

            <StackPanel
                Grid.Row="5"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="32"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource CompactOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.8"
                            Text="取消" />
                    </StackPanel>
                </Button>
                <Button
                    Width="100"
                    Height="32"
                    Margin="10,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Cursor="Hand"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Style="{StaticResource CompactOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Check" />
                        <TextBlock VerticalAlignment="Center" Text="确认" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>