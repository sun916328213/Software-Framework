<UserControl
    x:Class="WPFCustomControls.PropertyGrid.Views.FilePathEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WPFCustomControls.ValueConvert"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root">
    <UserControl.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="HasError" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PathBox"
                AutomationProperties.Name="文件路径"
                IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                Style="{DynamicResource CompactTextBox}"
                Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{Binding Text, ElementName=Root}" />
            <Button
                x:Name="BrowseButton"
                Grid.Column="1"
                Width="30"
                MinWidth="30"
                Margin="4,0,0,0"
                Padding="4"
                AutomationProperties.Name="选择文件"
                Click="Browse"
                Style="{DynamicResource CompactFlatButton}"
                ToolTip="选择文件">
                <md:PackIcon
                    Width="18"
                    Height="18"
                    Kind="FolderOpenOutline" />
            </Button>
        </Grid>
        <TextBlock
            Grid.Row="1"
            FontSize="12"
            Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
            Text="{Binding SelectionError, ElementName=Root}"
            TextWrapping="Wrap"
            Visibility="{Binding SelectionError, ElementName=Root, Converter={StaticResource HasError}}" />
    </Grid>
</UserControl>
