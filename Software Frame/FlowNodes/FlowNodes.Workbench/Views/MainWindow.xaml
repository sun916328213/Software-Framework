<!--
中文阅读说明：界面与资源声明。
FlowNodes 模块：WPF 流程节点与执行、编辑协作的集成；新增或迁移节点需同时核对节点目录、执行契约和持久化类型身份。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window x:Class="FlowNodes.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:controls="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    Title="FlowNodes 测试工作台" Style="{StaticResource WorkbenchWindow}" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,24">
                    <md:PackIcon Kind="GraphOutline" Width="36" Height="36" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" HorizontalAlignment="Left"/>
                    <TextBlock Text="FlowNodes" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBlock Text="测试工作台" Opacity="0.7"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <controls:ThemePickerView Theme="{Binding Theme}" FieldBackground="{DynamicResource MaterialDesign.Brush.Card.Background}" FieldForeground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock Text="{Binding NavigationError}" TextWrapping="Wrap" Margin="0,8,0,0"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ListBox ItemsSource="{Binding NavItems}" IsEnabled="{Binding CanSelectNavigation}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignListBox}" Margin="12,0" VerticalAlignment="Top">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Margin="8,6" FontWeight="SemiBold"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16"><TextBlock Text="流程节点" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="节点验证 · 运行与输出" Opacity="0.7" Margin="0,6,0,0"/></StackPanel>
            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="FlowRegion"/>
        </Grid>
    </Grid>
</Window>