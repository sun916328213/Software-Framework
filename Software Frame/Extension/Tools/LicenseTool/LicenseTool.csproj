<!--
中文阅读说明：项目构建声明。
Extension 模块：共享基础能力与集成适配；Extension.Core 保持轻量，WPF 和厂商 SDK 集成归其他部分。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>LicenseTool</RootNamespace>
    <AssemblyName>LicenseTool</AssemblyName>
    <Description>软件授权签发与验证工具（配套 Extension.Security）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <ProjectReference Include="..\..\Extension.Core\Extension.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\..\..\WPFCustomControls\WPFCustomControls\Resources\CompactControlStyles.xaml" Link="Resources\CompactControlStyles.xaml" />
  </ItemGroup>
</Project>
