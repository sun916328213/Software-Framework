<!--
中文阅读说明：界面与资源声明。
Extension 模块：共享基础能力与集成适配；Extension.Core 保持轻量，WPF 和厂商 SDK 集成归其他部分。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window x:Class="LicenseTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License 授权工具" Height="680" Width="900" MinWidth="760" MinHeight="560"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource CompactOutlinedButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource CompactOutlinedTextBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <!-- ══════════ 密钥管理 ══════════ -->
            <TabItem Header="① 密钥管理">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.75"
                        Text="流程：厂商在此生成密钥对 → 私钥自己存好（绝不进客户端）→ 公钥硬编码/配置文件 embedded 到客户端程序。"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="BtnGenKeys" Content="生成 2048 密钥对" Margin="0,4,8,4" Padding="12,4" Click="BtnGenKeys_Click" AutomationProperties.Name="生成 2048 密钥对"  MinHeight="32"  Style="{StaticResource CompactPrimaryButton}" />
                        <Button x:Name="BtnLoadPri" Content="加载私钥" Margin="0,4,8,4" Padding="12,4" Click="BtnLoadPri_Click" AutomationProperties.Name="加载私钥"  MinHeight="32" />
                        <Button x:Name="BtnLoadPub" Content="加载公钥" Margin="0,4,8,4" Padding="12,4" Click="BtnLoadPub_Click" AutomationProperties.Name="加载公钥"  MinHeight="32" />
                        <Button x:Name="BtnSavePri" Content="保存私钥" Margin="0,4,8,4" Padding="12,4" Click="BtnSavePri_Click" AutomationProperties.Name="保存私钥"  MinHeight="32" />
                        <Button x:Name="BtnSavePub" Content="保存公钥" Margin="0,4,8,4" Padding="12,4" Click="BtnSavePub_Click" AutomationProperties.Name="保存公钥"  MinHeight="32" />
                    </WrapPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,4" Text="私钥（厂商保管）："/>
                        <TextBox Style="{StaticResource CompactMultilineTextBox}" Grid.Row="1" x:Name="TxtPrivateKey" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />
                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,4" Text="公钥（嵌入客户端）："/>
                        <TextBox Style="{StaticResource CompactMultilineTextBox}" Grid.Row="3" x:Name="TxtPublicKey" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />
                    </Grid>
                </DockPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ 签发 License ══════════ -->
            <TabItem Header="② 签发 License">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel Margin="12">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="80"/>
                            <RowDefinition Height="Auto" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="客户名称：" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource CompactTextBox}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtCustomer" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="绑定机器码：" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource CompactTextBox}" Grid.Row="1" Grid.Column="1" x:Name="TxtMachineCode" Margin="0,4" FontFamily="Consolas"
                                 ToolTip="为空 = 不绑定，任意机器可用"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnFillLocalMachine" Content="填入本机" Margin="0,4,8,4" Padding="12,4" Click="BtnFillLocalMachine_Click" AutomationProperties.Name="填入本机"  MinHeight="32" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="本机机器码：" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LblLocalMachine"
                                   VerticalAlignment="Center" Margin="0,4" FontFamily="Consolas" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="过期日期：" TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <DatePicker x:Name="DpExpire" Width="160"/>
                            <CheckBox x:Name="ChkPermanent" Content="永久有效" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="试用天数：" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBox Style="{StaticResource CompactTextBox}" x:Name="TxtTrialDays" Text="30" Width="72"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" Text="使用私钥：" TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <Button x:Name="BtnUseKeyTabPri" Content="取自【密钥管理】页私钥框" Padding="12,4" Click="BtnUseKeyTabPri_Click" AutomationProperties.Name="取自【密钥管理】页私钥框"  MinHeight="32"  Margin="0,4,8,4" />
                            <TextBlock x:Name="LblPriStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.75" Text="未载入"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" Text="功能点（每行一个，空=全部）：" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource CompactMultilineTextBox}" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtFeatures" Margin="0,4"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="Vision&#x0a;Motion" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" Text="扩展字段（每行 key=value）：" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource CompactMultilineTextBox}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtExtra" Margin="0,4"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />

                        <WrapPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Button x:Name="BtnCreate" Content="生成 License" Padding="12,4" Margin="0,4,8,4" Click="BtnCreate_Click" AutomationProperties.Name="生成 License"  MinHeight="32"  Style="{StaticResource CompactPrimaryButton}" />
                            <Button x:Name="BtnCreateTrial" Content="生成试用版" Padding="12,4" Margin="0,4,8,4" Click="BtnCreateTrial_Click" AutomationProperties.Name="生成试用版"  MinHeight="32" />
                            <Button x:Name="BtnSaveLic" Content="保存为 .lic 文件" Padding="12,4" Click="BtnSaveLic_Click" AutomationProperties.Name="保存为 .lic 文件"  MinHeight="32"  Margin="0,4,8,4" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,8,0,4" Text="License 文本："/>
                    <TextBox Style="{StaticResource CompactMultilineTextBox}" x:Name="TxtLicenseOut" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" IsReadOnly="True" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />
                </DockPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ 验证 License ══════════ -->
            <TabItem Header="③ 验证 License">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel Margin="12">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="96"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="License 文本：" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource CompactMultilineTextBox}" Grid.Row="0" Grid.Column="1" x:Name="TxtLicIn" Margin="0,4"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />
                        <Button Grid.Row="0" Grid.Column="2" x:Name="BtnLoadLic" Content="从 .lic 文件加载" Margin="0,4,8,4" Padding="12,4" Click="BtnLoadLic_Click" AutomationProperties.Name="从 .lic 文件加载"  MinHeight="32" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4" Text="客户端公钥：" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource CompactTextBox}" Grid.Row="1" Grid.Column="1" x:Name="TxtVerifyPub" Margin="0,4" FontFamily="Consolas" FontSize="12"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="BtnUseKeyTabPub" Content="取自【密钥管理】页" Margin="0,4,8,4" Padding="12,4" Click="BtnUseKeyTabPub_Click" AutomationProperties.Name="取自【密钥管理】页"  MinHeight="32" />

                        <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="ChkCheckMachine" Content="校验机器码绑定" IsChecked="True" VerticalAlignment="Center"/>
                            <TextBlock Text="所需功能点：" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBox Style="{StaticResource CompactTextBox}" x:Name="TxtRequiredFeature" Width="112"/>
                        </WrapPanel>

                        <Button Grid.Row="3" Grid.Column="1" x:Name="BtnVerify" Content="验 证" Padding="12,4"
                                HorizontalAlignment="Left" Margin="0,4,8,4" Click="BtnVerify_Click" AutomationProperties.Name="验 证"  MinHeight="32"  Style="{StaticResource CompactPrimaryButton}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" x:Name="TxtVerifyResult" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,4" Text="等待验证…"/>
                    <TextBox Style="{StaticResource CompactMultilineTextBox}" x:Name="TxtVerifyDetail" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" MinHeight="96"  MaxHeight="240"  VerticalContentAlignment="Top" />
                </DockPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
