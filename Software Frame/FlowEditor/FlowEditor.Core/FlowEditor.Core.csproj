<!--
中文阅读说明：项目构建声明。
FlowEditor 模块：流程模型、执行和编辑器协作；Core、Runtime 与 Controls 分别承担模型契约、执行能力和界面职责。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FlowEditor.Core</RootNamespace>
    <AssemblyName>FlowEditor.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1573;CS1574;CS1587</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <PropertyGroup><DefineConstants>$(DefineConstants);FLOW_EDITOR_TYPE_RESOLVER</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Extension\Extension.Core\Core\Reflection\FrameworkTypeResolver.cs" Link="Compatibility\FrameworkTypeResolver.cs" />
    <EmbeddedResource Include="..\..\Extension\Extension.Core\Core\Reflection\FrameworkTypeAliases.json" LogicalName="Framework.TypeAliases.json" />
  </ItemGroup>
</Project>
