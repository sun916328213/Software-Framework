<!--
中文阅读说明：界面与资源声明。
FlowEditor 模块：流程模型、执行和编辑器协作；Core、Runtime 与 Controls 分别承担模型契约、执行能力和界面职责。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="FlowEditor.Controls.Views.FlowCommandBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
        </Style>

        <Style
            x:Key="ToolBarButtonStyle"
            BasedOn="{StaticResource CompactFlatButton}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,2" />
        </Style>

        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="12,8" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0">
                <Button
                    Command="{Binding RunCurrentCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="当前流程执行"
                    ToolTip="当前流程执行">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="NavigationVariant" />
                </Button>
                <Button
                    Command="{Binding RunAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="全部运行 (F5)"
                    ToolTip="全部运行 (F5)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="PlayArrow" />
                </Button>
                <Button
                    Command="{Binding StopAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="全部停止 (Shift+F5)"
                    ToolTip="全部停止 (Shift+F5)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Stop" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding LoopRunAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="循环执行"
                    ToolTip="循环执行">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Loop" />
                </Button>
                <Button
                    Command="{Binding LoopStopAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="停止循环"
                    ToolTip="停止循环">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="StopCircleOutline" />
                </Button>
                <TextBlock
                    Margin="6,0,2,0"
                    Style="{StaticResource InfoTextStyle}"
                    Text="间隔(ms):" />
                <TextBox Style="{StaticResource CompactTextBox}"
                    Width="70"
                    Height="32"
                    AutomationProperties.Name="循环执行间隔（毫秒）"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding ActiveTab.Model.LoopInterval, UpdateSourceTrigger=PropertyChanged}" />
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding NewFlowCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="新建流程 (Ctrl+N)"
                    ToolTip="新建流程 (Ctrl+N)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Plus" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.SaveCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="保存当前页面流程 (Ctrl+S)"
                    ToolTip="保存当前页面流程 (Ctrl+S)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSave" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.SaveAsCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="另存为当前页面流程"
                    ToolTip="另存为当前页面流程">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSaveAll" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.LoadCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="打开文件 (Ctrl+O)"
                    ToolTip="打开文件 (Ctrl+O)">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="FolderOpen" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding SaveAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="保存所有流程"
                    ToolTip="保存所有流程">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSaveAll" />
                </Button>
                <Button
                    Command="{Binding SaveAllAsCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="多流程另存为"
                    ToolTip="多流程另存为">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="ContentSaveMoveOutline" />
                </Button>
                <Button
                    Command="{Binding LoadAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="打开多流程文件"
                    ToolTip="打开多流程文件">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="FolderMultipleOutline" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding ActiveTab.ClearAllCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="清空当前流程"
                    ToolTip="清空当前流程">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Delete" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.UndoCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="撤销 (Ctrl+Z)"
                    ToolTip="撤销 (Ctrl+Z)">
                    <materialDesign:PackIcon Kind="Undo" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.RedoCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="重做 (Ctrl+Y)"
                    ToolTip="重做 (Ctrl+Y)">
                    <materialDesign:PackIcon Kind="Redo" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding ActiveTab.ZoomOutCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="缩小"
                    ToolTip="缩小">
                    <materialDesign:PackIcon Kind="MagnifyMinus" />
                </Button>
                <TextBlock
                    Width="44"
                    Style="{StaticResource InfoTextStyle}"
                    Text="{Binding ActiveTab.Model.ZoomPercentage}"
                    TextAlignment="Center" />
                <Button
                    Command="{Binding ActiveTab.ZoomInCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="放大"
                    ToolTip="放大">
                    <materialDesign:PackIcon Kind="MagnifyPlus" />
                </Button>
                <Button
                    Command="{Binding ActiveTab.ZoomToFitCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="自适应画布"
                    ToolTip="自适应画布">
                    <materialDesign:PackIcon Kind="FitToPage" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Button
                    Command="{Binding ActiveTab.StepContinueCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="执行当前选中节点（调试暂停时继续）"
                    ToolTip="执行当前选中节点（调试暂停时继续）">
                    <materialDesign:PackIcon Kind="StepForward" />
                </Button>
                <Button
                    x:Name="ExportPngButton"
                    Click="OnExportPngClick"
                    IsEnabled="{Binding HasActiveTab}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="导出PNG"
                    ToolTip="导出PNG">
                    <materialDesign:PackIcon Kind="ImageOutline" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                <Viewbox
                    x:Name="DataConnectionsToggleHost"
                    Width="40"
                    Height="22"
                    Stretch="Uniform">
                    <ToggleButton
                        x:Name="DataConnectionsToggle"
                        IsChecked="{Binding ActiveTab.Model.ShowDataConnections}"
                        AutomationProperties.Name="显示/隐藏数据连线"
                    ToolTip="显示/隐藏数据连线">
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="ChartTimelineVariant" />
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </Viewbox>
                <Button
                    x:Name="ShortcutHelpButton"
                    Command="{Binding ShowShortcutHelpCommand}"
                    Style="{StaticResource ToolBarButtonStyle}"
                    AutomationProperties.Name="显示快捷键帮助"
                    ToolTip="显示快捷键帮助">
                    <materialDesign:PackIcon Kind="HelpCircleOutline" />
                </Button>
            </WrapPanel>

            <StackPanel
                HorizontalAlignment="Right"
                Grid.Row="1" Margin="0,4,0,0"
                Orientation="Horizontal">
                <ProgressBar
                    Width="60"
                    Height="4"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsIndeterminate="{Binding ActiveTab.Model.IsRunning}"
                    Visibility="{Binding ActiveTab.Model.IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Margin="0,0,4,0"
                    Style="{StaticResource InfoTextStyle}"
                    Text="{Binding ActiveTab.Model.LoopProgressText}"
                    Visibility="{Binding ActiveTab.Model.IsLoopRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Margin="0,0,8,0"
                    Style="{StaticResource InfoTextStyle}"
                    Text="{Binding ActiveTab.Model.StatusText}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
