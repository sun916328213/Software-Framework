<!--
中文阅读说明：界面与资源声明。
FlowEditor 模块：流程模型、执行和编辑器协作；Core、Runtime 与 Controls 分别承担模型契约、执行能力和界面职责。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window
    x:Class="FlowEditor.Controls.Views.DispatchRuleEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="编辑分发规则"
    Width="560"
    MinWidth="420"
    MinHeight="420"
    Style="{StaticResource MaterialDesignWindow}"
    Height="480"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        </Style>
    </Window.Resources>


    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="编辑分发规则" />
            <TextBlock
                Margin="0,5,0,0"
                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                Text="每个匹配值只激活一个输出分支；输入为空或未命中规则时节点报错。"
                TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid
            x:Name="RulesGrid"
            Grid.Row="1"
            materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
            AutoGenerateColumns="False"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            Style="{StaticResource MaterialDesignDataGrid}"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            ItemsSource="{Binding Rules}">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="0.8*"
                    Binding="{Binding Match, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"
                    Header="匹配值" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Branch, UpdateSourceTrigger=PropertyChanged}"
                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"
                    Header="输出分支名称" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <Button
                Padding="12,5"
                Click="AddRule_Click"
                Content="添加规则" />
            <Button
                Margin="8,0,0,0"
                Padding="12,5"
                Click="DeleteRule_Click"
                Content="删除选中" />
                <CheckBox
                    x:Name="IgnoreCaseCheckBox"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Content="忽略大小写" />
                <CheckBox
                    x:Name="TrimInputCheckBox"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Content="去除首尾空格" />
        </WrapPanel>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ValidationText"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                MinWidth="82"
                Padding="12,6"
                Click="Cancel_Click"
                Content="取消"
                IsCancel="True" />
            <Button
                Grid.Column="2"
                MinWidth="82"
                Margin="8,0,0,0"
                Padding="12,6"
                Click="Save_Click"
                Content="保存"
                IsDefault="True" />
        </Grid>
    </Grid>
</Window>
