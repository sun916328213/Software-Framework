<!--
中文阅读说明：界面与资源声明。
FlowEditor 模块：流程模型、执行和编辑器协作；Core、Runtime 与 Controls 分别承担模型契约、执行能力和界面职责。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="FlowEditor.Controls.Views.FlowOutputPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:FlowEditor.Controls.Behaviors"
    xmlns:converters="clr-namespace:FlowEditor.Controls.Presentation.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <converters:FlowOutputTextFilterConverter x:Key="OutputTextFilterConverter" />
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel
                Grid.Row="0"
                Margin="8,4,4,4">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Margin="0,0,12,0"
                    Text="输出" />
                <Button
                    x:Name="ClearOutputButton"
                    Height="32"
                    HorizontalAlignment="Right"
                    Command="{Binding ActiveTab.ClearOutputCommand}"
                    Content="清除"
                    Style="{StaticResource CompactFlatButton}"
                    ToolTip="一键清空当前输出" />
                <CheckBox
                    x:Name="AutoScrollToggle"
                    Margin="8,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="自动滚动"
                    IsChecked="True"
                    ToolTip="取消后保留当前位置，新日志仍会继续接收" />
                <ComboBox Style="{StaticResource CompactComboBox}"
                    x:Name="OutputLevelFilter"
                    AutomationProperties.Name="输出日志级别"
                    Width="88"
                    Height="32"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    SelectedIndex="0"
                    SelectedValuePath="Tag"
                    ToolTip="按日志级别过滤显示">
                    <ComboBoxItem Content="全部" Tag="All" />
                    <ComboBoxItem Content="错误" Tag="Error" />
                    <ComboBoxItem Content="警告" Tag="Warning" />
                    <ComboBoxItem Content="信息" Tag="Info" />
                </ComboBox>
                <TextBox Style="{StaticResource CompactTextBox}"
                    x:Name="OutputSearchBox"
                    AutomationProperties.Name="搜索当前输出"
                    Width="180"
                    Height="32"
                    Margin="8,0,4,0"
                    Padding="6,1"
                    VerticalContentAlignment="Center"
                    ToolTip="搜索当前输出">
                    <materialDesign:HintAssist.Hint>
                        <StackPanel Margin="-2,0,0,0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Search" />
                            <TextBlock Text="搜索当前输出" />
                        </StackPanel>
                    </materialDesign:HintAssist.Hint>
                </TextBox>
            </WrapPanel>
            <TextBox
                x:Name="OutputTextBox"
                AutomationProperties.Name="流程执行输出"
                Grid.Row="1"
                Padding="10,2"
                behaviors:TextBoxAutoScrollBehavior.IsEnabled="{Binding IsChecked, ElementName=AutoScrollToggle}"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto">
                <TextBox.Text>
                    <MultiBinding Converter="{StaticResource OutputTextFilterConverter}" Mode="OneWay">
                        <Binding Path="ActiveTab.Model.OutputText" />
                        <Binding ElementName="OutputLevelFilter" Path="SelectedValue" />
                        <Binding ElementName="OutputSearchBox" Path="Text" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </Grid>
    </Border>
</UserControl>
