<!--
中文阅读说明：界面与资源声明。
DataManager 模块：数据访问契约、SQL/日志/Excel 运行能力及配置界面；具体数据库配置和实体由使用方决定。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <!--
            页面样式（SectionTitle / DmInput / DmCombo / DmGrid / OutputBox）
            不在本文件定义，只**引用** DataManager.Controls 自己那份 —— 样式归页面所有，宿主只做引用。
            各页面也在自己的 UserControl.Resources 里合并同一字典，故页面换宿主也能独立工作。
        -->
        <ResourceDictionary Source="pack://application:,,,/DataManager.Controls;component/Themes/PageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  品牌色（侧栏固定深色区专用，不随主题变；功能色仍走 MD 原生键）  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A" />

    <!--
        导航项标题：默认跟随浅深；选中行压在 Primary 上时换成 Primary.Foreground。
        
        ⚠️ 前景必须写在 Style 的 Setter 里。之前在 DataTemplate 里直接写
        `Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"` —— 那是**局部值**，
        会盖过 DataTrigger 的 Setter，触发器等于白挂（本仓踩过两次）。
        ⚠️ Style 里 `ElementName` 解析不到（独立命名域），只能用 RelativeSource 找 ListBoxItem。
        ⚠️ 不能写死白色：主色可能是浅色（Amber / Lime），要交给 MD 的 `Primary.Foreground`
        （按主色明暗自动翻黑/白）。19 主色 × 浅深 38 组合实测 ≥4.5:1。
    -->
    <Style x:Key="NavItemText" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        侧栏导航。侧栏底色由 MainWindow.xaml 给（Card.Background，跟随主题）；
        悬停底色与选中强调色都走 MD 原生键，分别跟随主题 / 主色。
        chip 使用 MD 主色背景及其配套 Primary.Foreground，随主色明暗保持可读性。
    -->
    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:Chip
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            Content="{Binding Badge}"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        <!--  前景交给 NavItemText（选中态要换成 Primary.Foreground，见上）。  -->
                        <TextBlock Style="{StaticResource NavItemText}" Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="bd"
                                    Margin="0,2"
                                    Padding="8,6"
                                    Background="Transparent"
                                    CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </Trigger>
                                    <!--
                                        悬停底色必须**跟随主题**，不能写死深色。
                                        原来写死 #1E293B，而标题前景是跟随浅深的 Foreground ——
                                        浅色主题下就成了「近黑的字压在深 navy 上」，实测只有 1.40:1，几乎看不见。
                                        ListView.Hover 是 MD 的半透明叠层（浅 #19000000 / 深 #19FFFFFF），
                                        叠在 Card.Background 上实测 浅 14.30:1 / 深 6.20:1。
                                    -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListView.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
