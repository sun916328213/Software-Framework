    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Extension\Extension.Core\Extension.Core.csproj" />
    <!-- P12：测试直接引用 Core + Runtime。兼容门面已于 2026-09-29 删除，旧 API 由 Runtime 直接承载。 -->
