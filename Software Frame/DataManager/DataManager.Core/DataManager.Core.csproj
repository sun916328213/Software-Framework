<!--
中文阅读说明：项目构建声明。
DataManager 模块：数据访问契约、SQL/日志/Excel 运行能力及配置界面；具体数据库配置和实体由使用方决定。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>Library</OutputType>
    <!-- P12：平台策略保持 AnyCPU，本轮不以 net9.0-windows7.0 -> net9.0 为目标。 -->
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DataManager.Core</AssemblyName>
    <!-- Core 只承载契约与纯模型，暂不单独打包。 -->
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>DataManager.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Extension\Extension.Core\Extension.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 参数类（SQLParam/LogParam/ExcelParam）为 ObservableObject；基础 MVVM 库，非 Provider 实现。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
