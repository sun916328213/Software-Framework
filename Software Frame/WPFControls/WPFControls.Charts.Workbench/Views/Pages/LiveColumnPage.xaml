<local:ChartRefreshView x:Class="WPFControls.Charts.Workbench.Views.Pages.LiveColumnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPFControls.Charts.Workbench.Views"
    xmlns:live="clr-namespace:WPFControls.Controls.Views.Charts;assembly=WPFControls.Charts">
    <live:ChartsColumnView x:Name="Chart" Height="420" ItemSource="{Binding Lines, Mode=OneWay}"
        AxisX="{Binding Labels, Mode=OneWay}" AxisFontSize="{Binding AxisFontSize}"
        AnimationsSpeed="{Binding AnimationDuration}" />
</local:ChartRefreshView>
