<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared">
    <ControlTemplate x:Key="ChartTrackerTemplate">
        <oxy:TrackerControl Position="{Binding Position}" LineExtents="{Binding PlotModel.PlotArea}"
            LineStroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type oxy:PlotViewBase}}}"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type oxy:PlotViewBase}}}"
            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type oxy:PlotViewBase}}}"
            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type oxy:PlotViewBase}}}">
            <TextBlock Text="{Binding}" Margin="8" />
        </oxy:TrackerControl>
    </ControlTemplate>
</ResourceDictionary>
