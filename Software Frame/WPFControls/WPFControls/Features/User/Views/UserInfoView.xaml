<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.UserInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:WPFControls.Controls.Views.User"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels"
    x:Name="UserControl"
    Width="380"
    Height="500"
    d:DataContext="{d:DesignInstance viewmodel:UserInfoViewModel}"
    FontFamily="Microsoft YaHei UI"
    FontSize="14"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style x:Key="HiddenTabHeaderStyle" TargetType="TabControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="0" Style="{StaticResource Border_Style}">
        <TabControl
            x:Name="TabControl"
            SelectedIndex="{Binding Datas.TabSelectItem, Mode=TwoWay}"
            Style="{StaticResource HiddenTabHeaderStyle}">
            <TabItem x:Name="tab1" Height="20">
                <view:LoginView
                    AddCommand="{Binding AddShowCommand}"
                    DeleteCommand="{Binding DeletShowCommand}"
                    ErrorMessage="{Binding Datas.ErrorMessage, Mode=TwoWay}"
                    ExitCommand="{Binding ExitCommand}"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    LoginCommand="{Binding LoginCommand}"
                    LogoutCommand="{Binding LogoutCommand}"
                    ModifyCommand="{Binding ModifyShowCommand}"
                    Password="{Binding Datas.Password, Mode=TwoWay}"
                    UserLevel="{Binding Datas.CurUserInfo.Level}"
                    UserName="{Binding Datas.UserName, Mode=TwoWay}"
                    UserNameCollection="{Binding Datas.UserNames}" />
            </TabItem>

            <TabItem Height="{Binding Height, ElementName=tab1}">
                <view:AddUserView
                    AddCommand="{Binding AddCommand}"
                    ConfirmPassword="{Binding Datas.ConfirmPassword, Mode=TwoWay}"
                    ErrorMessage="{Binding Datas.ErrorMessage, Mode=TwoWay}"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    Password="{Binding Datas.Password, Mode=TwoWay}"
                    ReturnCommand="{Binding ReturnCommand}"
                    UserLevel="{Binding Datas.UserLevel, Mode=TwoWay}"
                    UserLevelCollection="{Binding Datas.UserLevels}"
                    UserName="{Binding Datas.UserName, Mode=TwoWay}" />
            </TabItem>

            <TabItem Height="{Binding Height, ElementName=tab1}">
                <view:ModifyUserView
                    ConfirmPassword="{Binding Datas.ConfirmPassword, Mode=TwoWay}"
                    ErrorMessage="{Binding Datas.ErrorMessage, Mode=TwoWay}"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    ModifyCommand="{Binding ModifyCommand}"
                    NewPassword="{Binding Datas.NewPassword, Mode=TwoWay}"
                    Password="{Binding Datas.Password, Mode=TwoWay}"
                    ReturnCommand="{Binding ReturnCommand}"
                    UserName="{Binding Datas.UserName, Mode=TwoWay}"
                    UserNameCollection="{Binding Datas.UserNames}" />
            </TabItem>

            <TabItem Height="{Binding Height, ElementName=tab1}">
                <view:DeletUserView
                    x:Name="View_DeletUser"
                    ConfirmPassword="{Binding Datas.ConfirmPassword, Mode=TwoWay}"
                    DeleteCommand="{Binding DeletCommand}"
                    ErrorMessage="{Binding Datas.ErrorMessage, Mode=TwoWay}"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    Password="{Binding Datas.Password, Mode=TwoWay}"
                    ReturnCommand="{Binding ReturnCommand}"
                    UserName="{Binding Datas.UserName, Mode=TwoWay}"
                    UserNameCollection="{Binding Datas.UserNames}" />
            </TabItem>

        </TabControl>
    </Border>

</UserControl>