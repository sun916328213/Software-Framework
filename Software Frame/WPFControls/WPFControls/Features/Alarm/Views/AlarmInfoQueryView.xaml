<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.AlarmInfoQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views.Charts;assembly=WPFControls.Charts"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:WPFControls.Controls.Views"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels.Alarm"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:AlarmInfoQueryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Style="{StaticResource Border_Style}">
            <view:QueryView
                EndTime="{Binding Datas.DateTime_End, Mode=TwoWay}"
                IsShowFilter="False"
                IsShowSelect="False"
                QueryCommand="{Binding QueryCommand}"
                SaveCommand="{Binding SaveCommand}"
                StartTime="{Binding Datas.DateTime_Start, Mode=TwoWay}" />
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <custm:DataGridView
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.Datas}" />
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource Border_Style}">
            <cust:ChartsPieView ItemSource="{Binding PieData, Mode=TwoWay}" />
        </Border>

    </Grid>
</UserControl>
