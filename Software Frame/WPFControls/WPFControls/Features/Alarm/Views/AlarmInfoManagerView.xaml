<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.AlarmInfoManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--
        报警信息设置页（编辑 Config\Alarm.csv）。
        T12b：保存不再走 SaveCallback（控件内置写盘 + 事后回调），改绑页面自己的 SaveCommand ——
        落盘交给 AlarmInfoManagerService.Save（校验 → 落盘），成功/失败结果落在下方状态行。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Border_Style}">
            <wpfcc:ConfigManagerView
                AddVisibility="Collapsed"
                DeleteVisibility="Collapsed"
                Title="{Binding Datas.Name}"
                FileName="{Binding Datas.FileName}"
                FilePath="{Binding Datas.FilePath}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.DataCollection}"
                RowHeight="38"
                SaveCommand="{Binding SaveCommand}"
                SelectVisibility="Collapsed" />
        </Border>

        <!--
            结果行：保存失败时明确写"配置未改变"，加载期问题（缺文件 / 读失败）在进入页面时就摆出来。
            空串时本行不占位。
        -->
        <TextBlock
            x:Name="StatusLine"
            Grid.Row="1"
            Margin="8,4,8,6"
            Text="{Binding StatusText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
