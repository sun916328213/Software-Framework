<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.VisionInspectionItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WPFCustomControls.ValueConvert;assembly=WPFCustomControls"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:WPFControls.ProgramControl.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:VisionInspectionItemViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <converters:IsReadToIsEnableConverter x:Key="IsReadToIsEnableConverter" />

            <DiscreteObjectKeyFrame x:Key="DataContextProxy" Value="{Binding}" />

            <x:Array x:Key="TriggerModeEnum" Type="{x:Type sys:String}">
                <sys:String>OFF</sys:String><sys:String>Software</sys:String>
                <sys:String>Frame_Line1</sys:String><sys:String>Frame_Line2</sys:String>
            </x:Array>

            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style BasedOn="{StaticResource CompactPrimaryButton}" TargetType="Button">
                <Setter Property="Margin" Value="4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <wpfcc:ConfigManagerView
            x:Name="deviceManagerView"
            Title="{Binding Datas.Name}"
            FileName="{Binding Datas.FileName}"
            FilePath="{Binding Datas.FilePath}"
            IsReadOnly="True"
            ItemsSource="{Binding Datas.DataCollection}"
            SelectItem="{Binding Datas.CurVisionInspectionItem, Mode=TwoWay}">

            <wpfcc:ConfigManagerView.DataGridColumns>
                <DataGridTextColumn
                    MinWidth="100"
                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Name" />

                <DataGridComboBoxColumn
                    MinWidth="100"
                    Header="CamName"
                    ItemsSource="{Binding Source={StaticResource DataContextProxy}, Path=Value.Cams}"
                    SelectedItemBinding="{Binding CamName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn
                    MinWidth="100"
                    Binding="{Binding ToolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="ToolName" />

                <materialDesign:DataGridTextColumn
                    MinWidth="100"
                    Binding="{Binding Exposure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="Exposure" />

                <DataGridTextColumn Binding="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Gain" />

                <materialDesign:DataGridComboBoxColumn
                    MinWidth="100"
                    Header="TriggerMode"
                    ItemsSource="{Binding Source={StaticResource TriggerModeEnum}}"
                    SelectedItemBinding="{Binding TriggerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTemplateColumn Header="LightItems">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel IsEnabled="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource IsReadToIsEnableConverter}}" Orientation="Horizontal">
                                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="4">
                                    <custm:DataGridView
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        GridLinesVisibility="Horizontal"
                                        ItemsSource="{Binding LightItems}" />
                                </Border>
                                <StackPanel>
                                    <Button
                                        Command="{Binding Source={StaticResource DataContextProxy}, Path=Value.AddLinght}"
                                        CommandParameter="{Binding}"
                                        Content="Add" />
                                    <Button
                                        Command="{Binding Source={StaticResource DataContextProxy}, Path=Value.ClearLinght}"
                                        CommandParameter="{Binding}"
                                        Content="Clear" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="VisionTool">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button
                                    Command="{Binding Source={StaticResource DataContextProxy}, Path=Value.AddLinght}"
                                    CommandParameter="{Binding}"
                                    Content="Add" />
                                <Button
                                    Command="{Binding Source={StaticResource DataContextProxy}, Path=Value.ClearLinght}"
                                    CommandParameter="{Binding}"
                                    Content="Clear" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </wpfcc:ConfigManagerView.DataGridColumns>

        </wpfcc:ConfigManagerView>
    </Grid>
</UserControl>
