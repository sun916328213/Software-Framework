<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.Display.DisplayQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views.Display"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ButtonStyle"
            BasedOn="{StaticResource CompactOutlinedButton}"
            TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MinHeight="32" />
            <RowDefinition Height="Auto" MinHeight="32" />
        </Grid.RowDefinitions>

        <local:DisplaySingleGroupView Title="图像" DisplayImage="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}" />



        <Label
            x:Name="lbl_SelectPath"
            Grid.Row="1"
            Grid.Column="0" />

        <UniformGrid
            Grid.Row="2"
            MinWidth="250"
            HorizontalAlignment="Center"
            Columns="5"
            Rows="0">
            <Button
                ToolTip="第一张图像" AutomationProperties.Name="第一张图像" Command="{Binding FirstCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Cursor="Hand"
                Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowCollapseLeft" />
                </Button.Content>
            </Button>
            <Button ToolTip="上一张图像" AutomationProperties.Name="上一张图像" Command="{Binding LastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button.Content>
            </Button>
            <Label
                x:Name="lbl_Process"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />
            <Button ToolTip="下一张图像" AutomationProperties.Name="下一张图像" Command="{Binding NextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowRight" />
                </Button.Content>
            </Button>
            <Button ToolTip="最后一张图像" AutomationProperties.Name="最后一张图像" Command="{Binding EndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowCollapseRight" />
                </Button.Content>
            </Button>

        </UniformGrid>


    </Grid>
</UserControl>