<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.DataQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels"
    x:Name="UserControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
                <ResourceDictionary Source="/WPFControls;component/Resources/NavigationStyle.xaml" />-->
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="LabelStyle"
                BasedOn="{StaticResource MaterialDesignLabel}"
                TargetType="Label">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="ButtonStyle"
                BasedOn="{StaticResource CompactPrimaryButton}"
                TargetType="Button">
                <Setter Property="Width" Value="100" />
                <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
            </Style>

            <Style
                x:Key="DatePickerStyle"
                BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}"
                TargetType="DatePicker">
                <Setter Property="Width" Value="180" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="SelectedDateFormat" Value="Long" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Border_Style}">
            <cust:QueryView
                FilterCommand="{Binding QueryCommand}"
                FilterValue="{Binding Datas.ID, Mode=TwoWay}"
                IsShowFilter="True"
                IsShowSelect="False"
                QueryCommand="{Binding QueryCommand}"
                SaveCommand="{Binding SaveCommand}"
                EndTime="{Binding Datas.DateTime_End, Mode=TwoWay}"
                StartTime="{Binding Datas.DateTime_Start, Mode=TwoWay}" />
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <custm:DataGridView
                Background="{Binding ElementName=UserControl, Path=Background}"
                FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.DatasDTO}" />
        </Border>


    </Grid>
</UserControl>
