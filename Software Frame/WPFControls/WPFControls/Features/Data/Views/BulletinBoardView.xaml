<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.BulletinBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bulletinboard="clr-namespace:WPFControls.Controls.Views.BulletinBoard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPFControls.ProgramControl.ViewModels"
    xmlns:prism="http://prismlibrary.com/"
    d:DataContext="{d:DesignInstance Type=models:BulletinBoardViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <bulletinboard:ProductionCapacityView
            Grid.Row="0"
            AlarmTime="2000"
            OKCount="{Binding StatisicsModel.OK}"
            RunTime="2000"
            TotalCount="{Binding StatisicsModel.Total}" />
        <bulletinboard:YieldStatisticsView
            Title="每小时产量"
            Grid.Row="1"
            AxisX="{Binding Datas.AxisX_Day, Mode=TwoWay}"
            ItemSource="{Binding Datas.Data_Day}" />
        <bulletinboard:YieldStatisticsView
            Title="每月产量"
            Grid.Row="2"
            AxisX="{Binding Datas.AxisX_Month, Mode=TwoWay}"
            ItemSource="{Binding Datas.Data_Month}" />
    </Grid>

</UserControl>
