<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.ImageQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:cust1="clr-namespace:WPFControls.ProgramControl.Views.Display"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels.Data"
    d:DataContext="{d:DesignInstance Type=viewmodels:ImageQueryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
                <ResourceDictionary Source="/WPFControls;component/Resources/NavigationStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Border_Style}">
            <cust:QueryView
                ColWidth="240,240,100,105,*"
                EndTime="{Binding Datas.DateTime_End, Mode=TwoWay}"
                FilterCommand="{Binding FilterCommand}"
                FilterValue="{Binding Datas.ID, Mode=TwoWay}"
                IsShowFilter="True"
                IsShowSelect="False"
                QueryCommand="{Binding QueryCommand}"
                SaveCommand="{Binding SaveCommand}"
                StartTime="{Binding Datas.DateTime_Start, Mode=TwoWay}" />
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Border_Style}" />

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <custm:DataGridView
                x:Name="View_DataGrid"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.ImageInfoDatasDTO}"
                SelectedItem="{Binding Datas.SelectedItem}" />

        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Style="{StaticResource Border_Style}">
            <cust1:DisplayQueryView ItemsSource="{Binding Datas.ImagePaths}" />
        </Border>
    </Grid>
</UserControl>