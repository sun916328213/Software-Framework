<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.CapacityStatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:WPFControls.Controls.Views.Charts;assembly=WPFControls.Charts"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:CapacityStatisticsViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="CardValueStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource Color_Teal}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="8" Style="{StaticResource Border_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="4,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource Color_Teal}"
                        Text="产能统计" />

                </StackPanel>
            </Grid>

            <!--  时间查询  -->
            <Border
                Grid.Row="1"
                Margin="4"
                Style="{StaticResource Border_Style}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <cust:QueryView
                        Grid.Column="0"
                        EndTime="{Binding Datas.EndTime, Mode=TwoWay}"
                        IsShowFilter="False"
                        IsShowSelect="False"
                        QueryCommand="{Binding QueryCommand}"
                        SaveCommand="{Binding SaveCommand}"
                        StartTime="{Binding Datas.StartTime, Mode=TwoWay}" />

                </Grid>
            </Border>

            <!--  汇总卡片  -->
            <UniformGrid Grid.Row="2" Columns="6">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="区间产量" />
                        <TextBlock
                            Foreground="{StaticResource Color_Blue}"
                            Style="{StaticResource CardValueStyle}"
                            Text="{Binding Datas.TotalOutput}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="良品数" />
                        <TextBlock
                            Foreground="{StaticResource Color_Green}"
                            Style="{StaticResource CardValueStyle}"
                            Text="{Binding Datas.GoodCount}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="不良品数" />
                        <TextBlock
                            Foreground="{StaticResource Color_Red}"
                            Style="{StaticResource CardValueStyle}"
                            Text="{Binding Datas.DefectCount}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="良率" />
                        <TextBlock
                            Foreground="{StaticResource Color_Blue}"
                            Style="{StaticResource CardValueStyle}"
                            Text="{Binding Datas.YieldRate, StringFormat={}{0:F1}%}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="稼动率" />
                        <TextBlock
                            Foreground="{StaticResource Color_Orange}"
                            Style="{StaticResource CardValueStyle}"
                            Text="{Binding Datas.UtilizationRate, StringFormat={}{0:F1}%}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="运行时长" />
                        <TextBlock Style="{StaticResource CardValueStyle}" Text="{Binding Datas.RunTime, StringFormat={}{0:F1}h}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  图表区域  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="4"
                    BorderThickness="0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="产量趋势" />
                        <charts:ChartsLineView
                            Grid.Row="1"
                            Margin="4"
                            AxisX="{Binding Datas.AxisX}"
                            ItemSource="{Binding Datas.OutputTrend}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Margin="4"
                    Style="{StaticResource CardStyle}"
                    Visibility="Hidden">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="良品/不良品分布" />
                        <charts:ChartsPieView
                            Grid.Row="1"
                            Margin="4"
                            ItemSource="{Binding Datas.PieData}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
