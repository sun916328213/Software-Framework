<!--
    中文阅读说明：界面与资源声明。
    WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
    绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.SEMIManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels.Log"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:SEMIManagerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!--
        T12c：两张表都**不设** FilePath / FileName（它们绑的是内存里的 SECS 表，不是磁盘文件），
        而控件内置 SaveData 在 FilePath/FileName 为空时**直接 return** ⇒ 早退分支会让 SaveCallback
        永远不被调用，两个保存按钮形同虚设。改绑 SaveCommand 后内置路径整条不再执行。
        M02：保存链路已改通 —— 服务层把表格里的行经 SaveReports(IEnumerable&lt;...&gt;) 交给契约，
        状态行"已保存"从此名副其实。表格本身仍是只读的（IsReadOnly=True，Add/Delete 折叠）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Rows="2">
            <Border Style="{StaticResource Border_Style}">
                <wpfcc:ConfigManagerView
                    Title="SEMI ReportInfo"
                    AddVisibility="Collapsed"
                    DeleteVisibility="Collapsed"
                    IsReadOnly="True"
                    ItemsSource="{Binding Datas.Reports}"
                    RowHeight="38"
                    SaveCommand="{Binding ReportSaveCommand}"
                    SelectVisibility="Collapsed" />
            </Border>

            <Border Style="{StaticResource Border_Style}">
                <wpfcc:ConfigManagerView
                    Title="SEMI EventInfo"
                    AddVisibility="Collapsed"
                    DeleteVisibility="Collapsed"
                    IsReadOnly="True"
                    ItemsSource="{Binding Datas.Events}"
                    RowHeight="38"
                    SaveCommand="{Binding EventSaveCommand}"
                    SelectVisibility="Collapsed" />
            </Border>
        </UniformGrid>

        <!--  结果行：保存失败时明确写"未改变"；加载失败也走这一行。空串时本行不占位。  -->
        <TextBlock
            x:Name="StatusLine"
            Grid.Row="1"
            Margin="8,4,8,6"
            Text="{Binding StatusText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
