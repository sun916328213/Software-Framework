<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.SEMIManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels.Log"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:SEMIManagerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UniformGrid Rows="2">
        <Border Style="{StaticResource Border_Style}">
            <wpfcc:ConfigManagerView
                AddVisibility="Collapsed"
                DeleteVisibility="Collapsed"
                Title="SEMI ReportInfo"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.Reports}"
                RowHeight="38"
                SaveCallback="{Binding ReportSaveCommand}"
                SelectVisibility="Collapsed" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Border_Style}">
            <wpfcc:ConfigManagerView
                AddVisibility="Collapsed"
                DeleteVisibility="Collapsed"
                Title="SEMI EventInfo"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.Events}"
                RowHeight="38"
                SaveCallback="{Binding EventSaveCommand}"
                SelectVisibility="Collapsed" />
        </Border>
    </UniformGrid>


</UserControl>
