<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.LogConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:LogConfigViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--
        日志统一配置界面（仿 CamManagerView）：内嵌 ConfigManagerView 编辑 Config\LogConfig.json。
        T12a：保存不再走 SaveCallback（控件内置写盘 + 事后回调），改绑页面自己的 SaveCommand ——
        落盘与生效由 LogConfigService.Save 统一负责，成功/失败结果落在下方状态行。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfcc:ConfigManagerView
            Grid.Row="0"
            Title="{Binding Datas.Name}"
            AddVisibility="Collapsed"
            DeleteVisibility="Collapsed"
            FileName="{Binding Datas.FileName}"
            FilePath="{Binding Datas.FilePath}"
            IsReadOnly="True"
            ItemsSource="{Binding Datas.DataCollection}"
            SaveCommand="{Binding SaveCommand}"
            SelectVisibility="Collapsed" />

        <!-- 保存结果：失败时明确写"未生效"，绝不在写盘失败时显示成功。空串时本行不占位。 -->
        <TextBlock
            x:Name="StatusLine"
            Grid.Row="1"
            Margin="8,4,8,6"
            Text="{Binding StatusText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
