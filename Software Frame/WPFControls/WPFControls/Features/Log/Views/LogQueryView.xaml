<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.LogQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedConverters="clr-namespace:WPFControls.Controls.Converters"
    xmlns:converters="clr-namespace:WPFControls.ValueConvert"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:globalization="clr-namespace:System.Globalization;assembly=mscorlib"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:view="clr-namespace:WPFControls.Controls.Views"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels.Log"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:LogQueryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <sharedConverters:LanguageConverter x:Key="LanguageConverter" />

        <Style
            x:Key="LabelStyle"
            BasedOn="{StaticResource MaterialDesignLabel}"
            TargetType="Label">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="ButtonStyle"
            BasedOn="{StaticResource CompactPrimaryButton}"
            TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
        </Style>

    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Style="{StaticResource Border_Style}">
            <view:QueryView
                FilterCommand="{Binding FilterCommand}"
                FilterItem="{Binding Datas.FilterItem, Mode=TwoWay}"
                FilterItemSource="{Binding ElementName=UserControl, Path=FilterColumnSource}"
                FilterResetCommand="{Binding FilterResetCommand}"
                FilterValue="{Binding Datas.FilterText, Mode=TwoWay}"
                IsShowFilter="True"
                IsShowSelect="True"
                QueryCommand="{Binding QueryCommand}"
                SaveCommand="{Binding SaveCommand}"
                SelectFilterCommand="{Binding SelectFilterCommand}"
                SelectItem="{Binding Datas.SelectItem, Mode=TwoWay}"
                SelectItemSource="{Binding Datas.SelectItemSource}"
                SelectResetCommand="{Binding SelectResetCommand}"
                EndTime="{Binding Datas.DateTime_End, Mode=TwoWay}"
                StartTime="{Binding Datas.DateTime_Start, Mode=TwoWay}" />
        </Border>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <custm:DataGridLogView
                x:Name="View_DataGrid"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                ColumnWidth="Auto"
                EnableRowVirtualization="False"
                FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.LogDatas}"
                ScrollViewer.CanContentScroll="False"
                VirtualizingPanel.IsVirtualizing="False" />
        </Border>

        <Border
            Grid.Row="2"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <view:PaginationView
                CurrentPage="{Binding Datas.CurrentPage, Mode=TwoWay}"
                PageChangedCommand="{Binding PageChangedCommand}"
                PageSize="{Binding Datas.PageSize}"
                TotalCount="{Binding Datas.TotalCount}" />
        </Border>

    </Grid>
</UserControl>
