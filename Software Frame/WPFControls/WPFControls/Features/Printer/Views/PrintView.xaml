<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.PrintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels.Printer"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:PrintViewModel}"
    d:DesignHeight="350"
    d:DesignWidth="400"
    local:PrintView.PreviewImage="{Binding Datas.LabelImage, Mode=OneWay}"
    local:PrintView.PrintInfo="{Binding Datas.PrintInfo, Mode=OneWay}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style BasedOn="{StaticResource CompactPrimaryButton}" TargetType="{x:Type Button}">
                <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
                <Setter Property="Width" Value="100" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Grid.Row="0"
        Grid.Column="0"
        Cursor="">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="44" />
            <RowDefinition Height="Auto" MinHeight="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalContentAlignment="Center"
            Content="标签路径：" />
        <TextBox Style="{StaticResource CompactTextBox}"
            Grid.Row="0"
            Grid.Column="1"
            Margin="4,6,4,6"
            Text="{Binding Datas.LabelFormat}" />
        <Button
            Grid.Row="0"
            Grid.Column="2"
            Command="{Binding OpenCommand}"
            Content="打开" />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            Margin="10,0"
            VerticalContentAlignment="Center"
            Content="打印机名称："
            Cursor="" />
        <ComboBox Style="{StaticResource CompactComboBox}"
            x:Name="cmb_PrintName"
            Grid.Row="1"
            Grid.Column="1"
            Margin="4,4"
            ItemsSource="{Binding Datas.PrintNames}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding SelectPrintCommand}" CommandParameter="{Binding ElementName=cmb_PrintName, Path=SelectedItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <custm:DataGridView
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            IsReadOnly="False"
            ItemsSource="{Binding Datas.LabelField}" />
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <Button
                Margin="0,0,0,6"
                Command="{Binding GetValueCommand}"
                Content=" 获取" />
            <Button
                Margin="0,0,0,6"
                Command="{Binding SetValueCommand}"
                Content="设置" />
            <Button
                Margin="0,0,0,6"
                Command="{Binding PrintCommand}"
                Content="打印" />
        </StackPanel>
                </ScrollViewer>

    </Grid>

</UserControl>