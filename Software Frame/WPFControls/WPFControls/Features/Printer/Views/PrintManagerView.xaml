<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.PrintManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:custview="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels.Printer"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:PrintManagerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource CompactPrimaryButton}" TargetType="{x:Type Button}">
                <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
                <Setter Property="Width" Value="100" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <custview:PrintView x:Name="view_Bartender" />
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <Grid Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <custm:DataGridView
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Datas.PrintInfos}"
                    SelectedIndex="{Binding Datas.SelectPrintIndex}" />
                <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel
                    VerticalAlignment="Bottom">
                    <Button
                        Command="{Binding AddCommand}"
                        CommandParameter="{Binding ElementName=view_Bartender, Path=(custview:PrintView.PrintInfo)}"
                        Content="添加" />
                    <Button Command="{Binding ClearCommand}" Content="删除" />
                    <Button Command="{Binding UpCommand}" Content="上移" />
                    <Button Command="{Binding DownCommand}" Content="下移" />
                    <Button Command="{Binding PrintCommand}" Content="一键打印" />
                    <Button Command="{Binding SettingCommand}" Content="一键清除" />
                </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Style="{StaticResource Border_Style}">
            <GroupBox Margin="8" Header="预览">
                <Image Source="{Binding ElementName=view_Bartender, Path=(custview:PrintView.PreviewImage)}" />
            </GroupBox>
        </Border>
    </Grid>
</UserControl>
