<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.WindowMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:materDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:valueconvert="clr-namespace:WPFControls.ValueConvert"
    xmlns:viewmodels="clr-namespace:WPFControls.ProgramControl.ViewModels"
    x:Name="UserControl"
    Margin="0"
    Padding="0"
    d:DataContext="{d:DesignInstance Type=viewmodels:WindowMenuViewModel}"
    d:DesignHeight="35"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FontSize="12"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Placement" Value="Bottom" />
                <Setter Property="HorizontalOffset" Value="0" />
                <Setter Property="VerticalOffset" Value="10" />
            </Style>

            <Style TargetType="materDesign:PackIcon">
                <Setter Property="Width" Value="25" />
                <Setter Property="Height" Value="25" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <valueconvert:LinkStatusToColorConvert x:Key="LinkColorConvert" />
            <valueconvert:SecsStatusToColorConvert x:Key="SecsColorConvert" />

        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="0,0,0,0"
        Padding="0"
        Style="{StaticResource Border_Style}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Image
                    Width="20"
                    Height="20"
                    Margin="8,0"
                    DockPanel.Dock="Left"
                    Source="{StaticResource AppIcon}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Datas.Title}" />
                <cust:TitleTextBlockView Title="" Value="{Binding StatisicsModel.DateTime}" />

            </DockPanel>

            <DockPanel Grid.Column="2">
                <UniformGrid Columns="3" DockPanel.Dock="Right">
                    <Button
                        materDesign:ButtonAssist.CornerRadius="10"
                        Command="{Binding MinimizeCommand}"
                        ToolTip="最小化" AutomationProperties.Name="最小化"
                        ToolTipService.BetweenShowDelay="100"
                        ToolTipService.InitialShowDelay="100">
                        <Button.Content>
                            <materDesign:PackIcon Kind="WindowMinimize" />
                        </Button.Content>
                    </Button>
                    <Button
                        materDesign:ButtonAssist.CornerRadius="10"
                        Command="{Binding MaximizeCommand}"
                        ToolTip="最大化" AutomationProperties.Name="最大化"
                        ToolTipService.BetweenShowDelay="100"
                        ToolTipService.InitialShowDelay="100">
                        <Button.Content>
                            <materDesign:PackIcon Kind="{Binding MaximizeIconKind}" />
                        </Button.Content>
                    </Button>
                    <Button
                        materDesign:ButtonAssist.CornerRadius="10"
                        Command="{Binding CloseCommand}"
                        ToolTip="关闭" AutomationProperties.Name="关闭"
                        ToolTipService.BetweenShowDelay="100"
                        ToolTipService.InitialShowDelay="100">
                        <Button.Content>
                            <materDesign:PackIcon Kind="WindowClose" />
                        </Button.Content>
                    </Button>
                </UniformGrid>
                <Separator
                    Margin="10,0,0,0"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SeparatorVertical_Style}" />

                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0"
                        materDesign:ButtonAssist.CornerRadius="8"
                        Command="{Binding LogoutCommand}"
                        ToolTip="用户注销" AutomationProperties.Name="用户注销"
                        ToolTipService.BetweenShowDelay="100"
                        ToolTipService.InitialShowDelay="100">
                        <Button.Content>
                            <materDesign:PackIcon Kind="AccountArrowLeftOutline" />
                        </Button.Content>
                    </Button>
                    <Button
                        Margin="0,0,10,0"
                        materDesign:ButtonAssist.CornerRadius="8"
                        Command="{Binding LoginCommand}"
                        ToolTip="用户登录" AutomationProperties.Name="用户登录"
                        ToolTipService.BetweenShowDelay="100"
                        ToolTipService.InitialShowDelay="100">
                        <Button.Content>
                            <materDesign:PackIcon Kind="AccountCircleOutline" />
                        </Button.Content>
                    </Button>
                    <TextBlock Text="用户名称:" />
                    <TextBlock Text="{Binding UserInfoModel.CurUserInfo.Name}" />
                    <TextBlock Text="    " />
                    <TextBlock Text="用户等级:" />
                    <TextBlock Text="{Binding UserInfoModel.CurUserInfo.Level}" />
                </StackPanel>

                <Separator DockPanel.Dock="Right" Style="{StaticResource SeparatorVertical_Style}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <cust:TitleTextBlockView
                        Title="SEMI Link:"
                        Margin="4,0"
                        Foreground="{Binding StatisicsModel.SecsStatus, Converter={StaticResource LinkColorConvert}}"
                        Value="{Binding StatisicsModel.SecsStatus}" />

                    <cust:TitleTextBlockView
                        Title="SEMI Mode:"
                        Margin="4,0"
                        Foreground="{Binding StatisicsModel.SecsMode, Converter={StaticResource SecsColorConvert}}"
                        Value="{Binding StatisicsModel.SecsMode}" />

                    <cust:TitleTextBlockView
                        Title="PLC Link:"
                        Margin="4,0"
                        Foreground="{Binding StatisicsModel.PLCLinkStatus, Converter={StaticResource LinkColorConvert}}"
                        Value="{Binding StatisicsModel.PLCLinkStatus}" />


                </StackPanel>
            </DockPanel>



        </Grid>
    </Border>
</UserControl>