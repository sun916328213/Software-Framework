<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.ProgramControl.Views.ResourceMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WPFControls.ValueConvert"
    xmlns:cust="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.ProgramControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPFControls.ProgramControl.Models"
    xmlns:viewmodel="clr-namespace:WPFControls.ProgramControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:ResourceMonitorViewModels}"
    d:DesignHeight="90"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style TargetType="materialDesign:PackIcon">
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <UniformGrid Columns="3">

        <Border Style="{StaticResource Border_Style}">
            <DockPanel>
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Kind="Memory" />
                <UniformGrid DockPanel.Dock="Left" Rows="2">
                    <TextBlock VerticalAlignment="Bottom" Text="CPU利用率" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" Text="{Binding Datas.SystemCPURate}" />
                </UniformGrid>

                <cust:CircleProcessBar
                    Padding="0,0,8,0"
                    HorizontalAlignment="Right"
                    Value="{Binding Datas.SystemCPU}" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Border_Style}">
            <DockPanel>
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Kind="SetTopBox"
                    RenderTransformOrigin="0.5,0.5">
                    <materialDesign:PackIcon.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform Angle="-45" />
                            <TranslateTransform />
                        </TransformGroup>
                    </materialDesign:PackIcon.RenderTransform>
                </materialDesign:PackIcon>

                <UniformGrid DockPanel.Dock="Left" Rows="2">
                    <TextBlock VerticalAlignment="Bottom" Text="内存利用率" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" Text="{Binding Datas.SystemMemoryRate}" />
                </UniformGrid>

                <cust:CircleProcessBar
                    Padding="0,0,8,0"
                    HorizontalAlignment="Right"
                    Value="{Binding Datas.SystemMemory}" />

            </DockPanel>
        </Border>



        <Border Style="{StaticResource Border_Style}">
            <DockPanel>
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Kind="Harddisk" />

                <UniformGrid DockPanel.Dock="Left" Rows="2">
                    <TextBlock VerticalAlignment="Bottom" Text="磁盘利用率" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" Text="{Binding Datas.DiskRate}" />
                </UniformGrid>
                <cust:CircleProcessBar
                    Padding="0,0,8,0"
                    HorizontalAlignment="Right"
                    Value="{Binding Datas.Disk}" />
            </DockPanel>
        </Border>
    </UniformGrid>
</UserControl>