<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.Controls.Views.QueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:HelpTool="clr-namespace:Extension.UI.Controls;assembly=Extension"
    xmlns:sharedConverters="clr-namespace:WPFControls.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:globalization="clr-namespace:System.Globalization;assembly=mscorlib"
    xmlns:local="clr-namespace:WPFControls.Controls.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    x:Name="UserControl"
    d:DesignHeight="150"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>

        <sharedConverters:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
        <BooleanToVisibilityConverter x:Key="QueryBoolToVisibility" />
        <sharedConverters:GridLengthArrayConverter x:Key="GridLengthArrayConverter" />
        <sharedConverters:HelpToolLanguageConverter x:Key="HelpToolLanguageConverter" />

        <Style
            x:Key="LabelStyle"
            BasedOn="{StaticResource MaterialDesignLabel}"
            TargetType="Label">
            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="80" />
        </Style>

        <Style
            x:Key="ButtonStyle"
            BasedOn="{StaticResource CompactPrimaryButton}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="DatePickerStyle"
            BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}"
            TargetType="DatePicker">
            <Setter Property="Width" Value="160" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:CalendarAssist.Orientation" Value="Horizontal" />
            <!--  绑定语言属性到HelpTool的语言设置，显式指定ConverterCulture  -->
            <Setter Property="Language" Value="{Binding Source={x:Static HelpTool:LangSwitchEx.Language}, Converter={StaticResource HelpToolLanguageConverter}, ConverterCulture=en-US}" />
        </Style>

        <Style TargetType="materialDesign:PackIcon">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style BasedOn="{StaticResource CompactComboBox}" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="PrimaryLight" />
        </Style>

    </UserControl.Resources>


    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
    <Grid MinWidth="760" Margin="0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="44" />
            <RowDefinition Height="{Binding ElementName=UserControl, Path=IsShowFilter, Converter={StaticResource BooleanToGridLengthConverter}}" />
            <RowDefinition Height="{Binding ElementName=UserControl, Path=IsShowSelect, Converter={StaticResource BooleanToGridLengthConverter}}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=UserControl, Path=ColWidth, Converter={StaticResource GridLengthArrayConverter}, ConverterParameter=0}" />
            <ColumnDefinition Width="{Binding ElementName=UserControl, Path=ColWidth, Converter={StaticResource GridLengthArrayConverter}, ConverterParameter=1}" />
            <ColumnDefinition Width="{Binding ElementName=UserControl, Path=ColWidth, Converter={StaticResource GridLengthArrayConverter}, ConverterParameter=2}" />
            <ColumnDefinition Width="{Binding ElementName=UserControl, Path=ColWidth, Converter={StaticResource GridLengthArrayConverter}, ConverterParameter=3}" />
            <ColumnDefinition Width="{Binding ElementName=UserControl, Path=ColWidth, Converter={StaticResource GridLengthArrayConverter}, ConverterParameter=4}" />
        </Grid.ColumnDefinitions>

        <!--  第一行数据 时间查询  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Orientation="Horizontal">
            <Label Content="开始时间：" Style="{StaticResource LabelStyle}" />
            <DatePicker AutomationProperties.Name="开始时间" SelectedDate="{Binding ElementName=UserControl, Path=StartTime}" Style="{StaticResource DatePickerStyle}" />
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal">
            <Label Content="结束时间：" Style="{StaticResource LabelStyle}" />
            <DatePicker
                Name="DatePicker1"
                AutomationProperties.Name="结束时间" SelectedDate="{Binding ElementName=UserControl, Path=EndTime}"
                Style="{StaticResource DatePickerStyle}" />
        </StackPanel>

        <Button
            Grid.Row="0"
            Grid.Column="2"
            AutomationProperties.Name="查询" Command="{Binding ElementName=UserControl, Path=QueryCommand}"
            Style="{StaticResource ButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Magnify" />
                <TextBlock Text="查询" />
            </StackPanel>

        </Button>

        <Button
            Grid.Row="0"
            Grid.Column="3"
            AutomationProperties.Name="保存查询结果" Command="{Binding ElementName=UserControl, Path=SaveCommand}"
            Style="{StaticResource ButtonStyle}"
            Visibility="{Binding ElementName=UserControl, Path=SaveVisibility}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ContentSave" />
                <TextBlock Text="保存" />
            </StackPanel>
        </Button>


        <!--  第二行数据 字段筛选  -->
        <StackPanel
            Grid.Row="1"
            Visibility="{Binding ElementName=UserControl, Path=IsShowFilter, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="0"
            Orientation="Horizontal">
            <Label Content="筛选字段:" Style="{StaticResource LabelStyle}" />
            <ComboBox Style="{StaticResource CompactComboBox}"
                Width="{Binding ElementName=DatePicker1, Path=Width}"
                AutomationProperties.Name="筛选字段" ItemsSource="{Binding ElementName=UserControl, Path=FilterItemSource}"
                SelectedItem="{Binding ElementName=UserControl, Path=FilterItem, Mode=TwoWay}" />

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Visibility="{Binding ElementName=UserControl, Path=IsShowFilter, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="1"
            Orientation="Horizontal">
            <Label Content="字段信息:" Style="{StaticResource LabelStyle}" />

            <TextBox Style="{StaticResource CompactTextBox}"
                Width="{Binding ElementName=DatePicker1, Path=Width}"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="筛选字段信息" MinHeight="32" Text="{Binding ElementName=UserControl, Path=FilterValue}" />
        </StackPanel>

        <Button
            Grid.Row="1"
            Visibility="{Binding ElementName=UserControl, Path=IsShowFilter, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="2"
            AutomationProperties.Name="筛选字段" Command="{Binding ElementName=UserControl, Path=FilterCommand}"
            Style="{StaticResource ButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Filter" />
                <TextBlock Text="筛选" />
            </StackPanel>
        </Button>

        <Button
            Grid.Row="1"
            Visibility="{Binding ElementName=UserControl, Path=IsShowFilter, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="3"
            AutomationProperties.Name="重置字段筛选" Command="{Binding ElementName=UserControl, Path=FilterResetCommand}"
            Style="{StaticResource ButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FilterRemove" />
                <TextBlock Text="重置筛选" />
            </StackPanel>
        </Button>


        <!--  第三行数据 Log日志等级筛选  -->
        <StackPanel
            Grid.Row="2"
            Visibility="{Binding ElementName=UserControl, Path=IsShowSelect, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="0"
            Orientation="Horizontal">
            <Label Content="等级选择：" Style="{StaticResource LabelStyle}" />
            <ComboBox Style="{StaticResource CompactComboBox}"
                Width="{Binding ElementName=DatePicker1, Path=Width}"
                AutomationProperties.Name="日志等级" ItemsSource="{Binding ElementName=UserControl, Path=SelectItemSource}"
                SelectedItem="{Binding ElementName=UserControl, Path=SelectItem}" />
        </StackPanel>

        <Button
            Grid.Row="2"
            Visibility="{Binding ElementName=UserControl, Path=IsShowSelect, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="2"
            AutomationProperties.Name="筛选等级" Command="{Binding ElementName=UserControl, Path=SelectFilterCommand}"
            Style="{StaticResource ButtonStyle}">
            <StackPanel Orientation="horizontal">
                <materialDesign:PackIcon Kind="FilterVariant" />
                <TextBlock Text="筛选" />


            </StackPanel>
        </Button>

        <Button
            Grid.Row="2"
            Visibility="{Binding ElementName=UserControl, Path=IsShowSelect, Converter={StaticResource QueryBoolToVisibility}}"
            Grid.Column="3"
            AutomationProperties.Name="重置等级筛选" Command="{Binding ElementName=UserControl, Path=SelectResetCommand}"
            Style="{StaticResource ButtonStyle}">
            <StackPanel Orientation="horizontal">
                <materialDesign:PackIcon Kind="FilterVariantRemove" />
                <TextBlock Text="重置筛选" />
            </StackPanel>
        </Button>
    </Grid>
    </ScrollViewer>

</UserControl>