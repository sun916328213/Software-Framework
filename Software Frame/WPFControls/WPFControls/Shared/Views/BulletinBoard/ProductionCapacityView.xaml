<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="WPFControls.Controls.Views.BulletinBoard.ProductionCapacityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Charts="clr-namespace:WPFControls.Controls.Models.Charts;assembly=WPFControls.Charts"
    xmlns:charts="clr-namespace:WPFControls.Controls.Views.Charts;assembly=WPFControls.Charts"
    xmlns:cust="clr-namespace:WPFControls.Controls.Views"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.Controls.Views.BulletinBoard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="150"
    d:DesignWidth="600"
    Loaded="ProductionCapacityView_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6" />
            </Style>

            <Style TargetType="{x:Type StackPanel}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Border_Style}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0"
                VerticalAlignment="Center"
                Text="今日产量" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="良品数量" />
                    <TextBlock x:Name="TB_OKCount" FontSize="24" FontWeight="SemiBold" Text="{Binding OKCount, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="总数量" />
                    <TextBlock x:Name="TB_Total" FontSize="24" FontWeight="SemiBold" Text="{Binding TotalCount, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="不良品数量" />
                    <TextBlock x:Name="TB_NGCount" FontSize="24" FontWeight="SemiBold" Text="{Binding NGCount, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="良品率" />
                    <custm:CircleProcessBar x:Name="TB_OKRate" />
                </StackPanel>

                <charts:ChartsMultipleGaugeView
                    x:Name="PieChart"
                    Grid.Column="4"
                    DrawMargin="50,0,0,0"
                    MaxValue="3600" />

            </Grid>
        </Grid>
    </Border>
</UserControl>
