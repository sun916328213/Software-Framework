<!--
中文阅读说明：界面与资源声明。
WPFControls 模块：可复用业务界面及模块装配，页面可用性与机型实际选择分离，具体数据库实体和硬件启动归宿主。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:HelpTool="clr-namespace:Extension.UI.Controls;assembly=Extension"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControls.Controls.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:WPFControls.Controls.Models"
    x:Class="WPFControls.Controls.Views.User.AddUserView"
    x:Name="userControl"
    d:DesignHeight="500"
    d:DesignWidth="400"
    UseLayoutRounding="True"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    FontFamily="Microsoft YaHei UI"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControls;component/Shared/Views/User/UserFormStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        CanContentScroll="False"
        Focusable="False">
        <StackPanel Margin="12">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Name="btn_Return_Create"
                    Command="{Binding ElementName=userControl, Path=ReturnCommand}"
                    Cursor="Hand"
                    ToolTip="返回登录"
                    AutomationProperties.Name="返回登录"
                    Style="{StaticResource UserFormBackButton}">
                    <Button.Content>
                        <materialDesign:PackIcon
                            x:Name="packIcon"
                            Width="20"
                            Height="{Binding Width, ElementName=packIcon}"
                            Kind="ArrowLeft"/>
                    </Button.Content>
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock
                        Text="新增用户"
                        FontSize="22"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"/>
                    <TextBlock
                        Text="填写账户信息并选择用户等级"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <TextBox
                Name="txt_Name"
                materialDesign:HintAssist.Hint="用户名"
                Style="{StaticResource UserFormTextBox}"
                Text="{Binding ElementName=userControl, Path=UserName, Mode=TwoWay}"
                AutomationProperties.Name="用户名"/>
            <PasswordBox
                Name="txt_NewPassword"
                HelpTool:PasswordBoxEx.Attach="True"
                HelpTool:PasswordBoxEx.Password="{Binding ElementName=userControl, Path=Password, Mode=TwoWay}"
                materialDesign:HintAssist.Hint="密码"
                Style="{StaticResource UserFormPasswordBox}"
                AutomationProperties.Name="密码"/>
            <PasswordBox
                Name="txt_ConformPassword"
                HelpTool:PasswordBoxEx.Attach="True"
                HelpTool:PasswordBoxEx.Password="{Binding ElementName=userControl, Path=ConfirmPassword, Mode=TwoWay}"
                materialDesign:HintAssist.Hint="确认密码"
                Style="{StaticResource UserFormPasswordBox}"
                AutomationProperties.Name="确认密码"/>
            <ComboBox
                Name="cmb_Level"
                materialDesign:HintAssist.Hint="用户等级"
                ItemsSource="{Binding ElementName=userControl, Path=UserLevelCollection, Mode=TwoWay}"
                SelectedItem="{Binding ElementName=userControl, Path=UserLevel, Mode=TwoWay}"
                Style="{StaticResource UserFormComboBox}"
                AutomationProperties.Name="用户等级"/>
            <Label Name="lbl_ShowInfo_Create" Content="{Binding ElementName=userControl, Path=ErrorMessage, Mode=TwoWay}" Style="{StaticResource UserFormError}"/>
            <Button
                Name="btn_Create"
                Command="{Binding ElementName=userControl, Path=AddCommand}"
                Content="新建用户"
                Style="{StaticResource UserFormPrimaryButton}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
