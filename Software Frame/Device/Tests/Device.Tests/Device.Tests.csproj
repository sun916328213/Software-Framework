<!--
中文阅读说明：项目构建声明。
Device 模块：设备契约、驱动适配、工作区及界面；真实连接和释放顺序由设备生命周期约定决定。 本文件属于测试，构造条件与断言不代表真实硬件或生产环境已验收。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Device.Tests</AssemblyName>
    <RootNamespace>Device.Tests</RootNamespace>
    <!-- 逻辑测试线：直引 Core + Runtime，不启用 WPF。
         Runtime 因厂商 DLL 必须为 windows7.0，故整条线取 net9.0-windows7.0；
         控件与宿主装配测试另见 Device.Workbench.Tests。 -->
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 与被测类库平台策略一致：测试进程保持 AnyCPU，不强制 x64。 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Device.Core\Device.Core.csproj" />
    <ProjectReference Include="..\..\Device.Runtime\Device.Runtime.csproj" />
  </ItemGroup>
</Project>