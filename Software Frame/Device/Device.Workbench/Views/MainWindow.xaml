<!--
中文阅读说明：界面与资源声明。
Device 模块：设备契约、驱动适配、工作区及界面；真实连接和释放顺序由设备生命周期约定决定。 本文件属于验证宿主，模块组合与人工验证流程应与生产机型业务区分。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<Window
    x:Class="Device.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    Title="Device 测试工作台"
    Width="1440"
    Height="900"
    MinWidth="1100"
   MinHeight="700"
    Style="{StaticResource WorkbenchWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  侧栏（跟随主题：浅色主题下浅底深字，深色主题下深底浅字）  -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <DockPanel>
                <StackPanel Margin="12,16,12,12" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="CameraControl" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Text="Device" />
                            <!--  次要文字：主前景 + Opacity（不用 ForegroundLight，WCAG 不过关）  -->
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Opacity="0.7"
                                Text="测试工作台 · Material" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--
                    主题切换复用 ThemePickerView：Theme 传宿主 DI 里的 ThemeService 单例。
                    侧栏跟随主题，必须显式传 FieldBackground / FieldForeground
                    （控件默认值是给固定深色侧栏用的，压在浅底上看不清）。
                -->
                <StackPanel Margin="16,0,16,16" DockPanel.Dock="Bottom">
                    <wpfcc:ThemePickerView
                        FieldBackground="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        FieldForeground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Theme="{Binding Theme}" />
                    <TextBlock Text="{Binding NavigationError}" TextWrapping="Wrap" Margin="0,8,0,0"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Margin="8,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Opacity="0.7"
                        Text="Core · Runtime · Drivers · Prism · WPF · .NET 9" />
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding NavItems}" IsEnabled="{Binding CanSelectNavigation}"
                    SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource NavListBox}" />
            </DockPanel>
        </Border>

        <!--  内容区域（Prism 区域导航）：宿主保持纯容器，页面级滚动由各页自己的 ScrollViewer 负责  -->
        <ContentControl
            Grid.Column="1"
            Margin="12"
            prism:RegionManager.RegionName="MainRegion" />
    </Grid>
</Window>
