<!--
中文阅读说明：界面与资源声明。
Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="Vision.Controls.View.VisionBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:theme="clr-namespace:Vision.Controls.Presentation"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:view="clr-namespace:Vision.Controls.View"
    xmlns:common="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Vision.Controls;component/Themes/PageStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <common:PageHeaderView Title="视觉工具" SubTitle="工具目录 · 参数与 ROI" IconKind="ImageFilterCenterFocus" Margin="0,0,0,8"/>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="2*" MinWidth="320" />
            <ColumnDefinition Width="*" MinWidth="230" />
        </Grid.ColumnDefinitions>
        <!-- Tool Browser：目录 -->
        <ListBox AutomationProperties.Name="视觉工具目录" Style="{StaticResource MaterialDesignListBox}" Padding="8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            ItemsSource="{Binding Browser.ToolEntries, RelativeSource={RelativeSource AncestorType=UserControl}}"
            DisplayMemberPath="Name"
            SelectedItem="{Binding Browser.SelectedEntry, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
        <!-- 参数编辑 + 执行 + 对比 + Benchmark -->
        <Grid Grid.Column="1" Margin="8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <view:ToolCardView Card="{Binding Browser.CurrentCard, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <xctk:PropertyGrid Margin="0,8,0,8" theme:PropertyGridThemeAssist.IsEnabled="True"
                Grid.Row="1"
                SelectedObject="{Binding Browser.CurrentParameters, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <WrapPanel Grid.Row="2">
                <Button Style="{StaticResource CompactOutlinedButton}"
                    Margin="0,4,4,4"
                    Command="{Binding Browser.LoadImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="加载图像" />
                <Button Style="{StaticResource CompactOutlinedButton}"
                    Margin="0,4,4,4"
                    Command="{Binding Browser.UseDemoImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="合成图" />
                <Button Style="{StaticResource CompactOutlinedButton}"
                    Margin="0,4,4,4"
                    Command="{Binding Browser.CompareBlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="后端对比" />
                <Button Style="{StaticResource CompactOutlinedButton}"
                    Margin="0,4,0,4"
                    Command="{Binding Browser.RunBenchmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="Benchmark" />
            </WrapPanel>
            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                Text="{Binding Browser.ImageInfoText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="4"
                Margin="0,4,0,0"
                Text="{Binding Browser.CompareText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="5"
                Margin="0,4,0,0"
                Text="{Binding Browser.BenchmarkText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextWrapping="Wrap" />
        </Grid>
        <!-- ROI 编辑 + AI Provider 选择 -->
        <Grid Grid.Column="2" Margin="8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <view:RoiEditorView Editor="{Binding Browser.RoiEditor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <StackPanel Grid.Row="1">
                <TextBlock Text="AI Provider（三家切换）："
                    Margin="0,4,0,4" />
                    <ComboBox Style="{StaticResource CompactComboBox}" md:HintAssist.Hint="AI Provider" AutomationProperties.Name="AI Provider"
                    ItemsSource="{Binding Browser.ProviderEntries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Name"
                    SelectedValue="{Binding Browser.SelectedProviderName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
