<!--
中文阅读说明：界面与资源声明。
Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl x:Class="Vision.Controls.View.ToolEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:theme="clr-namespace:Vision.Controls.Presentation"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Tool.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8">
                <Button Style="{StaticResource CompactOutlinedButton}" Content="校验" Click="ValidateClick" Margin="0,0,8,4"/>
                <Button Style="{StaticResource CompactOutlinedButton}" x:Name="ModelButton" Content="加载 / 训练" Click="LoadClick" Margin="0,0,8,4" Visibility="Collapsed"/>
                <Button Content="执行" Click="RunClick" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,4"/>
                <Button Style="{StaticResource CompactOutlinedButton}" Content="保存" Click="SaveClick" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <xctk:PropertyGrid theme:PropertyGridThemeAssist.IsEnabled="True" AutoGenerateProperties="False" SelectedObject="{Binding Tool, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <xctk:PropertyGrid.PropertyDefinitions>
                    <xctk:PropertyDefinition TargetProperties="Name"/>
                    <xctk:PropertyDefinition TargetProperties="TemplateImagePath"/>
                </xctk:PropertyGrid.PropertyDefinitions>
            </xctk:PropertyGrid>
            <xctk:PropertyGrid Margin="8,0,0,0" theme:PropertyGridThemeAssist.IsEnabled="True" Grid.Column="1" SelectedObject="{Binding Tool.EditableParameters, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
    </DockPanel>
</UserControl>
