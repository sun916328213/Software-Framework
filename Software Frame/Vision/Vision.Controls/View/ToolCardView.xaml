<!--
中文阅读说明：界面与资源声明。
Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="Vision.Controls.View.ToolCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Vision.Controls;component/Themes/PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <md:Card Style="{StaticResource VisionCard}">
        <StackPanel>
            <TextBlock
                FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                Text="{Binding Card.ToolName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding Card.StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Card.ResultSummary, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextWrapping="Wrap" Text="{Binding Card.ElapsedMs, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=用时 {0} ms}" />
            <WrapPanel Margin="0,8,0,0">
                <Button
                    Margin="0,4,8,0"
                    Command="{Binding Card.RefreshValidationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="校验" />
                <Button
                    Margin="0,4,8,0"
                    Command="{Binding Card.EnsureLoadedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="加载" />
                <Button
                    Margin="0,4,0,0"
                    Command="{Binding Card.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="执行" Style="{StaticResource CompactPrimaryButton}" />
            </WrapPanel>
        </StackPanel>
    </md:Card>
</UserControl>
