<!--
中文阅读说明：界面与资源声明。
Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。
绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WPFCustomControls;component/Resources/CompactControlStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="VisionSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="VisionCard" TargetType="md:Card">
        <Setter Property="Padding" Value="12" />
        <Setter Property="UniformCornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
