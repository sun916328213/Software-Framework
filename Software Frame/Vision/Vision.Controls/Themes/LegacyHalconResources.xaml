    <!--  样式资源  -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="2"
                        SnapsToDevicePixels="true"
                        Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                        StrokeDashArray="2 3"
                        StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="SecoteBlueBrush" Color="#429bf5" />

    <!--  紧凑的 ListBoxItem：去掉多余内边距 & 选中高亮  -->
    <Style x:Key="CompactListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  薄&自动隐藏的 ScrollViewer 模板：用于 ListBox 的内置滚动  -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <!--  内容  -->
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" />

                        <!--  竖向滚动条（悬浮在右侧，默认透明）  -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Column="1"
                            Width="6"
                            Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Minimum="0"
                            Opacity="0"
                            Orientation="Vertical"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{TemplateBinding VerticalOffset}" />

                        <!--  横向滚动条（如不需要可删）  -->
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Height="6"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Maximum="{TemplateBinding ScrollableWidth}"
                            Minimum="0"
                            Opacity="0"
                            Orientation="Horizontal"
                            ViewportSize="{TemplateBinding ViewportWidth}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{TemplateBinding HorizontalOffset}" />
                    </Grid>

                    <!--  鼠标移入 ScrollViewer 或滚动时淡入，移出淡出  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  可选：更“细”的滚动条滑块（Thumb）风格  -->
    <Style TargetType="ScrollBar">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
        <!--  拖动块颜色（半透明深灰）  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb
                                    Width="6"
                                    Height="20"
                                    Background="{TemplateBinding Foreground}"
                                    Opacity="0.8" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style
        x:Key="ScrollBar_Style"
        BasedOn="{StaticResource MaterialDesignScrollBar}"
        TargetType="{x:Type ScrollBar}">
        <Setter Property="materialDesign:ScrollBarAssist.ButtonsVisibility" Value="Collapsed" />
        <Setter Property="materialDesign:ScrollBarAssist.ThumbCornerRadius" Value="4" />
        <Setter Property="materialDesign:ScrollBarAssist.ThumbHeight" Value="22" />
        <Setter Property="materialDesign:ScrollBarAssist.ThumbWidth" Value="28" />
    </Style>
</ResourceDictionary>