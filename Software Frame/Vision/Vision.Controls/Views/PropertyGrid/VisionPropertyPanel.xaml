<ScrollViewer
    x:Class="Vision.Controls.View.VisionPropertyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:view="clr-namespace:Vision.Controls.View"
    x:Name="Root"
    HorizontalScrollBarVisibility="Disabled"
    VerticalScrollBarVisibility="Auto">
    <ScrollViewer.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vision.Controls;component/Themes/VisionPropertyPanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Vision.PropertyPanel.BoolToVisibility" />
            <DataTemplate x:Key="VisionPropertyRow">
                <Grid x:Name="PropertyRow" Visibility="{Binding IsRowVisible, Converter={StaticResource Vision.PropertyPanel.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource Vision.PropertyPanel.LabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        MouseDown="LabelMouseDown"
                        MouseLeave="LabelMouseLeave"
                        Style="{DynamicResource Vision.PropertyPanel.Label}"
                        Text="{Binding Label}">
                        <TextBlock.ToolTip>
                            <ToolTip Placement="Mouse">
                                <TextBlock Style="{DynamicResource Vision.PropertyPanel.Help}" Text="{Binding HelpText}" />
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <view:VisionPropertyEditorPresenter Style="{DynamicResource Vision.PropertyPanel.Editor}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="10,0,6,6"
                        Text="{Binding ValidationText}"
                        TextWrapping="Wrap"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        Visibility="{Binding HasValidationIssues, Converter={StaticResource Vision.PropertyPanel.BoolToVisibility}}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ScrollViewer.Resources>
    <StackPanel>
        <ItemsControl x:Name="ParameterIssues" Margin="8,4" ItemsSource="{Binding ParameterValidation.Issues, ElementName=Root}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2"
                               Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    <ItemsControl x:Name="PropertyGroups" ItemsSource="{Binding Model.Groups, ElementName=Root}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <materialDesign:Card Style="{DynamicResource Vision.PropertyPanel.Group}">
                    <Expander
                        Header="{Binding GroupName}"
                        IsExpanded="{Binding ExpandGroups, RelativeSource={RelativeSource AncestorType=view:VisionPropertyPanel}, Mode=OneWay}"
                        Style="{DynamicResource Vision.PropertyPanel.Expander}">
                        <ItemsControl ItemTemplate="{StaticResource VisionPropertyRow}" ItemsSource="{Binding Items}" />
                    </Expander>
                </materialDesign:Card>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
</ScrollViewer>
