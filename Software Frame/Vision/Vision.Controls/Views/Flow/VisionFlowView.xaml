<UserControl
    x:Class="Vision.Controls.View.VisionFlowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flow="clr-namespace:FlowEditor.Controls.Views;assembly=FlowEditor.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    PreviewMouseDown="OnNodeDoubleClick"
    mc:Ignorable="d">
    <DockPanel>
        <!--  视觉任务专属动作移到菜单；执行、文件和画布布局继续使用原容器。  -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="视觉任务">
                <MenuItem x:Name="LoadTaskImageMenuItem" Header="加载任务图像" Command="{Binding LoadImageCommand}" />
                <MenuItem x:Name="CaptureFixtureMenuItem" Header="选中节点设为定位基准" Command="{Binding CaptureFixtureReferenceCommand}" />
            </MenuItem>
        </Menu>
        <flow:FlowChartContainerView
            x:Name="FlowHost"
            Loaded="OnEditorLoaded"
            PreviewDragOver="OnPaletteDragOver"
            PreviewDrop="OnPaletteDrop" />
    </DockPanel>
</UserControl>
