<!--
    中文阅读说明：界面与资源声明。
    Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。
    绑定路径、命令、资源键和事件处理器与对应代码协作；请同步核对 DataContext 和资源字典来源。
-->
<UserControl
    x:Class="Vision.Controls.View.RoiEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:roi="clr-namespace:Vision.Core.Roi;assembly=Vision.Core"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    x:Name="Root"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,4"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding Editor.Count, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=ROI（{0}）}" />
            <ListBox
                Grid.Row="2"
                MinHeight="48"
                MaxHeight="120"
                VerticalAlignment="Top"
                AutomationProperties.Name="ROI 列表"
                ItemsSource="{Binding Editor.Rois, RelativeSource={RelativeSource AncestorType=UserControl}}"
                SelectedItem="{Binding Editor.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                Style="{StaticResource MaterialDesignListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <TextBlock Margin="4,3" ToolTip="{Binding}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Kind}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static roi:RoiKind.Rectangle}">
                                            <Setter Property="Text" Value="矩形" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static roi:RoiKind.RotatedRectangle}">
                                            <Setter Property="Text" Value="旋转矩形" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static roi:RoiKind.Circle}">
                                            <Setter Property="Text" Value="圆" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static roi:RoiKind.Ellipse}">
                                            <Setter Property="Text" Value="椭圆" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static roi:RoiKind.Polygon}">
                                            <Setter Property="Text" Value="多边形" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                Grid.Row="3"
                Margin="0,6"
                DataContext="{Binding Editor, ElementName=Root}"
                IsEnabled="{Binding HasSelection}">
                <TextBlock
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="选中 ROI（图像像素坐标）" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,2,6,2">
                        <TextBlock Text="中心 X" />
                        <TextBox x:Name="RoiX" Text="{Binding SelectedX, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,2,6,2">
                        <TextBlock Text="中心 Y" />
                        <TextBox Text="{Binding SelectedY, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,2,6,2" IsEnabled="{Binding CanResizeSelected}">
                        <TextBlock Text="宽 / 圆直径" />
                        <TextBox x:Name="RoiWidth" Text="{Binding SelectedWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,2,6,2" IsEnabled="{Binding CanResizeSelected}">
                        <TextBlock Text="高 / 圆直径" />
                        <TextBox Text="{Binding SelectedHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Margin="0,2,6,2" IsEnabled="{Binding CanRotateSelected}">
                        <TextBlock Text="角度（度）" />
                        <TextBox Text="{Binding SelectedAngle, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.7"
                    Text="选择模式：拖主体移动；黄色方块调整尺寸或多边形顶点。普通矩形不旋转；旋转矩形/椭圆可用橙色圆柄旋转。Esc 回滚当前编辑，Delete 删除选中。"
                    TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,4,0,8">
                <ComboBox
                    MinWidth="115"
                    Margin="0,4,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="ROI类型"
                    SelectedItem="{Binding Editor.SelectedRoiType, ElementName=Root, Mode=TwoWay}">
                    <sys:String>矩形</sys:String>
                    <sys:String>旋转矩形</sys:String>
                    <sys:String>圆</sys:String>
                    <sys:String>椭圆</sys:String>
                    <sys:String>多边形</sys:String>
                </ComboBox>
                <ContentPresenter Margin="0,4,8,0" Content="{Binding AdditionalActions, ElementName=Root}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
                <Button
                    Margin="0,4,8,0"
                    AutomationProperties.Name="添加ROI"
                    Command="{Binding Editor.AddSelectedRoiCommand, ElementName=Root}"
                    Content="添加"
                    ToolTip="添加所选类型；多边形初始为三角形，可在画布选择模式拖动顶点调整。搜索域工具仅保留一个 ROI，新增会替换现有 ROI。" />
                <Button
                    Margin="0,4,8,0"
                    Command="{Binding Editor.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="删除" />
                <Button
                    Margin="0,4,0,0"
                    Command="{Binding Editor.ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="清空" />
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
