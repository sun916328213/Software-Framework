<UserControl
    x:Class="Vision.Controls.View.VisionImageToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Vision.Controls.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vision.Controls;component/Themes/VisionBrowserStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="ImageViewsBar"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
        BorderThickness="0,0,0,1">

        <WrapPanel Margin="0">
            <ListBox
                x:Name="ImageViewSelector"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="图像视图"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource VisionSelectionTab}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedValue="{Binding SelectedImageView, Mode=TwoWay}"
                SelectedValuePath="Tag"
                ToolTip="输入图像：当前工具输入；ROI 图像：输入加 ROI；结果图像：输出（无则输入）加结果；训练图像：真实取样局部像素，只读。">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem Content="输入图像" Tag="{x:Static models:ImageViewKind.Input}" />
                <ListBoxItem Content="ROI 图像" Tag="{x:Static models:ImageViewKind.Roi}" />
                <ListBoxItem Content="结果图像" Tag="{x:Static models:ImageViewKind.Result}" />
                <ListBoxItem Content="训练图像" Tag="{x:Static models:ImageViewKind.Training}" IsEnabled="{Binding HasTrainingImage}" ToolTip="真实模板取样图；尚无取样时禁用，非输入ROI编辑坐标">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource VisionSelectionTab}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SupportsTemplateInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBoxItem.Style>
                </ListBoxItem>
            </ListBox>
            <StackPanel
                x:Name="CanvasTools"
                Margin="0"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                IsEnabled="{Binding IsSessionActive}"
                Orientation="Horizontal">
                <Button
                    x:Name="SelectCanvasButton"
                    AutomationProperties.Name="选择"
                    Click="SelectCanvas"
                    Style="{StaticResource VisionIconButton}"
                    ToolTip="选择/编辑 ROI；结果页直接拾取结果。中键或 Ctrl+左键可临时平移">
                    <md:PackIcon
                        Width="24"
                        Height="24"
                        Kind="CursorDefaultOutline" />
                </Button>
                <Button
                    AutomationProperties.Name="适应窗口"
                    Click="FitImage"
                    Style="{StaticResource VisionIconButton}"
                    ToolTip="适应窗口；滚轮缩放">
                    <md:PackIcon
                        Width="24"
                        Height="24"
                        Kind="FitToScreenOutline" />
                </Button>
                <Button
                    AutomationProperties.Name="1:1"
                    Click="ActualPixels"
                    Style="{StaticResource VisionIconButton}"
                    ToolTip="实际像素 1:1">
                    <md:PackIcon
                        Width="24"
                        Height="24"
                        Kind="ImageSizeSelectActual" />
                </Button>
                <Menu
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent">
                    <MenuItem
                        Height="32"
                        Padding="2"
                        AutomationProperties.Name="标注设置"
                        ToolTip="标注显隐与算法中间图">
                        <MenuItem.Header>
                            <md:PackIcon
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="LayersOutline" />
                        </MenuItem.Header>
                        <MenuItem
                            x:Name="RoiOverlayMenu"
                            Header="ROI 标注"
                            IsCheckable="True"
                            IsChecked="{Binding ShowRois, Mode=TwoWay}" />
                        <MenuItem
                            x:Name="ResultOverlayMenu"
                            Header="结果标注"
                            IsCheckable="True"
                            IsChecked="{Binding ShowResults, Mode=TwoWay}" />
                        <MenuItem
                            Header="结果边界框"
                            IsCheckable="True"
                            IsChecked="{Binding ShowResultBounds, Mode=TwoWay}" />
                        <MenuItem
                            Header="结果中心点"
                            IsCheckable="True"
                            IsChecked="{Binding ShowResultCenters, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem
                            x:Name="IntermediateImageMenu"
                            Header="算法中间 ROI 图"
                            IsCheckable="True"
                            IsChecked="{Binding ShowRoiImage, Mode=TwoWay}"
                            ToolTip="仅显式查看算法发布的中间图；没有有效图时显示原图并提示" />
                    </MenuItem>
                </Menu>
            </StackPanel>

        </WrapPanel>


    </Border>
</UserControl>
