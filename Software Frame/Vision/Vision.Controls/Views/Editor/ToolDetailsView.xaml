<UserControl
    x:Class="Vision.Controls.View.ToolDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Vision.Core;assembly=Vision.Core"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:shared="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:view="clr-namespace:Vision.Controls.View"
    x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vision.Controls;component/Themes/VisionBrowserStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource VisionCommandButton}" TargetType="Button" />
            <Style
                x:Key="ResultGrid"
                BasedOn="{StaticResource MaterialDesignDataGrid}"
                TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="EnableColumnVirtualization" Value="True" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>
            <Style
                x:Key="LinkedResultGrid"
                BasedOn="{StaticResource ResultGrid}"
                TargetType="DataGrid">
                <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
                <Setter Property="ItemsSource" Value="{Binding Results.Items}" />
                <Setter Property="SelectedItem" Value="{Binding Results.SelectedItem, Mode=TwoWay}" />
                <EventSetter Event="PreviewKeyDown" Handler="ResultKeyDown" />
                <EventSetter Event="SelectionChanged" Handler="ResultSelectionChanged" />
            </Style>
            <Style
                x:Key="ResultDetailsText"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="TextBox">
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Text" Value="{Binding ResultDetails, Mode=OneWay}" />
            </Style>
            <DataTemplate x:Key="TextResultsTemplate">
                <TextBox AcceptsReturn="True" Style="{StaticResource ResultDetailsText}" />
            </DataTemplate>
            <DataTemplate x:Key="TabularResultsTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid
                        AutoGenerateColumns="True"
                        AutomationProperties.Name="工具结果明细表"
                        ItemsSource="{Binding TableRows}"
                        Style="{StaticResource ResultGrid}" />
                    <TextBox
                        Grid.Row="1"
                        MaxHeight="130"
                        Style="{StaticResource ResultDetailsText}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="MatchResultsTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutomationProperties.Name="模板匹配结果表格" Style="{StaticResource LinkedResultGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="45"
                                Binding="{Binding Id}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Score, StringFormat=0.####}"
                                Header="分数" />
                            <DataGridTextColumn
                                Width="85"
                                Binding="{Binding X, StringFormat=0.###}"
                                Header="中心 X" />
                            <DataGridTextColumn
                                Width="85"
                                Binding="{Binding Y, StringFormat=0.###}"
                                Header="中心 Y" />
                            <DataGridTextColumn
                                Width="85"
                                Binding="{Binding AngleDeg, StringFormat=0.###, TargetNullValue=—}"
                                Header="角度（度）" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Scale, StringFormat=0.###, TargetNullValue=—}"
                                Header="缩放" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding GeometryDescription}"
                                Header="定位语义" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox
                        Grid.Row="1"
                        MaxHeight="110"
                        Style="{StaticResource ResultDetailsText}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DetectionResultsTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutomationProperties.Name="AI检测结果表格" Style="{StaticResource LinkedResultGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="45"
                                Binding="{Binding Id}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Label}"
                                Header="类别" />
                            <DataGridTextColumn
                                Width="75"
                                Binding="{Binding ClassId}"
                                Header="类别编号" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Score, StringFormat=0.####}"
                                Header="分数" />
                            <DataGridTextColumn
                                Width="85"
                                Binding="{Binding X, StringFormat=0.###}"
                                Header="框中心 X" />
                            <DataGridTextColumn
                                Width="85"
                                Binding="{Binding Y, StringFormat=0.###}"
                                Header="框中心 Y" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding GeometryDescription}"
                                Header="定位语义" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox
                        Grid.Row="1"
                        MaxHeight="110"
                        Style="{StaticResource ResultDetailsText}" />
                </Grid>
            </DataTemplate>
            <Style x:Key="BlobMeasurementText" TargetType="TextBlock">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <DataTemplate x:Key="StructuredResultsTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="80" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="4,2,4,6"
                        Opacity="0.7"
                        Text="每行一个斑点 · 面积为像素数，宽高为外接尺寸。点击行或图形查看对应斑点。"
                        TextWrapping="Wrap" />
                    <md:Card Grid.Row="1" UniformCornerRadius="8">
                        <shared:DataGridView
                            view:BlobResultsGrid.SelectedFeatures="{Binding DataContext.BlobEditor.SelectedFeatures, RelativeSource={RelativeSource AncestorType={x:Type view:ToolDetailsView}}}"
                            AutoGenerateColumns="False"
                            AutomationProperties.Name="视觉结果表格"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            FrozenColumnCount="1"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            IsSynchronizedWithCurrentItem="False"
                            ItemsSource="{Binding Results.Items}"
                            PreviewKeyDown="ResultKeyDown"
                            RowHeight="30"
                            SelectedItem="{Binding Results.SelectedItem, Mode=TwoWay}"
                            SelectionChanged="ResultSelectionChanged"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Resources>
                                <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="3,2" />
                                </Style>
                                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="3,4" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="32"
                                    Binding="{Binding Id}"
                                    ElementStyle="{StaticResource BlobMeasurementText}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Area, StringFormat=0.###}"
                                    ElementStyle="{StaticResource BlobMeasurementText}"
                                    Header="面积(px²)" />
                                <DataGridTextColumn
                                    Width="78"
                                    Binding="{Binding BoundingWidth, StringFormat=0.###, TargetNullValue=—}"
                                    ElementStyle="{StaticResource BlobMeasurementText}"
                                    Header="外接宽(px)" />
                                <DataGridTextColumn
                                    Width="78"
                                    Binding="{Binding BoundingHeight, StringFormat=0.###, TargetNullValue=—}"
                                    ElementStyle="{StaticResource BlobMeasurementText}"
                                    Header="外接高(px)" />
                                <DataGridTextColumn
                                    Width="85"
                                    Binding="{Binding X, StringFormat=0.###}"
                                    ElementStyle="{StaticResource BlobMeasurementText}"
                                    Header="中心 X" />
                                <DataGridTextColumn
                                    Width="85"
                                    Binding="{Binding Y, StringFormat=0.###}"
                                    ElementStyle="{StaticResource BlobMeasurementText}"
                                    Header="中心 Y" />
                            </DataGrid.Columns>
                        </shared:DataGridView>
                    </md:Card>
                    <Border
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        Padding="4"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                        BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SelectedBlobMeasurements" DataContext="{Binding Results.SelectedItem}">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Id, StringFormat='选中斑点 #{0}'}" />
                                <TextBlock Text="{Binding Area, StringFormat='像素面积：{0:0.###} px²'}" />
                                <WrapPanel>
                                    <TextBlock Margin="0,0,8,0" Text="{Binding BoundingWidth, StringFormat='外接宽：{0:0.###} px', TargetNullValue=外接宽：—}" />
                                    <TextBlock Text="{Binding BoundingHeight, StringFormat='外接高：{0:0.###} px', TargetNullValue=外接高：—}" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding FeatureValues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock Width="120" Text="{Binding Key}" />
                                                <TextBlock Text="{Binding Value, StringFormat=0.###}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Border
            Padding="8,5"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <TextBlock
                x:Name="ToolIdentity"
                FontWeight="SemiBold"
                Text="{Binding ToolIdentity, TargetNullValue=未选择工具, FallbackValue=未选择工具}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding ToolIdentity}" />
        </Border>
        <TabControl x:Name="DetailsTabs" SelectionChanged="DetailsTabChanged">
            <TabControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource VisionDetailsTab}" TargetType="TabItem">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem
                x:Name="ParametersTab"
                Header="参数"
                IsEnabled="{Binding IsEditingEnabled}">
                <DockPanel>
                    <WrapPanel
                        x:Name="ToolActions"
                        Margin="4"
                        DockPanel.Dock="Bottom"
                        IsEnabled="{Binding IsSessionActive}">
                        <Button
                            Margin="3"
                            AutomationProperties.Name="加载模型"
                            Command="{Binding CurrentCard.EnsureLoadedCommand}"
                            IsEnabled="{Binding HasCurrentTool}"
                            Style="{StaticResource VisionCommandButton}"
                            ToolTip="显式加载当前工具的模型"
                            Visibility="{Binding SupportsModelLoading, Converter={StaticResource CapabilityVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,6,0"
                                    Kind="FolderMultipleOutline" />
                                <TextBlock Text="加载模型" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <view:VisionPropertyPanel
                        x:Name="ParametersPanel"
                        IsEnabled="{Binding IsEditingEnabled}"
                        AutoGenerateProperties="True"
                        ExpandGroups="True"
                        ParametersChanged="MetadataParametersChanged"
                        ParameterValidation="{Binding CurrentCard.Model.ParameterValidation}"
                        PropertyArea="{x:Static core:ToolPropertyArea.Parameters}"
                        TargetObject="{Binding ParameterEditor}" />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="RoiTab" Header="ROI">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="RoiPurpose"
                        Margin="0,0,0,8"
                        Text="{Binding RoiPurpose}"
                        TextWrapping="Wrap" />
                    <view:RoiEditorView
                        Grid.Row="1"
                        Editor="{Binding RoiEditor}"
                        IsEnabled="{Binding IsEditingEnabled}"
                        Visibility="{Binding UsesAreaRois, Converter={StaticResource CapabilityVisibility}}">
                        <view:RoiEditorView.AdditionalActions>
                            <Button
                                AutomationProperties.Name="绘制ROI"
                                Click="DrawSelectedRoi"
                                Content="绘制"
                                IsEnabled="{Binding CanDrawAreaRoi}"
                                ToolTip="按所选类型绘制；拖拽松开确认，多边形用完成 / Enter / 双击 / 右键确认，Esc 取消"
                                Visibility="{Binding UsesAreaRois, Converter={StaticResource CapabilityVisibility}}" />

                        </view:RoiEditorView.AdditionalActions>
                    </view:RoiEditorView>
                    <view:LineRoiEditorView
                        x:Name="LineRegionEditor"
                        Grid.Row="1"
                        GeometryEdited="LineRoiGeometryEdited"
                        IsEnabled="{Binding IsEditingEnabled}"
                        Parameters="{Binding LineSearch}"
                        Visibility="{Binding HasLineSearch, Converter={StaticResource CapabilityVisibility}}" />
                    <StackPanel Grid.Row="2">
                        <Button
                            Command="{Binding SetCropRegionFromRoiCommand}"
                            Content="使用选中矩形作为裁剪区域"
                            Visibility="{Binding SupportsCropRegion, Converter={StaticResource CapabilityVisibility}}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="ResultsTab" Header="结果">
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding CurrentCard}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TextResultsTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentCard.HasTabularResults}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TabularResultsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentCard.Results.HasItems}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource StructuredResultsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasBlobEditor}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource StructuredResultsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentCard.Results.HasMatchItems}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MatchResultsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentCard.Results.HasDetectionItems}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DetectionResultsTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </TabItem>
            <TabItem
                x:Name="ModelTab"
                Header="模型"
                Visibility="{Binding SupportsModelPanel, Converter={StaticResource CapabilityVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <StackPanel Visibility="{Binding SupportsProvider, Converter={StaticResource CapabilityVisibility}}">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="AI Provider" />
                            <ComboBox
                                AutomationProperties.Name="AI Provider"
                                IsEnabled="{Binding IsEditingEnabled}"
                                ItemsSource="{Binding ProviderEntries}"
                                SelectedValue="{Binding SelectedProviderName, Mode=TwoWay}"
                                SelectedValuePath="Name"
                                Style="{StaticResource CompactComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Opacity="0.65" Text="{Binding IsAvailable, StringFormat='  可用：{0}'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,0"
                            Opacity="0.7"
                            Text="在参数页填写模型路径等参数后，点击参数区的“加载模型”。是否可用以实际加载结果为准。"
                            TextWrapping="Wrap"
                            Visibility="{Binding SupportsModelLoading, Converter={StaticResource CapabilityVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem
                x:Name="TemplateTab"
                Header="模板"
                Visibility="{Binding SupportsTemplateInput, Converter={StaticResource CapabilityVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" IsEnabled="{Binding IsEditingEnabled}">
                        <TextBlock
                            x:Name="TemplateSteps"
                            Margin="0,0,0,8"
                            Text="① 在 ROI 页绘制并选中轴对齐矩形，设置为模板（不改变搜索图）；② 在参数页设置搜索参数；③ 点击执行并查看结果。"
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="TemplateSearchGuidance" Margin="0,0,0,8" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="按当前工具要求准备模板或模型；具体参数和搜索能力以工具说明为准。" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpenCvTemplateMatch}" Value="True">
                                            <Setter Property="Text" Value="灰度模板无需训练。角度范围为 0 表示固定方向。姿态搜索限制累计1亿响应像素；该预算并非内存或耗时预测，实际精化与候选取决于图像，执行仍可能超限。" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TemplateEditor.RequiresTraining}" Value="True">
                                            <Setter Property="Text" Value="取样后需显式训练，或显式加载可用模型；训练设置改变后需重新训练。模型引用路径不代表模型已加载。" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding SetTemplateFromRoiCommand}" Content="选中矩形设为模板" />
                        <StackPanel
                            Margin="0,8,0,0"
                            DataContext="{Binding TemplateEditor}"
                            Visibility="{Binding IsActive, Converter={StaticResource CapabilityVisibility}}">
                            <view:VisionPropertyPanel
                                ExpandGroups="True"
                                ParametersChanged="TemplateTrainingParametersChanged"
                                Tag="{Binding}"
                                TargetObject="{Binding TrainingParameters}" />
                            <WrapPanel>
                                <Button
                                    Margin="2"
                                    Command="{Binding TrainCommand}"
                                    Content="训练模型"
                                    Visibility="{Binding RequiresTraining, Converter={StaticResource CapabilityVisibility}}" />
                                <Button
                                    Margin="2"
                                    Command="{Binding SaveCommand}"
                                    Content="保存模板/模型" />
                                <Button
                                    Margin="2"
                                    Command="{Binding LoadCommand}"
                                    Content="加载模板/模型" />
                                <Button
                                    Margin="2"
                                    Command="{Binding ClearCommand}"
                                    Content="清除模板/模型" />
                            </WrapPanel>
                            <TextBlock
                                Margin="0,6"
                                Text="{Binding Status}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ModelStateText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="TemplateSize" Text="{Binding TemplateSizeText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ModelReferencePath, StringFormat='模型文件引用：{0}'}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HasModel, StringFormat='已有模板/模型：{0}'}" />
                            <TextBlock Text="{Binding NeedsTraining, StringFormat='需要重新训练：{0}'}" />
                            <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" />
                            <Image
                                Height="130"
                                Margin="0,8"
                                Source="{Binding PreviewImage}"
                                Stretch="Uniform" />
                            <TextBlock Text="模型局部轮廓（非搜索图结果）" Visibility="{Binding HasContours, Converter={StaticResource CapabilityVisibility}}" />
                            <view:TemplateContourPreview
                                Height="150"
                                Contours="{Binding Contours}"
                                Visibility="{Binding HasContours, Converter={StaticResource CapabilityVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
