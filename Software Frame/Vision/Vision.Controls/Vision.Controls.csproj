<!--
中文阅读说明：项目构建声明。
Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13.0</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Vision.Controls</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="$(NuGetPackageRoot)materialdesignthemes\**\contentFiles\**\Resources\Noto\*.ttf;$(NuGetPackageRoot)materialdesignthemes\**\contentFiles\**\Resources\Roboto\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
    <ProjectReference Include="..\Vision.Core\Vision.Core.csproj" />
    <!-- P8（2026-09-28）：新控件/VM 面向标准化 Tool（P3/P4/P5），UI 根据 Tool/Result 展示。
         旧视图仍绑迁移源（P9 退场前新旧并存）；Tools 一律不得反向引用 Controls（守卫见 Tests）。 -->
    <ProjectReference Include="..\Tools\Halcon\Vision.Tools.Halcon.csproj" />
    <ProjectReference Include="..\Tools\OpenCv\Vision.Tools.OpenCv.csproj" />
    <ProjectReference Include="..\Tools\AI\Vision.Tools.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
  </ItemGroup>
</Project>
