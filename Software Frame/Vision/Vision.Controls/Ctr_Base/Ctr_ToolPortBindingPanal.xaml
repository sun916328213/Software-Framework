<UserControl
    x:Class="Vision.Controls.Ctr_Base.Ctr_ToolPortBindingPanal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Ctr_Base"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <GroupBox Padding="4" Header="Card Group Box">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid
                    x:Name="gd_Title"
                    Height="32"
                    Margin="0,-5,0,-5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Kind="SwapVerticalBold" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button
                        x:Name="btn_Exit"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        Style="{StaticResource CompactFlatButton}"
                        ToolTip="关闭端口绑定面板"
                        AutomationProperties.Name="关闭端口绑定面板"
                        BorderThickness="0">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Kind="CloseThick" />
                    </Button>
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>



    </GroupBox>

</UserControl>
