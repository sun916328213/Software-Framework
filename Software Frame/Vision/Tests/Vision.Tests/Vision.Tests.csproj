<!--
中文阅读说明：项目构建声明。
Vision 模块：视觉工具模型、算法适配和编辑展示；厂商能力与界面转换应在对应边界内协作。 本文件属于测试，构造条件与断言不代表真实硬件或生产环境已验收。
目标框架、项目引用、包引用及复制规则保持原有声明；依赖边界以这些声明和实际构建结果为准。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vision.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- P2：Architecture/CorePurityTests 直接断言 Vision.Core 的契约类型与 csproj 内容。
         原先只是**借** DPLibrary_Halcon_F48 传递拿到 Vision.Core；显式声明后，
         将来 P9 摘掉下面那条迁移源引用时，Core 的纯度守卫不会被顺带打断。 -->
    <ProjectReference Include="..\..\Vision.Core\Vision.Core.csproj" />
    <!-- P3（2026-09-28）：HALCON Tool Contract Tests 引用标准化后的 Vision.Tools.Halcon。
         只测 Validate/Parameters/Result/纯 helper，无 HALCON Runtime 也能跑（计划 §9.1）。 -->
    <ProjectReference Include="..\..\Tools\Halcon\Vision.Tools.Halcon.csproj" />
    <!-- P4（2026-09-28）：OpenCV Tool 首批能力 + HALCON/OpenCV 对比测试。
         OpenCvSharp4.runtime.win 随 Vision.Tools.OpenCv 传递，测试可真实执行 Cv2 算子。 -->
    <ProjectReference Include="..\..\Tools\OpenCv\Vision.Tools.OpenCv.csproj" />
    <!-- P5（2026-09-28）：统一 AI Tool 层使用 fake Provider 完整测试，无真实 SDK 也能跑。 -->
    <ProjectReference Include="..\..\Tools\AI\Vision.Tools.AI.csproj" />
    <!-- P6（2026-09-28）：三家 Provider 生命周期独立验证；Invi 用 fake native API，
         Aiditron/Halcon 走“无 SDK 时行为”断言，真实推理留 RequiresRuntime。 -->
    <ProjectReference Include="..\..\AI\Invi\Vision.AI.Invi.csproj" />
    <ProjectReference Include="..\..\AI\Aiditron\Vision.AI.Aiditron.csproj" />
    <ProjectReference Include="..\..\AI\Halcon\Vision.AI.Halcon.csproj" />
    <!-- ⛔ 本工程是**纯逻辑测试线**：不得引用任何 WPF 工程（Vision.Controls / Vision.Workbench）。
         2026-09-29 分层收口：原先挂在下面的 P8（Controls VM）与 P10（WorkbenchSmoke）测试
         已迁到 Vision.Workbench.Tests（UseWPF + STA 宿主）；两者各自独占一种运行环境，
         本工程保持无 UseWPF，可独立构建。
         Controls 的**反向引用守卫**（ControlsDependencyTests）仍在 Architecture/ 下：
         它只做文件/csproj 扫描，不需要引用被守卫的程序集。 -->
  </ItemGroup>
</Project>
