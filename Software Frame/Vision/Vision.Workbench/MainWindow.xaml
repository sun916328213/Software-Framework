<Window x:Class="Vision.Workbench.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/"
 xmlns:controls="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
 Title="Vision 视觉流程工作台" Style="{StaticResource WorkbenchWindow}" WindowStartupLocation="CenterScreen">
 <Grid Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="8,2">
   <controls:AppearancePickerView x:Name="Appearance" DockPanel.Dock="Right" Theme="{Binding Theme}"/>
   <TextBlock Text="视觉流程调试" VerticalAlignment="Center"/>
   <TextBlock Margin="12,0" Text="{Binding NavigationError}" TextWrapping="Wrap"/>
  </DockPanel>
  <ContentControl Grid.Row="1" prism:RegionManager.RegionName="VisionRegion"/>
 </Grid>
</Window>
