<Window
    x:Class="Licensing.Activation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="激活"
    Width="720"
    Height="600"
    MinWidth="560"
    MinHeight="520">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="本机机器码（发送给供应商申请授权）" />
        <TextBox
            x:Name="MachineCode"
            Grid.Row="1"
            Margin="0,8,0,10"
            FontSize="20"
            IsReadOnly="True" />
        <TextBlock
            x:Name="LicenseSummary"
            Grid.Row="2"
            Margin="0,0,0,10"
            FontSize="14"
            FontWeight="SemiBold"
            Text="● 正在读取授权状态…"
            TextWrapping="Wrap" />
        <WrapPanel
            Grid.Row="3"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <Button
                x:Name="CopyButton"
                Padding="12,6"
                Click="Copy_Click"
                Content="复制机器码" />
            <Button
                x:Name="ExportButton"
                Margin="12,0,0,0"
                Padding="12,6"
                Click="Export_Click"
                Content="导出申请单"
                ToolTip="保存成 .sfreq 文件发给供应商。比复制机器码更适合邮件、微信传输；远程桌面或隔离网络下剪贴板不可用时也走这里。生成过时间恢复请求时会一并写入。" />
            <Button
                x:Name="ActivateButton"
                Margin="12,0,0,0"
                Padding="24,6"
                Click="Activate_Click"
                Content="激活"
                FontWeight="SemiBold"
                ToolTip="输入框有内容时，按粘贴的授权激活；输入框为空时，打开文件选择 .lic。" />
            <Button
                Margin="12,0,0,0"
                Padding="12,6"
                Click="Refresh_Click"
                Content="刷新状态" />
        </WrapPanel>
        <TextBlock Grid.Row="4" Text="把供应商发来的授权内容粘贴到这里后点「激活」；留空点「激活」则选择 .lic 文件（换行和空格会自动忽略）" />
        <TextBox
            x:Name="LicenseInput"
            Grid.Row="5"
            Height="64"
            Margin="0,8,0,12"
            AcceptsReturn="True"
            FontFamily="Consolas"
            HorizontalScrollBarVisibility="Disabled"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <TextBox
            x:Name="Status"
            Grid.Row="6"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <DockPanel
            Grid.Row="7"
            Margin="0,12,0,0"
            LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    x:Name="RecoveryButton"
                    Margin="12,0,0,0"
                    Padding="10,4"
                    Click="Recovery_Click"
                    Content="时间异常恢复"
                    IsEnabled="False"
                    ToolTip="仅在系统时间被改过、授权报时间异常时使用：生成请求发给供应商，供应商签发恢复授权后重新激活。" />
                <Button
                    x:Name="ClearButton"
                    Margin="12,0,0,0"
                    Padding="10,4"
                    Click="Clear_Click"
                    Content="清除本机授权"
                    IsEnabled="False"
                    ToolTip="只删除本机授权文件，不退还授权、不解除机器绑定；重新使用需要再次导入供应商提供的授权。" />
            </StackPanel>
            <TextBlock
                x:Name="FooterHint"
                VerticalAlignment="Center"
                Text="本工具负责导出申请单、导入授权，不签发授权。"
                TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
