<Window
    x:Class="Licensing.Authorization.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="授权"
    Width="620"
    Height="580">
    <Window.Resources>
        <ResourceDictionary>
            <!--
                紧凑样式在本窗口内合并，而不是只放在 App.xaml：主窗口必须能被独立构建，
                测试宿主和未来的装配入口都没有 App.xaml 的资源，StaticResource 找不到就直接抛 XamlParseException。
                App.xaml 继续负责 BundledTheme 与 MD 隐式样式（签发身份对话框只依赖它们）。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Licensing.Authorization;component/Resources/CompactControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--
                不写 Button/TextBox/TextBlock 的隐式样式：隐式样式会把控件从应用层主题里摘出来，
                变成「主窗口经典 WPF、签发身份对话框是 MD」两套长相。控件统一用上面字典里的紧凑命名样式。
            -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,0" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gray" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <!--  身份与信任锚是所有操作的前提，做成常驻状态条，而不是散落在按钮旁的提示文字。  -->
        <Border
            Margin="0,0,0,10"
            Padding="12,6"
            Background="#F5F6F7"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="8"
            DockPanel.Dock="Top">
            <DockPanel>
                <Button
                    Click="Environment_Click"
                    Content="签发身份"
                    DockPanel.Dock="Right"
                    Style="{StaticResource CompactOutlinedButton}"
                    ToolTip="初始化、解锁、备份或恢复签发身份。没有它不能签发授权。" />
                <TextBlock
                    x:Name="EnvironmentStatus"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <TextBox
            x:Name="StatusText"
            MaxHeight="130"
            Margin="0,8,0,0"
            Padding="8,6"
            Background="#FAFAFA"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            DockPanel.Dock="Bottom"
            IsReadOnly="True"
            Style="{StaticResource CompactMultilineTextBox}"
            Text="就绪"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <TabControl x:Name="Tabs">
            <TabItem Header="签发授权">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="720"
                        Margin="16,8,16,16"
                        HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="产品标识" />
                        <TextBlock Style="{StaticResource Hint}" Text="必须与客户程序内嵌的值完全一致，区分大小写；签发后不要再改。" />
                        <TextBox
                            x:Name="Product"
                            Style="{StaticResource CompactTextBox}"
                            ToolTip="1–64 个字符，首字符为英文字母或数字，仅允许英文字母、数字、点和下划线、短横线；区分大小写。示例：SoftwareFrame.MachineApp。签发后不要再改，否则已发出的授权在客户机上会提示产品不匹配。" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="客户名称" />
                        <TextBox x:Name="Customer" Style="{StaticResource CompactTextBox}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="客户机器码" />
                        <TextBlock Style="{StaticResource Hint}" Text="客户在激活工具里点「导出申请单」发给你，形如 V2-XXXX-XXXX-XXXX-XXXX；也可以直接粘贴。" />
                        <DockPanel>
                            <Button
                                Margin="8,2,0,2"
                                Click="ReadRequest_Click"
                                Content="从申请单读取"
                                DockPanel.Dock="Right"
                                Style="{StaticResource CompactOutlinedButton}"
                                ToolTip="读取客户发来的 .sfreq：自动填好机器码；带时间恢复请求时一并填入。" />
                            <TextBox
                                x:Name="Machine"
                                Margin="0,2"
                                FontFamily="Consolas"
                                Style="{StaticResource CompactTextBox}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="授权期限" />
                        <WrapPanel>
                            <TextBox
                                x:Name="ExpiryDays"
                                Width="70"
                                Margin="0,2,8,2"
                                Style="{StaticResource CompactTextBox}"
                                Text="365"
                                TextChanged="ExpiryDays_Changed"
                                ToolTip="从今天算起的天数，到期时刻为第 N 天的 23:59:59（本地时间）。" />
                            <TextBlock
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Text="天" />
                            <CheckBox
                                x:Name="Permanent"
                                Margin="0,4,16,4"
                                VerticalAlignment="Center"
                                Checked="Permanent_Changed"
                                Content="永久授权"
                                Unchecked="Permanent_Changed" />
                            <CheckBox
                                x:Name="Trial"
                                Margin="0,4,4,4"
                                VerticalAlignment="Center"
                                Content="试用" />
                        </WrapPanel>
                        <TextBlock
                            x:Name="ExpiryPreview"
                            Style="{StaticResource Hint}"
                            Text="" />

                        <Expander Margin="0,10,0,0" Header="高级选项：功能点、扩展字段、时间恢复">
                            <StackPanel Margin="4,8,0,0">
                                <TextBlock Style="{StaticResource Hint}" Text="功能点（逗号分隔，留空代表全部功能）" />
                                <TextBox x:Name="Features" Style="{StaticResource CompactTextBox}" />
                                <TextBlock Style="{StaticResource Hint}" Text="扩展字段（每行 key=value）" />
                                <TextBox
                                    x:Name="Extra"
                                    Height="80"
                                    AcceptsReturn="True"
                                    Style="{StaticResource CompactMultilineTextBox}" />
                                <TextBlock Style="{StaticResource Hint}" Text="时间恢复请求：先审核客户身份和异常原因；普通续期留空" />
                                <TextBox x:Name="RecoveryRequest" Style="{StaticResource CompactTextBox}" />
                            </StackPanel>
                        </Expander>

                        <Button
                            MinWidth="180"
                            Margin="0,20,0,4"
                            HorizontalAlignment="Left"
                            Click="Issue_Click"
                            Content="生成授权文件"
                            Style="{StaticResource CompactPrimaryButton}" />
                        <TextBlock
                            x:Name="GeneratedFile"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="授权记录">
                <DockPanel Margin="16,8,16,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Hint}" Text="每次签发自动保留完整 .lic；续期生成新记录，不覆盖旧文件。" />
                        <DockPanel>
                            <Button
                                Margin="0,4,0,4"
                                Click="OpenRecords_Click"
                                Content="打开记录目录"
                                DockPanel.Dock="Right"
                                Style="{StaticResource CompactFlatButton}" />
                            <Button
                                Margin="0,4,4,4"
                                Click="Renew_Click"
                                Content="选择记录续期"
                                DockPanel.Dock="Right"
                                Style="{StaticResource CompactPrimaryButton}" />
                            <Button
                                Margin="0,4,4,4"
                                Click="RefreshRecords_Click"
                                Content="刷新记录"
                                DockPanel.Dock="Right"
                                Style="{StaticResource CompactOutlinedButton}" />
                            <TextBox
                                x:Name="RecordSearch"
                                Margin="0,4,8,4"
                                Style="{StaticResource CompactTextBox}"
                                TextChanged="Search_Changed"
                                ToolTip="按客户、机器码或产品筛选" />
                        </DockPanel>
                    </StackPanel>
                    <DataGrid
                        x:Name="Records"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Customer}"
                                Header="客户" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Product}"
                                Header="产品" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Machine}"
                                Header="机器码" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Expiry}"
                                Header="期限" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Issued}"
                                Header="签发时间" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Number}"
                                Header="授权编号" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="验证授权">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="720"
                        Margin="16,8,16,16"
                        HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Hint}" Text="用当前签发身份验证：检查签名、所选产品和期限；不要求厂商电脑与客户机器码一致。" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button
                                Margin="0,4,8,4"
                                Click="Verify_Click"
                                Content="选择 .lic 验证"
                                Style="{StaticResource CompactOutlinedButton}" />
                            <Button
                                Margin="0,4,8,4"
                                Click="VerifyPaste_Click"
                                Content="验证粘贴的授权内容"
                                Style="{StaticResource CompactOutlinedButton}" />
                        </WrapPanel>
                        <TextBlock
                            Margin="0,10,0,2"
                            Style="{StaticResource Hint}"
                            Text="客户只发来一段文本时，直接粘贴到这里（换行、空格、全角空格会自动忽略）" />
                        <TextBox
                            x:Name="VerifyInput"
                            Height="80"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Style="{StaticResource CompactMultilineTextBox}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="验证结果" />
                        <TextBox
                            x:Name="Verification"
                            Height="220"
                            Margin="0,2,0,0"
                            IsReadOnly="True"
                            Style="{StaticResource CompactMultilineTextBox}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="客户工具包">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="720"
                        Margin="16,8,16,16"
                        HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Hint}" Text="生成客户工具包：交给客户的就是这个目录，已内置发行身份和产品标识，客户无需任何配置。" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="交付方式" />
                        <TextBlock Style="{StaticResource Hint}" Text="整目录复制给客户，只发 EXE 会缺 Licensing.Core/Licensing.Trust 等 DLL。所选位置已有内容时自动新建子目录，不会覆盖或删除任何文件。发布耗时 1–3 分钟，可取消；取消后的目录不可交付。" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="信任锚" />
                        <TextBlock Style="{StaticResource Hint}" Text="顶部状态条会先告诉你能不能生成客户包：本机签发身份必须就是仓库 Build\Trust.props 钉住的公钥，不一致时发布会被拒绝。" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button
                                MinWidth="180"
                                Margin="0,0,8,0"
                                Click="Publish_Click"
                                Content="生成客户工具包"
                                Style="{StaticResource CompactPrimaryButton}" />
                            <Button
                                x:Name="CancelOperation"
                                Click="Cancel_Click"
                                Content="取消发布"
                                IsEnabled="False"
                                Style="{StaticResource CompactOutlinedButton}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
