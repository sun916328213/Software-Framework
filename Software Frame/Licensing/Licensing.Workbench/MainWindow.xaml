<Window x:Class="Licensing.Workbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="授权接入验证 Workbench（无设备）" Width="780" Height="520" MinWidth="600" MinHeight="400">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="仅模拟宿主接入：不连接设备、不签发授权、不启动 MachineApp。" TextWrapping="Wrap"/>
      <TextBox x:Name="Machine" IsReadOnly="True" Margin="0,10" FontFamily="Consolas"/>
      <TextBlock x:Name="Authorization" Text="尚未初始化，禁止新任务。" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,12">
        <Button x:Name="StartTask" Content="模拟启动任务（10秒）" IsEnabled="False" Padding="12,6" Click="Start_Click"/>
        <Button Content="立即检查" Padding="12,6" Margin="12,0,0,0" Click="Check_Click"/>
      </WrapPanel>
      <TextBlock Text="激活工具可关闭；本窗口每秒检查。授权失效禁止新任务，已开始的模拟任务自然完成。关闭本窗口仅取消模拟任务。" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBox x:Name="Log" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
