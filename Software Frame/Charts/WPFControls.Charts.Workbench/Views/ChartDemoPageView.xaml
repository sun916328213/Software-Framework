<UserControl x:Class="WPFControls.Charts.Workbench.Views.ChartDemoPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:WPFControls.Charts.Workbench.Views.Pages"
    xmlns:vm="clr-namespace:WPFControls.Charts.Workbench.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="LiveLine"><pages:LiveLinePage /></DataTemplate>
        <DataTemplate x:Key="LiveColumn"><pages:LiveColumnPage /></DataTemplate>
        <DataTemplate x:Key="LivePie"><pages:LivePiePage /></DataTemplate>
        <DataTemplate x:Key="LiveGauge"><pages:LiveGaugePage /></DataTemplate>
        <DataTemplate x:Key="OxyLine"><pages:OxyLinePage /></DataTemplate>
        <DataTemplate x:Key="OxyPie"><pages:OxyPiePage /></DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <TextBlock Text="{Binding Title}" FontSize="24" Margin="4,8" />
            <GroupBox Header="数据操作" Margin="4" Padding="4">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasCartesian, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding DataSizeCaption}" VerticalAlignment="Center" Margin="4" />
                        <ComboBox Width="90" ItemsSource="{Binding PointCountOptions}" SelectedItem="{Binding PointCount}" Margin="4" IsEnabled="{Binding CanConfigureData}"
                            ToolTip="修改数量后点击“生成 / 重置数据”。" />
                    </StackPanel>
                    <Button Content="生成 / 重置数据" Command="{Binding ReplaceDataCommand}" />
                    <Button Content="更新首个数值" Command="{Binding MutateDataCommand}" />
                    <Button Content="{Binding AddSeriesCaption}" Command="{Binding AddSeriesCommand}"
                        Visibility="{Binding HasCartesian, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="{Binding RemoveSeriesCaption}" Command="{Binding RemoveSeriesCommand}"
                        Visibility="{Binding HasCartesian, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="{Binding AddCategoryCaption}" Command="{Binding AddCategoryCommand}"
                        Visibility="{Binding HasCategories, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="{Binding RemoveCategoryCaption}" Command="{Binding RemoveCategoryCommand}"
                        Visibility="{Binding HasCategories, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="清空并停止" Command="{Binding ClearDataCommand}" />
                </WrapPanel>
            </GroupBox>
            <GroupBox Header="样式设置" Margin="4" Padding="4">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasCartesian, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="坐标轴字体" VerticalAlignment="Center" Margin="8" />
                        <Slider Width="120" Minimum="8" Maximum="24" Value="{Binding AxisFontSize}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasInnerDiameter, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="圆环内径（0 为饼图）" VerticalAlignment="Center" Margin="8" />
                        <Slider Width="120" Minimum="0" Maximum="0.9" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding InnerDiameter}" />
                    </StackPanel>
                    <CheckBox Content="启用动画（500 ms）" IsChecked="{Binding EnableAnimations}" Margin="8" VerticalAlignment="Center"
                        Visibility="{Binding HasAnimation, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="深浅主题在窗口顶部统一切换。" Margin="8" VerticalAlignment="Center" />
                </WrapPanel>
            </GroupBox>
            <GroupBox Header="模拟运行" Margin="4" Padding="4">
                <WrapPanel>
                    <TextBlock Text="间隔 / ms" VerticalAlignment="Center" Margin="4" />
                    <ComboBox Width="90" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding IntervalMilliseconds}" Margin="4" />
                    <Button Content="开始模拟" Command="{Binding StartCommand}" />
                    <Button Content="停止模拟" Command="{Binding StopCommand}" />
                    <TextBlock Text="运行时禁止手动修改；切页停止上一页。" Margin="8" VerticalAlignment="Center" />
                </WrapPanel>
            </GroupBox>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="8" />
            <ContentControl x:Name="ChartHost" HorizontalContentAlignment="Stretch">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{Binding}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ChartPageKind.LiveLine}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LiveLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ChartPageKind.LiveColumn}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LiveColumn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ChartPageKind.LivePie}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LivePie}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ChartPageKind.LiveGauge}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LiveGauge}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ChartPageKind.OxyLine}">
                                <Setter Property="ContentTemplate" Value="{StaticResource OxyLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ChartPageKind.OxyPie}">
                                <Setter Property="ContentTemplate" Value="{StaticResource OxyPie}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChartsMounted}" Value="False">
                                <Setter Property="Content" Value="{x:Null}" />
                                <Setter Property="ContentTemplate" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <Expander Header="诊断与生命周期验证（高级）" Margin="4">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox Content="修改后自动刷新" IsChecked="{Binding AutoRefresh}" Margin="8" VerticalAlignment="Center"
                            ToolTip="取消后，增删和修改不主动刷新，用来检查原始集合通知行为。生成 / 重置数据仍刷新。" />
                        <Button Content="重新绘制当前数据" Command="{Binding RefreshCommand}" />
                        <CheckBox Content="挂载图表" IsChecked="{Binding ChartsMounted}" Margin="8" VerticalAlignment="Center" />
                        <Button Content="重建本页（停止并重置）" Command="{Binding DataContext.ResetPageCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </WrapPanel>
                    <WrapPanel Margin="8">
                        <TextBlock Text="定时次数：" /><TextBlock Text="{Binding TickCount}" Margin="0,0,16,0" />
                        <TextBlock Text="显式刷新次数：" /><TextBlock Text="{Binding RefreshCount}" Margin="0,0,16,0" />
                        <TextBlock Text="同步重建 / ms：" /><TextBlock Text="{Binding LastRefreshMilliseconds, StringFormat={}{0:F2}}" Margin="0,0,16,0" />
                        <TextBlock Text="进程托管内存 / MiB：" /><TextBlock Text="{Binding ManagedMemoryMb, StringFormat={}{0:F1}}" Margin="0,0,16,0" />
                        <TextBlock Text="会话 / s：" /><TextBlock Text="{Binding SessionSeconds, StringFormat={}{0:F1}}" />
                    </WrapPanel>
                    <TextBlock Margin="8" TextWrapping="Wrap"
                        Text="取消挂载不停止本页会话。计时仅包含本页同步模型重建，不含生成、绑定、布局或绘制；托管堆读数不是单页或原生内存，不能据此排名或判断泄漏。" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
