<local:ChartRefreshView x:Class="WPFControls.Charts.Workbench.Views.Pages.LivePiePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPFControls.Charts.Workbench.Views"
    xmlns:live="clr-namespace:WPFControls.Controls.Views.Charts;assembly=WPFControls.Charts">
    <live:ChartsPieView x:Name="Chart" Height="420" ItemSource="{Binding PieData, Mode=OneWay}"
        AnimationsSpeed="{Binding AnimationDuration}" />
</local:ChartRefreshView>
