<Window x:Class="WPFControls.Charts.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPFControls.Charts.Workbench.Views"
    xmlns:theme="clr-namespace:WPFControls.Charts.Themes;assembly=WPFControls.Charts"
    theme:ChartTheme.IsDark="{Binding IsDarkTheme}"
    Title="WPFControls.Charts · 分类型人工验证" Width="1250" Height="850" MinWidth="560" MinHeight="500"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
                <TextBlock Text="图表人工验证 · 仅模拟数据" FontSize="22" Margin="4" />
                <CheckBox Content="深色主题（包含图表）" IsChecked="{Binding IsDarkTheme}" Margin="16,8" VerticalAlignment="Center" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                DisplayMemberPath="Title" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <ContentControl Content="{Binding SelectedPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
                <DataTemplate><local:ChartDemoPageView /></DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </DockPanel>
</Window>
