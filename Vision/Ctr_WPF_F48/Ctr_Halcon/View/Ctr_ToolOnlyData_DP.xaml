<UserControl
    x:Class="Ctr_WPF_F48.Ctr_Halcon.View.Ctr_ToolOnlyData_DP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DPLibrary_Halcon_F48.Base;assembly=DPLibrary_Halcon_F48"
    xmlns:converter="clr-namespace:Ctr_WPF_F48.Converter"
    xmlns:ctr_wpf_f48="clr-namespace:Ctr_WPF_F48"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Ctr_WPF_F48.Ctr_Halcon.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="550"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ctr_WPF_F48;component/Ctr_Halcon/View/ResourceDic .xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <conv:DisplayModelToLayersConverter x:Key="DisplayModelToLayersConverter" />
            <converter:PropertiesConverter x:Key="PropertiesConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <GroupBox
        Padding="4"
        Header="Card Group Box"
        Style="{StaticResource MaterialDesignGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid x:Name="gd_Title" MouseDown="gd_Title_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Kind="ImageArea" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button
                        x:Name="btn_Exit"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="btn_Exit_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShowWindow, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Foreground="Black"
                            Kind="CloseThick" />
                    </Button>
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <local:Ctr_ToolData
                Grid.Row="0"
                Grid.Column="0"
                HTool="{Binding RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}, Path=Tool}" />
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding Tool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}, StringFormat='运行状态：{0}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Orange" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}}" Value="Idle">
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}}" Value="RunCompleted">
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}}" Value="Failed">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding Tool.RunMessage, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding Tool.RunTime, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolOnlyData_DP}, StringFormat='运行时间：{0}ms'}" />
            </Grid>
        </Grid>

    </GroupBox>

</UserControl>
