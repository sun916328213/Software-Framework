<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- P2：Architecture/CorePurityTests 直接断言 Vision.Core 的契约类型与 csproj 内容。
         原先只是**借** DPLibrary_Halcon_F48 传递拿到 Vision.Core；显式声明后，
         将来 P9 摘掉下面那条迁移源引用时，Core 的纯度守卫不会被顺带打断。 -->
    <ProjectReference Include="..\Vision.Core\Vision.Core.csproj" />
    <ProjectReference Include="..\DPLibrary_Halcon_F48\DPLibrary_Halcon_F48.csproj" />
    <!-- P3（2026-09-28）：HALCON Tool Contract Tests 引用标准化后的 Vision.Tools.Halcon。
         只测 Validate/Parameters/Result/纯 helper，无 HALCON Runtime 也能跑（计划 §9.1）。 -->
    <ProjectReference Include="..\Vision.Tools.Halcon\Vision.Tools.Halcon.csproj" />
    <!-- P4（2026-09-28）：OpenCV Tool 首批能力 + HALCON/OpenCV 对比测试。
         OpenCvSharp4.runtime.win 随 Vision.Tools.OpenCv 传递，测试可真实执行 Cv2 算子。 -->
    <ProjectReference Include="..\Vision.Tools.OpenCv\Vision.Tools.OpenCv.csproj" />
    <!-- P5（2026-09-28）：统一 AI Tool 层使用 fake Provider 完整测试，无真实 SDK 也能跑。 -->
    <ProjectReference Include="..\Vision.Tools.AI\Vision.Tools.AI.csproj" />
    <!-- P6（2026-09-28）：三家 Provider 生命周期独立验证；Invi 用 fake native API，
         Aiditron/Halcon 走“无 SDK 时行为”断言，真实推理留 RequiresRuntime。 -->
    <ProjectReference Include="..\Vision.AI.Invi\Vision.AI.Invi.csproj" />
    <ProjectReference Include="..\Vision.AI.Aiditron\Vision.AI.Aiditron.csproj" />
    <ProjectReference Include="..\Vision.AI.Halcon\Vision.AI.Halcon.csproj" />
    <!-- P8（2026-09-28）：新控件 VM/展示逻辑测试（无 UI 线程依赖）+ Controls 反向引用守卫。 -->
    <ProjectReference Include="..\Vision.Controls\Vision.Controls.csproj" />
    <!-- P10（2026-09-29）：WorkbenchSmoke 装配测试（测试→生产引用，计划 §9 允许；
         只碰 VM 装配与命令，不实例化任何可视化控件/窗口）。 -->
    <ProjectReference Include="..\Vision.Workbench\Vision.Workbench.csproj" />
  </ItemGroup>
</Project>
