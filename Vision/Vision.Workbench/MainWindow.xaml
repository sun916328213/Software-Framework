<Window
    x:Class="Vision.Workbench.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Workbench"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    d:DesignHeight="600"
    d:DesignWidth="720"
    mc:Ignorable="d">
    <Grid Margin="0">
        <TabControl
            x:Name="tabControl"
            Margin="0"
            TabStripPlacement="Right">
            <!-- P9（2026-09-28）：新 Tool 标准研发/验收入口。
                 ⛔ 2026-09-29：旧版 HALCON 页签（条码/二维码/标定/找线/AI/Blob）
                 随迁移源 DPLibrary_Halcon_F48 一并退场 —— 它们绑定的 Ctr_*_DP 控件与
                 ViewModelT 已删除，宿主现在无需 HALCON Runtime 也能启动。 -->
            <TabItem Header="ToolBrowser">
                <local:ToolBrowserView x:Name="ToolBrowser" Margin="4" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
