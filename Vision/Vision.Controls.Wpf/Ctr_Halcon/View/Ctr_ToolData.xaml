<UserControl
    x:Class="Vision.Controls.Wpf.Ctr_Halcon.View.Ctr_ToolData"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DPLibrary_Halcon_F48.Base;assembly=DPLibrary_Halcon_F48"
    xmlns:converter="clr-namespace:Vision.Controls.Wpf.Converter"
    xmlns:ctr_wpf_f48="clr-namespace:Vision.Controls.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Wpf.Ctr_Halcon.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="300"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vision.Controls.Wpf;component/Ctr_Halcon/View/ResourceDic .xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <conv:DisplayModelToLayersConverter x:Key="DisplayModelToLayersConverter" />
            <converter:PropertiesConverter x:Key="PropertiesConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Grid.Row="0"
        Grid.RowSpan="2"
        Grid.Column="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <TabControl x:Name="ParamControl" Margin="4">
            <TabControl.Style>
                <Style BasedOn="{StaticResource MaterialDesignTabControlBase}" TargetType="TabControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShowParam, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem
                x:Name="ti_1"
                Height="40"
                Header="参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ctr_wpf_f48:Ctr_PropertyPanel Grid.ColumnSpan="3" TargetObject="{Binding HTool, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}" />
                </Grid>
            </TabItem>
            <TabItem
                Height="30"
                Padding="0,0,0,0"
                Header="ROI">
                <TabItem.Style>
                    <Style BasedOn="{StaticResource MaterialDesignTabItem}" TargetType="TabItem">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ROI_Count, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}" Value="false">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ROI_Count, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}" Value="true">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*" />
                        <ColumnDefinition Width="120*" />
                        <ColumnDefinition Width="142*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="Border_ROI"
                        Grid.ColumnSpan="3"
                        Padding="4"
                        Background="#FFF1F1F1"
                        CornerRadius="12">
                        <local:Ctr_ROI
                            ItemsSource="{Binding HTool.SearchRegions, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}"
                            NameBindingPath="ROIName"
                            NameColumnHeader="名称"
                            TypeBindingPath="ROIType"
                            TypeColumnHeader="类型" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem
                Height="30"
                Padding="0,0,0,0"
                Header="卡尺">
                <TabItem.Style>
                    <Style BasedOn="{StaticResource MaterialDesignTabItem}" TargetType="TabItem">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding XLD_Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="false">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding XLD_Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="true">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Style>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*" />
                        <ColumnDefinition Width="120*" />
                        <ColumnDefinition Width="142*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="Border_Caliper"
                        Grid.ColumnSpan="3"
                        Padding="4"
                        Background="#FFF1F1F1"
                        CornerRadius="12">
                        <local:Ctr_ROI
                            ItemsSource="{Binding HTool.MeasurePaths, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}"
                            NameBindingPath="XLDName"
                            NameColumnHeader="名称"
                            TypeBindingPath="XLDType"
                            TypeColumnHeader="类型" />
                    </Border>
                </Grid>

            </TabItem>
            <TabItem
                Height="30"
                Padding="0,0,0,0"
                Header="结果">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding HTool.Results, RelativeSource={RelativeSource AncestorType=local:Ctr_ToolData}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="4"
                                    Padding="4"
                                    Background="{Binding ElementName=Expander, Path=Background}"
                                    CornerRadius="12">
                                    <Expander x:Name="Expander" Header="{Binding}">
                                        <ItemsControl ItemsSource="{Binding Path=., Converter={StaticResource PropertiesConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DockPanel Grid.Column="0" HorizontalAlignment="Center">
                                                            <TextBlock
                                                                Margin="4"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding Path=Key}" />
                                                            <TextBlock VerticalAlignment="Center" Text=":" />
                                                        </DockPanel>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Path=Value}" />
                                                    </Grid>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="4,4">
            <Button
                Width="100"
                Click="Run_Click"
                Content="测试运行"
                DockPanel.Dock="Left" />
            <Button
                Width="100"
                HorizontalAlignment="Right"
                Click="Save_Click"
                Content="保存参数"
                DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</UserControl>
