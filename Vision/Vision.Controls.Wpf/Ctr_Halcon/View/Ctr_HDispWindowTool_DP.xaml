<UserControl
    x:Class="Vision.Controls.Wpf.Ctr_Halcon.View.Ctr_HDispWindowTool_DP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Wpf.Ctr_Halcon.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid>
        <local:Ctr_HWindow_DP
            x:Name="Viewer"
            DispMessageDatas="{Binding HDispTool.DispMessages, RelativeSource={RelativeSource AncestorType=local:Ctr_HDispWindowTool_DP}}"
            DispRegionDatas="{Binding HDispTool.ResultRegions, RelativeSource={RelativeSource AncestorType=local:Ctr_HDispWindowTool_DP}, Mode=OneWay}"
            DispXLDDatas="{Binding HDispTool.ResultXLDs, RelativeSource={RelativeSource AncestorType=local:Ctr_HDispWindowTool_DP}, Mode=OneWay}"
            ImageSource="{Binding HDispTool.Image, RelativeSource={RelativeSource AncestorType=local:Ctr_HDispWindowTool_DP}}"
            IsShowMenu="Collapsed" />
    </Grid>
</UserControl>
