<UserControl
    x:Class="Vision.Controls.Wpf.Ctr_Halcon.View.HSmartWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:HalconDotNet="clr-namespace:HalconDotNet;assembly=MVTec.HalconDotNet-Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Wpf.Ctr_Halcon.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="Microsoft YaHei UI"
    mc:Ignorable="d">

    <HalconDotNet:HSmartWindowControlWPF x:Name="HSmartCtl">
        <HalconDotNet:HSmartWindowControlWPF.ContextMenu>
            <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="-10,0">
                <MenuItem Click="FitMenuItem_Click" Header="适应窗口">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="FitToScreenOutline" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="SaveMenuItem_Click" Header="保存图像">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ContentSaveMoveOutline" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="取消">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ExitToApp" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </HalconDotNet:HSmartWindowControlWPF.ContextMenu>
    </HalconDotNet:HSmartWindowControlWPF>

</UserControl>
