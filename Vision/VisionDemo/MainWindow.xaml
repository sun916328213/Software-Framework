<Window
    x:Class="H_Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Ctr="clr-namespace:Ctr_WPF_F48.Ctr_Halcon.View;assembly=Ctr_WPF_F48"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:local="clr-namespace:H_Test"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    d:DesignHeight="600"
    d:DesignWidth="720"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:ViewModelT />
    </Window.DataContext>
    <Grid Margin="0">
        <TabControl
            x:Name="tabControl"
            Margin="0"
            TabStripPlacement="Right">
            <TabItem Header="条码">

                <Ctr:Ctr_HVisionTool_DP HTool="{Binding BarcodeReader}" />

            </TabItem>
            <TabItem Header="条码自动识别">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding BarcodeReader2}" />
            </TabItem>
            <TabItem Header="二维码">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding BarcodeReader3}" />
            </TabItem>
            <TabItem Header="模板匹配—基于形状">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding template}" />

            </TabItem>
            <TabItem Header="标定">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ctr:Ctr_ToolOnlyData_DP Margin="10" Tool="{Binding nPoints}" />
                    <Ctr:Ctr_ToolOnlyData_DP
                        Grid.Column="1"
                        Margin="10"
                        Tool="{Binding tp}" />
                </Grid>
            </TabItem>
            <TabItem Header="找线">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding findLineCanny}" />
            </TabItem>
            <TabItem Header="模板匹配—基于形状2">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding template2}" />
            </TabItem>
            <TabItem Header="AI">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding aITool}" />
            </TabItem>
            <TabItem Header="Blob">
                <Ctr:Ctr_HVisionTool_DP HTool="{Binding Bb}" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
