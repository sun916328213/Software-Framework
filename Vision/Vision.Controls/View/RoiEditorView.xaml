<UserControl
    x:Class="Vision.Controls.View.RoiEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Editor.Count, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=ROI（{0}）}" />
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Editor.Rois, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SelectedItem="{Binding Editor.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal">
            <Button
                Margin="0,4,4,0"
                Click="OnAddRectangleClicked"
                Content="添加矩形" />
            <Button
                Margin="0,4,4,0"
                Click="OnAddCircleClicked"
                Content="添加圆" />
            <Button
                Margin="0,4,4,0"
                Command="{Binding Editor.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="删除" />
            <Button
                Margin="0,4,0,0"
                Command="{Binding Editor.ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="清空" />
        </StackPanel>
    </Grid>
</UserControl>
