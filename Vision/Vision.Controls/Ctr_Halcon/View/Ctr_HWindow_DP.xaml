<UserControl
    x:Class="Vision.Controls.Ctr_Halcon.View.Ctr_HWindow_DP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:HalconDotNet="clr-namespace:HalconDotNet;assembly=HalconDotNet"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Ctr_Halcon.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <DockPanel>
        <Menu
            x:Name="menu"
            Grid.Row="0"
            materialDesign:MenuAssist.MenuItemsPresenterMargin="-10,10"
            materialDesign:MenuAssist.TopLevelMenuItemHeight="30"
            DockPanel.Dock="Top"
            Visibility="{Binding IsShowMenu, RelativeSource={RelativeSource AncestorType=local:Ctr_HWindow_DP}}">
            <MenuItem
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Header="文件">
                <MenuItem
                    Click="LoadImage"
                    Header="打开"
                    Icon="{materialDesign:PackIcon Kind=FolderFileOutline}" />
                <MenuItem
                    Click="SaveImage"
                    Header="保存"
                    Icon="{materialDesign:PackIcon Kind=ContentSave}" />
            </MenuItem>
            <MenuItem
                x:Name="mi_Function"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Header="功能"
                Visibility="{Binding IsShowFunctionMenu, RelativeSource={RelativeSource AncestorType=local:Ctr_HWindow_DP}}">
                <MenuItem
                    x:Name="mu_Control"
                    Header=" ROI"
                    Icon="{materialDesign:PackIcon Kind=EyePlusOutline}" />
                <MenuItem
                    x:Name="mu_Measure"
                    Header="卡尺"
                    Icon="{materialDesign:PackIcon Kind=Ruler}" />
            </MenuItem>
        </Menu>

        <!--
            卡片容器：改用 MD 原生 Card，不再依赖自定义键 Border_Style。
            原因：Border_Style 只在 WPFCustomControls 的 Resources.xaml 里定义，
            本程序集不引用它，宿主没合并那份字典就会抛 XamlParseException（Vision.Workbench 就是）。
            为了一个样式去引用 WPFCustomControls + Prism，会平白多带 6 个 dll（约 1 MB）。
            UniformCornerRadius=8 与原 Border_Style 的圆角一致。
            ⚠️ 两处与原样式的差异：Card 无 BorderBrush（原样式有 1px 描边）；
            Card 的 ClipContent 默认 False（原样式有 RoundedCornerClipAssist 做圆角裁剪）。
            若圆角处露出直角，加 Padding="2" ClipContent="True"；
            要去掉 Card 默认阴影，加 materialDesign:ElevationAssist.Elevation="Dp0"。
        -->
        <materialDesign:Card UniformCornerRadius="8">
            <local:HSmartWindowView x:Name="HSWindowView" />
        </materialDesign:Card>
    </DockPanel>
</UserControl>
