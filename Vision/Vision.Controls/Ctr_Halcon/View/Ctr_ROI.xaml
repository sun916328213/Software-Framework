<DataGrid
    x:Class="Vision.Controls.Ctr_Halcon.View.Ctr_ROI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:visionCtr="clr-namespace:Vision.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Ctr_Halcon.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="400"
    materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
    AutoGenerateColumns="False"
    CanUserAddRows="False"
    IsReadOnly="False"
    PreviewMouseDoubleClick="dg_Common_PreviewMouseDoubleClick"
    RowDetailsVisibilityMode="VisibleWhenSelected"
    SelectionMode="Extended"
    Style="{StaticResource MaterialDesignDataGrid}"
    mc:Ignorable="d">
    <!--  列定义将在代码中动态创建  -->
    <DataGrid.Columns />
    <!--  列标题样式  -->
    <DataGrid.ColumnHeaderStyle>
        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </DataGrid.ColumnHeaderStyle>
    <!-- 行样式：把 IsSelected <-> IsHit 绑定起来 -->
    <DataGrid.RowStyle>
        <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
            <Setter Property="IsSelected" Value="{Binding IsHit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Style>
    </DataGrid.RowStyle>
    <!--  行详情里放你的属性面板；DataContext 就是该行的项  -->
    <DataGrid.RowDetailsTemplate>
        <DataTemplate>
            <Border
                x:Name="detailsBorder"
                Margin="4"
                BorderBrush="{StaticResource MaterialDesign.Brush.Primary}"
                BorderThickness="2"
                CornerRadius="12">
                <visionCtr:Ctr_PropertyPanel TargetObject="{Binding}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:Ctr_ROI}, Path=ShowBorderInRowDetails}" Value="False">
                    <Setter TargetName="detailsBorder" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </DataGrid.RowDetailsTemplate>
</DataGrid>