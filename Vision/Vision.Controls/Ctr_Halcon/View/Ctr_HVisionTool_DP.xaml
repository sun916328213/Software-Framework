<UserControl
    x:Class="Vision.Controls.Ctr_Halcon.View.Ctr_HVisionTool_DP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DPLibrary_Halcon_F48.Base;assembly=DPLibrary_Halcon_F48"
    xmlns:converter="clr-namespace:Vision.Controls.Converter"
    xmlns:visionCtr="clr-namespace:Vision.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Vision.Controls.Ctr_Halcon.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    Background="White"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Vision.Controls;component/Ctr_Halcon/View/ResourceDic .xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <conv:DisplayModelToLayersConverter x:Key="DisplayModelToLayersConverter" />
            <converter:PropertiesConverter x:Key="PropertiesConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <GroupBox Padding="4,0" Header="Card Group Box">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <Grid
                    x:Name="gd_Title"
                    Height="40"
                    Margin="0,-10,0,-10"
                    MouseDown="gd_Title_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Kind="ImageArea" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody1TextBlock}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button
                        x:Name="btn_Exit"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="btn_Exit_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShowWindow, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Foreground="Black"
                            Kind="CloseThick" />
                    </Button>
                </Grid>
            </DataTemplate>
        </GroupBox.HeaderTemplate>


        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="337*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock
                    Margin="8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Text="显示项：" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding HTool.DispModels, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}"
                    SelectedItem="{Binding HTool.DispLayer, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}, Converter={StaticResource DisplayModelToLayersConverter}}"
                    Style="{StaticResource MaterialDesignComboBox}" />
            </DockPanel>
            <local:Ctr_HWindow_DP
                x:Name="Viewer"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0"
                DispMeasurePathDatas="{Binding HTool.MeasurePaths, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}"
                DispMessageDatas="{Binding HTool.DispMessages, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}"
                DispROIDatas="{Binding HTool.SearchRegions, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}"
                DispRegionDatas="{Binding HTool.ResultRegions, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}, Mode=OneWay}"
                DispXLDDatas="{Binding HTool.ResultXLDs, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}, Mode=OneWay}"
                DisplayLayers="{Binding HTool.DispLayer, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}"
                ImageSource="{Binding HTool.Image, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}" />
            <local:Ctr_ToolData
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                Margin="10,0,0,0"
                HTool="{Binding RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}, Path=HTool}" />


            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding HTool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}, StringFormat='运行状态：{0}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Orange" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HTool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}" Value="Idle">
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HTool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}" Value="RunCompleted">
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HTool.ToolState, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}" Value="Failed">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding HTool.RunMessage, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding HTool.RunTime, RelativeSource={RelativeSource AncestorType=local:Ctr_HVisionTool_DP}, StringFormat='运行时间：{0}ms'}" />
            </Grid>

        </Grid>

    </GroupBox>

</UserControl>
