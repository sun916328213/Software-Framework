<UserControl
    x:Class="WPFControl.CustomControl.Views.PaginationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="UserControl"
    d:DesignHeight="50"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="NavButtonStyle"
            BasedOn="{StaticResource MaterialDesignFlatButton}"
            TargetType="Button" />

        <Style TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        CornerRadius="6">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                Text="{Binding ElementName=UserControl, Path=TotalCount, StringFormat=共 {0} 条}" />

            <Button
                Command="{Binding ElementName=UserControl, Path=FirstCommand}"
                Style="{StaticResource NavButtonStyle}"
                ToolTip="首页">
                <materialDesign:PackIcon Kind="ChevronDoubleLeft" />
            </Button>
            <Button
                Command="{Binding ElementName=UserControl, Path=PrevCommand}"
                Style="{StaticResource NavButtonStyle}"
                ToolTip="上一页">
                <materialDesign:PackIcon Kind="ChevronLeft" />
            </Button>

            <StackPanel
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    Text="第" />
                <TextBox
                    x:Name="PageNumberBox"
                    Width="40"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    KeyDown="PageNumberBox_KeyDown"
                    LostFocus="PageNumberBox_LostFocus"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="6,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="/ {0} 页">
                            <Binding ElementName="UserControl" Path="TotalPages" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <Button
                Command="{Binding ElementName=UserControl, Path=NextCommand}"
                Style="{StaticResource NavButtonStyle}"
                ToolTip="下一页">
                <materialDesign:PackIcon Kind="ChevronRight" />
            </Button>
            <Button
                Command="{Binding ElementName=UserControl, Path=LastCommand}"
                Style="{StaticResource NavButtonStyle}"
                ToolTip="末页">
                <materialDesign:PackIcon Kind="ChevronDoubleRight" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
