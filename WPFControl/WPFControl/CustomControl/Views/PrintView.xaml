<UserControl
    x:Class="WPFControl.CustomControl.Views.PrintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodel="clr-namespace:WPFControl.CustomControl.ViewModels"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:PrintViewModel}"
    d:DesignHeight="350"
    d:DesignWidth="400"
    local:PrintView.PreviewImage="{Binding Datas.LabelImage, Mode=OneWay}"
    local:PrintView.PrintInfo="{Binding Datas.PrintInfo, Mode=OneWay}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="{x:Type Button}">
                <Setter Property="FontSize" Value="{Binding ElementName=UserControl, Path=FontSize}" />
                <Setter Property="Width" Value="100" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Grid.Row="0"
        Grid.Column="0"
        Cursor="">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,0"
            VerticalContentAlignment="Center"
            Content="标签路径：" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="4,6,4,6"
            Text="{Binding Datas.LabelFormat}" />
        <Button
            Grid.Row="0"
            Grid.Column="2"
            Command="{Binding OpenCommand}"
            Content="打开" />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            Margin="10,0"
            VerticalContentAlignment="Center"
            Content="打印机名称："
            Cursor="" />
        <ComboBox
            x:Name="cmb_PrintName"
            Grid.Row="1"
            Grid.Column="1"
            Margin="4,-2,4,-2"
            ItemsSource="{Binding Datas.PrintNames}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding SelectPrintCommand}" CommandParameter="{Binding ElementName=cmb_PrintName, Path=SelectedItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <custm:DataGridView
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{StaticResource Color_White}"
            IsReadOnly="False"
            ItemsSource="{Binding Datas.LabelField}" />
        <StackPanel
            Grid.Row="2"
            Grid.Column="2"
            VerticalAlignment="Bottom"
            Orientation="Vertical">
            <Button
                Margin="0,0,0,10"
                Command="{Binding GetValueCommand}"
                Content=" 获取" />
            <Button
                Margin="0,0,0,10"
                Command="{Binding SetValueCommand}"
                Content="设置" />
            <Button
                Margin="0,0,0,10"
                Command="{Binding PrintCommand}"
                Content="打印" />
        </StackPanel>

    </Grid>

</UserControl>