<UserControl
    x:Class="WPFControl.CustomControl.Views.LightControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPFControl.CustomControl.ViewModels"
    xmlns:prism="http://prismlibrary.com/"
    d:DataContext="{d:DesignInstance Type=models:LightControlViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <GroupBox Header="光源控制">
        <Grid>
            <Grid.RowDefinitions>

                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="光源名称" />
                <ComboBox
                    Width="120"
                    Margin="4"
                    ItemsSource="{Binding LightControlNames}"
                    SelectedItem="{Binding SelectLightControlName, Mode=TwoWay}" />

                <TextBlock Width="40" />
                <TextBlock Text="光源通道" />
                <ComboBox
                    Width="120"
                    Margin="4"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    SelectedIndex="{Binding SelectChannel}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding SetLightCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="6" />
                    <ComboBoxItem Content="7" />
                    <ComboBoxItem Content="8" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal">

                <TextBlock Text="光源亮度" />
                <TextBlock Width="120" Text="{Binding Datas.LightIntensity}" />

                <Button
                    Width="120"
                    Margin="4"
                    Command="{Binding OpenAllCommand}"
                    Content="全部打开" />
                <Button
                    Width="120"
                    Margin="4"
                    Command="{Binding CloseAllCommand}"
                    Content="全部关闭" />
            </StackPanel>

            <Slider
                Grid.Row="2"
                Margin="4,0"
                Maximum="255"
                Minimum="0"
                Value="{Binding Datas.LightIntensity}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="ValueChanged">
                        <i:InvokeCommandAction Command="{Binding SetLightCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Slider>
        </Grid>
    </GroupBox>

</UserControl>