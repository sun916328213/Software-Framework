<UserControl
    x:Class="WPFControl.CustomControl.Views.Display.DisplaySingleView_DP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:halcon="http://schemas.mvtec.com/halcondotnet"
    xmlns:halcon_dp="clr-namespace:Vision.Controls.Ctr_Halcon.View;assembly=Vision.Controls"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views.Display"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    x:Name="UserControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>-->

    <Border Background="White" CornerRadius="8">
        <DockPanel>
            <view:TitleSeparatorView
                Title="{Binding ElementName=UserControl, Path=Title}"
                Margin="2.5,0"
                DockPanel.Dock="Top" />
            <halcon_dp:Ctr_HDispWindowTool_DP
                x:Name="HalconWindow"
                Margin="2.5"
                DockPanel.Dock="Top"
                HDispTool="{Binding ElementName=UserControl, Path=HTool}" />
        </DockPanel>
    </Border>
</UserControl>