<UserControl
    x:Class="WPFControl.CustomControl.Views.Display.DisplayQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views.Display"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ButtonStyle"
            BasedOn="{StaticResource MaterialDesignRaisedButton}"
            TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <local:DisplaySingleGroupView Title="图像" DisplayImage="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}" />



        <Label
            x:Name="lbl_SelectPath"
            Grid.Row="1"
            Grid.Column="0" />

        <UniformGrid
            Grid.Row="2"
            Width="250"
            Columns="5"
            Rows="0">
            <Button
                Command="{Binding FirstCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Cursor="Hand"
                Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowCollapseLeft" />
                </Button.Content>
            </Button>
            <Button Command="{Binding LastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button.Content>
            </Button>
            <Label
                x:Name="lbl_Process"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />
            <Button Command="{Binding NextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowRight" />
                </Button.Content>
            </Button>
            <Button Command="{Binding EndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ButtonStyle}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ArrowCollapseRight" />
                </Button.Content>
            </Button>

        </UniformGrid>


    </Grid>
</UserControl>