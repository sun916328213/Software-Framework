<UserControl
    x:Class="WPFControl.CustomControl.Views.DeviceManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WPFControl.ValueConvert"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="UserControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFCustomControls;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:IsReadToIsEnableConverter x:Key="IsReadToIsEnableConverter" />

            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Border_Style}">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>


            <GroupBox Margin="8" Header="{Binding ElementName=UserControl, Path=DeviceName}">
                <custm:DataGridView
                    x:Name="DataGridView"
                    Grid.Column="0"
                    Background="{Binding ElementName=UserControl, Path=Background}"
                    FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                    IsReadOnly="{Binding ElementName=UserControl, Path=IsReadOnly}"
                    ItemsSource="{Binding ElementName=UserControl, Path=ItemsSource}"
                    RowHeight="{Binding ElementName=UserControl, Path=RowHeight}" />
            </GroupBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
                <DockPanel>

                    <Button
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SaveCommand}"
                        Content="保存"
                        DockPanel.Dock="Bottom"
                        FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                        IsEnabled="{Binding ElementName=UserControl, Path=IsReadOnly, Converter={StaticResource IsReadToIsEnableConverter}}" />

                    <Button
                        x:Name="btn_Delete"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DeleteCommand}"
                        Content="删除"
                        DockPanel.Dock="Bottom"
                        FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                        IsEnabled="{Binding ElementName=UserControl, Path=IsReadOnly, Converter={StaticResource IsReadToIsEnableConverter}}"
                        Visibility="{Binding ElementName=UserControl, Path=DeletVisibility}" />


                    <Button
                        x:Name="btn_Add"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AddCommand}"
                        Content="增加"
                        DockPanel.Dock="Bottom"
                        FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                        IsEnabled="{Binding ElementName=UserControl, Path=IsReadOnly, Converter={StaticResource IsReadToIsEnableConverter}}"
                        Visibility="{Binding ElementName=UserControl, Path=AddVisibility}" />

                    <Button
                        x:Name="btn_Set"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=LockCommand}"
                        Content="解锁"
                        DockPanel.Dock="Bottom"
                        FontSize="{Binding ElementName=UserControl, Path=FontSize}" />

                    <Button
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectCommand}"
                        Content="选择"
                        DockPanel.Dock="Bottom"
                        FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                        Visibility="{Binding ElementName=UserControl, Path=SelectVisibility}" />

                </DockPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>