<UserControl
    x:Class="WPFControl.CustomControl.Views.User.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:HelpTool="clr-namespace:Extension.UI.Controls;assembly=Extension"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views.User"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="userControl"
    d:DesignHeight="500"
    d:DesignWidth="400"
    FontFamily="Microsoft YaHei UI"
    PreviewKeyDown="LoginView_PreviewKeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style
                x:Key="ButtonStyle_Login"
                BasedOn="{StaticResource MaterialDesignOutlinedButton}"
                TargetType="{x:Type Button}">
                <!--<Setter Property="Background" Value="{StaticResource Color_White}" />
               <Setter Property="BorderBrush" Value="{x:Null}" />
               <Setter Property="Foreground" Value="{StaticResource Color_Black}" />-->
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Margin" Value="4,4,4,4" />
                <Setter Property="Height" Value="35" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="{Binding ElementName=userControl, Path=FontSize}" />
            </Style>
            <Style
                x:Key="ButtonStyle_Meun"
                BasedOn="{StaticResource MaterialDesignFlatButton}"
                TargetType="{x:Type Button}">
                <Setter Property="FontSize" Value="{Binding ElementName=userControl, Path=FontSize}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
                <!--<Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Color_Black}" />
                        <Setter Property="Background" Value="{StaticResource Color_White}" />
                    </Trigger>
                </Style.Triggers>-->
            </Style>
            <Style
                x:Key="ButtonStyle_Close"
                BasedOn="{StaticResource MaterialDesignFlatButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="0,0,0,0" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="Width" Value="60" />
                <Setter Property="Height" Value="60" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Color_Black}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style
                x:Key="ComboxStyle"
                BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}"
                TargetType="{x:Type ComboBox}">
                <Setter Property="Margin" Value="14,4,4,4" />
                <Setter Property="Height" Value="60" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="用户名" />
                <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.75" />
                <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-25" />
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="PrimaryLight" />
            </Style>


            <Style
                x:Key="PasswordStyle"
                BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                TargetType="{x:Type PasswordBox}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="14,4,4,4" />
                <Setter Property="Height" Value="60" />
                <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.75" />
                <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-25" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="密码" />
            </Style>

            <Style
                x:Key="TextBoxStyle_Create"
                BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}"
                TargetType="{x:Type TextBox}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="14,4,4,4" />
                <Setter Property="Height" Value="60" />
                <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.75" />
                <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-25" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="用户名" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Color_White}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="70" />
            <RowDefinition Height="10" />
            <RowDefinition Height="70" />
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <materialDesign:PackIcon
            Grid.Row="1"
            Grid.Column="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Kind="Account" />
        <materialDesign:PackIcon
            Grid.Row="3"
            Grid.Column="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Kind="LockCheckOutline" />

        <TextBox
            x:Name="cmb_Name"
            Grid.Row="1"
            Grid.Column="2"
            Style="{StaticResource TextBoxStyle_Create}"
            Text="{Binding ElementName=userControl, Path=UserName, Mode=TwoWay}" />
        <PasswordBox
            x:Name="txt_Password"
            Grid.Row="3"
            Grid.Column="2"
            HelpTool:PasswordBoxEx.Attach="True"
            HelpTool:PasswordBoxEx.Password="{Binding ElementName=userControl, Path=Password, Mode=TwoWay}"
            Style="{StaticResource PasswordStyle}" />
        <Button
            x:Name="btn_Return"
            Command="{Binding ElementName=userControl, Path=ExitCommand}"
            Cursor="Hand"
            Style="{StaticResource ButtonStyle_Close}">
            <materialDesign:PackIcon
                x:Name="packIcon"
                Width="50"
                Height="{Binding Width, ElementName=packIcon}"
                Kind="ExitToApp" />
        </Button>
        <Label
            x:Name="lbl_ShowInfo"
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalContentAlignment="Center"
            Content="{Binding ElementName=userControl, Path=ErrorMessage, Mode=TwoWay}"
            Cursor=""
            Foreground="{StaticResource Color_Red}" />
        <Button
            x:Name="btn_Login"
            Grid.Row="5"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Command="{Binding ElementName=userControl, Path=LoginCommand}"
            Content="登入"
            Cursor="Hand"
            Style="{StaticResource ButtonStyle_Login}" />
        <Button
            x:Name="btn_AddInfo"
            Grid.Row="7"
            Grid.Column="2"
            Command="{Binding ElementName=userControl, Path=AddCommand}"
            Content="新增用户信息">
            <Button.Style>
                <Style BasedOn="{StaticResource ButtonStyle_Meun}" TargetType="Button">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=userControl, Path=UserLevel}" Value="Admin">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=userControl, Path=UserLevel}" Value="SuperAdmin">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button
            x:Name="btn_ModInfo"
            Grid.Row="8"
            Grid.Column="2"
            Command="{Binding ElementName=userControl, Path=ModifyCommand}"
            Content="修改用户信息"
            Style="{StaticResource ButtonStyle_Meun}" />
        <Button
            x:Name="btn_ManageInfo"
            Grid.Row="9"
            Grid.Column="2"
            Command="{Binding ElementName=userControl, Path=DeleteCommand}"
            Content="删除用户信息"
            Style="{StaticResource ButtonStyle_Meun}" />
        <Button
            x:Name="btn_DeletInfo"
            Grid.Row="10"
            Grid.Column="2"
            Command="{Binding ElementName=userControl, Path=LogoutCommand}"
            Content="注销用户信息"
            Style="{StaticResource ButtonStyle_Meun}" />
    </Grid>
</UserControl>
