<UserControl
    x:Class="WPFControl.CustomControl.Views.User.ModifyUserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:HelpTool="clr-namespace:Extension.Core.ControlEx;assembly=Extension"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:WPFControl.CustomControl.Models"
    x:Name="userControl"
    d:DesignHeight="500"
    d:DesignWidth="400"
    FontFamily="Microsoft YaHei UI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style
                x:Key="ButtonStyle_Modify"
                BasedOn="{StaticResource MaterialDesignOutlinedButton}"
                TargetType="Button">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Margin" Value="4,4,4,4" />
                <Setter Property="Height" Value="35" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="{Binding ElementName=userControl, Path=FontSize}" />
            </Style>
            <Style
                x:Key="ButtonStyle_Close"
                BasedOn="{StaticResource MaterialDesignFlatButton}"
                TargetType="Button">
                <Setter Property="Padding" Value="0,0,0,0" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="Width" Value="60" />
                <Setter Property="Height" Value="60" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Color_Black}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style
                x:Key="ComboxStyle"
                BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}"
                TargetType="ComboBox">
                <Setter Property="Margin" Value="14,4,4,4" />
                <Setter Property="Height" Value="60" />
                <Setter Property="materialDesign:HintAssist.Hint" Value="用户名" />
                <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.75" />
                <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-20" />
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="PrimaryLight" />
            </Style>
            <Style
                x:Key="TextBoxStyle"
                BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}"
                TargetType="TextBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="14,4,4,4" />
                <Setter Property="Height" Value="60" />
            </Style>
            <Style
                x:Key="PasswordStyle"
                BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                TargetType="PasswordBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="14,4,4,4" />
                <Setter Property="Height" Value="60" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Color_White}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="60" />
            <RowDefinition Height="10" />
            <RowDefinition Height="60" />
            <RowDefinition Height="10" />
            <RowDefinition Height="60" />
            <RowDefinition Height="10" />
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <materialDesign:PackIcon
            Grid.Row="1"
            Grid.Column="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Kind="Account" />
        <materialDesign:PackIcon
            Grid.Row="3"
            Grid.Column="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Kind="LockOutline" />
        <materialDesign:PackIcon
            Grid.Row="5"
            Grid.Column="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Kind="LockCheckOutline" />
        <materialDesign:PackIcon
            Grid.Row="7"
            Grid.Column="1"
            Width="40"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Kind="LockOpenPlusOutline" />
        <ComboBox
            Name="txt_Name"
            Grid.Row="1"
            Grid.Column="2"
            materialDesign:HintAssist.Hint="用户名"
            ItemsSource="{Binding ElementName=userControl, Path=UserNameCollection, Mode=TwoWay}"
            Style="{StaticResource ComboxStyle}"
            Text="{Binding ElementName=userControl, Path=UserName, Mode=TwoWay}" />
        <PasswordBox
            Name="txt_Password"
            Grid.Row="3"
            Grid.Column="2"
            HelpTool:PasswordBoxEx.Attach="True"
            HelpTool:PasswordBoxEx.Password="{Binding ElementName=userControl, Path=Password, Mode=TwoWay}"
            materialDesign:HintAssist.Hint="密码"
            Style="{StaticResource PasswordStyle}" />
        <PasswordBox
            Name="txt_NewPassword"
            Grid.Row="5"
            Grid.Column="2"
            HelpTool:PasswordBoxEx.Attach="True"
            HelpTool:PasswordBoxEx.Password="{Binding ElementName=userControl, Path=NewPassword, Mode=TwoWay}"
            materialDesign:HintAssist.Hint="新密码"
            Style="{StaticResource PasswordStyle}" />
        <PasswordBox
            Grid.Row="7"
            Grid.Column="2"
            HelpTool:PasswordBoxEx.Attach="True"
            HelpTool:PasswordBoxEx.Password="{Binding ElementName=userControl, Path=ConfirmPassword, Mode=TwoWay}"
            materialDesign:HintAssist.Hint="确认密码"
            Style="{StaticResource PasswordStyle}" />

        <Button
            Name="btn_Return_Create"
            Command="{Binding ElementName=userControl, Path=ReturnCommand}"
            Cursor="Hand"
            Style="{StaticResource ButtonStyle_Close}">
            <Button.Content>
                <materialDesign:PackIcon
                    x:Name="packIcon"
                    Width="50"
                    Height="{Binding Width, ElementName=packIcon}"
                    Kind="ArrowULeftTop" />
            </Button.Content>
        </Button>
        <Label
            Name="lbl_ShowInfo_Create"
            Grid.Row="10"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Padding="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalContentAlignment="Center"
            Content="{Binding ElementName=userControl, Path=ErrorMessage}"
            Foreground="{StaticResource Color_Red}" />
        <Button
            Grid.Row="9"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Command="{Binding ElementName=userControl, Path=ModifyCommand}"
            Content="修改"
            Style="{StaticResource ButtonStyle_Modify}" />
    </Grid>

</UserControl>
