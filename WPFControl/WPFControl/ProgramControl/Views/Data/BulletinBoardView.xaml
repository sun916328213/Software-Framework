<UserControl
    x:Class="WPFControl.ProgramControl.Views.BulletinBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bulletinboard="clr-namespace:WPFControl.CustomControl.Views.BulletinBoard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPFControl.ProgramControl.ViewModels"
    xmlns:prism="http://prismlibrary.com/"
    d:DataContext="{d:DesignInstance Type=models:BulletinBoardViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <bulletinboard:ProductionCapacityView
            Grid.Row="0"
            AlarmTime="2000"
            OKCount="{Binding StatisicsModel.OK}"
            RunTime="2000"
            TotalCount="{Binding StatisicsModel.Total}" />
        <bulletinboard:YieldStatisticsView
            Title="每小时产量"
            Grid.Row="1"
            AxisX="{Binding Datas.AxisX_Day, Mode=TwoWay}"
            ItemSource="{Binding Datas.Data_Day}" />
        <bulletinboard:YieldStatisticsView
            Title="每月产量"
            Grid.Row="2"
            AxisX="{Binding Datas.AxisX_Month, Mode=TwoWay}"
            ItemSource="{Binding Datas.Data_Month}" />
    </Grid>

</UserControl>
