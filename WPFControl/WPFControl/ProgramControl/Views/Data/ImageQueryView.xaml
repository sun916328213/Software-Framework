<UserControl
    x:Class="WPFControl.ProgramControl.Views.ImageQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:cust1="clr-namespace:WPFControl.CustomControl.Views.Display"
    xmlns:custm="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WPFControl.ProgramControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ImageQueryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
                <ResourceDictionary Source="/WPFControl;component/Resources/NavigationStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Border_Style}">
            <cust:QueryView
                ColWidth="240,240,100,105,*"
                EndTime="{Binding Datas.DateTime_End, Mode=TwoWay}"
                FilterCommand="{Binding FilterCommand}"
                FilterValue="{Binding Datas.ID, Mode=TwoWay}"
                IsShowFilter="True"
                IsShowSelect="False"
                QueryCommand="{Binding QueryCommand}"
                SaveCommand="{Binding SaveCommand}"
                StartTime="{Binding Datas.DateTime_Start, Mode=TwoWay}" />
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Border_Style}" />

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource Border_Style}">
            <custm:DataGridView
                x:Name="View_DataGrid"
                Background="{StaticResource Color_White}"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.ImageInfoDatasDTO}"
                SelectedItem="{Binding Datas.SelectedItem}" />

        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Style="{StaticResource Border_Style}">
            <cust1:DisplayQueryView ItemsSource="{Binding Datas.ImagePaths}" />
        </Border>
    </Grid>
</UserControl>