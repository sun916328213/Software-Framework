<UserControl
    x:Class="WPFControl.ProgramControl.Views.LogConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:WPFControl.ProgramControl.ViewModels"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodels:LogConfigViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  日志统一配置界面（仿 CamManagerView）：内嵌 DeviceManagerView 编辑保存 Config\LogConfig.json  -->
    <wpfcc:ConfigManagerView
        AddVisibility="Collapsed"
        DeleteVisibility="Collapsed"
        Title="{Binding Datas.Name}"
        FileName="{Binding Datas.FileName}"
        FilePath="{Binding Datas.FilePath}"
        IsReadOnly="True"
        ItemsSource="{Binding Datas.DataCollection}"
        SaveCallback="{Binding SaveCallbackCommand}"
        SelectVisibility="Collapsed" />
</UserControl>
