<UserControl
    x:Class="WPFControl.ProgramControl.Views.SEMIManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:WPFControl.ProgramControl.ViewModels"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:SEMIManagerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UniformGrid Rows="2">
        <Border Style="{StaticResource Border_Style}">
            <cust:DeviceManagerView
                AddVisibility="Collapsed"
                DeletVisibility="Collapsed"
                DeviceName="SEMI ReportInfo"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.Reports}"
                RowHeight="38"
                SaveCallback="{Binding ReportSaveCommand}"
                SelectVisibility="Collapsed" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Border_Style}">
            <cust:DeviceManagerView
                AddVisibility="Collapsed"
                DeletVisibility="Collapsed"
                DeviceName="SEMI EventInfo"
                IsReadOnly="True"
                ItemsSource="{Binding Datas.Events}"
                RowHeight="38"
                SaveCallback="{Binding EventSaveCommand}"
                SelectVisibility="Collapsed" />
        </Border>
    </UniformGrid>


</UserControl>
