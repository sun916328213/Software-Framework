<UserControl
    x:Class="WPFControl.ProgramControl.Views.RFIDManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:WPFControl.ProgramControl.Models"
    xmlns:viewmodel="clr-namespace:WPFControl.ProgramControl.ViewModels"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:RFIDManagerViewModel}"
    d:DesignHeight="550"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style
                x:Key="Label_style"
                BasedOn="{StaticResource MaterialDesignLabel}"
                TargetType="Label">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <cust:DeviceManagerView
            DeviceName="{Binding Datas.Name}"
            FileName="{Binding Datas.FileName}"
            FilePath="{Binding Datas.FilePath}"
            IsReadOnly="True"
            ItemsSource="{Binding Datas.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding SaveCallbackCommand}"
            SelectItem="{Binding Datas.SelectedItem, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackCommand}" />

        <Border
            Grid.Row="1"
            Cursor=""
            Style="{StaticResource Border_Style}">
            <GroupBox
                Width="400"
                Margin="8"
                HorizontalAlignment="Left">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RFID测试:" />
                        <TextBlock Width="10" />
                        <TextBlock Text="{Binding Datas.CurRFID.Name}" TextAlignment="Center" />
                    </StackPanel>
                </GroupBox.Header>
                <UniformGrid Columns="1" Rows="5">
                    <UniformGrid Columns="3">
                        <Label
                            Width="120"
                            Content="连接状态:"
                            Style="{StaticResource Label_style}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Datas.ConnectStatus}"
                            TextAlignment="Center" />
                        <Button
                            Width="100"
                            Command="{Binding ConnectCommand}"
                            Content="连接" />
                    </UniformGrid>
                    <UniformGrid Columns="3">
                        <Label
                            Width="120"
                            Content="Page:"
                            Style="{StaticResource Label_style}" />
                        <ComboBox
                            Width="120"
                            HorizontalContentAlignment="Center"
                            SelectedItem="{Binding Datas.Page, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignComboBox}">
                            <ComboBox.ItemsSource>
                                <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Int32">
                                    <sys:Int32>1</sys:Int32>
                                    <sys:Int32>2</sys:Int32>
                                    <sys:Int32>3</sys:Int32>
                                    <sys:Int32>4</sys:Int32>
                                    <sys:Int32>5</sys:Int32>
                                    <sys:Int32>6</sys:Int32>
                                    <sys:Int32>7</sys:Int32>
                                    <sys:Int32>8</sys:Int32>
                                    <sys:Int32>9</sys:Int32>
                                    <sys:Int32>10</sys:Int32>
                                    <sys:Int32>11</sys:Int32>
                                    <sys:Int32>12</sys:Int32>
                                    <sys:Int32>13</sys:Int32>
                                    <sys:Int32>14</sys:Int32>
                                    <sys:Int32>15</sys:Int32>
                                    <sys:Int32>16</sys:Int32>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                    </UniformGrid>
                    <UniformGrid Columns="3">
                        <Label
                            Width="120"
                            Content="写入数据:"
                            Style="{StaticResource Label_style}" />
                        <TextBox
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignTextBox}"
                            Text="{Binding Datas.WriteValue, Mode=OneWayToSource}"
                            TextAlignment="Center" />
                        <Button
                            Width="100"
                            Command="{Binding WriteCommand}"
                            Content="写入" />
                    </UniformGrid>
                    <UniformGrid Columns="3">
                        <Label
                            Width="120"
                            Content="读取数据:"
                            Style="{StaticResource Label_style}" />
                        <TextBox
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsReadOnly="True"
                            Text="{Binding Datas.ReadValue}"
                            TextAlignment="Center" />
                        <Button
                            Width="100"
                            Command="{Binding ReadCommand}"
                            Content="读取" />
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="120"
                            Content="错误信息:"
                            Style="{StaticResource Label_style}" />
                        <Label
                            Width="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding Datas.Error}"
                            Foreground="{StaticResource Color_Red}" />
                    </StackPanel>
                </UniformGrid>

            </GroupBox>
        </Border>
    </Grid>
</UserControl>