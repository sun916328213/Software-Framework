<UserControl
    x:Class="WPFControl.ProgramControl.Views.CamManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:custdisplay="clr-namespace:WPFControl.CustomControl.Views.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodel="clr-namespace:WPFControl.ProgramControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodel:CamManagerViewModel}"
    d:DesignHeight="750"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style
                x:Key="Label_style"
                BasedOn="{StaticResource MaterialDesignLabel}"
                TargetType="Label">
                <Setter Property="Width" Value="120" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="Button_style"
                BasedOn="{StaticResource MaterialDesignRaisedButton}"
                TargetType="Button">
                <Setter Property="Width" Value="130" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2.5*" />
        </Grid.RowDefinitions>
        <wpfcc:ConfigManagerView
            Title="{Binding Datas.Name}"
            FileName="{Binding Datas.FileName}"
            FilePath="{Binding Datas.FilePath}"
            IsReadOnly="True"
            ItemsSource="{Binding Datas.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding SaveCallbackCommand}"
            SelectItem="{Binding Datas.SelectedItem, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackCommand}" />



        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource Border_Style}">
                <DockPanel>
                    <ContentControl
                        Margin="8"
                        prism:RegionManager.RegionName="LightControlRegion"
                        DockPanel.Dock="Bottom" />
                    <GroupBox Margin="8">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="相机测试:" />
                                <TextBlock Width="10" />
                                <TextBlock Text="{Binding Datas.CurCam.Name}" TextAlignment="Center" />
                            </StackPanel>
                        </GroupBox.Header>
                        <UniformGrid Columns="1" Rows="5">
                            <UniformGrid x:Name="UniformGrid" Columns="3">
                                <Label Content="连接状态:" Style="{StaticResource Label_style}" />
                                <TextBlock
                                    Width="120"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Datas.ConnectStatus}"
                                    TextAlignment="Center" />
                                <Button
                                    Command="{Binding ConnectCommand}"
                                    Content="连接"
                                    Style="{StaticResource Button_style}" Cursor="Hand" />
                            </UniformGrid>
                            <UniformGrid Columns="{Binding ElementName=UniformGrid, Path=Columns}">

                                <Button
                                    Command="{Binding LiveCommand}"
                                    Content="{Binding Datas.LiveButtonText}"
                                    Style="{StaticResource Button_style}" />
                                <Button
                                    Command="{Binding GrabCommand}"
                                    Content="图像采集"
                                    Style="{StaticResource Button_style}" />

                                <Button
                                    Command="{Binding ShowLineCommand}"
                                    CommandParameter="{Binding ElementName=DisplaySingleGroupView1}"
                                    Content="{Binding Datas.ShowCrossButtonText}"
                                    Style="{StaticResource Button_style}" />
                            </UniformGrid>
                            <UniformGrid Columns="{Binding ElementName=UniformGrid, Path=Columns}">
                                <Label Content="曝光:" Style="{StaticResource Label_style}" />
                                <materialDesign:NumericUpDown
                                    Width="100"
                                    MinWidth="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Maximum="10000"
                                    Style="{StaticResource MaterialDesignFloatingHintUpDownBase}"
                                    TextBlock.TextAlignment="Center"
                                    ValueStep="10"
                                    Value="{Binding Datas.Exposure}" />
                                <Button
                                    Command="{Binding SettingCommand}"
                                    Content="设置"
                                    Style="{StaticResource Button_style}" />

                            </UniformGrid>
                            <UniformGrid Columns="{Binding ElementName=UniformGrid, Path=Columns}">
                                <Label Content="增益:" Style="{StaticResource Label_style}" />
                                <materialDesign:DecimalUpDown
                                    Width="100"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Maximum="10"
                                    Minimum="0"
                                    Style="{StaticResource MaterialDesignFloatingHintDecimalUpDown}"
                                    TextBlock.TextAlignment="Center"
                                    ValueStep="0.1"
                                    Value="{Binding Datas.Gain}" />
                                <Button
                                    Command="{Binding SettingCommand}"
                                    Content="设置"
                                    Style="{StaticResource Button_style}" />
                            </UniformGrid>
                            <UniformGrid Columns="{Binding ElementName=UniformGrid, Path=Columns}">
                                <Label
                                    Content="帧率:"
                                    Style="{StaticResource Label_style}"
                                    Visibility="Hidden" />
                                <TextBlock
                                    Width="120"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Datas.FPS}"
                                    TextAlignment="Center"
                                    Visibility="Hidden" />
                                <Button
                                    Command="{Binding SaveCommand}"
                                    Content="保存参数"
                                    Style="{StaticResource Button_style}" />
                            </UniformGrid>

                        </UniformGrid>

                    </GroupBox>
                </DockPanel>


            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource Border_Style}">
                <custdisplay:DisplaySingleGroupView
                    x:Name="DisplaySingleGroupView1"
                    Title="图像"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    DisplayImage="{Binding Datas.Image}" />
            </Border>
        </Grid>

    </Grid>
</UserControl>