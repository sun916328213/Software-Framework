<UserControl
    x:Class="WPFControl.ProgramControl.Views.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:valueconvert="clr-namespace:WPFControl.ValueConvert"
    xmlns:viewmodel="clr-namespace:WPFControl.ProgramControl.ViewModels"
    x:Name="UserControl"
    d:DataContext="{d:DesignInstance Type=viewmodel:StatisticsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WPFControl;component/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <valueconvert:LinkStatusToColorConvert x:Key="LinkColorConvert" />
            <valueconvert:SecsStatusToColorConvert x:Key="SecsColorConvert" />
            <valueconvert:DeviceStatusToColorConvert x:Key="DeviceColorConvert" />

            <Style TargetType="cust:TitleTextBlockView">
                <Setter Property="HorizontalAlignment" Value="Left" />

            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Border_Style}">
        <DockPanel>
            <cust:TitleSeparatorView Title="运行信息" DockPanel.Dock="Top" />


            <UniformGrid
                x:Name="info"
                Margin="8"
                Columns="1"
                Rows="6">

                <UniformGrid Columns="1">
                    <cust:TitleTextBlockView Title="ID:" Value="{Binding Statistics.ID}" />
                </UniformGrid>

                <UniformGrid Columns="1">
                    <cust:TitleTextBlockView Title="Time:" Value="{Binding Statistics.DateTime}" />
                </UniformGrid>

                <UniformGrid Columns="2">
                    <cust:TitleTextBlockView
                        Title="SEMI Link:"
                        Foreground="{Binding Statistics.SecsStatus, Converter={StaticResource LinkColorConvert}}"
                        Value="{Binding Statistics.SecsStatus}" />

                    <cust:TitleTextBlockView
                        Title="SEMI Mode:"
                        Foreground="{Binding Statistics.SecsMode, Converter={StaticResource SecsColorConvert}}"
                        Value="{Binding Statistics.SecsMode}" />
                </UniformGrid>

                <UniformGrid Columns="2">
                    <cust:TitleTextBlockView
                        Title="PLC Link:"
                        Foreground="{Binding Statistics.PLCLinkStatus, Converter={StaticResource LinkColorConvert}}"
                        Value="{Binding Statistics.PLCLinkStatus}" />

                    <cust:TitleTextBlockView
                        Title="Device Status:"
                        Foreground="{Binding Statistics.DeviceStatus, Converter={StaticResource DeviceColorConvert}}"
                        Value="{Binding Statistics.DeviceStatus}" />
                </UniformGrid>



                <UniformGrid Columns="2">
                    <cust:TitleTextBlockView
                        Title="Total:"
                        Unit="PCS"
                        Value="{Binding Statistics.Total}" />

                    <cust:TitleTextBlockView
                        Title="OK:"
                        Unit="PCS"
                        Value="{Binding Statistics.OK}" />

                </UniformGrid>

                <UniformGrid Columns="2">

                    <cust:TitleTextBlockView Title="Pass Rate:" Value="{Binding Statistics.Rate}" />

                    <Button
                        Width="100"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearCountCommand}"
                        Content="清零"
                        FontSize="{Binding ElementName=UserControl, Path=FontSize}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                </UniformGrid>



            </UniformGrid>
        </DockPanel>

    </Border>

</UserControl>
