<UserControl
    x:Class="WPFControl.ProgramControl.Views.UserInfoManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="clr-namespace:WPFControl.CustomControl.Views"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFControl.ProgramControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:WPFControl.ProgramControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:UserInfoManagerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border Style="{StaticResource Border_Style}">
        <wpfcc:ConfigManagerView
            Title="User Info"
            FileName="{Binding FileName}"
            FilePath="{Binding FilePath}"
            IsReadOnly="True"
            ItemsSource="{Binding Datas.UserInfos}"
            RowHeight="38"
            SelectVisibility="Collapsed" />
    </Border>
</UserControl>
