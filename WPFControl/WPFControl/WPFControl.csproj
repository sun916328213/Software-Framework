    <!-- 2026-09-16：日志模型（ELogLevel/LogInfo）迁入 DataManager 后显式引用，
         不再依赖 FlowNodes 的传递引用来访问 DataManager -->
    <ProjectReference Include="..\..\FlowNodes\FlowNodes\FlowNodes.csproj" />
    <!-- 2026-09-17：以下两个引用在 74228b2 合并时被误吞（合并取了对方分支的 csproj 版本），
         此处补回。二者都是架构必需：
         · DataManagerLogging —— WPFControlModule 注册 IFlowLogSink 并装配 DataManagerFlowLogSink
           （架构测试 WpfHostLogging_WiresSinkThroughSharedLogManagerWithoutHostServiceCoupling
           强制要求：宿主只把 adapter 装到共享 LogManager 上，不得解析 LogConfigService）。
         · DataManager.Controls —— 让 SqlView / LogView / ExcelView 三个配置页随 WPFControl
           一起被引用（见 WPFControlModule.RegisterTypes 中的说明），宿主只引用 WPFControl。 -->
    <ProjectReference Include="..\..\FlowEditor\FlowEditor.DataManagerLogging\FlowEditor.DataManagerLogging.csproj" />
    <ProjectReference Include="..\..\DataManager\DataManager.Controls\DataManager.Controls.csproj" />
    <!-- 2026-09-23：按架构分析文档 3.1 补全直接引用。这 6 个工程此前只存在于传递闭包里
         （经 FlowNodes / Extension / DataManager），而源码确实在用它们的类型 ⇒ 上游一动
         就可能静默打断 WPFControl 的编译。显式声明让依赖图可读；构建闭包不变。
         ⛔ Halcon 包仍只在 Extension.csproj 一处锁版本（项目约定），此处不重复声明。 -->
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\Secs\SecsGem.Core\SecsGem.Core.csproj" />
    <!-- 2026-09-29：兼容门面 DataManager/DataManager 已删除，改为直连 Core + Runtime。 -->
    <ProjectReference Include="..\..\DataManager\DataManager.Core\DataManager.Core.csproj" />
    <ProjectReference Include="..\..\DataManager\DataManager.Runtime\DataManager.Runtime.csproj" />
    <ProjectReference Include="..\..\Vision\Vision.Controls\Vision.Controls.csproj" />
    <!-- 2026-09-23（审计补漏）：这两个工程此前同样只靠传递闭包（经 FlowNodes）拿到 ——
         上一轮补 6 个时漏了它们，是全仓「声明≠使用」审计扫出来的。
         · FlowEditor        —— FlowEditor.Core(1 文件) / FlowEditor.ViewModels(4 文件)
         · WPFCustomControls —— WPFCustomControls.Controls(15 文件) / WPFCustomControls.Window.Views(9 文件) -->
    <ProjectReference Include="..\..\FlowEditor\FlowEditor.Controls\FlowEditor.Controls.csproj" />
    <!-- ScriptEditor.Views/Services are used directly by the host. -->
    <ProjectReference Include="..\..\ScriptEditor\ScriptEditor.Controls\ScriptEditor.Controls.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
    <!-- 2026-09-24（P8-1）：接入新 Device 栈，取代旧 Device/Device 的相机/光源/RFID/扫码/标签打印能力。
         · Device.Core     —— 契约 / Options / Result（Controls 与 Runtime 都只面向它）
         · Device.Controls —— 可复用的设备测试页（Camera/Light/Rfid/Scanner/LabelPrint 的 View + Workspace）
         · Device.Runtime  —— 工厂与厂商 SDK 实现；**只用于组合**，由 WPFControlModule 注册成单例
         WPFControl 是宿主侧 Prism 模块、天然承担组合职责，所以工厂注册放 WPFControlModule，
         不把 Prism 依赖塞进 Device.Runtime（见 P8 计划 3.2 / 4）。 -->
    <ProjectReference Include="..\..\Device\Device.Core\Device.Core.csproj" />
    <ProjectReference Include="..\..\Device\Device.Controls\Device.Controls.csproj" />
    <ProjectReference Include="..\..\Device\Device.Runtime\Device.Runtime.csproj" />
