<Window
    x:Class="EditorDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:script="clr-namespace:ScriptEditor.Views;assembly=ScriptEditor"
    Width="1400"
    Height="900"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <TabControl>
        <TabItem Header="脚本编辑器">
            <script:ScriptManagerView/>
        </TabItem>
        <TabItem Header="流程图">
            <ContentControl prism:RegionManager.RegionName="FlowRegion" />
        </TabItem>
    </TabControl>

</Window>