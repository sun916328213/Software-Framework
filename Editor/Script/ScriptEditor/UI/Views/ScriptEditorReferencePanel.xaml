<!--
    ScriptEditorReferencePanel.xaml - 引用管理侧边栏（前后端分离：从 ScriptEditorView 中独立出来，延迟创建）
-->
<UserControl
    x:Class="ScriptEditor.Views.ScriptEditorReferencePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <UserControl.Resources>
    <!-- 资源字典已提升到 App.xaml 级别，无需在此重复加载 -->
</UserControl.Resources>

    <Border Width="260" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
        <DockPanel>
            <!--  头部  -->
            <Border Padding="10,8" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#444" Text="引用管理" />
                    <Button Grid.Column="1" Width="24" Height="24" Padding="0"
                            Command="{Binding AddReferenceCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="添加 DLL 引用">
                        <materialDesign:PackIcon Width="20" Height="20" Kind="Plus" />
                    </Button>
                    <Button Grid.Column="2" Width="24" Height="24" Padding="0"
                            Command="{Binding ToggleReferencePanelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="关闭引用面板">
                        <materialDesign:PackIcon Width="20" Height="20" Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <!--  搜索框  -->
            <Border Padding="8,6" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReferenceFilterBox"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="搜索引用..."
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding ReferenceFilter, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Width="24" Height="24" Padding="0"
                            Command="{Binding ClearReferenceFilterCommand}"
                            Foreground="#999"
                            Style="{StaticResource MaterialDesignFlatButton}" ToolTip="清除搜索">
                        <materialDesign:PackIcon Width="16" Height="16" Kind="CloseCircle" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <StackPanel Margin="0,4">
                    <!--  用户添加的引用  -->
                    <Expander x:Name="UserRefExpander" HorizontalContentAlignment="Stretch"
                              Background="Transparent" Header="用户添加的引用"
                              IsExpanded="True" Style="{StaticResource MaterialDesignExpander}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Margin="-15">
                                    <TextBlock VerticalAlignment="Center" Text="用户添加的引用" />
                                    <Border Height="20" Margin="30,0" HorizontalAlignment="Right"
                                            Background="#E0E0E0" CornerRadius="3">
                                        <TextBlock Margin="4" VerticalAlignment="Center" FontSize="10"
                                                   Foreground="#666"
                                                   Text="{Binding DataContext.References.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <ItemsControl HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                      ItemsSource="{Binding FilteredReferences}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,1" Padding="6,4" CornerRadius="3">
                                        <DockPanel>
                                            <Button Width="20" Height="20" Padding="0"
                                                    materialDesign:ButtonAssist.CornerRadius="3"
                                                    Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    DockPanel.Dock="Right" Foreground="#E53935"
                                                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="移除引用">
                                                <materialDesign:PackIcon Width="14" Height="14" Kind="Close" />
                                            </Button>
                                            <StackPanel>
                                                <TextBlock FontSize="12" Foreground="#444" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                <TextBlock FontSize="10" Foreground="#999" Text="{Binding FullPath}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!--  默认引用  -->
                    <Expander x:Name="DefaultRefExpander" Background="Transparent"
                              Header="默认引用" IsExpanded="False"
                              Style="{StaticResource MaterialDesignExpander}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Margin="-15,0">
                                    <TextBlock VerticalAlignment="Center" Text="默认引用" />
                                    <Border Height="20" Margin="30,0" HorizontalAlignment="Right"
                                            Background="#E0E0E0" CornerRadius="3">
                                        <TextBlock Margin="4" VerticalAlignment="Center" FontSize="10"
                                                   Foreground="#666"
                                                   Text="{Binding DataContext.DefaultReferences.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <ItemsControl Background="Transparent" BorderThickness="0"
                                      ItemsSource="{Binding FilteredDefaultReferences}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,1" Padding="6,4" CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="#555" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                            <TextBlock FontSize="10" Foreground="#AAA" Text="{Binding FullPath}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>