<Window
    x:Class="DeviceDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl>
            <TabItem Header="RFID">
                <Grid>
                    <Button
                        Margin="0,1,0,0"
                        Click="Connect_Click"
                        Content="Connect" />
                    <Button
                        Margin="0,50,0,0"
                        Click="Disconnect_Click"
                        Content="Disconnect" />
                    <Button
                        Margin="0,95,0,0"
                        Click="Read_Click"
                        Content="Read" />
                    <Button
                        Margin="0,140,0,0"
                        Click="Write_Click"
                        Content="Write" />
                    <Button
                        Margin="0,195,0,0"
                        Click="ReadMulit_Click"
                        Content="MulitRead" />
                    <Button
                        Margin="0,240,0,0"
                        Click="WriteMulit_Click"
                        Content="MulitWrite" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
