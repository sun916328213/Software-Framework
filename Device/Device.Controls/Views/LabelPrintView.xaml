<UserControl
    x:Class="Device.Controls.Views.LabelPrintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Device.Controls.Views.Shared"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.5*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shared:PageHeaderView
            Title="标签打印测试"
            Grid.Row="0"
            Margin="0,0,0,12"
            IconKind="Label"
            SubTitle="通过 Device.Core 的 ILabelPrintEngineFactory 与 ILabelPrintEngine 测试标签模板：打开 / 字段 / 预览 / 打印" />

        <wpfcc:ConfigManagerView
            Title="标签打印引擎档案"
            Grid.Row="1"
            Height="250"
            Margin="0,0,0,12"
            AddCallback="{Binding ProfileAddedAction}"
            DeletedCallback="{Binding ProfileDeletedAction}"
            FileName="{Binding Model.FileName}"
            FilePath="{Binding Model.FilePath}"
            ItemsSource="{Binding Model.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding ProfilesSavedAction}"
            SelectItem="{Binding Model.SelectedProfile, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackAction}">
            <wpfcc:ConfigManagerView.DataGridColumns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Header="档案名"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTemplateColumn
                    Width="160"
                    MinWidth="140"
                    Header="驱动"
                    HeaderStyle="{StaticResource DmHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="{Binding DriverId}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.Model.Drivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedValue="{Binding DriverId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="110"
                    Binding="{Binding DefaultPrinterName, UpdateSourceTrigger=PropertyChanged}"
                    Header="默认打印机"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="90"
                    MinWidth="70"
                    Binding="{Binding PrintTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                    Header="打印超时ms"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="80"
                    MinWidth="70"
                    Binding="{Binding PreviewDpi, UpdateSourceTrigger=PropertyChanged}"
                    Header="预览DPI"
                    HeaderStyle="{StaticResource DmHeader}" />
            </wpfcc:ConfigManagerView.DataGridColumns>
        </wpfcc:ConfigManagerView>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card
                Grid.Column="0"
                Padding="12"
                UniformCornerRadius="12">
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="标签打印测试:" />
                            <TextBlock Width="10" />
                            <TextBlock Text="{Binding Model.SelectedProfile.Name}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="3" Rows="6">
                        <Label Content="连接状态:" Style="{StaticResource PanelLabel}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Model.StatusText}"
                            TextAlignment="Center" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding ConnectCommand}"
                                Content="连接"
                                Style="{StaticResource PanelButton}"
                                Width="62" />
                            <Button
                                Command="{Binding DisconnectCommand}"
                                Content="断开"
                                Style="{StaticResource DangerButton}"
                                Width="62" />
                        </StackPanel>

                        <Label Content="打印机:" Style="{StaticResource PanelLabel}" />
                        <ComboBox
                            Width="170"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Model.Printers}"
                            SelectedItem="{Binding Model.SelectedPrinter}"
                            Style="{StaticResource DmCombo}" />
                        <Button
                            Command="{Binding LoadPrintersCommand}"
                            Content="读取列表"
                            Style="{StaticResource PanelButton}" />

                        <Label Content="模板路径:" Style="{StaticResource PanelLabel}" />
                        <TextBox
                            Width="220"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource DmInput}"
                            Text="{Binding Model.TemplatePath, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="如 C:\Labels\tag.btw" />
                        <Button
                            Command="{Binding OpenTemplateCommand}"
                            Content="打开模板"
                            Style="{StaticResource PanelButton}" />

                        <Button
                            Command="{Binding ReloadFieldsCommand}"
                            Content="读取字段"
                            Style="{StaticResource PanelButton}" />
                        <Button
                            Command="{Binding ApplyFieldsCommand}"
                            Content="下发字段"
                            Style="{StaticResource PanelButton}" />
                        <Button
                            Command="{Binding PreviewCommand}"
                            Content="渲染预览"
                            Style="{StaticResource PanelButton}" />

                        <Label Content="份数:" Style="{StaticResource PanelLabel}" />
                        <materialDesign:NumericUpDown
                            Width="90"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Maximum="999"
                            Minimum="1"
                            Value="{Binding Model.Copies}" />
                        <Button
                            Command="{Binding PrintCommand}"
                            Content="打印"
                            Style="{StaticResource PanelButton}" />

                        <Label
                            Grid.ColumnSpan="2"
                            Content="断开即关闭模板"
                            Style="{StaticResource PanelLabel}" />
                        <Button
                            Command="{Binding CloseTemplateCommand}"
                            Content="关闭模板"
                            Style="{StaticResource PanelButton}" />
                    </UniformGrid>
                </GroupBox>
            </materialDesign:Card>

            <materialDesign:Card
                Grid.Column="2"
                Padding="12"
                UniformCornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.6*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="模板预览" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.7"
                                Text="{Binding Model.TemplatePath}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border
                            Background="#101418"
                            CornerRadius="8"
                            ClipToBounds="True">
                            <Image
                                Margin="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding Model.Preview}"
                                Stretch="Uniform" />
                        </Border>
                    </DockPanel>

                    <DockPanel Grid.Row="2">
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="4,0,4,8"
                            Style="{StaticResource SectionTitle}"
                            Text="模板字段（值可编辑）" />
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            ItemsSource="{Binding Model.Fields}"
                            Style="{StaticResource DmGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    Header="字段名"
                                    HeaderStyle="{StaticResource DmHeader}"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    Header="值"
                                    HeaderStyle="{StaticResource DmHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <shared:RunOutputView
            Grid.Row="3"
            Margin="0,12,0,0"
            OutputHeight="130" />
    </Grid>
</UserControl>
