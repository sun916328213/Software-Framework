<UserControl
    x:Class="Device.Controls.Views.Shared.PageHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  页面样式归 Device.Controls 自己所有，由本页自行合并（宿主不替页面合并）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  测试页页头：图标 + 标题 + 副标题。纯展示，无 VM 耦合（DataContext 穿透）。  -->
    <StackPanel Orientation="Horizontal">
        <materialDesign:PackIcon
            Width="28"
            Height="28"
            VerticalAlignment="Center"
            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
            Kind="{Binding ElementName=Root, Path=IconKind}" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding ElementName=Root, Path=Title}" />
            <TextBlock Style="{StaticResource PageSubTitle}" Text="{Binding ElementName=Root, Path=SubTitle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
