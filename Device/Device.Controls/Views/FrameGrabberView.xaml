<UserControl
    x:Class="Device.Controls.Views.FrameGrabberView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Device.Controls.Views.Shared"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.5*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shared:PageHeaderView
            Title="采集卡测试"
            Grid.Row="0"
            Margin="0,0,0,12"
            IconKind="Video"
            SubTitle="通过 Device.Core 的 IFrameGrabberFactory 与 IFrameGrabber 测试采集卡档案；连接后驱动持续推帧" />

        <wpfcc:ConfigManagerView
            Title="采集卡档案"
            Grid.Row="1"
            Height="250"
            Margin="0,0,0,12"
            AddCallback="{Binding ProfileAddedAction}"
            DeletedCallback="{Binding ProfileDeletedAction}"
            FileName="{Binding Model.FileName}"
            FilePath="{Binding Model.FilePath}"
            ItemsSource="{Binding Model.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding ProfilesSavedAction}"
            SelectItem="{Binding Model.SelectedProfile, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackAction}">
            <wpfcc:ConfigManagerView.DataGridColumns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Header="档案名"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTemplateColumn
                    Width="160"
                    MinWidth="140"
                    Header="驱动"
                    HeaderStyle="{StaticResource DmHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="{Binding DriverId}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.Model.Drivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedValue="{Binding DriverId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="2*"
                    MinWidth="140"
                    Binding="{Binding ConfigurationFilePath, UpdateSourceTrigger=PropertyChanged}"
                    Header="配置文件(DCF/CAM)"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="60"
                    MinWidth="55"
                    Binding="{Binding BoardIndex, UpdateSourceTrigger=PropertyChanged}"
                    Header="板卡"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="65"
                    MinWidth="60"
                    Binding="{Binding Connector, UpdateSourceTrigger=PropertyChanged}"
                    Header="接口"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="90"
                    MinWidth="80"
                    Binding="{Binding PixelFormat, UpdateSourceTrigger=PropertyChanged}"
                    Header="像素格式"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="60"
                    MinWidth="55"
                    Binding="{Binding BufferCount, UpdateSourceTrigger=PropertyChanged}"
                    Header="缓冲"
                    HeaderStyle="{StaticResource DmHeader}" />
            </wpfcc:ConfigManagerView.DataGridColumns>
        </wpfcc:ConfigManagerView>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card
                Grid.Column="0"
                Padding="12"
                UniformCornerRadius="12">
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="采集卡测试:" />
                            <TextBlock Width="10" />
                            <TextBlock Text="{Binding Model.SelectedProfile.Name}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="3" Rows="3">
                        <Label Content="连接状态:" Style="{StaticResource PanelLabel}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Model.StatusText}"
                            TextAlignment="Center" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding ConnectCommand}"
                                Content="连接"
                                Style="{StaticResource PanelButton}"
                                Width="62" />
                            <Button
                                Command="{Binding DisconnectCommand}"
                                Content="断开"
                                Style="{StaticResource DangerButton}"
                                Width="62" />
                        </StackPanel>

                        <Label Content="帧计数:" Style="{StaticResource PanelLabel}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Model.FrameCount}"
                            TextAlignment="Center" />
                        <Button
                            Command="{Binding ResetCountCommand}"
                            Content="计数清零"
                            Style="{StaticResource PanelButton}" />

                        <Label
                            Content="连接即持续推帧"
                            Style="{StaticResource PanelLabel}" />
                    </UniformGrid>
                </GroupBox>
            </materialDesign:Card>

            <materialDesign:Card
                Grid.Column="2"
                Padding="12"
                UniformCornerRadius="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="图像" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.7"
                            Text="{Binding Model.FrameInfo}" />
                    </Grid>
                    <Border
                        Background="#101418"
                        CornerRadius="8"
                        ClipToBounds="True">
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding Model.Preview}"
                            Stretch="Uniform" />
                    </Border>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <shared:RunOutputView
            Grid.Row="3"
            Margin="0,12,0,0"
            OutputHeight="130" />
    </Grid>
</UserControl>
