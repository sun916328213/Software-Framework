<UserControl
    x:Class="Device.Controls.Views.LightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Device.Controls.Views.Shared"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.5*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shared:PageHeaderView
            Title="光源控制器测试"
            Grid.Row="0"
            Margin="0,0,0,12"
            IconKind="Lightbulb"
            SubTitle="通过 Device.Core 的 ILightControllerFactory 与 ILightController 测试光源档案与亮度下发" />

        <wpfcc:ConfigManagerView
            Title="光源档案"
            Grid.Row="1"
            Height="250"
            Margin="0,0,0,12"
            AddCallback="{Binding ProfileAddedAction}"
            DeletedCallback="{Binding ProfileDeletedAction}"
            FileName="{Binding Model.FileName}"
            FilePath="{Binding Model.FilePath}"
            ItemsSource="{Binding Model.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding ProfilesSavedAction}"
            SelectItem="{Binding Model.SelectedProfile, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackAction}">
            <wpfcc:ConfigManagerView.DataGridColumns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Header="档案名"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTemplateColumn
                    Width="160"
                    MinWidth="140"
                    Header="驱动"
                    HeaderStyle="{StaticResource DmHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="{Binding DriverId}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.Model.Drivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedValue="{Binding DriverId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="90"
                    Binding="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                    Header="串口"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="70"
                    MinWidth="60"
                    Binding="{Binding ChannelCount, UpdateSourceTrigger=PropertyChanged}"
                    Header="通道数"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="80"
                    MinWidth="70"
                    Binding="{Binding MaximumIntensity, UpdateSourceTrigger=PropertyChanged}"
                    Header="最大亮度"
                    HeaderStyle="{StaticResource DmHeader}" />
            </wpfcc:ConfigManagerView.DataGridColumns>
        </wpfcc:ConfigManagerView>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card
                Grid.Column="0"
                Padding="12"
                UniformCornerRadius="12">
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="光源测试:" />
                            <TextBlock Width="10" />
                            <TextBlock Text="{Binding Model.SelectedProfile.Name}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="3" Rows="4">
                        <Label Content="连接状态:" Style="{StaticResource PanelLabel}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Model.StatusText}"
                            TextAlignment="Center" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding ConnectCommand}"
                                Content="连接"
                                Style="{StaticResource PanelButton}"
                                Width="62" />
                            <Button
                                Command="{Binding DisconnectCommand}"
                                Content="断开"
                                Style="{StaticResource DangerButton}"
                                Width="62" />
                        </StackPanel>

                        <!--  通道号从 1 开始；「设置通道」= SetIntensityAsync(通道, 亮度)  -->
                        <Label Content="通道:" Style="{StaticResource PanelLabel}" />
                        <materialDesign:NumericUpDown
                            Width="110"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Maximum="8"
                            Minimum="1"
                            Value="{Binding Model.Channel}" />
                        <Button
                            Command="{Binding SetChannelCommand}"
                            Content="设置亮度"
                            Style="{StaticResource PanelButton}" />

                        <Label Content="亮度:" Style="{StaticResource PanelLabel}" />
                        <materialDesign:NumericUpDown
                            Width="110"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Maximum="255"
                            Minimum="0"
                            Value="{Binding Model.Intensity}" />
                        <Border />

                        <Label Content="全通道亮度:" Style="{StaticResource PanelLabel}" />
                        <materialDesign:NumericUpDown
                            Width="110"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Maximum="255"
                            Minimum="0"
                            Value="{Binding Model.AllIntensity}" />
                        <Button
                            Command="{Binding SetAllCommand}"
                            Content="全通道设置"
                            Style="{StaticResource PanelButton}"
                            ToolTip="SetAllIntensityAsync 一次性下发所有通道" />
                    </UniformGrid>
                </GroupBox>
            </materialDesign:Card>

            <materialDesign:Card
                Grid.Column="2"
                Padding="12"
                UniformCornerRadius="12">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Margin="4,0,4,8"
                        Style="{StaticResource SectionTitle}"
                        Text="说明" />
                    <TextBlock
                        Margin="4"
                        FontSize="13"
                        LineHeight="24"
                        Opacity="0.8"
                        Text="光源控制器为纯下发设备，无回读画面。&#10;&#10;1. 选中档案后点「连接」打开串口；&#10;2. 「设置亮度」按通道号(从 1 开始)与亮度单通道下发；&#10;3. 「全通道设置」把所有通道设为同一亮度；&#10;4. 每次下发的结果与耗时见下方运行输出；&#10;5. 档案改动后点档案表右侧「保存」落盘到 Config/Lights.json。" />
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <shared:RunOutputView
            Grid.Row="3"
            Margin="0,12,0,0"
            OutputHeight="130" />
    </Grid>
</UserControl>
