<UserControl
    x:Class="Device.Controls.Views.ScannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Device.Controls.Views.Shared"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.5*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shared:PageHeaderView
            Title="扫码器测试"
            Grid.Row="0"
            Margin="0,0,0,12"
            IconKind="BarcodeScan"
            SubTitle="通过 Device.Core 的 IScannerFactory 与 IScanner 测试扫码器档案；扫码数据自动出现在右侧收件箱" />

        <wpfcc:ConfigManagerView
            Title="扫码器档案"
            Grid.Row="1"
            Height="250"
            Margin="0,0,0,12"
            AddCallback="{Binding ProfileAddedAction}"
            DeletedCallback="{Binding ProfileDeletedAction}"
            FileName="{Binding Model.FileName}"
            FilePath="{Binding Model.FilePath}"
            ItemsSource="{Binding Model.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding ProfilesSavedAction}"
            SelectItem="{Binding Model.SelectedProfile, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackAction}">
            <wpfcc:ConfigManagerView.DataGridColumns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Header="档案名"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTemplateColumn
                    Width="160"
                    MinWidth="140"
                    Header="驱动"
                    HeaderStyle="{StaticResource DmHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="{Binding DriverId}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.Model.Drivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedValue="{Binding DriverId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="90"
                    Binding="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                    Header="串口"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="80"
                    MinWidth="70"
                    Binding="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"
                    Header="波特率"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="75"
                    MinWidth="70"
                    Binding="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}"
                    Header="数据位"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="75"
                    MinWidth="70"
                    Binding="{Binding StopBits, UpdateSourceTrigger=PropertyChanged}"
                    Header="停止位"
                    HeaderStyle="{StaticResource DmHeader}" />
                <DataGridTextColumn
                    Width="70"
                    MinWidth="60"
                    Binding="{Binding Parity, UpdateSourceTrigger=PropertyChanged}"
                    Header="校验"
                    HeaderStyle="{StaticResource DmHeader}" />
            </wpfcc:ConfigManagerView.DataGridColumns>
        </wpfcc:ConfigManagerView>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card
                Grid.Column="0"
                Padding="12"
                UniformCornerRadius="12">
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="扫码器测试:" />
                            <TextBlock Width="10" />
                            <TextBlock Text="{Binding Model.SelectedProfile.Name}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <UniformGrid Columns="3" Rows="2">
                        <Label Content="连接状态:" Style="{StaticResource PanelLabel}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Model.StatusText}"
                            TextAlignment="Center" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding ConnectCommand}"
                                Content="连接"
                                Style="{StaticResource PanelButton}"
                                Width="62" />
                            <Button
                                Command="{Binding DisconnectCommand}"
                                Content="断开"
                                Style="{StaticResource DangerButton}"
                                Width="62" />
                        </StackPanel>

                        <Button
                            Command="{Binding ClearScansCommand}"
                            Content="清空记录"
                            Style="{StaticResource PanelButton}" />
                        <Label
                            Grid.ColumnSpan="2"
                            Content="扫码自动入箱"
                            Style="{StaticResource PanelLabel}" />
                    </UniformGrid>
                </GroupBox>
            </materialDesign:Card>

            <materialDesign:Card
                Grid.Column="2"
                Padding="12"
                UniformCornerRadius="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="扫码收件箱（最新在前）" />
                    </Grid>
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Model.Scans}"
                        Style="{StaticResource DmGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding ReceivedAt}"
                                Header="时间"
                                HeaderStyle="{StaticResource DmHeader}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Value}"
                                Header="条码内容"
                                HeaderStyle="{StaticResource DmHeader}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <shared:RunOutputView
            Grid.Row="3"
            Margin="0,12,0,0"
            OutputHeight="130" />
    </Grid>
</UserControl>
