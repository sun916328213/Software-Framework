<UserControl
    x:Class="Device.Controls.Views.CameraView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Device.Controls.Views.Shared"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignWidth="1360"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  页面样式归 Device.Controls 自己所有，由本页自行合并（宿主不替页面合并）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>

            <!--  以下三个样式移植自旧 CamManagerView：标签 120 居中、按钮 130 抬起  -->
            <Style
                x:Key="Label_style"
                BasedOn="{StaticResource MaterialDesignLabel}"
                TargetType="Label">
                <Setter Property="Width" Value="120" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="Button_style"
                BasedOn="{StaticResource MaterialDesignRaisedButton}"
                TargetType="Button">
                <Setter Property="Width" Value="130" />
            </Style>

            <Style
                x:Key="CamHeader"
                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
                TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  版式对标 CamManagerView：上部整宽档案表 + 下部「左 500 控制面板 / 右图像显示」；MinHeight 绑宿主 ScrollViewer 视口，窗口不足时整页可滚  -->
    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.5*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <shared:PageHeaderView
            Title="相机测试"
            Grid.Row="0"
            Margin="0,0,0,12"
            IconKind="Camera"
            SubTitle="通过 Device.Core 的 ICameraFactory 与 ICamera 管理相机档案、扫描在线设备并测试连接与抓图；曝光/增益等参数由检测项下发" />

        <!--
            档案表：整宽，列与回调全 XAML 声明，零 code-behind。
            Height=250：ConfigManagerView 右侧按钮列要 240（5 按钮 × 48）+ 10 外框；
            SelectedCallback 对标旧页 SetCurCam（切行停实时、代理属性回填）。
        -->
        <wpfcc:ConfigManagerView
            x:Name="CameraManager"
            Title="相机档案"
            Grid.Row="1"
            Height="250"
            Margin="0,0,0,12"
            AddCallback="{Binding ProfileAddedAction}"
            DeletedCallback="{Binding ProfileDeletedAction}"
            FileName="{Binding Model.FileName}"
            FilePath="{Binding Model.FilePath}"
            ItemsSource="{Binding Model.DataCollection}"
            RowHeight="38"
            SaveCallback="{Binding ProfilesSavedAction}"
            SelectItem="{Binding Model.SelectedProfile, Mode=TwoWay}"
            SelectedCallback="{Binding SelectCallbackAction}">
            <wpfcc:ConfigManagerView.DataGridColumns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="100"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Header="档案名"
                    HeaderStyle="{StaticResource CamHeader}" />
                <!--
                    驱动列 = 展示 DriverId 字符串 / 编辑时下拉选 AvailableDrivers。
                    列模板不在可视树里，取 VM 数据必须 RelativeSource 找 UserControl
                    （ElementName 在独立命名域解析不到）。
                -->
                <DataGridTemplateColumn
                    Width="160"
                    MinWidth="140"
                    Header="驱动"
                    HeaderStyle="{StaticResource CamHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="{Binding DriverId}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.Model.Drivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedValue="{Binding DriverId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="110"
                    Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                    Header="IP 地址"
                    HeaderStyle="{StaticResource CamHeader}" />
                <DataGridTextColumn
                    Width="80"
                    MinWidth="70"
                    Binding="{Binding ExposureMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                    Header="曝光ms"
                    HeaderStyle="{StaticResource CamHeader}" />
                <DataGridTextColumn
                    Width="70"
                    MinWidth="60"
                    Binding="{Binding Gain, UpdateSourceTrigger=PropertyChanged}"
                    Header="增益"
                    HeaderStyle="{StaticResource CamHeader}" />
                <DataGridTextColumn
                    Width="80"
                    MinWidth="70"
                    Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                    Header="超时ms"
                    HeaderStyle="{StaticResource CamHeader}" />
            </wpfcc:ConfigManagerView.DataGridColumns>
        </wpfcc:ConfigManagerView>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：控制面板（对标旧页 UniformGrid 行式布局）  -->
            <materialDesign:Card
                Grid.Column="0"
                Padding="12"
                UniformCornerRadius="12">
                <GroupBox>
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="相机测试:" />
                            <TextBlock Width="10" />
                            <TextBlock Text="{Binding Model.SelectedProfile.Name}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <!--  本页只验证「档案 + 在线 + 连接 + 图像」；曝光/增益等参数由检测项负责下发  -->
                    <UniformGrid Columns="3" Rows="4">
                        <!--  行 1：连接状态 + 连接/断开  -->
                        <Label Content="连接状态:" Style="{StaticResource Label_style}" />
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Model.StatusText}"
                            TextAlignment="Center" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="62"
                                Margin="0,0,6,0"
                                Command="{Binding ConnectCommand}"
                                Content="连接"
                                Style="{StaticResource Button_style}" />
                            <Button
                                Width="62"
                                Command="{Binding DisconnectCommand}"
                                Content="断开">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.OnDanger}" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!--  行 2：实时 / 采集 / 十字线  -->
                        <Button
                            Command="{Binding LiveCommand}"
                            Content="{Binding Model.LiveButtonText}"
                            Style="{StaticResource Button_style}" />
                        <Button
                            Command="{Binding CaptureCommand}"
                            Content="图像采集"
                            Style="{StaticResource Button_style}" />
                        <Button
                            Command="{Binding ShowCrossCommand}"
                            Content="{Binding Model.ShowCrossButtonText}"
                            FontSize="12"
                            Style="{StaticResource Button_style}" />

                        <!--  行 3：在线设备下拉 + 扫描  -->
                        <Label Content="在线设备:" Style="{StaticResource Label_style}" />
                        <ComboBox
                            Width="150"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Model.Devices}"
                            SelectedItem="{Binding Model.SelectedDevice}" />
                        <Button
                            Command="{Binding ScanCommand}"
                            Content="扫描"
                            Style="{StaticResource Button_style}" />

                        <!--  行 4：建档案 / 保存图像  -->
                        <Border />
                        <Button
                            Command="{Binding AddFromDeviceCommand}"
                            Content="建档案"
                            Style="{StaticResource Button_style}"
                            ToolTip="用上方选中的在线设备创建相机档案（IP/驱动自动回填）" />
                        <Button
                            Command="{Binding SaveImageCommand}"
                            Content="保存图像"
                            Style="{StaticResource Button_style}" />
                    </UniformGrid>
                </GroupBox>
            </materialDesign:Card>

            <!--  右：图像显示（对标旧页 DisplaySingleGroupView；十字线为 WPF 叠加层，替代 Halcon 版本）  -->
            <materialDesign:Card
                Grid.Column="2"
                Padding="12"
                UniformCornerRadius="12">
                <DockPanel>
                    <Grid Margin="4,0,4,8" DockPanel.Dock="Top">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="图像" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.7"
                            Text="{Binding Model.FrameInfo}" />
                    </Grid>
                    <!--  深色底让灰度图有对比；无图时只留空底与右上角规格说明  -->
                    <Border
                        Background="#101418"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding Model.Preview}"
                                Stretch="Uniform" />
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Fill="Red"
                                Visibility="{Binding Model.IsShowCross, Converter={StaticResource BoolToVis}}" />
                            <Rectangle
                                Height="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Fill="Red"
                                Visibility="{Binding Model.IsShowCross, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <shared:RunOutputView
            Grid.Row="3"
            Margin="0,12,0,0"
            OutputHeight="130" />
    </Grid>
</UserControl>
