<UserControl
    x:Class="Device.Controls.Views.CameraView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Device.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Device.Controls.Models"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    d:DesignHeight="900"
    d:DesignWidth="1000"
    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  页面样式归 Device.Controls 自己所有，由本页自行合并（宿主不替页面合并）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  列对象不在可视树里：借代理把页面 VM 递进 DataGridComboBoxColumn.ItemsSource  -->
            <common:BindingProxy x:Key="PageProxy" Data="{Binding}" />

            <!--  下拉弹层背景走 ComboBox 模板里的 ColorZone（见 CamComboElementStyle/EditingElementStyle 的 PrimaryLight），此处沿用原有两行  -->
            <DynamicResource x:Key="MaterialDesign.Brush.ComboBox.Popup.LightBackground" ResourceKey="MaterialDesign.Brush.Primary.Light" />
            <DynamicResource x:Key="MaterialDesign.Brush.DataGrid.PopupBorder" ResourceKey="MaterialDesign.Brush.Primary.Light" />

            <Style BasedOn="{StaticResource ScrollBar_Style}" TargetType="ScrollBar" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>

            <!--  以下三个样式移植自旧 CamManagerView：标签 120 居中、按钮 130 抬起  -->
            <Style
                x:Key="Label_style"
                BasedOn="{StaticResource MaterialDesignLabel}"
                TargetType="Label">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,6" />
            </Style>



            <!--  拉满单元格用：已并入 PageStyles 的 PanelButton（同值），此处不再重复定义  -->
            <!--  连接切换单键已改双键（与其他页一致），此样式删除；VM 的 ConnectToggleAsync 如无他用可一并删  -->

            <Style
                x:Key="CamHeader"
                BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}"
                TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </Style>

            <!--  表格文本/下拉列样式见 PageStyles 共享（DmTextElementStyle / DmComboElementStyle / DmComboEditingStyle）；DataGridComboBoxColumn 不吃宿主隐式 ComboBox 样式，必须显式指定 -->

        </ResourceDictionary>
    </UserControl.Resources>

    <!--  版式：上部整宽相机列表 + 下部「左 400 测试/输出列 / 右图像显示」  -->
    <!--  页面级滚动归本页：窗口高度不足时整页出垂直滚动条；MinHeight 绑视口，窗口足够大时星号行撑满  -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2.5*" />
            </Grid.RowDefinitions>

            <wpfcc:PageHeaderView
                Title="相机测试"
                Grid.Row="0"
                Margin="0,0,0,12"
                IconKind="Camera"
                SubTitle="通过 Device.Core 的 ICameraFactory 与 ICamera 管理相机列表、测试连接与抓图；曝光/增益等参数由检测项下发" />

            <!--
                相机列表：整宽，列与回调全 XAML 声明，零 code-behind。
                Height=330：ConfigManagerView 右侧按钮列 5 按钮（选择/解锁/增加/删除/保存）× 48 + 外框；
                SelectedCallback 对标旧页 SetCurCam（切行停实时）。
            -->
            <wpfcc:ConfigManagerView
                x:Name="CameraManager"
                Title="相机列表"
                Grid.Row="1"
                Margin="0,0,0,12"
                AddCallback="{Binding ProfileAddedAction}"
                DeletedCallback="{Binding ProfileDeletedAction}"
                FileName="{Binding Model.FileName}"
                FilePath="{Binding Model.FilePath}"
                ItemsSource="{Binding Model.DataCollection}"
                SaveCallback="{Binding ProfilesSavedAction}"
                SelectItem="{Binding Model.SelectedProfile, Mode=TwoWay}"
                SelectedCallback="{Binding SelectCallbackAction}">
                <wpfcc:ConfigManagerView.DataGridColumns>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource DmTextElementStyle}"
                        Header="相机名称"
                        HeaderStyle="{StaticResource CamHeader}" />
                    <!--  驱动列 = DriverId 一套名（展示与下拉同源）；下拉数据是运行时目录，经 PageProxy 递进来  -->
                    <DataGridComboBoxColumn
                        Width="*"
                        MinWidth="160"
                        EditingElementStyle="{StaticResource DmComboEditingStyle}"
                        ElementStyle="{StaticResource DmComboElementStyle}"
                        Header="驱动"
                        HeaderStyle="{StaticResource CamHeader}"
                        ItemsSource="{Binding Data.Model.Drivers, Source={StaticResource PageProxy}}"
                        SelectedItemBinding="{Binding DriverId}" />
                    <!--  类型 = CameraScanType 枚举名直出（AreaScan/LineScan），与驱动列同一定案：不做中文映射；静态列表用 x:Static 取  -->
                    <DataGridComboBoxColumn
                        Width="*"
                        MinWidth="110"
                        EditingElementStyle="{StaticResource DmComboEditingStyle}"
                        ElementStyle="{StaticResource DmComboElementStyle}"
                        Header="类型"
                        HeaderStyle="{StaticResource CamHeader}"
                        ItemsSource="{x:Static models:CameraPageModel.ScanTypes}"
                        SelectedItemBinding="{Binding ScanType}" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="110"
                        Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource DmTextElementStyle}"
                        Header="IP 地址"
                        HeaderStyle="{StaticResource CamHeader}" />
                    <DataGridTextColumn
                        Width="90"
                        MinWidth="80"
                        Binding="{Binding ExposureMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource DmTextElementStyle}"
                        Header="曝光ms"
                        HeaderStyle="{StaticResource CamHeader}" />
                    <DataGridTextColumn
                        Width="70"
                        MinWidth="60"
                        Binding="{Binding Gain, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource DmTextElementStyle}"
                        Header="增益"
                        HeaderStyle="{StaticResource CamHeader}" />
                    <DataGridTextColumn
                        Width="90"
                        MinWidth="80"
                        Binding="{Binding TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource DmTextElementStyle}"
                        Header="超时ms"
                        HeaderStyle="{StaticResource CamHeader}" />
                    <!--  参数文件 = CameraOptions.ParameterFilePath，厂商参数文件路径，连接后先加载再应用公共参数  -->
                    <DataGridTextColumn
                        Width="1.5*"
                        MinWidth="140"
                        Binding="{Binding ParameterFilePath, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource DmTextElementStyle}"
                        Header="参数文件"
                        HeaderStyle="{StaticResource CamHeader}" />
                </wpfcc:ConfigManagerView.DataGridColumns>
            </wpfcc:ConfigManagerView>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左列：紧凑相机测试卡 + 运行输出；`*` 行让输出卡吃满剩余高度，与右侧图像卡底部对齐  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <materialDesign:Card
                        Grid.Row="0"
                        Padding="12"
                        UniformCornerRadius="12">
                        <GroupBox>
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="相机测试:" />
                                    <TextBlock Width="10" />
                                    <TextBlock Text="{Binding Model.SelectedProfile.Name}" />
                                </StackPanel>
                            </GroupBox.Header>
                            <!--  本页只做「列表 + 连接 + 图像」验证；曝光/增益等参数由检测项负责下发  -->
                            <!--  紧凑测试卡三行：行1 状态文字 + 连接，行2 图像采集/保存图像，行3 图像实时 + 断开（右下）；所有按钮等长  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="连接状态:" Style="{StaticResource Label_style}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Model.StatusText}"
                                        TextAlignment="Left" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding ConnectCommand}"
                                    Content="连接"
                                    Style="{StaticResource PanelButton}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Command="{Binding CaptureCommand}"
                                    Content="图像采集"
                                    Style="{StaticResource PanelButton}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding SaveImageCommand}"
                                    Content="保存图像"
                                    Style="{StaticResource PanelButton}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Command="{Binding LiveCommand}"
                                    Content="{Binding Model.LiveButtonText}"
                                    Style="{StaticResource PanelButton}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Command="{Binding DisconnectCommand}"
                                    Content="断开"
                                    Style="{StaticResource DangerButton}" />
                            </Grid>
                        </GroupBox>
                    </materialDesign:Card>

                    <wpfcc:RunOutputView
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        ClearCommand="{Binding ClearOutputCommand}"
                        Elapsed="{Binding LastElapsed}"
                        Text="{Binding OutputText}" />
                </Grid>

                <!--  右：图像显示（对标旧页 DisplaySingleGroupView；十字线一类的显示叠加归检测项显示层）  -->
                <materialDesign:Card
                    Grid.Column="2"
                    Padding="12"
                    UniformCornerRadius="12">
                    <DockPanel>
                        <Grid Margin="4,0,4,8" DockPanel.Dock="Top">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionTitle}"
                                Text="图像" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.7"
                                Text="{Binding Model.FrameInfo}" />
                        </Grid>
                        <!--  深色底让灰度图有对比；无图时只留空底与右上角规格说明  -->
                        <Border
                            Background="#101418"
                            ClipToBounds="True"
                            CornerRadius="8">
                            <Grid>
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding Model.Preview}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
