<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <!--
            页面样式（PageTitle / PageSubTitle / SectionTitle / DmInput / DmCombo / DmGrid / OutputBox）
            不在本文件定义，只**引用** Device.Controls 自己那份 —— 样式归页面所有，宿主只做引用。
            本文件只留壳级样式：侧栏导航 + 品牌色。
        -->
        <ResourceDictionary Source="pack://application:,,,/Device.Controls;component/Themes/PageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  品牌色（侧栏 chip 固定深色底专用，不随主题变；功能色仍走 MD 原生键）  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

    <!--
        导航项标题：默认跟随浅深；选中行压在 Primary 上时换成 Primary.Foreground。
        ⚠️ 前景必须写在 Style 的 Setter 里（DataTemplate 局部值会盖过 DataTrigger）。
        ⚠️ 不能写死白色：主色可能是浅色，要交给 MD 的 Primary.Foreground 自动翻黑/白。
    -->
    <Style x:Key="NavItemText" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        侧栏导航。悬停底色走 MD 原生 ListView.Hover（跟随主题），
        选中底色走 Primary（跟随主色）；chip 保持固定深底浅字（与主色解耦）。
    -->
    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:Chip
                            Background="#334155"
                            Content="{Binding Badge}"
                            Foreground="#E2E8F0" />
                        <TextBlock Style="{StaticResource NavItemText}" Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="bd"
                                    Margin="0,2"
                                    Padding="8,6"
                                    Background="Transparent"
                                    CornerRadius="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListView.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
