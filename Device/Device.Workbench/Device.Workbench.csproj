<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- P6：项目统一 AnyCPU；厂商 SDK 位数限制改由 Device.Runtime 在运行时检查，不再强制宿主架构。 -->
    <Platform>AnyCPU</Platform>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Extension\Extension\Extension.csproj" />
    <ProjectReference Include="..\..\WPFCustomControls\WPFCustomControls\WPFCustomControls.csproj" />
    <ProjectReference Include="..\Device.Controls\Device.Controls.csproj" />
    <ProjectReference Include="..\Device.Runtime\Device.Runtime.csproj" />
  </ItemGroup>

</Project>
