<Window
    x:Class="Device.Workbench.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:wpfcc="clr-namespace:WPFCustomControls.Controls;assembly=WPFCustomControls"
    Title="Device 测试工作台"
    Width="1440"
    Height="900"
    MinWidth="1100"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  侧栏（跟随主题：浅色主题下浅底深字，深色主题下深底浅字）  -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <DockPanel>
                <StackPanel Margin="10,24,16,12" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="40"
                            Height="40"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="CameraControl" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Text="Device" />
                            <!--  次要文字：主前景 + Opacity（不用 ForegroundLight，WCAG 不过关）  -->
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Opacity="0.7"
                                Text="测试工作台 · Material" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--
                    主题切换复用 ThemePickerView：Theme 传宿主 DI 里的 ThemeService 单例。
                    侧栏跟随主题，必须显式传 FieldBackground / FieldForeground
                    （控件默认值是给固定深色侧栏用的，压在浅底上看不清）。
                -->
                <StackPanel Margin="16,0,16,16" DockPanel.Dock="Bottom">
                    <wpfcc:ThemePickerView
                        FieldBackground="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        FieldForeground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Theme="{Binding Theme}" />
                    <TextBlock
                        Margin="8,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                        Opacity="0.7"
                        Text="Core · Runtime · Drivers · Prism · WPF · .NET 9" />
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                    Style="{StaticResource NavListBox}" />
            </DockPanel>
        </Border>

        <!--
            内容区域（Prism 区域导航）：整页套 ScrollViewer，窗口高度不足时页面可上下滚动。
            页面外边距挪到这里，页面根 Grid 才能干净地绑定 ViewportHeight 撑满视口。
        -->
        <ScrollViewer
            Grid.Column="1"
            Margin="24,12,24,12"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ContentControl prism:RegionManager.RegionName="MainRegion" />
        </ScrollViewer>
    </Grid>
</Window>
